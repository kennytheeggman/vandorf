// The terminal routes: shells on a pty, read by long polling.
//   POST /api/term?cwd=..                 a new terminal, its id
//   GET  /api/term/list                   the terminals' ids
//   GET  /api/term/read?id=&from=         output from an offset (X-Next, X-Closed)
//   POST /api/term/input?id=              the body, typed
//   POST /api/term/resize?id=&cols=&rows=
//   POST /api/term/kill?id=

func Chunk(c: TermChunk): HttpResponse = "../../rs/src/ide_leaf.rs:chunk_response";
func Ints(xs: []int): []Json = "../../rs/src/ide_leaf.rs:ints";

proc TermRoute(At): HttpResponse {
	func At(s: { base: string, req: HttpRequest }): { base: string, req: HttpRequest } = "../../rs/src/sema_leaf.rs:same";
	func Q(s: { q: map[string]string, k: string }): int = "../../rs/src/ide_leaf.rs:query_int";
	func OkJson(n: int): HttpResponse = "../../rs/src/ide_leaf.rs:ok_json";
	At switch {
		(this.req.method == "POST" && this.req.path == "/api/term" && "cwd" in this.req.query && this.req.query["cwd"] != "") -> ResolvePath(s = { base = this.base, p = this.req.query["cwd"] }),
		(this.req.method == "POST" && this.req.path == "/api/term") -> Term.Spawn(cwd = this.base),
		(this.req.method == "GET" && this.req.path == "/api/term/list") -> Term.List(n = 0),
		(!("id" in this.req.query) || Q(s = { q = this.req.query, k = "id" }) < 0) -> id(ApiErr(msg = "no such terminal")),
		(this.req.method == "GET" && this.req.path == "/api/term/read") -> Term.Read(id = Q(s = { q = this.req.query, k = "id" }), from = Q(s = { q = this.req.query, k = "from" })),
		(this.req.method == "POST" && this.req.path == "/api/term/input") -> Term.Input(id = Q(s = { q = this.req.query, k = "id" }), data = this.req.body) as Typed,
		(this.req.method == "POST" && this.req.path == "/api/term/resize" && Q(s = { q = this.req.query, k = "cols" }) > 0 && Q(s = { q = this.req.query, k = "rows" }) > 0) -> Term.Resize(id = Q(s = { q = this.req.query, k = "id" }), cols = Q(s = { q = this.req.query, k = "cols" }), rows = Q(s = { q = this.req.query, k = "rows" })) as Resized,
		(this.req.method == "POST" && this.req.path == "/api/term/resize") -> id(ApiErr(msg = "need cols and rows")),
		(this.req.method == "POST" && this.req.path == "/api/term/kill") -> Term.Kill(id = Q(s = { q = this.req.query, k = "id" })),
		else -> id(NotFound(n = 0))
	};
	// A cwd that isn't a directory under the source directory: the source
	// directory.
	ResolvePath switch {
		Ok(dir) -> Fs.IsDir(path = dir),
		Err(_) -> Term.Spawn(cwd = At.base)
	};
	Fs.IsDir switch {
		(this) -> Term.Spawn(cwd = UnwrapR2(r = ResolvePath)),
		else -> Term.Spawn(cwd = At.base)
	};
	Term.Spawn switch {
		Ok(n) -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "id", value = Num(n) }]))),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Term.List -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "ids", value = Arr(Ints(xs = this)) }])));
	Term.Read switch {
		(this.ok) -> id(Chunk(c = this)),
		else -> id(ApiErr(msg = "no such terminal"))
	};
	Typed -> Done(r = this);
	Resized -> Done(r = this);
	func Done(r: Res<string>): Res<string> = "../../rs/src/sema_leaf.rs:same";
	Done switch {
		Ok(_) -> id(OkJson(n = 0)),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Term.Kill switch {
		(this) -> id(OkJson(n = 0)),
		else -> id(ApiErr(msg = "no such terminal"))
	};
}
