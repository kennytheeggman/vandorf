// POST /api/compile {source} or {path}: the document, symbols and generated
// code, or diagnostics; with previews: false, no generated code (the
// diagram's part, quick). If the file belongs to a project (a vandorf.toml at
// or above it, inside the source directory), the whole project is compiled
// with the editor's text in place of the file, and previewed with the
// manifest's settings; otherwise just the text, with nominal output
// locations. Nothing is written.

type MaybeProject = enum { None, Some(Project) };
// The files compiled: names as shown, texts, the root names are relative to,
// and which is the editor's; previews: whether to generate code.
type Unit = { names: []string, srcs: []string, root: string, here: int, project: MaybeProject, previews: bool };
func WantsPreviews(j: Json): bool = "ide_leaf.rs:wants_previews";

func NonBlank(m: MaybeStr): bool = "ide_leaf.rs:non_blank";
func NonEmpty(m: MaybeStr): bool = "ide_leaf.rs:non_empty";
func PathIndex(paths: []string, root: string, abs: string): int = "ide_leaf.rs:index_of_path";
func SetAt(xs: []string, i: int, x: string): []string = "ide_leaf.rs:set_at";

proc CompileRoute(At): HttpResponse {
	func At(req: HttpRequest): HttpRequest = "../leaf.rs:same";
	func Text(s: string): string = "../leaf.rs:same";
	At -> Session.Base(n = 0);
	Session.Base -> ParseJson(text = At.body);
	ParseJson switch {
		Ok(j) -> switch {
			(NonBlank(m = JsonStr(j = j, key = "source"))) -> Text(s = UnwrapS(m = JsonStr(j = j, key = "source"))),
			(NonEmpty(m = JsonStr(j = j, key = "path"))) -> ReadSource(s = { base = Session.Base, p = UnwrapS(m = JsonStr(j = j, key = "path")) }),
			else -> id(ApiErr(msg = "provide either \"path\" or \"source\""))
		},
		Err(e) -> id(ApiErr(msg = "bad request: " + e.msg))
	};
	ReadSource switch {
		Ok(text) -> Text(s = text),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Text switch {
		(NonEmpty(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "path"))) -> ResolvePath(s = { base = Session.Base, p = UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "path")) }),
		else -> CompileUnit(s = { base = Session.Base, unit = { names = [EditorName(j = UnwrapJ(r = ParseJson))], srcs = [this], root = Session.Base, here = 0, project = None(), previews = WantsPreviews(j = UnwrapJ(r = ParseJson)) } }) as Single
	};
	ResolvePath switch {
		Ok(abs) -> FindUp(s = { dir = Parent(p = abs), marker = "vandorf.toml" }),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	FindUp switch {
		(this != "" && (this == Session.Base || HasPrefix(s = this, prefix = Session.Base + "/"))) -> LoadProject(path = JoinP(a = this, b = "vandorf.toml")),
		else -> CompileUnit(s = { base = Session.Base, unit = { names = [EditorName(j = UnwrapJ(r = ParseJson))], srcs = [Text], root = Session.Base, here = 0, project = None(), previews = WantsPreviews(j = UnwrapJ(r = ParseJson)) } }) as Alone
	};
	LoadProject switch {
		Ok(p) -> switch {
			(PathIndex(paths = p.paths, root = p.root, abs = UnwrapR2(r = ResolvePath)) < 0) -> id(ApiErr(msg = UnwrapR2(r = ResolvePath) + " is not under the sources of " + JoinP(a = FindUp, b = "vandorf.toml"))),
			else -> CompileUnit(s = { base = Session.Base, unit = { names = p.paths, srcs = SetAt(xs = p.srcs, i = PathIndex(paths = p.paths, root = p.root, abs = UnwrapR2(r = ResolvePath)), x = Text), root = p.root, here = PathIndex(paths = p.paths, root = p.root, abs = UnwrapR2(r = ResolvePath)), project = Some({ ..p, srcs = SetAt(xs = p.srcs, i = PathIndex(paths = p.paths, root = p.root, abs = UnwrapR2(r = ResolvePath)), x = Text) }), previews = WantsPreviews(j = UnwrapJ(r = ParseJson)) } }) as InProject
		},
		Err(e) -> id(ApiErr(msg = e.msg))
	};
}

// The editor's file as named in messages: its path, its "name", or <editor>.
func EditorName(j: Json): string = "ide_leaf.rs:editor_name";
func UnwrapR2(r: Res<string>): string = "ide_leaf.rs:unwrap_res_string";

// What a unit is checked from, as a cache key: its sources (their names
// and the file asked about only change how the result is shown).
func CheckKey(srcs: []string): string = "ide_leaf.rs:check_key";
func NoProgram(n: int): Program = "ide_leaf.rs:no_program";

proc CompileUnit(At): HttpResponse {
	func At(s: { base: string, unit: Unit }): { base: string, unit: Unit } = "../leaf.rs:same";
	// The unit's check: kept from an earlier compile, or made and kept.
	func Have(c: UnitCheck): UnitCheck = "../leaf.rs:same";
	At -> Checks.Get(key = CheckKey(srcs = this.unit.srcs));
	Checks.Get switch {
		Some(c) -> Have(c = c),
		else -> ParseUnit(s = { srcs = At.unit.srcs, i = 0, file = { types = [], interfaces = [], nodes = [] }, errors = [] })
	};
	ParseUnit switch {
		(this.errors.len > 0) -> Checks.Put(key = CheckKey(srcs = At.unit.srcs), c = { parse_errors = this.errors, sema_errors = [], prog = NoProgram(n = 0) }) as KeepParse,
		else -> Analyze(s = { srcs = At.unit.srcs, file = this.file })
	};
	Analyze -> Checks.Put(key = CheckKey(srcs = At.unit.srcs), c = { parse_errors = [], sema_errors = this.errors, prog = this.prog }) as KeepSema;
	KeepParse -> Have(c = { parse_errors = ParseUnit.errors, sema_errors = [], prog = NoProgram(n = 0) });
	KeepSema -> Have(c = { parse_errors = [], sema_errors = Analyze.errors, prog = Analyze.prog });
	Have switch {
		(this.parse_errors.len > 0) -> Diagnostics(s = { unit = At.unit, errors = this.parse_errors }) as ParseErrors,
		(this.sema_errors.len > 0) -> Diagnostics(s = { unit = At.unit, errors = this.sema_errors }) as SemaErrors,
		else -> Symbols(s = { base = At.base, unit = At.unit, prog = this.prog })
	};
	Symbols switch {
		(At.unit.previews) -> RustPreview(s = { unit = At.unit, prog = Have.prog }),
		else -> DocumentJson(prog = Have.prog) as DiagramOnly
	};
	RustPreview -> GoPreview(s = { unit = At.unit, prog = Have.prog });
	GoPreview -> DocumentJson(prog = Have.prog);
	DiagramOnly -> id(Api(j = Obj([
		{ key = "ok", value = Bool(true) },
		{ key = "name", value = Str(At.unit.names[At.unit.here]) },
		{ key = "project", value = ProjectName(p = At.unit.project) },
		{ key = "grids", value = Num(Procs(nodes = Have.prog.nodes).len) },
		{ key = "document", value = this },
		{ key = "symbols", value = Symbols }
	])));
	DocumentJson -> id(Api(j = Obj([
		{ key = "ok", value = Bool(true) },
		{ key = "name", value = Str(At.unit.names[At.unit.here]) },
		{ key = "project", value = ProjectName(p = At.unit.project) },
		{ key = "grids", value = Num(Procs(nodes = Have.prog.nodes).len) },
		{ key = "document", value = this },
		{ key = "symbols", value = Symbols },
		{ key = "go", value = GoPreview },
		{ key = "rust", value = RustPreview }
	])));
}

func ProjectName(p: MaybeProject): Json = "ide_leaf.rs:project_name_json";

// Each file parsed, its errors kept (they're diagnostics, not failures).
proc ParseUnit(At): { file: File, errors: []Diag } {
	func At(s: { srcs: []string, i: int, file: File, errors: []Diag }): { srcs: []string, i: int, file: File, errors: []Diag } = "../leaf.rs:same";
	At switch {
		(this.i == this.srcs.len) -> id({ file = this.file, errors = this.errors }),
		else -> TryParse(src = this.srcs[this.i], file = this.i)
	};
	TryParse switch {
		Ok(f) -> At(s = { ..At, i = At.i + 1, file = { types = At.file.types + f.types, interfaces = At.file.interfaces + f.interfaces, nodes = At.file.nodes + f.nodes } }),
		Err(e) -> At(s = { ..At, i = At.i + 1, errors = At.errors + [e] })
	};
}

// 200 with ok: false, so the client can still read the diagnostics.
proc Diagnostics(At): HttpResponse {
	func At(s: { unit: Unit, errors: []Diag }): { unit: Unit, errors: []Diag } = "../leaf.rs:same";
	func List(names: []string, srcs: []string, here: int, errors: []Diag): Json = "ide_leaf.rs:diagnostics_json";
	func Rendered(names: []string, srcs: []string, errors: []Diag): string = "ide_leaf.rs:render_diagnostics";
	At -> id(Api(j = Obj([
		{ key = "ok", value = Bool(false) },
		{ key = "error", value = Str(Rendered(names = this.unit.names, srcs = this.unit.srcs, errors = this.errors)) },
		{ key = "diagnostics", value = List(names = this.unit.names, srcs = this.unit.srcs, here = this.unit.here, errors = this.errors) }
	])));
}

// ---- Symbols, for the viewer's preview drawer ----

// Typedefs, funcs and procs, with where they're declared (paths relative to
// the source directory, 0-based lines) and, for funcs, their implementation
// files resolved the same way.
proc Symbols(At): Json {
	func At(s: { base: string, unit: Unit, prog: Program }): { base: string, unit: Unit, prog: Program } = "../leaf.rs:same";
	At -> TypeSymbols(s = { types = this.prog.types, i = 0, acc = [] });
	TypeSymbols -> NodeSymbols(s = { base = At.base, unit = At.unit, prog = At.prog, i = 0, acc = [] });
	NodeSymbols -> id(Obj([{ key = "types", value = Obj(TypeSymbols) }, { key = "nodes", value = Obj(this) }]));
}

proc TypeSymbols(At): []JsonField {
	func At(s: { types: []TypeDef, i: int, acc: []JsonField }): { types: []TypeDef, i: int, acc: []JsonField } = "../leaf.rs:same";
	At switch {
		(this.i == this.types.len) -> id(this.acc),
		else -> ShowType(t = this.types[this.i].ty)
	};
	ShowType -> At(s = { ..At, i = At.i + 1, acc = At.acc + [{ key = At.types[At.i].name, value = Obj([{ key = "def", value = Str(this) }, { key = "recursive", value = Bool(At.types[At.i].recursive) }]) }] });
}

proc NodeSymbols(At): []JsonField {
	func At(s: { base: string, unit: Unit, prog: Program, i: int, acc: []JsonField }): { base: string, unit: Unit, prog: Program, i: int, acc: []JsonField } = "../leaf.rs:same";
	func K(k: NodeKind): NodeKind = "../leaf.rs:same";
	// { file, line } of a node: its file relative to base (or null).
	func Loc(base: string, unit: Unit, span: Span): Json = "ide_leaf.rs:loc_json";
	// A func's implementations: written, path (relative to base), function, lang.
	func Imps(base: string, unit: Unit, span: Span, imps: []ImplRef): Json = "ide_leaf.rs:imps_json";
	At switch {
		(this.i == this.prog.nodes.len) -> id(this.acc),
		else -> K(k = this.prog.nodes[this.i].kind)
	};
	K switch {
		Func(f) -> ShowParams(s = { ps = f.params, i = 0, acc = "" }) as FP,
		Proc(p) -> ShowParams(s = { ps = NodeParams(nodes = At.prog.nodes, n = p.entry), i = 0, acc = "" }) as PP,
		else -> At(s = { ..At, i = At.i + 1 })
	};
	FP -> ShowType(t = NodeRet(nodes = At.prog.nodes, n = At.i)) as FR;
	FR -> At(s = { ..At, i = At.i + 1, acc = At.acc + [{ key = QualName(n = At.prog.nodes[At.i]), value = Obj([
		{ key = "kind", value = Str("func") },
		{ key = "params", value = Str(FP) },
		{ key = "ret", value = Str(this) },
		{ key = "imps", value = Imps(base = At.base, unit = At.unit, span = At.prog.nodes[At.i].span, imps = FuncImps(n = At.prog.nodes[At.i])) },
		{ key = "loc", value = Loc(base = At.base, unit = At.unit, span = At.prog.nodes[At.i].span) }
	]) }] });
	PP -> ShowType(t = NodeRet(nodes = At.prog.nodes, n = At.i)) as PR;
	PR -> At(s = { ..At, i = At.i + 1, acc = At.acc + [{ key = QualName(n = At.prog.nodes[At.i]), value = Obj([
		{ key = "kind", value = Str("proc") },
		{ key = "params", value = Str(PP) },
		{ key = "ret", value = Str(this) },
		{ key = "entry", value = Str(EntryName(prog = At.prog, pid = At.i)) },
		{ key = "loc", value = Loc(base = At.base, unit = At.unit, span = At.prog.nodes[At.i].span) }
	]) }] });
}

func FuncImps(n: NodeDecl): []ImplRef = "ide_leaf.rs:func_imps";
func EntryName(prog: Program, pid: int): string = "ide_leaf.rs:entry_name";

// ---- The Rust preview: what `vcc build` would generate ----

proc RustPreview(At): Json {
	func At(s: { unit: Unit, prog: Program }): { unit: Unit, prog: Program } = "../leaf.rs:same";
	func P(p: MaybeProject): MaybeProject = "../leaf.rs:same";
	func R(r: MaybeRust): MaybeRust = "../leaf.rs:same";
	func NominalMains(prog: Program): map[string]Bin = "ide_leaf.rs:nominal_mains";
	func Dirs(root: string, paths: []string): []string = "../cli/cli_leaf.rs:dirs";
	At -> P(p = this.unit.project);
	P switch {
		Some(p) -> R(r = p.manifest.rust),
		// Nominal locations: impl paths as written, as if the output were
		// next to the file.
		else -> Preview(s = { prog = At.prog, module_dir = Some("app"), krate = "my_crate", bins = NominalMains(prog = At.prog) }) as Nominal
	};
	R switch {
		Some(r) -> FindUp(s = { dir = JoinP(a = At.unit.root, b = r.out), marker = "Cargo.toml" }),
		else -> id(Obj([{ key = "ok", value = Bool(false) }, { key = "error", value = Str("not configured in vandorf.toml") }]))
	};
	FindUp -> CrateName(dir = this);
	CrateName -> Preview(s = {
		prog = RebaseImpls(prog = At.prog, dirs = Dirs(root = At.unit.root, paths = At.unit.names), out = JoinP(a = At.unit.root, b = UnwrapR(r = R).out)),
		module_dir = ModuleDir(target = UnwrapR(r = R), out = JoinP(a = At.unit.root, b = UnwrapR(r = R).out), croot = FindUp),
		krate = this,
		bins = UnwrapPr(p = P).manifest.bins
	}) as Configured;
}

func UnwrapPr(p: MaybeProject): Project = "ide_leaf.rs:unwrap_project";

// What vcc build would generate in Go: with [go]'s settings, or nominal
// ones (package app in example.com/app) for a file outside a project.
proc GoPreview(At): Json {
	func At(s: { unit: Unit, prog: Program }): { unit: Unit, prog: Program } = "../leaf.rs:same";
	func P(p: MaybeProject): MaybeProject = "../leaf.rs:same";
	func G(g: MaybeGo): MaybeGo = "../leaf.rs:same";
	func Base(b: MaybeStr): MaybeStr = "../leaf.rs:same";
	func NominalGoMains(prog: Program): []GoMainSpec = "ide_leaf.rs:nominal_go_mains";
	func UnwrapG(g: MaybeGo): GoTarget = "ide_leaf.rs:unwrap_go";
	func Dirs(root: string, paths: []string): []string = "../cli/cli_leaf.rs:dirs";
	At -> P(p = this.unit.project);
	P switch {
		Some(p) -> G(g = p.manifest.go),
		else -> GoPreviewJson(s = { prog = At.prog, package = "app", import_base = Some("example.com/app"), types_dir = "types", mains = NominalGoMains(prog = At.prog), servers = [] }) as Nominal
	};
	G switch {
		Some(g) -> FindUp(s = { dir = JoinP(a = At.unit.root, b = g.out), marker = "go.mod" }),
		else -> id(Obj([{ key = "ok", value = Bool(false) }, { key = "error", value = Str("not configured in vandorf.toml") }]))
	};
	FindUp switch {
		(this == "") -> Base(b = GoImportBase(g = UnwrapG(g = G), root = "", gomod = "", out = JoinP(a = At.unit.root, b = UnwrapG(g = G).out))),
		else -> Fs.Read(path = JoinP(a = this, b = "go.mod"))
	};
	Fs.Read -> Base(b = GoImportBase(g = UnwrapG(g = G), root = FindUp, gomod = this, out = JoinP(a = At.unit.root, b = UnwrapG(g = G).out)));
	Base -> GoPreviewJson(s = {
		prog = RebaseImpls(prog = At.prog, dirs = Dirs(root = At.unit.root, paths = At.unit.names), out = JoinP(a = At.unit.root, b = UnwrapG(g = G).out)),
		package = GoPackage(g = UnwrapG(g = G), out = JoinP(a = At.unit.root, b = UnwrapG(g = G).out)),
		import_base = this,
		types_dir = UnwrapOr(m = UnwrapG(g = G).types_dir, d = "types"),
		mains = GoMainSpecs(c = { project = UnwrapPr(p = P), prog = At.prog }, g = UnwrapG(g = G), names = UnwrapPr(p = P).manifest.bins.keys),
		servers = []
	}) as Configured;
}

// The generated files as JSON (artifacts: types, code, mains) and the
// implementations they call; or the error.
proc GoPreviewJson(At): Json {
	func At(s: GoGenIn): GoGenIn = "../leaf.rs:same";
	func Output(o: GoOut, prog: Program, t: Table, setup: GoSetup): Json = "ide_leaf.rs:go_output_json";
	At -> GoGenerate(s = this);
	GoGenerate -> BuildTable(prog = At.prog);
	BuildTable -> id(Output(o = GoGenerate, prog = At.prog, t = this, setup = GoSetupOf(package = At.package, import_base = At.import_base, types_dir = At.types_dir)));
}

// The generated files as JSON: artifacts (types, code, mains) and the
// implementations they call; or the error.
proc Preview(At): Json {
	func At(s: { prog: Program, module_dir: MaybeStr, krate: string, bins: map[string]Bin }): { prog: Program, module_dir: MaybeStr, krate: string, bins: map[string]Bin } = "../leaf.rs:same";
	func Output(types: string, modrs: string, procs: string, mains: []OutFile, impls: Json): Json = "ide_leaf.rs:output_json";
	func Impls(prog: Program, t: Table, module_dir: MaybeStr): Json = "ide_leaf.rs:impls_json";
	func Error(msg: string): Json = "ide_leaf.rs:error_json";
	At -> RustGenerate(s = { prog = this.prog, module_dir = this.module_dir, servers = [] });
	RustGenerate switch {
		{ types = _, procs = _, modrs = _, http = _, err = Some(e) } -> id(Error(msg = e)),
		else -> PreviewMains(s = { prog = At.prog, bins = At.bins, names = At.bins.keys, module_dir = At.module_dir, krate = At.krate, i = 0, acc = [] })
	};
	PreviewMains switch {
		Ok(mains) -> BuildTable(prog = At.prog),
		Err(e) -> id(Error(msg = e.msg))
	};
	BuildTable -> id(Output(types = RustGenerate.types, modrs = RustGenerate.modrs, procs = RustGenerate.procs, mains = UnwrapOut(r = PreviewMains), impls = Impls(prog = At.prog, t = this, module_dir = At.module_dir)));
}

func UnwrapOut(r: Res<[]OutFile>): []OutFile = "ide_leaf.rs:unwrap_out";

// The bins' files: dir (relative to the module) as path, file name as kind.
proc PreviewMains(At): Res<[]OutFile> {
	func At(s: { prog: Program, bins: map[string]Bin, names: []string, module_dir: MaybeStr, krate: string, i: int, acc: []OutFile }): { prog: Program, bins: map[string]Bin, names: []string, module_dir: MaybeStr, krate: string, i: int, acc: []OutFile } = "../leaf.rs:same";
	func RustMain(prog: Program, t: Table, name: string, entry: string, path: string, module_dir: MaybeStr, krate: string): { dir: string, file: string, text: string, err: MaybeStr } = "../gen/gen_leaf.rs:rust_main";
	func BinPath(b: Bin, name: string): string = "../cli/cli_leaf.rs:bin_path";
	At switch {
		(this.i == this.names.len) -> id(Ok(this.acc)),
		else -> BuildTable(prog = this.prog)
	};
	BuildTable -> RustMain(prog = At.prog, t = this, name = At.names[At.i], entry = At.bins[At.names[At.i]].entry, path = BinPath(b = At.bins[At.names[At.i]], name = At.names[At.i]), module_dir = At.module_dir, krate = At.krate);
	RustMain switch {
		{ dir = _, file = _, text = _, err = Some(e) } -> id(Err({ msg = e, span = { at = 0, end = 0, file = 0 } })),
		else -> At(s = { ..At, i = At.i + 1, acc = At.acc + [{ path = this.dir, text = this.text, kind = this.file }] })
	};
}
