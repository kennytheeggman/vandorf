// Projects (src/project.rs in the reference): vandorf.toml and the .sys
// files it covers.

type Manifest = { name: string, sources: []string, rust: MaybeRust, has_go: bool, bins: map[string]Bin };
type RustTarget = { out: string, module_dir: MaybeStr };
type MaybeRust = enum { None, Some(RustTarget) };
type Bin = { entry: string, go: MaybeStr, rust: MaybeStr };
// root: the manifest's directory. paths: relative to root, sorted.
type Project = { root: string, manifest: Manifest, paths: []string, srcs: []string };

func ParseManifest(text: string): Res<Manifest> = "../../rs/src/cli_leaf.rs:parse_manifest";
func JoinP(a: string, b: string): string = "../../rs/src/cli_leaf.rs:join";
func Parent(p: string): string = "../../rs/src/cli_leaf.rs:parent";
func Relative(target: string, from: string): string = "../../rs/src/cli_leaf.rs:relative";
func SortDedup(xs: []string): []string = "../../rs/src/cli_leaf.rs:sort_dedup";
func StartsWith(text: string, prefix: string): bool = "../../rs/src/cli_leaf.rs:starts_with";
func RebaseImpls(prog: Program, dirs: []string, out: string): Program = "../../rs/src/cli_leaf.rs:rebase_impls";
func RelSegs(root: string, dir: string): []string = "../../rs/src/cli_leaf.rs:rel_segs";
func CargoLibName(toml: string, has_lib_rs: bool): string = "../../rs/src/cli_leaf.rs:cargo_lib_name";

// The nearest directory at or above dir that has `marker`, or "".
proc FindUp(At): string {
	func At(s: { dir: string, marker: string }): { dir: string, marker: string } = "../../rs/src/sema_leaf.rs:same";
	At -> Fs.IsFile(path = JoinP(a = this.dir, b = this.marker));
	Fs.IsFile switch {
		(this) -> id(At.dir),
		(At.dir == "/" || At.dir == "") -> id(""),
		else -> At(s = { dir = Parent(p = At.dir), marker = At.marker })
	};
}

// Reads the manifest at path and every .sys file under its sources.
proc LoadProject(At): Res<Project> {
	func At(path: string): string = "../../rs/src/sema_leaf.rs:same";
	At -> Fs.Read(path = this) as Text;
	Text -> ParseManifest(text = this);
	ParseManifest switch {
		Ok(m) -> SourceFiles(s = { root = Parent(p = At), m = m, i = 0, acc = [] }),
		Err(e) -> id(Err({ msg = At + ": " + e.msg, span = e.span }))
	};
	SourceFiles switch {
		Ok(paths) -> switch {
			(paths.len == 0) -> id(Err({ msg = At + ": no .sys files under " + Join(parts = UnwrapM(r = ParseManifest).sources, sep = ", "), span = { at = 0, end = 0, file = 0 } })),
			else -> ReadAll(s = { root = Parent(p = At), paths = paths, i = 0, acc = [] })
		},
		Err(e) -> id(Err({ msg = At + ": " + e.msg, span = e.span }))
	};
	ReadAll -> id(Ok({ root = Parent(p = At), manifest = UnwrapM(r = ParseManifest), paths = UnwrapPaths(r = SourceFiles), srcs = this }));
}

func UnwrapM(r: Res<Manifest>): Manifest = "../../rs/src/cli_leaf.rs:unwrap_m";
func UnwrapPaths(r: Res<[]string>): []string = "../../rs/src/cli_leaf.rs:unwrap_paths";

// The .sys files under each source directory, relative to root, sorted.
proc SourceFiles(At): Res<[]string> {
	func At(s: { root: string, m: Manifest, i: int, acc: []string }): { root: string, m: Manifest, i: int, acc: []string } = "../../rs/src/sema_leaf.rs:same";
	func Rel(paths: []string, root: string): []string = "../../rs/src/cli_leaf.rs:rel_all";
	At switch {
		(this.i == this.m.sources.len) -> id(Ok(SortDedup(xs = this.acc))),
		else -> Fs.IsDir(path = JoinP(a = this.root, b = this.m.sources[this.i]))
	};
	Fs.IsDir switch {
		(this) -> Fs.Walk(dir = JoinP(a = At.root, b = At.m.sources[At.i])),
		else -> id(Err({ msg = "source directory " + At.m.sources[At.i] + " does not exist", span = { at = 0, end = 0, file = 0 } }))
	};
	Fs.Walk -> At(s = { root = At.root, m = At.m, i = At.i + 1, acc = At.acc + Rel(paths = this, root = At.root) });
}

proc ReadAll(At): []string {
	func At(s: { root: string, paths: []string, i: int, acc: []string }): { root: string, paths: []string, i: int, acc: []string } = "../../rs/src/sema_leaf.rs:same";
	At switch {
		(this.i == this.paths.len) -> id(this.acc),
		else -> Fs.Read(path = JoinP(a = this.root, b = this.paths[this.i]))
	};
	Fs.Read -> At(s = { root = At.root, paths = At.paths, i = At.i + 1, acc = At.acc + [this] });
}
