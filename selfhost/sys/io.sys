// I/O: the only impure part of vcc. Everything else is pure: procs, and
// leaf funcs in rs/src/*_leaf.rs.

interface Fs {
	func Read(path: string): string = "../rs/src/io.rs:read";
	// Writes text to path, creating its directory.
	func Write(path: string, text: string): bool = "../rs/src/io.rs:write";
	func IsFile(path: string): bool = "../rs/src/io.rs:is_file";
	func IsDir(path: string): bool = "../rs/src/io.rs:is_dir";
	// The working directory.
	func Cwd(n: int): string = "../rs/src/io.rs:cwd";
	// The .sys files under dir, skipping hidden directories and build output.
	func Walk(dir: string): []string = "../rs/src/io.rs:walk";
}

interface Tools {
	// Formats Rust files, if rustfmt is installed.
	func Rustfmt(files: []string): bool = "../rs/src/io.rs:rustfmt";
}

interface Console {
	// A line on stderr.
	func Err(line: string): bool = "../rs/src/io.rs:eprint";
}
