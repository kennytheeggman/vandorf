// http.rs and server executables (src/codegen/rust.rs: http,
// server_artifact in the reference): Json for every type, a call per proc
// a route runs, and a handler per server.

type Route = { method: string, path: string, proc: string };
// file: as the server's source file reaches it; ctype: its content type.
type StaticFile = { url: string, file: string, ctype: string };
// path: the server's file, relative to the crate's src/.
// routes: JSON in and out; raw: the proc takes the request, returns the response.
type ServerSpec = { name: string, addr: string, routes: []Route, raw: []Route, statics: []StaticFile, path: string };

func HttpRuntime(n: int): string = "../../leaves/gen_leaf.rs:http_runtime";
func ServerIdent(name: string): string = "../../leaves/gen_leaf.rs:server_ident";
func SortStrs(xs: []string): []string = "../../leaves/gen_leaf.rs:sort_strs";
func FindTop(prog: Program, name: string): int = "../../leaves/gen_leaf.rs:find_top";

// http.rs, or why it can't be written.
proc RustHttp(At): { text: string, err: MaybeStr } {
	func At(s: { g: RGen, servers: []ServerSpec }): { g: RGen, servers: []ServerSpec } = "../../leaves/sema_leaf.rs:same";
	func RouteProcs(servers: []ServerSpec): []string = "../../leaves/gen_leaf.rs:route_procs";
	At -> JsonImpls(s = { g = this.g, i = 0, acc = [
		L("// Code generated by vandorf. DO NOT EDIT."),
		L("//! HTTP servers for the procs: requests and results as JSON."),
		L("#![allow(unused, non_snake_case, clippy::all)]"),
		L(""),
		L("use super::types;"),
		Raw(HttpRuntime(n = 0)),
		L("")
	] });
	JsonImpls -> HttpCalls(s = { g = At.g, servers = At.servers, procs = SortStrs(xs = RouteProcs(servers = At.servers)), i = 0, acc = this });
	HttpCalls switch {
		{ lines = _, err = Some(e) } -> id({ text = "", err = Some(e) }),
		else -> RawCalls(s = { g = At.g, servers = At.servers, procs = SortStrs(xs = RawProcs(servers = At.servers)), i = 0, acc = this.lines })
	};
	func RawProcs(servers: []ServerSpec): []string = "../../leaves/gen_leaf.rs:raw_procs";
	RawCalls switch {
		{ lines = _, err = Some(e) } -> id({ text = "", err = Some(e) }),
		else -> Handlers(s = { g = At.g, servers = At.servers, i = 0, acc = this.lines })
	};
	Handlers -> id({ text = Lines(lines = this, indent = "    "), err = None() });
}

func Q2(s: string): string = "../../leaves/gen_leaf.rs:quote_twice";

// `impl Json` for each type of the table.
proc JsonImpls(At): []Line {
	func At(s: { g: RGen, i: int, acc: []Line }): { g: RGen, i: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	func S(s: Shape): Shape = "../../leaves/sema_leaf.rs:same";
	At switch {
		(this.i == this.g.table.types.len) -> id(this.acc),
		else -> S(s = this.g.table.types[this.i].shape)
	};
	S switch {
		Struct(fs) -> StructJson(s = { name = "types::" + At.g.table.types[At.i].name, tname = At.g.table.types[At.i].name, fs = fs, i = 0, to = [], from = [] }) as SJ,
		Enum(vs) -> EnumJson(s = { name = "types::" + At.g.table.types[At.i].name, tname = At.g.table.types[At.i].name, vs = vs, i = 0, to = [], bare = [], payload = [] }) as EJ
	};
	SJ -> Impl(ls = this);
	EJ -> Impl(ls = this);
	func Impl(ls: []Line): []Line = "../../leaves/sema_leaf.rs:same";
	Impl -> At(s = { ..At, i = At.i + 1, acc = At.acc + [L("impl Json for types::" + At.g.table.types[At.i].name + " {")] + this + [L("}"), L("")] });
}

proc StructJson(At): []Line {
	func At(s: { name: string, tname: string, fs: []RefMember, i: int, to: []Line, from: []Line }): { name: string, tname: string, fs: []RefMember, i: int, to: []Line, from: []Line } = "../../leaves/sema_leaf.rs:same";
	func Comma(i: int): string = "../../leaves/gen_leaf.rs:comma";
	At switch {
		(this.i == this.fs.len) -> id([L("fn to_json(&self, out: &mut String) {"), L("out.push('{');")] + this.to + [L("out.push('}');"), L("}"),
			L("fn from_json(v: &Value) -> Result<Self, String> {"), L("let fs = v.object(" + Quote(s = this.tname) + ")?;"), L("Ok(" + this.name + " {")] + this.from + [L("})"), L("}")]),
		else -> At(s = { ..this, i = this.i + 1,
			to = this.to + [L("out.push_str(" + Quote(s = Comma(i = this.i) + Quote(s = this.fs[this.i].name) + ":") + ");"), L("self." + RustIdent(s = this.fs[this.i].name) + ".to_json(out);")],
			from = this.from + [L(RustIdent(s = this.fs[this.i].name) + ": Json::from_json(field(fs, " + Quote(s = this.fs[this.i].name) + ")?).map_err(|e| format!(\"" + this.fs[this.i].name + ": {e}\"))?,")] })
	};
}

proc EnumJson(At): []Line {
	func At(s: { name: string, tname: string, vs: []RefMember, i: int, to: []Line, bare: []Line, payload: []Line }): { name: string, tname: string, vs: []RefMember, i: int, to: []Line, bare: []Line, payload: []Line } = "../../leaves/sema_leaf.rs:same";
	func IsVoidRef(r: TyRef): bool = "../../leaves/gen_leaf.rs:is_void_ref";
	At switch {
		(this.i == this.vs.len) -> id([L("fn to_json(&self, out: &mut String) {"), L("match self {")] + this.to + [L("}"), L("}"),
			L("fn from_json(v: &Value) -> Result<Self, String> {"), L("match v {"), L("Value::Str(tag) => match tag.as_str() {")] + this.bare + [
			L("t => Err(format!(\"" + this.tname + " has no variant {t} without a payload\")),"), L("},"),
			L("Value::Obj(fs) if fs.len() == 1 => match fs[0].0.as_str() {")] + this.payload + [
			L("t => Err(format!(\"" + this.tname + " has no variant {t} with a payload\")),"), L("},"),
			L("_ => Err(" + Quote(s = "expected a variant of " + this.tname + ": \"Tag\" or {\"Tag\": payload}") + ".into()),"), L("}"), L("}")]),
		(IsVoidRef(r = this.vs[this.i].r)) -> At(s = { ..this, i = this.i + 1,
			to = this.to + [L(this.name + "::" + RustIdent(s = this.vs[this.i].name) + " => out.push_str(" + Q2(s = this.vs[this.i].name) + "),")],
			bare = this.bare + [L(Quote(s = this.vs[this.i].name) + " => Ok(" + this.name + "::" + RustIdent(s = this.vs[this.i].name) + "),")] }),
		else -> At(s = { ..this, i = this.i + 1,
			to = this.to + [L(this.name + "::" + RustIdent(s = this.vs[this.i].name) + "(p) => {"), L("out.push_str(" + Quote(s = "{" + Quote(s = this.vs[this.i].name) + ":") + ");"), L("p.to_json(out);"), L("out.push('}');"), L("}")],
			payload = this.payload + [L(Quote(s = this.vs[this.i].name) + " => Ok(" + this.name + "::" + RustIdent(s = this.vs[this.i].name) + "(Json::from_json(&fs[0].1)?)),")] })
	};
}

// A call per proc a route runs: the request's parameters decoded, the proc
// run, its result encoded.
proc HttpCalls(At): { lines: []Line, err: MaybeStr } {
	func At(s: { g: RGen, servers: []ServerSpec, procs: []string, i: int, acc: []Line }): { g: RGen, servers: []ServerSpec, procs: []string, i: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	func Decodes(g: RGen, pid: int): []Line = "../../leaves/gen_leaf.rs:http_decodes";
	func ArgNames(g: RGen, pid: int): string = "../../leaves/gen_leaf.rs:http_args";
	func ServerOf(servers: []ServerSpec, proc: string): string = "../../leaves/gen_leaf.rs:server_of";
	At switch {
		(this.i == this.procs.len) -> id({ lines = this.acc, err = None() }),
		(FindTop(prog = this.g.prog, name = this.procs[this.i]) < 0) -> id({ lines = [], err = Some("http server " + ServerOf(servers = this.servers, proc = this.procs[this.i]) + " runs proc " + this.procs[this.i] + ", but there is no top-level proc " + this.procs[this.i]) }),
		else -> At(s = { ..this, i = this.i + 1, acc = this.acc + [
			L("/// Runs proc " + this.procs[this.i] + " with the request's parameters."),
			L("fn call_" + SnakeG(n = this.g.prog.nodes[FindTop(prog = this.g.prog, name = this.procs[this.i])]) + "(params: &Value) -> Result<String, (u16, String)> {")
		] + Decodes(g = this.g, pid = FindTop(prog = this.g.prog, name = this.procs[this.i])) + [
			L("let result = super::run_" + SnakeG(n = this.g.prog.nodes[FindTop(prog = this.g.prog, name = this.procs[this.i])]) + "(" + ArgNames(g = this.g, pid = FindTop(prog = this.g.prog, name = this.procs[this.i])) + ").map_err(|e| (500, e.to_string()))?;"),
			L("Ok(json(&result))"), L("}"), L("")
		] })
	};
}

// A call per proc a raw route runs: the request as the proc's struct, its
// result as the response.
proc RawCalls(At): { lines: []Line, err: MaybeStr } {
	func At(s: { g: RGen, servers: []ServerSpec, procs: []string, i: int, acc: []Line }): { g: RGen, servers: []ServerSpec, procs: []string, i: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	func ServerOf(servers: []ServerSpec, proc: string): string = "../../leaves/gen_leaf.rs:raw_server_of";
	func ShapeError(prog: Program, pid: int, server: string, name: string): MaybeStr = "../../leaves/gen_leaf.rs:raw_shape_error";
	func ParamType(g: RGen, pid: int): string = "../../leaves/gen_leaf.rs:raw_param_type";
	At switch {
		(this.i == this.procs.len) -> id({ lines = this.acc, err = None() }),
		(FindTop(prog = this.g.prog, name = this.procs[this.i]) < 0) -> id({ lines = [], err = Some("http server " + ServerOf(servers = this.servers, proc = this.procs[this.i]) + " runs proc " + this.procs[this.i] + ", but there is no top-level proc " + this.procs[this.i]) }),
		(IsSomeS(m = ShapeError(prog = this.g.prog, pid = FindTop(prog = this.g.prog, name = this.procs[this.i]), server = ServerOf(servers = this.servers, proc = this.procs[this.i]), name = this.procs[this.i]))) -> id({ lines = [], err = ShapeError(prog = this.g.prog, pid = FindTop(prog = this.g.prog, name = this.procs[this.i]), server = ServerOf(servers = this.servers, proc = this.procs[this.i]), name = this.procs[this.i]) }),
		else -> At(s = { ..this, i = this.i + 1, acc = this.acc + [
			L("/// Runs proc " + this.procs[this.i] + " on the raw request."),
			L("fn raw_" + SnakeG(n = this.g.prog.nodes[FindTop(prog = this.g.prog, name = this.procs[this.i])]) + "(req: &Request) -> Response {"),
			L("let r = " + ParamType(g = this.g, pid = FindTop(prog = this.g.prog, name = this.procs[this.i])) + " {"),
			L("method: types::Str::from(req.method.as_str()),"),
			L("path: types::Str::from(req.path.as_str()),"),
			L("query: query_pairs(&req.query).into_iter().map(|(k, v)| (types::Str::from(k.as_str()), types::Str::from(v.as_str()))).collect(),"),
			L("headers: req.headers.iter().map(|(k, v)| (types::Str::from(k.as_str()), types::Str::from(v.as_str()))).collect(),"),
			L("body: types::Str::from(req.body.as_str()),"),
			L("};"),
			L("match super::run_" + SnakeG(n = this.g.prog.nodes[FindTop(prog = this.g.prog, name = this.procs[this.i])]) + "(r) {"),
			L("Ok(res) => Response {"),
			L("status: res.status as u16,"),
			L("headers: res.headers.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect(),"),
			L("body: res.body.as_bytes().to_vec(),"),
			L("},"),
			L("Err(e) => error_response(500, &e.to_string()),"),
			L("}"), L("}"), L("")
		] })
	};
}

proc Handlers(At): []Line {
	func At(s: { g: RGen, servers: []ServerSpec, i: int, acc: []Line }): { g: RGen, servers: []ServerSpec, i: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	At switch {
		(this.i == this.servers.len) -> id(this.acc),
		else -> RouteLines(s = { g = this.g, routes = this.servers[this.i].routes, call = "json_route(req, call_", close = ")", i = 0, acc = [] }) as Json
	};
	Json -> RouteLines(s = { g = At.g, routes = At.servers[At.i].raw, call = "raw_", close = "(req)", i = 0, acc = this }) as Raw;
	Raw -> At(s = { ..At, i = At.i + 1, acc = At.acc + [
		L("/// The routes of http server " + At.servers[At.i].name + "."),
		L("pub fn handle_" + ServerIdent(name = At.servers[At.i].name) + "(req: &Request) -> Option<Response> {"),
		L("match (req.method.as_str(), req.path.as_str()) {")
	] + this + [L("_ => None,"), L("}"), L("}"), L("")] });
}

proc RouteLines(At): []Line {
	func At(s: { g: RGen, routes: []Route, call: string, close: string, i: int, acc: []Line }): { g: RGen, routes: []Route, call: string, close: string, i: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	At switch {
		(this.i == this.routes.len) -> id(this.acc),
		else -> At(s = { ..this, i = this.i + 1, acc = this.acc + [L("(" + Quote(s = this.routes[this.i].method) + ", " + Quote(s = this.routes[this.i].path) + ") => Some(" + this.call + SnakeG(n = this.g.prog.nodes[FindTop(prog = this.g.prog, name = this.routes[this.i].proc)]) + this.close + "),")] })
	};
}

// A server's executable: its routes and static files. Its directory
// relative to the module, file name and text.
proc RustServer(At): { dir: string, file: string, text: string, err: MaybeStr } {
	func At(s: { srv: ServerSpec, module_dir: MaybeStr, krate: string }): { srv: ServerSpec, module_dir: MaybeStr, krate: string } = "../../leaves/sema_leaf.rs:same";
	func D(d: MaybeStr): MaybeStr = "../../leaves/sema_leaf.rs:same";
	// The directory, relative to the module, of a file under src/.
	func MainDir(module_dir: string, path: string): { dir: string, file: string } = "../../leaves/gen_leaf.rs:main_dir";
	At -> D(d = this.module_dir);
	D switch {
		Some(dir) -> ModulePath(file = dir) as MP,
		else -> id({ dir = "", file = "", text = "", err = Some(At.srv.path + " goes in the crate's src/, so the output's place under it must be known: run inside a crate or pass --module-dir") })
	};
	MP switch {
		Some(mp) -> switch {
			(At.krate == "") -> id({ dir = "", file = "", text = "", err = Some(At.srv.path + " serves the procs through the library crate, whose name is unknown: run inside a crate with a src/lib.rs") }),
			else -> ServerLines(s = { srv = At.srv, http = ReplaceCrate(path = mp, krate = At.krate) + "::http", i = 0, acc = [] })
		},
		else -> id({ dir = "", file = "", text = "", err = Some(At.srv.path + " goes in the crate's src/, so the output's place under it must be known: run inside a crate or pass --module-dir") })
	};
	ServerLines -> id({ dir = MainDir(module_dir = UnwrapS(m = D), path = At.srv.path).dir, file = MainDir(module_dir = UnwrapS(m = D), path = At.srv.path).file, text = Lines(lines = this, indent = "    "), err = None() });
}

func ReplaceCrate(path: string, krate: string): string = "../../leaves/gen_leaf.rs:replace_crate";

proc ServerLines(At): []Line {
	func At(s: { srv: ServerSpec, http: string, i: int, acc: []Line }): { srv: ServerSpec, http: string, i: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	func RouteDocs(srv: ServerSpec): []Line = "../../leaves/gen_leaf.rs:route_docs";
	At switch {
		(this.i == this.srv.statics.len) -> id([
			L("// Code generated by vandorf. DO NOT EDIT."),
			L("//! HTTP server " + this.srv.name + " on " + this.srv.addr + ":"),
			L("//!")
		] + RouteDocs(srv = this.srv) + [L(""), L("static STATICS: &[" + this.http + "::Static] = &[")] + this.acc + [
			L("];"), L(""), L("fn main() {"),
			L(this.http + "::serve(" + Quote(s = this.srv.addr) + ", " + this.http + "::handle_" + ServerIdent(name = this.srv.name) + ", STATICS);"),
			L("}")
		]),
		else -> At(s = { ..this, i = this.i + 1, acc = this.acc + [L("(" + Quote(s = this.srv.statics[this.i].url) + ", " + Quote(s = this.srv.statics[this.i].ctype) + ", include_str!(" + Quote(s = this.srv.statics[this.i].file) + ")),")] })
	};
}
