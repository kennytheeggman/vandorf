// The Rust backend (src/codegen/rust.rs in the reference): types.rs, one
// state machine per proc in procs.rs, mod.rs, and mains.

type Line = enum { L(string), Raw(string) };

func Lines(lines: []Line, indent: string): string = "../../leaves/gen_leaf.rs:render_lines";
func RustShared(n: int): string = "../../leaves/gen_leaf.rs:rust_shared";
func RustIdent(s: string): string = "../../leaves/gen_leaf.rs:rust_ident";
func Quote(s: string): string = "../../leaves/gen_leaf.rs:quote";
func RustRender(t: Table, r: TyRef, qual: string): string = "../../leaves/gen_leaf.rs:rust_render";

// ---- types.rs ----

proc RustTypegen(At): string {
	func At(t: Table): Table = "../../leaves/sema_leaf.rs:same";
	At -> TypeLines(s = { t = this, i = 0, acc = [L("// Code generated by vandorf. DO NOT EDIT."), L("#![allow(non_camel_case_types, non_snake_case, dead_code)]"), Raw(RustShared(n = 0))] });
	TypeLines -> AliasLines(s = { t = At, i = 0, acc = this });
	AliasLines -> id(Lines(lines = this, indent = "    "));
}

proc TypeLines(At): []Line {
	func At(s: { t: Table, i: int, acc: []Line }): { t: Table, i: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	func S(s: Shape): Shape = "../../leaves/sema_leaf.rs:same";
	At switch {
		(this.i == this.t.types.len) -> id(this.acc),
		else -> S(s = this.t.types[this.i].shape)
	};
	S switch {
		Struct(fs) -> MemberLines(s = { t = At.t, i = At.i, ms = fs, variants = false, j = 0, acc = At.acc + [Doc(n = At.t.types[At.i]), L("#[derive(Debug, Clone, PartialEq)]"), L("pub struct " + At.t.types[At.i].name + " {")] }) as Ms,
		Enum(vs) -> MemberLines(s = { t = At.t, i = At.i, ms = vs, variants = true, j = 0, acc = At.acc + [Doc(n = At.t.types[At.i]), L("#[derive(Debug, Clone, PartialEq)]"), L("pub enum " + At.t.types[At.i].name + " {")] }) as Ms
	};
	Ms -> At(s = { t = At.t, i = At.i + 1, acc = this + [L("}"), L("")] });
}

// "/// A typedef." or "/// The type of the <origin>."
func Doc(n: NamedType): Line = "../../leaves/gen_leaf.rs:rust_doc";

proc MemberLines(At): []Line {
	func At(s: { t: Table, i: int, ms: []RefMember, variants: bool, j: int, acc: []Line }): { t: Table, i: int, ms: []RefMember, variants: bool, j: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	func IsVoidRef(r: TyRef): bool = "../../leaves/gen_leaf.rs:is_void_ref";
	At switch {
		(this.j == this.ms.len) -> id(this.acc),
		(this.variants && IsVoidRef(r = this.ms[this.j].r)) -> At(s = { t = this.t, i = this.i, ms = this.ms, variants = this.variants, j = this.j + 1, acc = this.acc + [L(RustIdent(s = this.ms[this.j].name) + ",")] }),
		(this.variants) -> At(s = { t = this.t, i = this.i, ms = this.ms, variants = this.variants, j = this.j + 1, acc = this.acc + [L(RustIdent(s = this.ms[this.j].name) + "(" + FieldType(t = this.t, i = this.i, m = this.ms[this.j]) + "),")] }),
		else -> At(s = { t = this.t, i = this.i, ms = this.ms, variants = this.variants, j = this.j + 1, acc = this.acc + [L("pub " + RustIdent(s = this.ms[this.j].name) + ": " + FieldType(t = this.t, i = this.i, m = this.ms[this.j]) + ",")] })
	};
}

// A field's type, behind an Arc where it would make the type contain itself.
func FieldType(t: Table, i: int, m: RefMember): string = "../../leaves/gen_leaf.rs:rust_field_type";

proc AliasLines(At): []Line {
	func At(s: { t: Table, i: int, acc: []Line }): { t: Table, i: int, acc: []Line } = "../../leaves/sema_leaf.rs:same";
	At switch {
		(this.i == this.t.aliases.len) -> id(this.acc),
		else -> At(s = { t = this.t, i = this.i + 1, acc = this.acc + [L("/// A typedef."), L("pub type " + this.t.aliases[this.i].name + " = " + RustRender(t = this.t, r = this.t.aliases[this.i].r, qual = "") + ";"), L("")] })
	};
}
