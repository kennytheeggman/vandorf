// Tokens. Lexing is a pure leaf (vandorf strings have no character access);
// everything from here on is .sys.

// kind: "ident", "int", "float", "str", "sym" or "eof". `text` is the
// token as written, except for "str", where it's the decoded value. `at`
// and `end` are byte offsets into the source.
type Tok = { kind: string, text: string, at: int, end: int, file: int };

func Lex(src: string, file: int): []Tok = "../leaves/leaf.rs:lex";

// Pure helpers the parser calls in expressions.
func MkIdent(t: Tok): Ident = "../leaves/leaf.rs:mk_ident";
func SpanOf(t: Tok): Span = "../leaves/leaf.rs:span_of";
func IntOf(t: Tok): int = "../leaves/leaf.rs:int_of";
func FloatOf(t: Tok): float = "../leaves/leaf.rs:float_of";
// Splits a "file:function" string token, failing if it isn't one.
func ImplOf(t: Tok): ImplRef = "../leaves/leaf.rs:impl_of";
