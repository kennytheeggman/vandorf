// Maps: a scope of declared names, as a sema pass would keep one. Maps are
// values: `+` and `-` make new ones. A missing key fails the proc, so
// lookups are guarded with `in`.
type Scope = map[string]{ slot: int, kind: string };

proc Resolve(names: []string, query: string): string {
	func Declare(names: []string, query: string): { scope: Scope, query: string } = "../go/app/impl.go:Declare", "../rs/src/impls.rs:declare";
	func Adjust(scope: Scope, query: string): { scope: Scope, query: string } = "../go/app/impl.go:Adjust", "../rs/src/impls.rs:adjust";
	func Found(name: string, slot: int, kind: string, total: int): string = "../go/app/impl.go:Found", "../rs/src/impls.rs:found";
	func Missing(name: string, known: []string): string = "../go/app/impl.go:Missing", "../rs/src/impls.rs:missing";

	// Add a builtin after the declared names, and drop `tmp`.
	Resolve -> Declare(names = this.names, query = this.query);
	Declare -> Adjust(
		scope = this.scope + ["len": { slot = this.scope.len, kind = "builtin" }] - ["tmp"],
		query = this.query
	);
	Adjust switch {
		(this.query in this.scope) -> Found(
			name = this.query,
			slot = this.scope[this.query].slot,
			kind = this.scope[this.query].kind,
			total = this.scope.len
		),
		else -> Missing(name = this.query, known = this.scope.keys)
	};
}
