// Classifies an expression by its shape: a small even literal, any other
// literal, a negated literal, a sum of literals, or something else; under a
// Neg, it classifies what's negated, as "minus ...".
//
// Pattern switches match structure: variants, struct fields (all of them,
// `_` for the ones that don't matter) and bindings. Conditions on values go
// in a switch nested under a pattern arm, which sees its bindings. The arms
// cover every Expr, so no else is needed. `id(value)` ends the proc with a
// value.
proc Classify(e: Expr): string {
	func Look(e: Expr): Expr = "../go/app/impl.go:Look", "../rs/src/impls.rs:look", "../py/impls.py:look";
	// Checks whether |i| < 100.
	func Small(i: int): bool = "../go/app/impl.go:Small", "../rs/src/impls.rs:small", "../py/impls.py:small";

	Classify -> Look(e = this.e);
	Look switch {
		Lit(n) -> switch {
			(Small(i = n) && n % 2 == 0) -> id("small even"),
			else -> id("literal")
		},
		Neg(Lit(_)) -> id("negated literal"),
		// Recursion through the graph: another instance of this proc.
		Neg(e) -> Classify(e = e) as Inner,
		Add({ l = Lit(_), r = Lit(_) }) -> id("sum of literals"),
		Add(_) -> id("something else")
	};
	Inner -> id("minus " + Inner);
}
