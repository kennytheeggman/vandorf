// test/fixtures/test1.sys from the Go implementation, with implementations.
// Impl paths are relative to the generated package (app/).

interface Foo {
	// Lives in another package: imported as example.com/demo/effects.
	func Call(s: string): int = "../effects/foo.go:Call";
}

proc ForEach(Start): int {
	func Start(i: int): { l: []int, s: string } = "impl.go:Range";
	func Process(i: int, l: []int): int = "impl.go:Square";
	func Collect(l: []int): int = "impl.go:Sum";

	Start for each (Start.l) -> Process(i = this, l = Start.l);
	Process collect each (Process) -> Collect(l = this);
}

proc Bar(Start): string {
	func Start(a: int, b: string): string = "impl.go:Repeat";
	func Loop(s: string): int = "impl.go:Grow";
	// No implementation: calls a generated stub that returns an error.
	func Branch1(i: int): string;
	func Branch2Begin(i: int): string = "impl.go:Describe";
	func Branch2End(i: int) = "impl.go:Log";
	func End(r: enum { I(string), S, B({i: int}) }): string = "impl.go:Finish";

	Start -> Loop(s = this);
	Loop switch {
		("this < 10") -> Loop(s = Start),
		("else") -> ForEach(i = this)
	};
	ForEach switch {
		("this == 0") -> Branch1(i = this),
		("else") -> Branch2Begin(i = this)
	};
	Branch2Begin -> Foo.Call(s = this);
	Foo.Call -> Branch2End(i = this);
	Branch2End -> End(r = S(this));
	Branch1 -> End(r = I(this));
}
