// A tour of the language, run by both backends' tests (go/app/app_test.go,
// rs/src/lib.rs). ForEach and Bar are tests/fixtures/test1.sys from the Go
// implementation; the procs after them add a feature each.
//
// Each func names one implementation per backend; paths are relative to the
// generated code's directory (go/app for Go, rs/src/app for Rust).

interface Foo {
	// Outside the generated package/module.
	func Call(s: string): int = "../effects/foo.go:Call", "../effects.rs:call";
}

proc ForEach(Start): int {
	func Start(i: int): { l: []int, s: string } = "impl.go:Range", "../impls.rs:range";
	func Process(i: int, l: []int): int = "impl.go:Square", "../impls.rs:square";
	func Collect(l: []int): int = "impl.go:Sum", "../impls.rs:sum";

	Start for each (Start.l) -> Process(i = this, l = Start.l);
	Process collect each (Process) -> Collect(l = this);
}

// How a Bar run ended; a typedef gives the generated type its name.
type Outcome = enum { I(string), S, B({ i: int }) };

proc Bar(Start): string {
	func Start(a: int, b: string): string = "impl.go:Repeat", "../impls.rs:repeat";
	func Loop(s: string): int = "impl.go:Grow", "../impls.rs:grow";
	// No implementation: calls a generated stub that returns an error.
	func Branch1(i: int): string;
	func Branch2Begin(i: int): string = "impl.go:Describe", "../impls.rs:describe";
	func Branch2End(i: int) = "impl.go:Log", "../impls.rs:log";
	func End(r: Outcome): string = "impl.go:Finish", "../impls.rs:finish";

	Start -> Loop(s = this);
	Loop switch {
		(this < 10) -> Loop(s = Start),
		else -> ForEach(i = this)
	};
	ForEach switch {
		(this == 0) -> Branch1(i = this),
		else -> Branch2Begin(i = this)
	};
	Branch2Begin -> Foo.Call(s = this);
	Foo.Call -> Branch2End(i = this);
	Branch2End -> End(r = S());
	Branch1 -> End(r = I(this));
}

// Entry point for `vandorf go/rust --main`: `main <a: int> <b: string>`.
proc Main(Start): string {
	func Start(a: int, b: string): { a: int, b: string } = "impl.go:Args", "../impls.rs:args";

	Start -> Bar(a = this.a, b = this.b);
}

// Typedefs, aliases and literals. Expr is recursive: Neg and Add hold
// Exprs, so the generated types box them (Box<Expr> in Rust, *Expr in Go).
type Expr = enum { Lit(int), Neg(Expr), Add({ l: Expr, r: Expr }) };

proc Calc(Build): int {
	func Build(base: int): Expr = "impl.go:Build", "../impls.rs:build";
	func Eval(e: Expr, scale: int): int = "impl.go:Eval", "../impls.rs:eval";
	func Total(xs: []int): int = "impl.go:Total", "../impls.rs:total";

	// Build(3) is 3 + 2; this evaluates -(3 + 2) + 10 = 5.
	Build -> Eval(e = Add({ l = Neg(this), r = Lit(10) }), scale = 1);
	// A second instance of Eval, with its own output and edge: 5 * 2.
	Eval -> Eval(e = Build, scale = 2) as Twice;
	// 5 + 10 + 100
	Twice -> Total(xs = [Eval, Twice, 100]);
}

// Pattern switches match structure: variants, struct fields (all of them,
// `_` for the ones that don't matter) and bindings. Conditions on values go
// in a switch nested under a pattern arm, which sees its bindings. The
// arms cover every Expr, so no else is needed.
proc Classify(Look): string {
	func Look(e: Expr): Expr = "impl.go:Look", "../impls.rs:look";
	func Small(i: int): bool = "impl.go:Small", "../impls.rs:small";
	func Say(s: string): string = "impl.go:Say", "../impls.rs:say";

	Look switch {
		Lit(n) -> switch {
			(Small(i = n) && n % 2 == 0) -> Say(s = "small even"),
			else -> Say(s = "literal")
		},
		Neg(Lit(_)) -> Say(s = "negated literal"),
		// Recursion through the graph: another instance of this proc.
		Neg(e) -> Classify(e = e) as Inner,
		Add({ l = Lit(_), r = Lit(_) }) -> Say(s = "sum of literals"),
		Add(_) -> Say(s = "something else")
	};
	Inner -> Say(s = "minus " + Inner);
}

// Maps: a scope of declared names, as a sema pass would keep one. Maps are
// values: `+` and `-` make new ones. A missing key fails the proc, so
// lookups are guarded with `in`.
type Scope = map[string]{ slot: int, kind: string };

proc Resolve(Declare): string {
	func Declare(names: []string, query: string): { scope: Scope, query: string } = "impl.go:Declare", "../impls.rs:declare";
	func Adjust(scope: Scope, query: string): { scope: Scope, query: string } = "impl.go:Adjust", "../impls.rs:adjust";
	func Found(name: string, slot: int, kind: string, total: int): string = "impl.go:Found", "../impls.rs:found";
	func Missing(name: string, known: []string): string = "impl.go:Missing", "../impls.rs:missing";

	// Add a builtin after the declared names, and drop `tmp`.
	Declare -> Adjust(
		scope = this.scope + ["len": { slot = this.scope.len, kind = "builtin" }] - ["tmp"],
		query = this.query
	);
	Adjust switch {
		(this.query in this.scope) -> Found(
			name = this.query,
			slot = this.scope[this.query].slot,
			kind = this.scope[this.query].kind,
			total = this.scope.len
		),
		else -> Missing(name = this.query, known = this.scope.keys)
	};
}
