// Runs vcc's command line: takes out the `-C <dir>`s and changes into each,
// then runs the command on the project around the working directory. `check`
// prints how many files and procs it has, `doc` prints its visualizer
// document, `build` generates its Go and Rust (and builds them), `test`
// builds it and runs its tests. A mistake in the command line fails with a
// message pointing at --help.
//
//   vcc check          checks the project around the working directory
//   vcc doc            prints its visualizer document
//   vcc build [bin]    generates its Go and Rust (and every bin, or just
//                      bin), running each language's post commands
//   vcc test           builds it all, then runs each language's test commands
//   vcc --help         prints the usage
//
// -C <dir>, anywhere and any number of times, runs the command as if started
// in <dir>. What a command prints is said explicitly (Console.Out and
// Console.Note), so it goes where the reference sends it.
proc Vcc(argv: []string): void {
	// Takes the `-C <dir>`s out of argv, wherever they are, keeping them in
	// order and the rest of the command as it was; a `-C` with nothing after it
	// is an error, returned rather than failed.
	func Opts(argv: []string): CliOpts = "cli/cli_leaf.rs:split_c";
	Vcc -> Opts(argv = this.argv);
	Opts switch {
		(this.err != "") -> Usage(msg = this.err),
		else -> ChangeDirs(s = { dirs = this.dirs, i = 0 })
	};
	ChangeDirs switch {
		Ok(_) -> id(Opts.rest) as Cmd,
		Err(e) -> Usage(msg = e.msg)
	};
	// Builds vcc's usage text, the commands and options, which --help prints and
	// a bad command line points at.
	func Help(n: int): string = "cli/cli_leaf.rs:usage";
	// Finds the first argument after the command that starts with `-`, a flag
	// vcc doesn't know; "" if there's none.
	func FirstFlag(args: []string): string = "cli/cli_leaf.rs:first_flag";
	// The command, without its -Cs.
	Cmd switch {
		(this.len == 0) -> Usage(msg = Help(n = 0)) as NoCommand,
		(this[0] == "-h" || this[0] == "--help" || this[0] == "help") -> Console.Out(text = Help(n = 0)),
		(FirstFlag(args = this) != "") -> Usage(msg = "unknown flag " + FirstFlag(args = this) + " (see vcc --help)") as BadFlag,
		(this.len == 1 && this[0] == "check") -> CheckProject(n = 0) as ForCheck,
		(this.len == 1 && this[0] == "doc") -> CheckProject(n = 0) as ForDoc,
		(this.len >= 1 && this.len <= 2 && this[0] == "build") -> CheckProject(n = 0) as ForBuild,
		(this.len == 1 && this[0] == "test") -> CheckProject(n = 0) as ForTest,
		(this[0] == "check" || this[0] == "doc" || this[0] == "build" || this[0] == "test") -> Usage(msg = "too many arguments for " + this[0] + " (see vcc --help)") as TooMany,
		else -> Usage(msg = "unknown command " + this[0] + " (see vcc --help)")
	};
	ForCheck switch {
		Ok(c) -> Console.Note(line = "ok: " + Itoa(i = c.project.paths.len) + " files, " + Itoa(i = Procs(nodes = c.prog.nodes).len) + " procs"),
		Err(e) -> Usage(msg = e.msg)
	};
	ForDoc switch {
		Ok(c) -> Document(prog = c.prog),
		Err(e) -> Usage(msg = e.msg)
	};
	Document -> Console.Out(text = this) as Printed;
	ForTest switch {
		Ok(c) -> Test(s = c),
		Err(e) -> Usage(msg = e.msg)
	};
	// Swallows a command's result: build and test print nothing when they
	// succeed.
	func Quiet(s: string): void = "cli/cli_leaf.rs:quiet";
	Test -> Quiet(s = this) as Tested;
	Build -> Quiet(s = this) as Built;
	ForBuild switch {
		Ok(c) -> switch {
			(Cmd.len == 2) -> Build(s = { c = c, only = Cmd[1] }),
			else -> Build(s = { c = c, only = "" })
		},
		Err(e) -> Usage(msg = e.msg)
	};
}

type CliOpts = { dirs: []string, rest: []string, err: string };

// Changes into each directory in turn, each relative to the last, stopping
// at the first that can't be entered and returning its error.
proc ChangeDirs(s: { dirs: []string, i: int }): Res<string> {
	ChangeDirs switch {
		(this.s.i == this.s.dirs.len) -> id(Ok("")),
		else -> Fs.Chdir(path = this.s.dirs[this.s.i])
	};
	Fs.Chdir switch {
		Ok(_) -> ChangeDirs(s = { ..ChangeDirs.s, i = ChangeDirs.s.i + 1 }),
		Err(e) -> id(Err(e))
	};
}

// Fails the command with msg, dropping a rendered diagnostic's first `error:
// `, which the executable prints itself.
func Usage(msg: string): void = "cli/cli_leaf.rs:fail_report";
