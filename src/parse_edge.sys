// Edges, targets, switch arms and patterns.

// Parses an edge: its source node, then what follows it. A call (`->`), a
// switch, a collect each, a for each, or a spawn and its join, spanning from
// the source to the end of the edge.
//
//   edge := path ( '->' target
//                | 'switch' '{' arm,* '}'
//                | 'collect' 'each' '(' IDENT ')' '->' target
//                | 'for' 'each' '(' expr ')' '->' target
//                | '->' 'spawn' '{' branch,* '}' 'join' target )
proc PEdge(toks: []Tok, pos: int): R<Edge> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PEdge -> At(toks = this.toks, pos = this.pos);
	At -> PPath(toks = this.toks, pos = this.pos);
	PPath -> At(toks = At.toks, pos = this.pos) as Kw;
	Kw switch {
		(IsSym(t = this.tok, s = "->") && IsWord(t = this.toks[this.pos + 1], s = "spawn") && IsSym(t = this.toks[this.pos + 2], s = "{")) -> PBranches(toks = this.toks, pos = this.pos + 3),
		(IsSym(t = this.tok, s = "->")) -> PTarget(toks = this.toks, pos = this.pos + 1) as CallTarget,
		(IsWord(t = this.tok, s = "switch")) -> Expect(toks = this.toks, pos = this.pos + 1, text = "{", what = "{ after switch") as SwitchOpen,
		(IsWord(t = this.tok, s = "collect")) -> Expect(toks = this.toks, pos = this.pos + 1, text = "each", what = "each after collect") as CollectEach,
		else -> Expect(toks = this.toks, pos = this.pos, text = "for", what = "->, switch, collect each or for each") as For
	};
	CallTarget -> id({ x = { source = PPath.x, kind = Call(this.x), span = { at = PPath.x.span.at, end = At.toks[this.pos - 1].end, file = PPath.x.span.file } }, pos = this.pos });

	SwitchOpen -> PArms(toks = this.toks, pos = this.pos);
	PArms -> Expect(toks = At.toks, pos = this.pos, text = "}", what = ", or }") as SwitchClose;
	SwitchClose -> id({ x = { source = PPath.x, kind = Match(PArms.x), span = { at = PPath.x.span.at, end = this.prev.end, file = PPath.x.span.file } }, pos = this.pos });

	CollectEach -> Expect(toks = this.toks, pos = this.pos, text = "(", what = "( after collect each") as CollectOpen;
	CollectOpen -> NeedIdent(toks = this.toks, pos = this.pos, what = "the collected node") as CollectDim;
	CollectDim -> Expect(toks = this.toks, pos = this.pos, text = ")", what = ")") as CollectClose;
	CollectClose -> Expect(toks = this.toks, pos = this.pos, text = "->", what = "->") as CollectArrow;
	CollectArrow -> PTarget(toks = this.toks, pos = this.pos) as CollectTarget;
	CollectTarget -> id({
		x = { source = PPath.x, kind = Collect({ dim = MkIdent(t = CollectDim.tok), target = this.x }), span = { at = PPath.x.span.at, end = At.toks[this.pos - 1].end, file = PPath.x.span.file } },
		pos = this.pos
	});

	PBranches -> Expect(toks = At.toks, pos = this.pos, text = "}", what = ", or }") as SpawnClose;
	SpawnClose -> Expect(toks = this.toks, pos = this.pos, text = "join", what = "join after the spawn's branches") as Join;
	Join -> PTarget(toks = this.toks, pos = this.pos) as JoinTarget;
	JoinTarget -> id({
		x = { source = PPath.x, kind = Spawn({ branches = PBranches.x, join = this.x }), span = { at = PPath.x.span.at, end = At.toks[this.pos - 1].end, file = PPath.x.span.file } },
		pos = this.pos
	});

	For -> Expect(toks = this.toks, pos = this.pos, text = "each", what = "each after for") as ForEach;
	ForEach -> Expect(toks = this.toks, pos = this.pos, text = "(", what = "( after for each") as ForOpen;
	ForOpen -> PExpr(toks = this.toks, pos = this.pos) as ForDim;
	ForDim -> Expect(toks = At.toks, pos = this.pos, text = ")", what = ")") as ForClose;
	ForClose -> Expect(toks = this.toks, pos = this.pos, text = "->", what = "->") as ForArrow;
	ForArrow -> PTarget(toks = this.toks, pos = this.pos) as ForTarget;
	ForTarget -> id({
		x = { source = PPath.x, kind = ForEach({ dim = ForDim.x, target = this.x }), span = { at = PPath.x.span.at, end = At.toks[this.pos - 1].end, file = PPath.x.span.file } },
		pos = this.pos
	});
}

// Parses a spawn's branches after its `{`, at least one, separated by
// commas, each a call marked `detach` or not, until the closing brace.
//
//   branch := 'detach'? target
proc PBranches(toks: []Tok, pos: int): R<[]Branch> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	func Loop(toks: []Tok, pos: int, acc: []Branch): AtAcc<[]Branch> = "leaf.rs:at_branches";
	PBranches -> At(toks = this.toks, pos = this.pos);
	At -> Loop(toks = this.toks, pos = this.pos, acc = []);
	Loop switch {
		(IsClose(t = this.cur.tok) && this.acc.len > 0) -> id({ x = this.acc, pos = this.cur.pos }),
		(IsWord(t = this.cur.tok, s = "detach")) -> PTarget(toks = this.cur.toks, pos = this.cur.pos + 1) as Detached,
		else -> PTarget(toks = this.cur.toks, pos = this.cur.pos) as Joined
	};
	Detached -> id({ b = { detach = true, target = this.x }, pos = this.pos }) as Got;
	Joined -> id({ b = { detach = false, target = this.x }, pos = this.pos }) as Got;
	Got -> At(toks = Loop.cur.toks, pos = this.pos) as After;
	After switch {
		(IsSym(t = this.tok, s = ",")) -> Loop(toks = this.toks, pos = this.pos + 1, acc = Loop.acc + [Got.b]),
		else -> id({ x = Loop.acc + [Got.b], pos = this.pos })
	};
}

// Parses what an edge calls: `id(value)`, or a node with its named
// arguments, either with an optional alias. Keeps the span of what's inside
// the parentheses, for the call's text in the diagram.
//
//   target := 'id' '(' expr ')' ('as' IDENT)?
//           | path '(' (arg (',' arg)*)? ')' ('as' IDENT)?
proc PTarget(toks: []Tok, pos: int): R<Target> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PTarget -> At(toks = this.toks, pos = this.pos);
	At switch {
		(IsWord(t = this.tok, s = "id")) -> Expect(toks = this.toks, pos = this.pos + 1, text = "(", what = "( after id") as IdOpen,
		(this.tok.kind == "ident") -> PPath(toks = this.toks, pos = this.pos),
		else -> NotTarget(toks = this.toks, pos = this.pos, what = "a call: a name, or id(value)")
	};
	// Fails at toks[pos], saying what was expected there instead.
	func NotTarget(toks: []Tok, pos: int, what: string): R<Target> = "leaf.rs:expected_target";
	IdOpen -> PExpr(toks = this.toks, pos = this.pos) as IdValue;
	IdValue -> Expect(toks = At.toks, pos = this.pos, text = ")", what = ") after id's value") as IdClose;
	IdClose -> PAlias(toks = this.toks, pos = this.pos) as IdAlias;
	IdAlias -> id({
		x = { node = { segs = [MkIdent(t = At.tok)], span = SpanOf(t = At.tok) }, args = [], alias = this.x, id = Some(IdValue.x), inner = Inner(toks = At.toks, from = IdOpen.pos, to = IdValue.pos) },
		pos = this.pos
	});
	PPath -> Expect(toks = At.toks, pos = this.pos, text = "(", what = "( and the call's arguments") as Open;
	Open -> PArgList(toks = this.toks, pos = this.pos);
	PArgList -> Expect(toks = At.toks, pos = this.pos, text = ")", what = ", or )") as Close;
	Close -> PAlias(toks = this.toks, pos = this.pos) as CallAlias;
	CallAlias -> id({ x = { node = PPath.x, args = PArgList.x, alias = this.x, id = None(), inner = Inner(toks = At.toks, from = Open.pos, to = PArgList.pos) }, pos = this.pos });
}

// The span covering toks[from..to], a call's arguments as written; empty, at
// toks[from], if there are none.
func Inner(toks: []Tok, from: int, to: int): Span = "leaf.rs:inner_span";

// Parses an `as Name` alias after a call, if there is one.
proc PAlias(toks: []Tok, pos: int): R<OptIdent> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PAlias -> At(toks = this.toks, pos = this.pos);
	At switch {
		(IsWord(t = this.tok, s = "as")) -> NeedIdent(toks = this.toks, pos = this.pos + 1, what = "the alias's name"),
		else -> id({ x = None(), pos = this.pos })
	};
	NeedIdent -> id({ x = Some(MkIdent(t = this.tok)), pos = this.pos });
}

// Parses a call's `name = value` arguments, separated by commas, a trailing
// comma allowed, until its closing parenthesis.
proc PArgList(toks: []Tok, pos: int): R<[]Arg> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	func Loop(toks: []Tok, pos: int, acc: []Arg): AtAcc<[]Arg> = "leaf.rs:at_args";
	PArgList -> At(toks = this.toks, pos = this.pos);
	At -> Loop(toks = this.toks, pos = this.pos, acc = []);
	Loop switch {
		(IsClose(t = this.cur.tok)) -> id({ x = this.acc, pos = this.cur.pos }),
		else -> NeedName(toks = this.cur.toks, pos = this.cur.pos, what = "an argument name")
	};
	NeedName -> Expect(toks = this.toks, pos = this.pos, text = "=", what = "= after the argument's name") as Eq;
	Eq -> PExpr(toks = this.toks, pos = this.pos) as Val;
	Val -> At(toks = Loop.cur.toks, pos = this.pos) as After;
	After switch {
		(IsSym(t = this.tok, s = ",")) -> Loop(toks = this.toks, pos = this.pos + 1, acc = Loop.acc + [{ name = MkIdent(t = NeedName.tok), value = Val.x }]),
		else -> id({ x = Loop.acc + [{ name = MkIdent(t = NeedName.tok), value = Val.x }], pos = this.pos })
	};
}

// Parses a switch's arms, separated by commas, a trailing comma allowed,
// until its closing brace.
proc PArms(toks: []Tok, pos: int): R<[]Arm> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	func Loop(toks: []Tok, pos: int, acc: []Arm): AtAcc<[]Arm> = "leaf.rs:at_arms";
	PArms -> At(toks = this.toks, pos = this.pos);
	At -> Loop(toks = this.toks, pos = this.pos, acc = []);
	Loop switch {
		(IsClose(t = this.cur.tok)) -> id({ x = this.acc, pos = this.cur.pos }),
		else -> PArm(toks = this.cur.toks, pos = this.cur.pos)
	};
	PArm -> At(toks = Loop.cur.toks, pos = this.pos) as After;
	After switch {
		(IsSym(t = this.tok, s = ",")) -> Loop(toks = this.toks, pos = this.pos + 1, acc = Loop.acc + [PArm.x]),
		else -> id({ x = Loop.acc + [PArm.x], pos = this.pos })
	};
}

// Parses one switch arm: its head (`else`, a condition in parentheses, or a
// pattern), its `->`, and its body. The arm's span covers its head, for the
// diagram's labels.
//
//   arm := ('else' | '(' expr ')' | pattern) '->' (target | 'switch' '{' arm,* '}')
proc PArm(toks: []Tok, pos: int): R<Arm> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PArm -> At(toks = this.toks, pos = this.pos);
	At switch {
		(IsWord(t = this.tok, s = "else")) -> Expect(toks = this.toks, pos = this.pos + 1, text = "->", what = "-> after else") as ElseArrow,
		(IsSym(t = this.tok, s = "(")) -> PExpr(toks = this.toks, pos = this.pos) as Cond,
		else -> PPat(toks = this.toks, pos = this.pos)
	};
	ElseArrow -> PArmBody(toks = this.toks, pos = this.pos) as ElseBody;
	ElseBody -> id({ x = { head = Else(), span = SpanOf(t = At.tok), body = this.x }, pos = this.pos });
	Cond -> Expect(toks = At.toks, pos = this.pos, text = "->", what = "-> after the condition") as CondArrow;
	CondArrow -> PArmBody(toks = this.toks, pos = this.pos) as CondBody;
	CondBody -> id({ x = { head = Cond(Cond.x), span = { at = At.tok.at, end = At.toks[CondArrow.pos - 2].end, file = At.tok.file }, body = this.x }, pos = this.pos });
	PPat -> Expect(toks = At.toks, pos = this.pos, text = "->", what = "| or -> after the pattern") as PatArrow;
	PatArrow -> PArmBody(toks = this.toks, pos = this.pos) as PatBody;
	PatBody -> id({ x = { head = Pat(PPat.x), span = PPat.x.span, body = this.x }, pos = this.pos });
}

// Parses an arm's body: a call, or a nested switch with its own arms.
proc PArmBody(toks: []Tok, pos: int): R<Body> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PArmBody -> At(toks = this.toks, pos = this.pos);
	At switch {
		(IsWord(t = this.tok, s = "switch")) -> Expect(toks = this.toks, pos = this.pos + 1, text = "{", what = "{ after switch") as Open,
		else -> PTarget(toks = this.toks, pos = this.pos)
	};
	Open -> PArms(toks = this.toks, pos = this.pos);
	PArms -> Expect(toks = At.toks, pos = this.pos, text = "}", what = ", or }") as Close;
	Close -> id({ x = Switch({ arms = PArms.x, span = { at = At.tok.at, end = this.prev.end, file = At.tok.file } }), pos = this.pos });
	PTarget -> id({ x = Call(this.x), pos = this.pos });
}

// Parses a pattern, alternatives separated by `|` making an Or.
//
//   pat := alt ('|' alt)*
proc PPat(toks: []Tok, pos: int): R<Pat> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PPat -> At(toks = this.toks, pos = this.pos);
	At -> PAlts(toks = this.toks, pos = this.pos);
	PAlts -> id({ x = OrOf(pats = this.x), pos = this.pos });
}

// Makes one pattern of alternatives: the pattern itself if there's one, else
// an Or of them all, spanning from the first to the last.
func OrOf(pats: []Pat): Pat = "leaf.rs:or_of";

// Parses a pattern's `|`-separated alternatives, at least one.
proc PAlts(toks: []Tok, pos: int): R<[]Pat> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	func Loop(toks: []Tok, pos: int, acc: []Pat): AtAcc<[]Pat> = "leaf.rs:at_pats";
	PAlts -> At(toks = this.toks, pos = this.pos);
	At -> Loop(toks = this.toks, pos = this.pos, acc = []);
	Loop -> PAlt(toks = this.cur.toks, pos = this.cur.pos);
	PAlt -> At(toks = Loop.cur.toks, pos = this.pos) as After;
	After switch {
		(IsSym(t = this.tok, s = "|")) -> Loop(toks = this.toks, pos = this.pos + 1, acc = Loop.acc + [PAlt.x]),
		else -> id({ x = Loop.acc + [PAlt.x], pos = this.pos })
	};
}

// Parses one alternative of a pattern: `_`, a binding, a variant with or
// without a payload's pattern, or a struct pattern.
//
//   alt := '_' | IDENT | IDENT '(' pat? ')' | '{' (NAME '=' pat),* '}'
proc PAlt(toks: []Tok, pos: int): R<Pat> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PAlt -> At(toks = this.toks, pos = this.pos);
	At switch {
		(IsSym(t = this.tok, s = "{")) -> PPatFields(toks = this.toks, pos = this.pos + 1),
		else -> NeedIdent(toks = this.toks, pos = this.pos, what = "a pattern")
	};
	PPatFields -> Expect(toks = At.toks, pos = this.pos, text = "}", what = ", or }") as FieldsClose;
	FieldsClose -> id({ x = { kind = Struct(PPatFields.x), span = { at = At.tok.at, end = this.prev.end, file = At.tok.file } }, pos = this.pos });
	NeedIdent -> At(toks = this.toks, pos = this.pos) as AfterName;
	AfterName switch {
		(IsSym(t = this.tok, s = "(")) -> At(toks = this.toks, pos = this.pos + 1) as Inside,
		(NeedIdent.tok.text == "_") -> id({ x = { kind = Wild(), span = SpanOf(t = NeedIdent.tok) }, pos = this.pos }),
		else -> id({ x = { kind = Bind(MkIdent(t = NeedIdent.tok)), span = SpanOf(t = NeedIdent.tok) }, pos = this.pos })
	};
	Inside switch {
		(IsSym(t = this.tok, s = ")")) -> id({
			x = { kind = Variant({ tag = MkIdent(t = NeedIdent.tok), payload = None() }), span = { at = NeedIdent.tok.at, end = this.tok.end, file = NeedIdent.tok.file } },
			pos = this.pos + 1
		}),
		else -> PPat(toks = this.toks, pos = this.pos) as Payload
	};
	Payload -> Expect(toks = At.toks, pos = this.pos, text = ")", what = ") after the payload's pattern") as PayloadClose;
	PayloadClose -> id({
		x = { kind = Variant({ tag = MkIdent(t = NeedIdent.tok), payload = Some(Payload.x) }), span = { at = NeedIdent.tok.at, end = this.prev.end, file = NeedIdent.tok.file } },
		pos = this.pos
	});
}

// Parses a struct pattern's `field = pattern` pairs, separated by commas,
// until its closing brace.
proc PPatFields(toks: []Tok, pos: int): R<[]PatField> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	func Loop(toks: []Tok, pos: int, acc: []PatField): AtAcc<[]PatField> = "leaf.rs:at_pat_fields";
	PPatFields -> At(toks = this.toks, pos = this.pos);
	At -> Loop(toks = this.toks, pos = this.pos, acc = []);
	Loop switch {
		(IsClose(t = this.cur.tok)) -> id({ x = this.acc, pos = this.cur.pos }),
		else -> NeedName(toks = this.cur.toks, pos = this.cur.pos, what = "a field name")
	};
	NeedName -> Expect(toks = this.toks, pos = this.pos, text = "=", what = "= after the field name") as Eq;
	Eq -> PPat(toks = this.toks, pos = this.pos);
	PPat -> At(toks = Loop.cur.toks, pos = this.pos) as After;
	After switch {
		(IsSym(t = this.tok, s = ",")) -> Loop(toks = this.toks, pos = this.pos + 1, acc = Loop.acc + [{ name = MkIdent(t = NeedName.tok), pat = PPat.x }]),
		else -> id({ x = Loop.acc + [{ name = MkIdent(t = NeedName.tok), pat = PPat.x }], pos = this.pos })
	};
}
