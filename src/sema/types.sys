// Types as sema resolves them (src/types.rs in the reference). A typedef,
// or an instance of a generic one, is named by its index into the
// program's []TypeDef.

type Type = enum {
	// "void", "int", "float", "bool" or "string".
	Prim(string),
	Array(Type),
	Map({ key: Type, value: Type }),
	Struct([]Member),
	Enum([]Member),
	Named({ id: int, name: string }),
	// A foreign typedef's body: the typedef `id`, named `name`, implemented
	// per backend by `imps` (`file:Type`). Nominal: it accepts only itself.
	Foreign({ id: int, name: string, imps: []ImplRef })
};
// A struct field or an enum variant (void for no payload).
type Member = { name: string, ty: Type };
// doc: the typedef's doc comment (an instance's is its generic's).
type TypeDef = { name: string, ident: string, ty: Type, recursive: bool, doc: string };
type MaybeType = enum { None, Some(Type) };

type Pair = { x: int, y: int };
type OptPair = enum { None, Some(Pair) };

func IsVoid(t: Type): bool = "sema_leaf.rs:is_void";
// Looks up the member named `name` among a struct's fields or an enum's
// variants: its type, if there is one.
func Member(ms: []Member, name: string): MaybeType = "sema_leaf.rs:member";
// Separates list items: ", " before every item but the first (i is the
// item's index).
func Sep(i: int): string = "sema_leaf.rs:sep";

// Follows typedef names to the structure behind them, through as many names
// as it takes. Sema rejects name cycles that never reach a structure, so
// this ends.
proc Unfold(s: { t: Type, defs: []TypeDef }): Type {
	Unfold -> id(this.s.t) as T;
	T switch {
		Named(n) -> Unfold(s = { t = Unfold.s.defs[n.id].ty, defs = Unfold.s.defs }),
		else -> id(this)
	};
}

// Writes a type as the source would: `[]int`, `map[string]R<int>`, `{ x:
// int, y: E }`, `enum { A, B(int) }`, typedefs by name.
proc ShowType(t: Type): string {
	ShowType switch {
		{ t = Prim(p) } -> id(p),
		{ t = Named(n) } -> id(n.name),
		{ t = Array(e) } -> ShowType(t = e) as Elem,
		{ t = Map(m) } -> ShowMap(s = m),
		{ t = Struct(ms) } -> ShowMembers(s = { ms = ms, variants = false, i = 0, acc = "" }) as Fields,
		{ t = Enum(ms) } -> ShowMembers(s = { ms = ms, variants = true, i = 0, acc = "" }) as Variants,
		{ t = Foreign(f) } -> id(f.name)
	};
	Elem -> id("[]" + this);
	Fields -> id("{ " + this + " }");
	Variants -> id("enum { " + this + " }");
}

// Writes a map type as the source would: `map[K]V`.
proc ShowMap(s: { key: Type, value: Type }): string {
	ShowMap -> ShowType(t = this.s.key) as Key;
	Key -> ShowType(t = ShowMap.s.value) as Val;
	Val -> id("map[" + Key + "]" + this);
}

// Writes a struct's fields as `n: t`, or an enum's variants as `n` or
// `n(t)`, joined with ", ".
proc ShowMembers(s: { ms: []Member, variants: bool, i: int, acc: string }): string {
	ShowMembers switch {
		(this.s.i == this.s.ms.len) -> id(this.s.acc),
		else -> ShowType(t = this.s.ms[this.s.i].ty)
	};
	ShowType switch {
		(ShowMembers.s.variants && IsVoid(t = ShowMembers.s.ms[ShowMembers.s.i].ty)) -> ShowMembers(s = { ms = ShowMembers.s.ms, variants = ShowMembers.s.variants, i = ShowMembers.s.i + 1, acc = ShowMembers.s.acc + Sep(i = ShowMembers.s.i) + ShowMembers.s.ms[ShowMembers.s.i].name }),
		(ShowMembers.s.variants) -> ShowMembers(s = { ms = ShowMembers.s.ms, variants = ShowMembers.s.variants, i = ShowMembers.s.i + 1, acc = ShowMembers.s.acc + Sep(i = ShowMembers.s.i) + ShowMembers.s.ms[ShowMembers.s.i].name + "(" + this + ")" }),
		else -> ShowMembers(s = { ms = ShowMembers.s.ms, variants = ShowMembers.s.variants, i = ShowMembers.s.i + 1, acc = ShowMembers.s.acc + Sep(i = ShowMembers.s.i) + ShowMembers.s.ms[ShowMembers.s.i].name + ": " + this })
	};
}

// Whether a value of type `b` can be passed where `a` is expected. Structs
// need the same fields; an enum accepts any enum whose variants are among
// its own. `assumed` holds typedef pairs being compared further up: meeting
// one again means the comparison came full circle with no mismatch.
type AcceptsIn = { a: Type, b: Type, defs: []TypeDef, assumed: []Pair };

// Decides whether a value of type b may go where type a is expected: the
// same primitives, arrays and maps of accepted types, structs with the same
// fields, or an enum with at least b's variants. Typedef names are unfolded
// to their structures, a pair of names already being compared is assumed to
// match, so recursive types end.
proc Accepts(s: AcceptsIn): bool {
	// Pairs two types' typedef ids, if both are typedef names.
	func Names(a: Type, b: Type): OptPair = "sema_leaf.rs:named_pair";
	func HasPair(ps: []Pair, p: Pair): bool = "sema_leaf.rs:has_pair";
	Accepts -> Names(a = this.s.a, b = this.s.b);
	Names switch {
		Some(p) -> switch {
			(p.x == p.y || HasPair(ps = Accepts.s.assumed, p = p)) -> id(true),
			else -> Unfold(s = { t = Accepts.s.a, defs = Accepts.s.defs }) as UA
		},
		else -> Unfold(s = { t = Accepts.s.a, defs = Accepts.s.defs }) as UA
	};
	UA -> Unfold(s = { t = Accepts.s.b, defs = Accepts.s.defs }) as UB;
	UB -> AcceptsShapes(s = { a = UA, b = this, defs = Accepts.s.defs, assumed = Accepts.s.assumed + NewPair(o = Names) });
}

// Makes the pair to assume while comparing two typedef names' structures:
// the names' pair, or none if they weren't both names.
func NewPair(o: OptPair): []Pair = "sema_leaf.rs:new_pair";

// Decides Accepts for two unfolded types, by their shapes: primitives must
// be the same, arrays' elements and maps' keys and values accepted, structs
// must have the same fields, an enum must have every variant of the one it
// accepts, and a foreign type accepts only itself.
proc AcceptsShapes(s: AcceptsIn): bool {
	AcceptsShapes -> id({ a = this.s.a, b = this.s.b }) as Both;
	Both switch {
		{ a = Prim(x), b = Prim(y) } -> id(x == y),
		{ a = Array(x), b = Array(y) } -> Accepts(s = { a = x, b = y, defs = AcceptsShapes.s.defs, assumed = AcceptsShapes.s.assumed }) as Elems,
		{ a = Map(x), b = Map(y) } -> AcceptsMap(s = { a = x, b = y, defs = AcceptsShapes.s.defs, assumed = AcceptsShapes.s.assumed }),
		{ a = Struct(x), b = Struct(y) } -> switch {
			(x.len == y.len) -> AllAccepted(s = { each = x, other = y, flip = false, defs = AcceptsShapes.s.defs, assumed = AcceptsShapes.s.assumed, i = 0 }) as Fields,
			else -> id(false)
		},
		{ a = Enum(x), b = Enum(y) } -> AllAccepted(s = { each = y, other = x, flip = true, defs = AcceptsShapes.s.defs, assumed = AcceptsShapes.s.assumed, i = 0 }) as Variants,
		{ a = Foreign(x), b = Foreign(y) } -> id(x.id == y.id),
		else -> id(false)
	};
}

// Decides Accepts for two map types: their keys, then their values.
proc AcceptsMap(s: { a: { key: Type, value: Type }, b: { key: Type, value: Type }, defs: []TypeDef, assumed: []Pair }): bool {
	AcceptsMap -> Accepts(s = { a = this.s.a.key, b = this.s.b.key, defs = this.s.defs, assumed = this.s.assumed }) as Keys;
	Keys switch {
		(this) -> Accepts(s = { a = AcceptsMap.s.a.value, b = AcceptsMap.s.b.value, defs = AcceptsMap.s.defs, assumed = AcceptsMap.s.assumed }) as Values,
		else -> id(false)
	};
}

// Checks that every member of `each` has a member of the same name in
// `other` whose type is accepted: Accepts(each's, other's), or with `flip`,
// Accepts(other's, each's).
proc AllAccepted(s: { each: []Member, other: []Member, flip: bool, defs: []TypeDef, assumed: []Pair, i: int }): bool {
	AllAccepted switch {
		(this.s.i == this.s.each.len) -> id(true),
		else -> Member(ms = this.s.other, name = this.s.each[this.s.i].name) as Found
	};
	Found switch {
		Some(t) -> switch {
			(AllAccepted.s.flip) -> Accepts(s = { a = t, b = AllAccepted.s.each[AllAccepted.s.i].ty, defs = AllAccepted.s.defs, assumed = AllAccepted.s.assumed }) as One,
			else -> Accepts(s = { a = AllAccepted.s.each[AllAccepted.s.i].ty, b = t, defs = AllAccepted.s.defs, assumed = AllAccepted.s.assumed }) as One
		},
		else -> id(false)
	};
	One switch {
		(this) -> AllAccepted(s = { each = AllAccepted.s.each, other = AllAccepted.s.other, flip = AllAccepted.s.flip, defs = AllAccepted.s.defs, assumed = AllAccepted.s.assumed, i = AllAccepted.s.i + 1 }),
		else -> id(false)
	};
}
