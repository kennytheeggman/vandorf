// Graphs: each proc's typed edges, its for each regions, and the checks
// that reads see nodes that ran (src/sema.rs: build_graph .. dominators in
// the reference). And Analyze, the whole of sema.

type GraphIn = { env: Env, p: Proc, g: Graph };

func NoGraph(n: int): Graph = "sema_leaf.rs:empty_graph";
// Adds a region to g, a child of `parent` entered at `entry`, its elements
// of type elem; its id is the old regions.len.
func NewRegion(g: Graph, parent: int, entry: int, elem: Type): Graph = "sema_leaf.rs:new_region";
// Puts node n in region r, recording both ways.
func InRegion(g: Graph, n: int, r: int): Graph = "sema_leaf.rs:in_region";
func WithSink(g: Graph, r: int, n: int): Graph = "sema_leaf.rs:with_sink";
func WithOpen(g: Graph, n: int, r: int): Graph = "sema_leaf.rs:with_open";
// Lists the calls an edge makes: its call, a switch's (depth first), a
// spawn's branches and its join.
func EdgeCalls(e: SEdge): []Call = "sema_leaf.rs:edge_calls";
func ArgValues(calls: []Call): []Expr = "sema_leaf.rs:arg_values";
// Lists the conditions of a switch's arms and of the switches nested in
// them, arm by arm.
func ArmConds(arms: []SArm): []Expr = "sema_leaf.rs:arm_conds";
// Lists what a switch's arms read, arm by arm: each one's conditions, then
// the arguments of its calls.
func ArmReads(arms: []SArm): []Expr = "sema_leaf.rs:arm_reads";
func EdgeNodes(g: Graph): []int = "sema_leaf.rs:edge_nodes";
func Ancestors(g: Graph, r: int): map[int]bool = "sema_leaf.rs:ancestors";
func Opener(g: Graph, r: int): int = "sema_leaf.rs:opener";

// A proc's graph, and the program's nodes with its `id(..) as N` typed.
type Built = { g: Graph, nodes: []NodeDecl };

// Builds and checks the graph of proc env.pid, declared as p. It types the
// proc's `id(..) as N` nodes, checks each edge, and records the spawns. Then
// it splits the nodes into regions, the body and each for each's, and checks
// that every read is in scope and of a node that has run, and that every
// node ending the proc returns its type.
proc BuildGraph(s: { env: Env, p: Proc }): Res<Built> {
	func Entry(nodes: []NodeDecl, pid: int): int = "sema_leaf.rs:proc_entry";
	BuildGraph -> TypedEnv(s = this.s);
	TypedEnv -> GraphEdges(s = { env = this, p = BuildGraph.s.p, g = NoGraph(n = 0), i = 0 });
	GraphEdges switch {
		Ok(g) -> WithSpawned(g = g, nodes = TypedEnv.nodes),
		Err(e) -> id(Err(e))
	};
	WithSpawned switch {
		Ok(g) -> Fill(s = { env = TypedEnv, p = BuildGraph.s.p, g = NewRegion(g = g, parent = -1, entry = Entry(nodes = TypedEnv.nodes, pid = TypedEnv.pid), elem = Prim("void")), r = 0, work = [Entry(nodes = TypedEnv.nodes, pid = TypedEnv.pid)], i = 0 }),
		Err(e) -> id(Err(e))
	};
	Fill switch {
		Ok(g) -> SpawnReach(g = g, nodes = TypedEnv.nodes, span = BuildGraph.s.p.name.span),
		Err(e) -> id(Err(e))
	};
	SpawnReach switch {
		Ok(g) -> CheckScopes(s = { env = TypedEnv, p = BuildGraph.s.p, g = g, edges = EdgeNodes(g = g), i = 0 }),
		Err(e) -> id(Err(e))
	};
	CheckScopes switch {
		Ok(g) -> Dominators(s = { g = g, r = 0, dom = [:] }),
		Err(e) -> id(Err(e))
	};
	Dominators -> CheckRuns(s = { env = TypedEnv, g = UnwrapG(r = CheckScopes), dom = this, edges = EdgeNodes(g = UnwrapG(r = CheckScopes)), i = 0 });
	CheckRuns switch {
		Ok(g) -> id(Ok({ g = g, nodes = TypedEnv.nodes })),
		Err(e) -> id(Err(e))
	};
}

func UnwrapG(r: Res<Graph>): Graph = "sema_leaf.rs:unwrap_g";
// Records each spawn's branches in g, with the node whose spawn runs each; a
// branch runs in one spawn only, and has no edge of its own.
func WithSpawned(g: Graph, nodes: []NodeDecl): Res<Graph> = "sema_leaf.rs:with_spawned";
// Fails if a spawn's branch is also reached as a step of the proc, outside
// its spawn.
func SpawnReach(g: Graph, nodes: []NodeDecl, span: Span): Res<Graph> = "sema_leaf.rs:spawn_reach";

// Types the proc's `id(..) as N` nodes, if it has any whose type isn't known
// yet.
proc TypedEnv(s: { env: Env, p: Proc }): Env {
	// Whether proc `pid` has an `id(..) as N` whose type isn't known yet.
	func HasUntyped(nodes: []NodeDecl, pid: int): bool = "sema_leaf.rs:has_untyped";
	TypedEnv switch {
		(HasUntyped(nodes = this.s.env.nodes, pid = this.s.env.pid)) -> IdTypes(s = { env = this.s.env, p = this.s.p, i = 0, typed = false }),
		else -> id(this.s.env)
	};
	IdTypes -> id(this);
}

// Types each `id(..) as N` from the first value passed to it: rounds over
// the edges, each checking the edges it can (their sources and reads have
// types) and typing the ids they pass values to, until a round types none.
// Edges that can't be checked yet are checked again by GraphEdges, which
// reports their errors.
proc IdTypes(s: { env: Env, p: Proc, i: int, typed: bool }): Env {
	// Whether the edge passes a value to an id whose type isn't known yet.
	func TypesIds(nodes: []NodeDecl, e: SEdge): bool = "sema_leaf.rs:types_ids";
	// Types each untyped id the edge calls by the value it passes it first.
	func TypedIds(nodes: []NodeDecl, e: SEdge): []NodeDecl = "sema_leaf.rs:typed_ids";
	IdTypes switch {
		(this.s.i == this.s.p.edges.len && this.s.typed) -> IdTypes(s = { ..this.s, i = 0, typed = false }),
		(this.s.i == this.s.p.edges.len) -> id(this.s.env),
		else -> EdgeOf(s = { env = this.s.env, p = this.s.p, i = this.s.i })
	};
	EdgeOf switch {
		Ok(x) -> switch {
			(TypesIds(nodes = IdTypes.s.env.nodes, e = x.e)) -> IdTypes(s = { ..IdTypes.s, env = { ..IdTypes.s.env, nodes = TypedIds(nodes = IdTypes.s.env.nodes, e = x.e) }, i = IdTypes.s.i + 1, typed = true }),
			else -> IdTypes(s = { ..IdTypes.s, i = IdTypes.s.i + 1 })
		},
		Err(_) -> IdTypes(s = { ..IdTypes.s, i = IdTypes.s.i + 1 })
	};
}

// Checks each of the proc's edges in turn and adds it to the graph, failing
// at the first error.
proc GraphEdges(s: { env: Env, p: Proc, g: Graph, i: int }): Res<Graph> {
	GraphEdges switch {
		(this.s.i == this.s.p.edges.len) -> id(Ok(this.s.g)),
		else -> EdgeOf(s = { env = this.s.env, p = this.s.p, i = this.s.i })
	};
	EdgeOf switch {
		Ok(x) -> AddEdge(s = { at = GraphEdges.s, src = x.src, e = x.e }),
		Err(e) -> id(Err(e))
	};
	AddEdge -> id(this);
}

type SrcEdge = { src: int, e: SEdge };

// Checks edge p.edges[i] from its source node, whose output is `this`: a
// call, a switch, a collect (`this` an array of the collected node's
// outputs, which can't be foreign), a for each over an array (`this` its
// element), or a spawn. Its source must be typed.
proc EdgeOf(s: { env: Env, p: Proc, i: int }): Res<SrcEdge> {
	EdgeOf -> ResolveNode(s = { nodes = this.s.env.nodes, globals = this.s.env.globals, pid = this.s.env.pid, path = this.s.p.edges[this.s.i].source });
	ResolveNode switch {
		Ok(src) -> switch {
			(IsUntypedId(n = EdgeOf.s.env.nodes[src])) -> id(Err(Untyped(n = EdgeOf.s.env.nodes[src], span = EdgeOf.s.p.edges[EdgeOf.s.i].source.span))),
			else -> id(EdgeOf.s.p.edges[EdgeOf.s.i].kind) as K
		},
		Err(e) -> id(Err(e))
	};
	K switch {
		Call(t) -> CallOf(s = { env = EdgeOf.s.env, sc = { this = NodeRet(nodes = EdgeOf.s.env.nodes, n = UnwrapN(r = ResolveNode)), binds = [] }, t = t }) as EC,
		Match(arms) -> Switch(s = { env = EdgeOf.s.env, sc = { this = NodeRet(nodes = EdgeOf.s.env.nodes, n = UnwrapN(r = ResolveNode)), binds = [] }, src = EdgeOf.s.p.edges[EdgeOf.s.i].source, arms = arms, span = EdgeOf.s.p.edges[EdgeOf.s.i].span, nested = false }) as EM,
		Collect(c) -> switch {
			(IsSomeStr(m = ForeignOf(t = NodeRet(nodes = EdgeOf.s.env.nodes, n = UnwrapN(r = ResolveNode)), defs = EdgeOf.s.env.types))) -> ShowType(t = NodeRet(nodes = EdgeOf.s.env.nodes, n = UnwrapN(r = ResolveNode))) as ForeignCollect,
			else -> CallOf(s = { env = EdgeOf.s.env, sc = { this = Array(NodeRet(nodes = EdgeOf.s.env.nodes, n = UnwrapN(r = ResolveNode))), binds = [] }, t = c.target }) as ECol
		},
		ForEach(f) -> Synth(s = { env = EdgeOf.s.env, sc = { this = NodeRet(nodes = EdgeOf.s.env.nodes, n = UnwrapN(r = ResolveNode)), binds = [] }, v = f.dim }) as Dim,
		Spawn(sp) -> SpawnEdge(s = { env = EdgeOf.s.env, ret = NodeRet(nodes = EdgeOf.s.env.nodes, n = UnwrapN(r = ResolveNode)), branches = sp.branches, join = sp.join, i = 0, out = [], fields = [] })
	};
	SpawnEdge switch {
		Ok(e) -> id(Ok({ src = UnwrapN(r = ResolveNode), e = e })),
		Err(e) -> id(Err(e))
	};
	EC switch {
		Ok(c) -> id(Ok({ src = UnwrapN(r = ResolveNode), e = Call(c) })),
		Err(e) -> id(Err(e))
	};
	EM switch {
		Ok(arms) -> id(Ok({ src = UnwrapN(r = ResolveNode), e = Match(arms) })),
		Err(e) -> id(Err(e))
	};
	ForeignCollect -> id(Err({ msg = QualName(n = EdgeOf.s.env.nodes[UnwrapN(r = ResolveNode)]) + " returns " + this + ", a foreign type, so collect each can't gather its outputs into an array", span = EdgeOf.s.p.edges[EdgeOf.s.i].source.span }));
	ECol switch {
		Ok(c) -> id(Ok({ src = UnwrapN(r = ResolveNode), e = Collect(c) })),
		Err(e) -> id(Err(e))
	};
	Dim switch {
		Ok(d) -> Unfold(s = { t = d.t, defs = EdgeOf.s.env.types }) as DimShape,
		Err(e) -> id(Err(e))
	};
	DimShape switch {
		(IsArray(t = this)) -> CallOf(s = { env = EdgeOf.s.env, sc = { this = ElemOf(t = this), binds = [] }, t = ForEachTarget(k = K) }) as EF,
		else -> ShowType(t = UnwrapTyped(r = Dim).t) as NotArray
	};
	NotArray -> id(Err({ msg = "for each needs an array, found " + this, span = ForEachDim(k = K).span }));
	EF switch {
		Ok(c) -> id(Ok({ src = UnwrapN(r = ResolveNode), e = ForEach({ dim = UnwrapTyped(r = Dim).e, elem = ElemOf(t = DimShape), call = c }) })),
		Err(e) -> id(Err(e))
	};
}

func ForEachTarget(k: EdgeKind): Target = "sema_leaf.rs:for_each_target";
func UnwrapC(r: Res<Call>): Call = "sema_leaf.rs:unwrap_c";
func ForEachDim(k: EdgeKind): Value = "sema_leaf.rs:for_each_dim";

// Checks `-> spawn { .. } join J(..)`: each branch is called with the
// spawner's output as this, and runs once; the join gets the joined
// branches' outputs, by node name (void ones and detached ones left out),
// and mustn't read a detached one. A joined branch can't return a foreign
// value.
proc SpawnEdge(s: { env: Env, ret: Type, branches: []Branch, join: Target, i: int, out: []SBranch, fields: []Member }): Res<SEdge> {
	func HasId(t: Target): bool = "sema_leaf.rs:has_id";
	func HasTarget(out: []SBranch, n: int): bool = "sema_leaf.rs:has_branch_target";
	func HasMember(ms: []Member, name: string): bool = "sema_leaf.rs:has_member";
	func Name(n: NodeDecl): string = "sema_leaf.rs:last_name";
	// Finds the first `this.X` argument of the join that names a detached branch
	// X: what the join can't read.
	func Detached(join: Target, out: []SBranch, nodes: []NodeDecl): OptIdent = "sema_leaf.rs:detached_ref";
	SpawnEdge switch {
		(this.s.i == this.s.branches.len) -> Detached(join = this.s.join, out = this.s.out, nodes = this.s.env.nodes),
		(HasId(t = this.s.branches[this.s.i].target)) -> id(Err({ msg = "id ends the proc, so it can't run in a spawn branch", span = this.s.branches[this.s.i].target.node.span })),
		else -> CallOf(s = { env = this.s.env, sc = { this = this.s.ret, binds = [] }, t = this.s.branches[this.s.i].target }) as Branch
	};
	Branch switch {
		Ok(c) -> switch {
			(HasTarget(out = SpawnEdge.s.out, n = c.target)) -> id(Err({ msg = QualName(n = SpawnEdge.s.env.nodes[c.target]) + " runs twice in this spawn; name one with `as`", span = SpawnEdge.s.branches[SpawnEdge.s.i].target.node.span })),
			(!SpawnEdge.s.branches[SpawnEdge.s.i].detach && IsSomeStr(m = ForeignOf(t = NodeRet(nodes = SpawnEdge.s.env.nodes, n = c.target), defs = SpawnEdge.s.env.types))) -> ShowType(t = NodeRet(nodes = SpawnEdge.s.env.nodes, n = c.target)) as ForeignOut,
			(SpawnEdge.s.branches[SpawnEdge.s.i].detach || IsVoid(t = NodeRet(nodes = SpawnEdge.s.env.nodes, n = c.target))) -> SpawnEdge(s = { ..SpawnEdge.s, i = SpawnEdge.s.i + 1, out = SpawnEdge.s.out + [{ call = c, detach = SpawnEdge.s.branches[SpawnEdge.s.i].detach }] }),
			(HasMember(ms = SpawnEdge.s.fields, name = Name(n = SpawnEdge.s.env.nodes[c.target]))) -> id(Err({ msg = "two joined branches are named " + Name(n = SpawnEdge.s.env.nodes[c.target]) + "; name one with `as`", span = SpawnEdge.s.branches[SpawnEdge.s.i].target.node.span })),
			else -> SpawnEdge(s = { ..SpawnEdge.s, i = SpawnEdge.s.i + 1, out = SpawnEdge.s.out + [{ call = c, detach = false }], fields = SpawnEdge.s.fields + [{ name = Name(n = SpawnEdge.s.env.nodes[c.target]), ty = NodeRet(nodes = SpawnEdge.s.env.nodes, n = c.target) }] })
		},
		Err(e) -> id(Err(e))
	};
	ForeignOut -> id(Err({ msg = QualName(n = SpawnEdge.s.env.nodes[UnwrapC(r = Branch).target]) + " returns " + this + ", a foreign type, which a join can't take: run it before or after the spawn", span = SpawnEdge.s.branches[SpawnEdge.s.i].target.node.span }));
	Detached switch {
		Some(x) -> id(Err({ msg = x.name + " is detached, so the join doesn't get its output", span = x.span })),
		else -> CallOf(s = { env = SpawnEdge.s.env, sc = { this = Struct(SpawnEdge.s.fields), binds = [] }, t = SpawnEdge.s.join }) as Join
	};
	Join switch {
		Ok(c) -> id(Ok(Spawn({ branches = SpawnEdge.s.out, join = c, joined = Struct(SpawnEdge.s.fields) }))),
		Err(e) -> id(Err(e))
	};
}

type MaybeDiag = enum { None, Some(Diag) };

// Adds one source's edge to the graph, failing if the source already has
// one or it lends a foreign value where it can't, then goes on with the rest
// of GraphEdges.
proc AddEdge(s: { at: { env: Env, p: Proc, g: Graph, i: int }, src: int, e: SEdge }): Res<Graph> {
	// Finds a foreign value an edge lends where it can't: twice to one call (in
	// two arguments, or one and a call inside another), to a detached spawn
	// branch, which nothing waits for, or to two branches, which run at once.
	// `this` is src's output.
	func EdgeLends(src: int, e: SEdge, nodes: []NodeDecl, defs: []TypeDef): MaybeDiag = "sema_leaf.rs:edge_lends";
	AddEdge switch {
		(this.s.src in this.s.at.g.edges) -> id(Err({ msg = ShowPath(p = this.s.at.p.edges[this.s.at.i].source) + " already has an outgoing edge", span = this.s.at.p.edges[this.s.at.i].source.span })),
		else -> EdgeLends(src = this.s.src, e = this.s.e, nodes = this.s.at.env.nodes, defs = this.s.at.env.types)
	};
	EdgeLends switch {
		Some(d) -> id(Err(d)),
		else -> GraphEdges(s = { env = AddEdge.s.at.env, p = AddEdge.s.at.p, g = { ..AddEdge.s.at.g, edges = AddEdge.s.at.g.edges + [AddEdge.s.src: AddEdge.s.e] }, i = AddEdge.s.at.i + 1 })
	};
}

// Assigns every node reachable from region r's entry to r, following each
// edge. At a for each it fills the region it opens first, which must end at
// a collect, then carries on in r after the collect. Fails on a node in two
// regions, a path that ends inside a for each, or a collect outside of one.
proc Fill(s: { env: Env, p: Proc, g: Graph, r: int, work: []int, i: int }): Res<Graph> {
	func Leaves(arms: []SArm): []int = "sema_leaf.rs:leaf_targets";
	Fill switch {
		(this.s.i == this.s.work.len) -> id(Ok(this.s.g)),
		(this.s.work[this.s.i] in this.s.g.region_of && this.s.g.region_of[this.s.work[this.s.i]] != this.s.r) -> id(Err({ msg = QualName(n = this.s.env.nodes[this.s.work[this.s.i]]) + " is reachable both inside and outside a for each region", span = this.s.p.name.span })),
		(this.s.work[this.s.i] in this.s.g.region_of) -> Fill(s = { env = this.s.env, p = this.s.p, g = this.s.g, r = this.s.r, work = this.s.work, i = this.s.i + 1 }),
		(this.s.work[this.s.i] in this.s.g.edges) -> id(this.s.g.edges[this.s.work[this.s.i]]) as E,
		(this.s.r != 0) -> id(Err({ msg = "path through " + QualName(n = this.s.env.nodes[this.s.work[this.s.i]]) + " ends inside a for each region without a collect", span = this.s.p.name.span })),
		else -> Fill(s = { env = this.s.env, p = this.s.p, g = InRegion(g = this.s.g, n = this.s.work[this.s.i], r = this.s.r), r = this.s.r, work = this.s.work, i = this.s.i + 1 })
	};
	E switch {
		Call(c) -> Fill(s = { env = Fill.s.env, p = Fill.s.p, g = InRegion(g = Fill.s.g, n = Fill.s.work[Fill.s.i], r = Fill.s.r), r = Fill.s.r, work = Fill.s.work + [c.target], i = Fill.s.i + 1 }),
		Match(arms) -> Fill(s = { env = Fill.s.env, p = Fill.s.p, g = InRegion(g = Fill.s.g, n = Fill.s.work[Fill.s.i], r = Fill.s.r), r = Fill.s.r, work = Fill.s.work + Leaves(arms = arms), i = Fill.s.i + 1 }),
		Spawn(sp) -> Fill(s = { env = Fill.s.env, p = Fill.s.p, g = InRegion(g = Fill.s.g, n = Fill.s.work[Fill.s.i], r = Fill.s.r), r = Fill.s.r, work = Fill.s.work + [sp.join.target], i = Fill.s.i + 1 }),
		Collect(c) -> switch {
			(Fill.s.r == 0) -> id(Err({ msg = QualName(n = Fill.s.env.nodes[Fill.s.work[Fill.s.i]]) + " collects outside of any for each", span = c.span })),
			(Fill.s.g.regions[Fill.s.r].sink >= 0 && Fill.s.g.regions[Fill.s.r].sink != Fill.s.work[Fill.s.i]) -> id(Err({ msg = "for each region collects at both " + QualName(n = Fill.s.env.nodes[Fill.s.g.regions[Fill.s.r].sink]) + " and " + QualName(n = Fill.s.env.nodes[Fill.s.work[Fill.s.i]]), span = c.span })),
			else -> Fill(s = { env = Fill.s.env, p = Fill.s.p, g = WithSink(g = InRegion(g = Fill.s.g, n = Fill.s.work[Fill.s.i], r = Fill.s.r), r = Fill.s.r, n = Fill.s.work[Fill.s.i]), r = Fill.s.r, work = Fill.s.work, i = Fill.s.i + 1 })
		},
		ForEach(f) -> Fill(s = { env = Fill.s.env, p = Fill.s.p, g = WithOpen(g = NewRegion(g = InRegion(g = Fill.s.g, n = Fill.s.work[Fill.s.i], r = Fill.s.r), parent = Fill.s.r, entry = f.call.target, elem = f.elem), n = Fill.s.work[Fill.s.i], r = Fill.s.g.regions.len), r = Fill.s.g.regions.len, work = [f.call.target], i = 0 }) as Child
	};
	Child switch {
		Ok(g) -> switch {
			(g.regions[Fill.s.g.regions.len].sink < 0) -> id(Err({ msg = "for each from " + QualName(n = Fill.s.env.nodes[Fill.s.work[Fill.s.i]]) + " never collects", span = ForEachCall(e = E).span })),
			else -> Fill(s = { env = Fill.s.env, p = Fill.s.p, g = g, r = Fill.s.r, work = Fill.s.work + [CollectTarget(g = g, sink = g.regions[Fill.s.g.regions.len].sink)], i = Fill.s.i + 1 })
		},
		Err(e) -> id(Err(e))
	};
}

func ForEachCall(e: SEdge): Call = "sema_leaf.rs:for_each_call";
func CollectTarget(g: Graph, sink: int): int = "sema_leaf.rs:collect_target";

// Checks every edge's reads: each is of a node in its own region or an
// enclosing one (not inside a for each, nor a spawn's branch). Then checks
// every node that ends the proc returns the proc's type.
proc CheckScopes(s: { env: Env, p: Proc, g: Graph, edges: []int, i: int }): Res<Graph> {
	CheckScopes switch {
		(this.s.i == this.s.edges.len) -> Terminals(s = { env = this.s.env, p = this.s.p, g = this.s.g, i = 0 }),
		(!(this.s.edges[this.s.i] in this.s.g.region_of)) -> CheckScopes(s = { env = this.s.env, p = this.s.p, g = this.s.g, edges = this.s.edges, i = this.s.i + 1 }),
		else -> id(this.s.g.edges[this.s.edges[this.s.i]]) as E
	};
	E switch {
		ForEach(f) -> InScope(s = { env = CheckScopes.s.env, g = CheckScopes.s.g, scope = CheckScopes.s.g.region_of[CheckScopes.s.edges[CheckScopes.s.i]], refs = [], todo = [f.dim] }) as DimOk,
		Collect(_) -> InScope(s = { env = CheckScopes.s.env, g = CheckScopes.s.g, scope = CheckScopes.s.g.regions[CheckScopes.s.g.region_of[CheckScopes.s.edges[CheckScopes.s.i]]].parent, refs = [], todo = ArgValues(calls = EdgeCalls(e = this)) }) as Reads,
		Match(arms) -> InScope(s = { env = CheckScopes.s.env, g = CheckScopes.s.g, scope = CheckScopes.s.g.region_of[CheckScopes.s.edges[CheckScopes.s.i]], refs = [], todo = ArgValues(calls = EdgeCalls(e = this)) + ArmConds(arms = arms) }) as Reads,
		Call(_) | Spawn(_) -> InScope(s = { env = CheckScopes.s.env, g = CheckScopes.s.g, scope = CheckScopes.s.g.region_of[CheckScopes.s.edges[CheckScopes.s.i]], refs = [], todo = ArgValues(calls = EdgeCalls(e = this)) }) as Reads
	};
	DimOk switch {
		Ok(_) -> InScope(s = { env = CheckScopes.s.env, g = CheckScopes.s.g, scope = CheckScopes.s.g.opens[CheckScopes.s.edges[CheckScopes.s.i]], refs = [], todo = ArgValues(calls = EdgeCalls(e = E)) }) as Reads,
		Err(e) -> id(Err(e))
	};
	Reads switch {
		Ok(_) -> CheckScopes(s = { env = CheckScopes.s.env, p = CheckScopes.s.p, g = CheckScopes.s.g, edges = CheckScopes.s.edges, i = CheckScopes.s.i + 1 }),
		Err(e) -> id(Err(e))
	};
}

// Checks that the reads in `todo` (expressions, depth first) are of nodes
// visible from region `scope`.
proc InScope(s: { env: Env, g: Graph, scope: int, refs: []Ref, todo: []Expr }): Res<int> {
	InScope -> RefsOf(s = { todo = this.s.todo, acc = [] });
	RefsOf -> ScopeEach(s = { env = InScope.s.env, g = InScope.s.g, scope = InScope.s.scope, refs = this, i = 0 });
}

// Checks each read in turn: this and bindings are always visible; a node
// must have run somewhere, not be a spawn's branch, and be in the region or
// one enclosing it, but a foreign value only in its own: a for each's
// elements run at once.
proc ScopeEach(s: { env: Env, g: Graph, scope: int, refs: []Ref, i: int }): Res<int> {
	func NodeOf(r: Root): int = "sema_leaf.rs:root_node";
	func LastName(n: NodeDecl): string = "sema_leaf.rs:last_name";
	ScopeEach switch {
		(this.s.i == this.s.refs.len) -> id(Ok(0)),
		// this and bindings are always in scope.
		(NodeOf(r = this.s.refs[this.s.i].root) < 0) -> ScopeEach(s = { env = this.s.env, g = this.s.g, scope = this.s.scope, refs = this.s.refs, i = this.s.i + 1 }),
		(NodeOf(r = this.s.refs[this.s.i].root) in this.s.g.spawned) -> id(Err({ msg = QualName(n = this.s.env.nodes[NodeOf(r = this.s.refs[this.s.i].root)]) + " runs in " + QualName(n = this.s.env.nodes[this.s.g.spawned[NodeOf(r = this.s.refs[this.s.i].root)]]) + "'s spawn, so its output is only visible to the join, as this." + LastName(n = this.s.env.nodes[NodeOf(r = this.s.refs[this.s.i].root)]), span = this.s.refs[this.s.i].span })),
		(!(NodeOf(r = this.s.refs[this.s.i].root) in this.s.g.region_of)) -> id(Err({ msg = QualName(n = this.s.env.nodes[NodeOf(r = this.s.refs[this.s.i].root)]) + " never runs in this proc", span = this.s.refs[this.s.i].span })),
		(this.s.g.region_of[NodeOf(r = this.s.refs[this.s.i].root)] != this.s.scope && this.s.g.region_of[NodeOf(r = this.s.refs[this.s.i].root)] in Ancestors(g = this.s.g, r = this.s.scope) && IsSomeStr(m = ForeignOf(t = this.s.refs[this.s.i].ty, defs = this.s.env.types))) -> id(Err({ msg = QualName(n = this.s.env.nodes[NodeOf(r = this.s.refs[this.s.i].root)]) + " is a foreign value from outside this for each region, whose elements run at once, so they can't borrow it", span = this.s.refs[this.s.i].span })),
		(this.s.g.region_of[NodeOf(r = this.s.refs[this.s.i].root)] in Ancestors(g = this.s.g, r = this.s.scope)) -> ScopeEach(s = { env = this.s.env, g = this.s.g, scope = this.s.scope, refs = this.s.refs, i = this.s.i + 1 }),
		else -> id(Err({ msg = QualName(n = this.s.env.nodes[NodeOf(r = this.s.refs[this.s.i].root)]) + " runs inside a for each region, so its output is not visible here", span = this.s.refs[this.s.i].span }))
	};
}

// Collects the Refs in expressions, depth first.
proc RefsOf(s: { todo: []Expr, acc: []Ref }): []Ref {
	func Parts(e: Expr): []Expr = "sema_leaf.rs:expr_parts";
	func RefIn(e: Expr): []Ref = "sema_leaf.rs:expr_ref";
	func RestE(es: []Expr): []Expr = "sema_leaf.rs:rest_exprs";
	RefsOf switch {
		(this.s.todo.len == 0) -> id(this.s.acc),
		else -> RefsOf(s = { todo = Parts(e = this.s.todo[0]) + RestE(es = this.s.todo), acc = this.s.acc + RefIn(e = this.s.todo[0]) })
	};
}

// Checks every node of the proc's body that has no edge out, which ends the
// proc, returns a type the proc's accepts.
proc Terminals(s: { env: Env, p: Proc, g: Graph, i: int }): Res<Graph> {
	Terminals switch {
		(this.s.i == this.s.g.regions[0].nodes.len) -> id(Ok(this.s.g)),
		(this.s.g.regions[0].nodes[this.s.i] in this.s.g.edges) -> Terminals(s = { env = this.s.env, p = this.s.p, g = this.s.g, i = this.s.i + 1 }),
		else -> Accepts(s = { a = ProcRet(n = this.s.env.nodes[this.s.env.pid]), b = NodeRet(nodes = this.s.env.nodes, n = this.s.g.regions[0].nodes[this.s.i]), defs = this.s.env.types, assumed = [] })
	};
	Accepts switch {
		(this) -> Terminals(s = { env = Terminals.s.env, p = Terminals.s.p, g = Terminals.s.g, i = Terminals.s.i + 1 }),
		else -> ShowType(t = NodeRet(nodes = Terminals.s.env.nodes, n = Terminals.s.g.regions[0].nodes[Terminals.s.i])) as Got
	};
	Got -> ShowType(t = ProcRet(n = Terminals.s.env.nodes[Terminals.s.env.pid])) as Want;
	Want -> id(Err({ msg = QualName(n = Terminals.s.env.nodes[Terminals.s.g.regions[0].nodes[Terminals.s.i]]) + " ends proc " + Terminals.s.p.name.name + " but returns " + Got + ", expected " + this, span = Terminals.s.p.name.span }));
}

// ---- Reads of nodes that may not have run ----

// Finds the dominators of each node within its region: the nodes on every
// path from the region's entry to it, itself included. A for each steps from
// its opener to its collect target, the region in between running in full.
proc Dominators(s: { g: Graph, r: int, dom: map[int]map[int]bool }): map[int]map[int]bool {
	func Preds(g: Graph, r: int): map[int][]int = "sema_leaf.rs:preds";
	func Start(g: Graph, r: int, dom: map[int]map[int]bool): map[int]map[int]bool = "sema_leaf.rs:dom_start";
	Dominators switch {
		(this.s.r == this.s.g.regions.len) -> id(this.s.dom),
		else -> DomRounds(s = { region = this.s.g.regions[this.s.r], preds = Preds(g = this.s.g, r = this.s.r), dom = Start(g = this.s.g, r = this.s.r, dom = this.s.dom), i = 0, changed = false })
	};
	DomRounds -> Dominators(s = { g = Dominators.s.g, r = Dominators.s.r + 1, dom = this });
}

// Repeats over a region's nodes until nothing changes: each node's
// dominators become the intersection of its predecessors', and itself.
proc DomRounds(s: { region: Region, preds: map[int][]int, dom: map[int]map[int]bool, i: int, changed: bool }): map[int]map[int]bool {
	func Meet(preds: map[int][]int, dom: map[int]map[int]bool, n: int): map[int]bool = "sema_leaf.rs:meet";
	func SameSet(a: map[int]bool, b: map[int]bool): bool = "sema_leaf.rs:same_set";
	DomRounds switch {
		(this.s.i == this.s.region.nodes.len && this.s.changed) -> DomRounds(s = { region = this.s.region, preds = this.s.preds, dom = this.s.dom, i = 0, changed = false }),
		(this.s.i == this.s.region.nodes.len) -> id(this.s.dom),
		(this.s.region.nodes[this.s.i] == this.s.region.entry) -> DomRounds(s = { region = this.s.region, preds = this.s.preds, dom = this.s.dom, i = this.s.i + 1, changed = this.s.changed }),
		(SameSet(a = Meet(preds = this.s.preds, dom = this.s.dom, n = this.s.region.nodes[this.s.i]), b = this.s.dom[this.s.region.nodes[this.s.i]])) -> DomRounds(s = { region = this.s.region, preds = this.s.preds, dom = this.s.dom, i = this.s.i + 1, changed = this.s.changed }),
		else -> DomRounds(s = { region = this.s.region, preds = this.s.preds, dom = this.s.dom + [this.s.region.nodes[this.s.i]: Meet(preds = this.s.preds, dom = this.s.dom, n = this.s.region.nodes[this.s.i])], i = this.s.i + 1, changed = true })
	};
}

// Checks that every node output an edge reads has run on every path to the
// edge: in its region it dominates the edge's source, and a node of an
// enclosing region dominates the for each that opened the region.
proc CheckRuns(s: { env: Env, g: Graph, dom: map[int]map[int]bool, edges: []int, i: int }): Res<Graph> {
	CheckRuns switch {
		(this.s.i == this.s.edges.len) -> id(Ok(this.s.g)),
		(!(this.s.edges[this.s.i] in this.s.g.region_of)) -> CheckRuns(s = { env = this.s.env, g = this.s.g, dom = this.s.dom, edges = this.s.edges, i = this.s.i + 1 }),
		else -> id(this.s.g.edges[this.s.edges[this.s.i]]) as E
	};
	E switch {
		// A spawn's branches and join are all at the spawner's step.
		Call(_) | Spawn(_) -> Ran(s = { env = CheckRuns.s.env, g = CheckRuns.s.g, dom = CheckRuns.s.dom, todo = ArgValues(calls = EdgeCalls(e = this)), r = CheckRuns.s.g.region_of[CheckRuns.s.edges[CheckRuns.s.i]], at = CheckRuns.s.edges[CheckRuns.s.i], src = CheckRuns.s.edges[CheckRuns.s.i] }) as Checked,
		Match(arms) -> Ran(s = { env = CheckRuns.s.env, g = CheckRuns.s.g, dom = CheckRuns.s.dom, todo = ArmReads(arms = arms), r = CheckRuns.s.g.region_of[CheckRuns.s.edges[CheckRuns.s.i]], at = CheckRuns.s.edges[CheckRuns.s.i], src = CheckRuns.s.edges[CheckRuns.s.i] }) as Checked,
		// The entry call's args are built before any node of the region runs.
		ForEach(f) -> Ran(s = { env = CheckRuns.s.env, g = CheckRuns.s.g, dom = CheckRuns.s.dom, todo = [f.dim] + ArgValues(calls = [f.call]), r = CheckRuns.s.g.region_of[CheckRuns.s.edges[CheckRuns.s.i]], at = CheckRuns.s.edges[CheckRuns.s.i], src = CheckRuns.s.edges[CheckRuns.s.i] }) as Checked,
		// After the region, in the enclosing one, at its opener.
		Collect(_) -> Ran(s = { env = CheckRuns.s.env, g = CheckRuns.s.g, dom = CheckRuns.s.dom, todo = ArgValues(calls = EdgeCalls(e = this)), r = CheckRuns.s.g.region_of[Opener(g = CheckRuns.s.g, r = CheckRuns.s.g.region_of[CheckRuns.s.edges[CheckRuns.s.i]])], at = Opener(g = CheckRuns.s.g, r = CheckRuns.s.g.region_of[CheckRuns.s.edges[CheckRuns.s.i]]), src = CheckRuns.s.edges[CheckRuns.s.i] }) as Checked
	};
	Checked switch {
		Ok(_) -> CheckRuns(s = { env = CheckRuns.s.env, g = CheckRuns.s.g, dom = CheckRuns.s.dom, edges = CheckRuns.s.edges, i = CheckRuns.s.i + 1 }),
		Err(e) -> id(Err(e))
	};
}

// Checks that each node the expressions read has run when `src`'s edge does,
// from `at` in region r.
proc Ran(s: { env: Env, g: Graph, dom: map[int]map[int]bool, todo: []Expr, r: int, at: int, src: int }): Res<int> {
	func NodeOf(r: Root): int = "sema_leaf.rs:root_node";
	// Finds where a path can skip node n on its way to `at` in region r, through
	// the regions enclosing it; -1 if every path runs n.
	func Skip(g: Graph, dom: map[int]map[int]bool, n: int, r: int, at: int): int = "sema_leaf.rs:skip";
	Ran -> RefsOf(s = { todo = this.s.todo, acc = [] });
	RefsOf -> RanEach(s = { at = Ran.s, refs = this, i = 0 });
}

// Checks each read in turn, failing at the first node that may not have run,
// naming the edge that reads it.
proc RanEach(s: { at: { env: Env, g: Graph, dom: map[int]map[int]bool, todo: []Expr, r: int, at: int, src: int }, refs: []Ref, i: int }): Res<int> {
	func NodeOf(r: Root): int = "sema_leaf.rs:root_node";
	// Finds where a path can skip node n on its way to `at` in region r, through
	// the regions enclosing it; -1 if every path runs n.
	func Skip(g: Graph, dom: map[int]map[int]bool, n: int, r: int, at: int): int = "sema_leaf.rs:skip";
	RanEach switch {
		(this.s.i == this.s.refs.len) -> id(Ok(0)),
		// this and bindings are always set.
		(NodeOf(r = this.s.refs[this.s.i].root) < 0 || Skip(g = this.s.at.g, dom = this.s.at.dom, n = NodeOf(r = this.s.refs[this.s.i].root), r = this.s.at.r, at = this.s.at.at) < 0) -> RanEach(s = { at = this.s.at, refs = this.s.refs, i = this.s.i + 1 }),
		else -> id(Err({
			msg = QualName(n = this.s.at.env.nodes[NodeOf(r = this.s.refs[this.s.i].root)]) + " may not have run when " + QualName(n = this.s.at.env.nodes[this.s.at.src]) + "'s edge reads it: a path to " + QualName(n = this.s.at.env.nodes[Skip(g = this.s.at.g, dom = this.s.at.dom, n = NodeOf(r = this.s.refs[this.s.i].root), r = this.s.at.r, at = this.s.at.at)]) + " skips it",
			span = this.s.refs[this.s.i].span
		}))
	};
}

// ---- Analyze ----

type Analysis = { prog: Program, errors: []Diag };

// Runs the whole of sema: declarations, then each proc's graph. Errors in
// one graph don't stop the others, but errors in the declarations stop it
// before the graphs, which need them.
proc Analyze(s: { srcs: []string, file: File }): Analysis {
	Analyze -> Declare(file = this.s.file);
	Declare switch {
		(this.ty.errors.len > 0) -> id({ prog = { types = this.ty.types, nodes = this.nodes, globals = this.globals, top = this.top }, errors = this.ty.errors }),
		else -> Graphs(s = { cx = this, srcs = Analyze.s.srcs, i = 0, errors = [] })
	};
}

// Builds each proc's graph in turn, keeping the ones that build and
// gathering every proc's errors.
proc Graphs(s: { cx: Cx, srcs: []string, i: int, errors: []Diag }): Analysis {
	func SetGraph(cx: Cx, pid: int, g: Graph): Cx = "sema_leaf.rs:set_graph";
	Graphs switch {
		(this.s.i == this.s.cx.procs.len) -> id({ prog = { types = this.s.cx.ty.types, nodes = this.s.cx.nodes, globals = this.s.cx.globals, top = this.s.cx.top }, errors = this.s.errors }),
		else -> BuildGraph(s = { env = { types = this.s.cx.ty.types, nodes = this.s.cx.nodes, globals = this.s.cx.globals, ids = this.s.cx.ids, pid = this.s.cx.procs[this.s.i].id, srcs = this.s.srcs }, p = this.s.cx.procs[this.s.i].p })
	};
	BuildGraph switch {
		Ok(b) -> Graphs(s = { cx = SetGraph(cx = { ..Graphs.s.cx, nodes = b.nodes }, pid = Graphs.s.cx.procs[Graphs.s.i].id, g = b.g), srcs = Graphs.s.srcs, i = Graphs.s.i + 1, errors = Graphs.s.errors }),
		Err(e) -> Graphs(s = { cx = Graphs.s.cx, srcs = Graphs.s.srcs, i = Graphs.s.i + 1, errors = Graphs.s.errors + [e] })
	};
}
