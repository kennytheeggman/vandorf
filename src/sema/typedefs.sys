// Typedefs: declaring them, generic ones and their instances, and resolving
// written types (src/sema.rs: declare_types .. ty in the reference).

type Diag = { msg: string, span: Span };

// Sema's state while resolving types.
type TyCx = {
	types: []TypeDef,
	// Where each typedef was declared, or (an instance) first used.
	spans: []Span,
	// Typedefs that aren't generic, by name.
	names: map[string]int,
	// Generic typedefs, by name; each use with arguments is an instance.
	generics: map[string]TypeDecl,
	// Generic typedefs whose bodies have errors, already reported.
	broken: map[string]bool,
	// Instances, by name as shown (`R<int>`).
	insts: map[string]int,
	// The type parameters of the instances being resolved, innermost last.
	bound: []map[string]Type,
	errors: []Diag
};

type TyOut = { cx: TyCx, t: MaybeType };
type MaybeMembers = enum { None, Some([]Member) };
type MaybeStr = enum { None, Some(string) };

func IsPrim(name: string): bool = "sema_leaf.rs:is_prim";
func Itoa(i: int): string = "sema_leaf.rs:itoa";
func Cap(s: string): string = "sema_leaf.rs:cap";
// Struct updates of the state.

func WithError(cx: TyCx, msg: string, span: Span): TyCx = "sema_leaf.rs:with_error";
func WithTypes(cx: TyCx, types: []TypeDef): TyCx = "sema_leaf.rs:with_types";
// Adds a typedef to cx, its type still void: its name and ident, where it's
// declared (span), and its name to look it up by.
func NewDef(cx: TyCx, name: string, ident: string, span: Span): TyCx = "sema_leaf.rs:new_def";
func NewInst(cx: TyCx, key: string, ident: string, span: Span): TyCx = "sema_leaf.rs:new_inst";
func SetTy(types: []TypeDef, id: int, t: Type): []TypeDef = "sema_leaf.rs:set_ty";
// Says which instance errors came from: appends " (in key)" to each of
// errors[from..], leaving earlier ones as they were.
func InInstance(errors: []Diag, from: int, key: string): []Diag = "sema_leaf.rs:in_instance";
// Looks up the type parameter `name` in the instance being resolved, the
// innermost: the argument it's bound to, if any.
func Bound(bound: []map[string]Type, name: string): MaybeType = "sema_leaf.rs:bound";
func Join(parts: []string, sep: string): string = "sema_leaf.rs:join";
func IsKeyType(t: Type): bool = "sema_leaf.rs:is_key_type";
func HasMember(ms: []Member, name: string): bool = "sema_leaf.rs:has_member";
func ParamMap(params: []Ident, args: []Type): map[string]Type = "sema_leaf.rs:param_map";

// ---- Resolving a written type ----

// Resolves a written type against the typedefs declared so far: names,
// instances of generics, arrays, maps, structs and enums. Errors go into cx,
// and the type is None if it doesn't resolve.
proc Ty(s: { cx: TyCx, t: TypeExpr }): TyOut {
	func ArrayOf(t: MaybeType): MaybeType = "sema_leaf.rs:array_of";
	func StructOf(ms: MaybeMembers): MaybeType = "sema_leaf.rs:struct_of";
	func EnumOf(ms: MaybeMembers): MaybeType = "sema_leaf.rs:enum_of";
	Ty -> id(this.s.t.kind) as Kind;
	Kind switch {
		Named(n) -> NamedTy(s = { cx = Ty.s.cx, n = n }),
		Inst(i) -> Instance(s = { cx = Ty.s.cx, n = i.name, args = i.args, i = 0, tys = [] }),
		Array(e) -> Ty(s = { cx = Ty.s.cx, t = e }) as Elem,
		Map(m) -> TyMap(s = { cx = Ty.s.cx, key = m.key, value = m.value }),
		Struct(fs) -> Fields(s = { cx = Ty.s.cx, fs = fs, i = 0, ok = true, acc = [] }),
		Enum(vs) -> Variants(s = { cx = Ty.s.cx, vs = vs, i = 0, acc = [] }),
		// Only a typedef's body, which DeclareTypes resolves itself.
		Foreign(_) -> id({ cx = { ..Ty.s.cx, errors = Ty.s.cx.errors + [{ msg = "expected a type, found a foreign type's implementations: name them with a typedef, type T = \"file:Type\";", span = Ty.s.t.span }] }, t = None() })
	};
	Elem -> id({ cx = this.cx, t = ArrayOf(t = this.t) });
	Fields -> id({ cx = this.cx, t = StructOf(ms = this.ms) });
	Variants -> id({ cx = this.cx, t = EnumOf(ms = this.ms) });
}

// Resolves a name written without type arguments: a type parameter bound by
// the instance being resolved, a primitive, or a typedef. Otherwise it
// records why it isn't a type (unknown, or generic and missing its
// arguments).
proc NamedTy(s: { cx: TyCx, n: Ident }): TyOut {
	NamedTy -> Bound(bound = this.s.cx.bound, name = this.s.n.name);
	Bound switch {
		Some(t) -> id({ cx = NamedTy.s.cx, t = Some(t) }),
		else -> switch {
			(IsPrim(name = NamedTy.s.n.name)) -> id({ cx = NamedTy.s.cx, t = Some(Prim(NamedTy.s.n.name)) }),
			(NamedTy.s.n.name in NamedTy.s.cx.names) -> id({ cx = NamedTy.s.cx, t = Some(Named({ id = NamedTy.s.cx.names[NamedTy.s.n.name], name = NamedTy.s.n.name })) }),
			else -> NameProblem(s = { cx = NamedTy.s.cx, name = NamedTy.s.n.name })
		}
	};
	NameProblem switch {
		Some(msg) -> id({ cx = { ..NamedTy.s.cx, errors = NamedTy.s.cx.errors + [{ msg = msg, span = NamedTy.s.n.span }] }, t = None() }),
		else -> id({ cx = { ..NamedTy.s.cx, errors = NamedTy.s.cx.errors + [{ msg = "unknown type " + NamedTy.s.n.name, span = NamedTy.s.n.span }] }, t = None() })
	};
}

// Explains why `name`, written without arguments, isn't a type: unknown, or
// generic and needing arguments (with an example of them). None if it is a
// type.
proc NameProblem(s: { cx: TyCx, name: string }): MaybeStr {
	func ParamNames(ps: []Ident): string = "sema_leaf.rs:param_names";
	NameProblem switch {
		(IsPrim(name = this.s.name) || this.s.name in this.s.cx.names || IsBoundName(bound = this.s.cx.bound, name = this.s.name)) -> id(None()),
		(this.s.name in this.s.cx.generics) -> id(Some(this.s.name + " is generic: give it type arguments, as in " + this.s.name + "<" + ParamNames(ps = this.s.cx.generics[this.s.name].params) + ">")),
		else -> id(Some("unknown type " + this.s.name))
	};
}

func IsBoundName(bound: []map[string]Type, name: string): bool = "sema_leaf.rs:is_bound";
// Whether d is a foreign typedef: `type T = "file:Type", ..;`.
func IsForeignDecl(d: TypeDecl): bool = "sema_leaf.rs:is_foreign_decl";

// Explains why `name<..>` with `count` arguments isn't a type: the wrong
// number of arguments, a type that isn't generic, or an unknown one. None if
// it is a type.
proc InstProblem(s: { cx: TyCx, name: string, count: int }): MaybeStr {
	func Plural(n: int): string = "sema_leaf.rs:plural";
	InstProblem switch {
		(this.s.name in this.s.cx.generics && this.s.cx.generics[this.s.name].params.len == this.s.count) -> id(None()),
		(this.s.name in this.s.cx.generics) -> id(Some(this.s.name + " takes " + Itoa(i = this.s.cx.generics[this.s.name].params.len) + " type argument" + Plural(n = this.s.cx.generics[this.s.name].params.len) + ", not " + Itoa(i = this.s.count))),
		(IsPrim(name = this.s.name) || this.s.name in this.s.cx.names || IsBoundName(bound = this.s.cx.bound, name = this.s.name)) -> id(Some(this.s.name + " isn't generic, so it takes no type arguments")),
		else -> id(Some("unknown type " + this.s.name))
	};
}

// Resolves a map type: its key and value, then checks the key is an int or a
// string, through any typedef names.
proc TyMap(s: { cx: TyCx, key: TypeExpr, value: TypeExpr }): TyOut {
	func MapOf(k: Type, v: MaybeType): MaybeType = "sema_leaf.rs:map_of";
	TyMap -> Ty(s = { cx = this.s.cx, t = this.s.key }) as Key;
	Key -> Ty(s = { cx = this.cx, t = TyMap.s.value }) as Val;
	Val -> id(Key.t) as KeyT;
	KeyT switch {
		Some(kt) -> Unfold(s = { t = kt, defs = Val.cx.types }) as KeyShape,
		else -> id({ cx = Val.cx, t = None() })
	};
	KeyShape switch {
		(IsKeyType(t = this)) -> id({ cx = Val.cx, t = MapOf(k = UnwrapT(t = Key.t), v = Val.t) }),
		else -> ShowType(t = UnwrapT(t = Key.t)) as Shown
	};
	Shown -> id({ cx = { ..Val.cx, errors = Val.cx.errors + [{ msg = "map keys are ints or strings, not " + this, span = TyMap.s.key.span }] }, t = None() });
}

func UnwrapT(t: MaybeType): Type = "sema_leaf.rs:unwrap_t";

// Resolves a struct's fields, each in turn, reporting duplicates. All are
// checked even after one fails, so every error is found; the fields are None
// if any failed.
proc Fields(s: { cx: TyCx, fs: []Field, i: int, ok: bool, acc: []Member }): { cx: TyCx, ms: MaybeMembers } {
	func Done(ok: bool, ms: []Member): MaybeMembers = "sema_leaf.rs:members_if";
	Fields switch {
		(this.s.i == this.s.fs.len) -> id({ cx = this.s.cx, ms = Done(ok = this.s.ok, ms = this.s.acc) }),
		(HasMember(ms = this.s.acc, name = this.s.fs[this.s.i].name.name)) -> Ty(s = { cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = "duplicate field " + this.s.fs[this.s.i].name.name, span = this.s.fs[this.s.i].name.span }] }, t = this.s.fs[this.s.i].ty }) as Dup,
		else -> Ty(s = { cx = this.s.cx, t = this.s.fs[this.s.i].ty }) as One
	};
	Dup switch {
		{ cx = _, t = Some(t) } -> Fields(s = { cx = Dup.cx, fs = Fields.s.fs, i = Fields.s.i + 1, ok = false, acc = Fields.s.acc + [{ name = Fields.s.fs[Fields.s.i].name.name, ty = t }] }),
		else -> Fields(s = { cx = Dup.cx, fs = Fields.s.fs, i = Fields.s.i + 1, ok = false, acc = Fields.s.acc })
	};
	One switch {
		{ cx = _, t = Some(t) } -> Fields(s = { cx = One.cx, fs = Fields.s.fs, i = Fields.s.i + 1, ok = Fields.s.ok, acc = Fields.s.acc + [{ name = Fields.s.fs[Fields.s.i].name.name, ty = t }] }),
		else -> Fields(s = { cx = One.cx, fs = Fields.s.fs, i = Fields.s.i + 1, ok = false, acc = Fields.s.acc })
	};
}

// Resolves an enum's variants, each payload in turn (void for none); stops
// at the first duplicate or payload that doesn't resolve.
proc Variants(s: { cx: TyCx, vs: []Variant, i: int, acc: []Member }): { cx: TyCx, ms: MaybeMembers } {
	Variants switch {
		(this.s.i == this.s.vs.len) -> id({ cx = this.s.cx, ms = Some(this.s.acc) }),
		(HasMember(ms = this.s.acc, name = this.s.vs[this.s.i].name.name)) -> id({ cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = "duplicate variant " + this.s.vs[this.s.i].name.name, span = this.s.vs[this.s.i].name.span }] }, ms = None() }),
		else -> id(this.s.vs[this.s.i].payload) as Payload
	};
	Payload switch {
		Some(p) -> Ty(s = { cx = Variants.s.cx, t = p }) as PT,
		else -> Variants(s = { cx = Variants.s.cx, vs = Variants.s.vs, i = Variants.s.i + 1, acc = Variants.s.acc + [{ name = Variants.s.vs[Variants.s.i].name.name, ty = Prim("void") }] })
	};
	PT switch {
		{ cx = _, t = Some(t) } -> Variants(s = { cx = PT.cx, vs = Variants.s.vs, i = Variants.s.i + 1, acc = Variants.s.acc + [{ name = Variants.s.vs[Variants.s.i].name.name, ty = t }] }),
		else -> id({ cx = PT.cx, ms = None() })
	};
}

// ---- Instances ----

// Resolves `n<args>`: checks the generic exists and takes that many
// arguments, resolves them, and makes the instance the first time it's used.
// It's a typedef of its own, keyed by how it's shown (`R<int>`), whose body
// is the generic's with the arguments substituted. Guards against instances
// that never stop expanding.
proc Instance(s: { cx: TyCx, n: Ident, args: []TypeExpr, i: int, tys: []Type }): TyOut {
	Instance -> InstProblem(s = { cx = this.s.cx, name = this.s.n.name, count = this.s.args.len });
	InstProblem switch {
		Some(msg) -> id({ cx = { ..Instance.s.cx, errors = Instance.s.cx.errors + [{ msg = msg, span = Instance.s.n.span }] }, t = None() }),
		else -> InstArgs(s = { cx = Instance.s.cx, args = Instance.s.args, i = 0, tys = [] }) as Args
	};
	Args switch {
		{ cx = _, tys = Some(tys) } -> switch {
			(Instance.s.n.name in Args.cx.broken) -> id({ cx = Args.cx, t = None() }),
			else -> ShowAll(s = { ts = tys, i = 0, acc = [] })
		},
		else -> id({ cx = Args.cx, t = None() })
	};
	ShowAll -> id(Instance.s.n.name + "<" + Join(parts = this, sep = ", ") + ">") as Key;
	Key switch {
		(this in Args.cx.insts) -> id({ cx = Args.cx, t = Some(Named({ id = Args.cx.insts[this], name = this })) }),
		(Args.cx.bound.len >= 32) -> id({ cx = { ..Args.cx, errors = Args.cx.errors + [{ msg = "type " + Instance.s.n.name + " never stops expanding: it uses itself with ever larger arguments", span = Instance.s.n.span }] }, t = None() }),
		else -> IdentAll(s = { ts = TysOf(m = Args.tys), types = Args.cx.types, i = 0, acc = "" })
	};
	IdentAll -> InstBody(s = { cx = NewInst(cx = Args.cx, key = Key, ident = Instance.s.n.name + this, span = Instance.s.n.span), key = Key, n = Instance.s.n, tys = TysOf(m = Args.tys) });
}

type MaybeTypes = enum { None, Some([]Type) };
func TysOf(m: MaybeTypes): []Type = "sema_leaf.rs:unwrap_tys";

// Resolves an instance's type arguments in turn; None at the first that
// doesn't resolve, or that's void or a struct or enum written out.
proc InstArgs(s: { cx: TyCx, args: []TypeExpr, i: int, tys: []Type }): { cx: TyCx, tys: MaybeTypes } {
	func WrittenOut(t: Type): bool = "sema_leaf.rs:is_struct_or_enum";
	InstArgs switch {
		(this.s.i == this.s.args.len) -> id({ cx = this.s.cx, tys = Some(this.s.tys) }),
		else -> Ty(s = { cx = this.s.cx, t = this.s.args[this.s.i] }) as One
	};
	One switch {
		{ cx = _, t = Some(t) } -> switch {
			(IsVoid(t = t)) -> id({ cx = { ..One.cx, errors = One.cx.errors + [{ msg = "void can't be a type argument", span = InstArgs.s.args[InstArgs.s.i].span }] }, tys = None() }),
			(WrittenOut(t = t)) -> id({ cx = { ..One.cx, errors = One.cx.errors + [{ msg = "a type argument can't be a struct or enum written out: name it with a typedef", span = InstArgs.s.args[InstArgs.s.i].span }] }, tys = None() }),
			else -> InstArgs(s = { cx = One.cx, args = InstArgs.s.args, i = InstArgs.s.i + 1, tys = InstArgs.s.tys + [t] })
		},
		else -> id({ cx = One.cx, tys = None() })
	};
}

// Resolves a new instance's body: the generic's, with its parameters bound
// to the arguments, then sets it as the instance's type. cx already has the
// instance (the last typedef). Errors inside say which instance they came
// from, and a body that is only a chain of names back to itself is rejected.
proc InstBody(s: { cx: TyCx, key: string, n: Ident, tys: []Type }): TyOut {
	InstBody -> Ty(s = { cx = { ..this.s.cx, bound = this.s.cx.bound + [ParamMap(params = this.s.cx.generics[this.s.n.name].params, args = this.s.tys)] }, t = this.s.cx.generics[this.s.n.name].ty }) as Body;
	// Which instance an error in a generic body came from, said once.
	Body switch {
		(InstBody.s.cx.bound.len == 0) -> id(WithErrors(cx = { ..this.cx, bound = InstBody.s.cx.bound }, errors = InInstance(errors = this.cx.errors, from = InstBody.s.cx.errors.len, key = InstBody.s.key))) as Restore,
		else -> id({ ..this.cx, bound = InstBody.s.cx.bound }) as Restore
	};
	Restore switch {
		(IsSome(t = Body.t)) -> ChainCycle(s = { types = SetTy(types = this.types, id = InstBody.s.cx.types.len - 1, t = UnwrapT(t = Body.t)), start = InstBody.s.cx.types.len - 1, seen = [InstBody.s.cx.types.len - 1], t = UnwrapT(t = Body.t) }),
		else -> id({ cx = this, t = None() })
	};
	// A cycle of names that never reaches a structure (`type W<T> = W<T>;`)
	// would make unfolding loop; cut it here.
	ChainCycle switch {
		(this) -> id({ cx = WithTypes(cx = { ..Restore, errors = Restore.errors + [{ msg = "type " + InstBody.s.key + " refers to itself, so it must be a struct or enum", span = InstBody.s.n.span }] }, types = SetTy(types = Restore.types, id = InstBody.s.cx.types.len - 1, t = Prim("void"))), t = None() }),
		else -> id({ cx = { ..Restore, types = SetTy(types = Restore.types, id = InstBody.s.cx.types.len - 1, t = UnwrapT(t = Body.t)) }, t = Some(Named({ id = InstBody.s.cx.types.len - 1, name = InstBody.s.key })) })
	};
}

func IsSome(t: MaybeType): bool = "sema_leaf.rs:is_some";
func WithErrors(cx: TyCx, errors: []Diag): TyCx = "sema_leaf.rs:with_errors";

// Follows typedef names from `t`, through each name's definition, to see
// whether they come back to one already seen.
proc ChainCycle(s: { types: []TypeDef, start: int, seen: []int, t: Type }): bool {
	func Seen(seen: []int, x: int): bool = "sema_leaf.rs:has_int";
	ChainCycle -> id(this.s.t) as T;
	T switch {
		Named(n) -> switch {
			(Seen(seen = ChainCycle.s.seen, x = n.id)) -> id(true),
			else -> ChainCycle(s = { types = ChainCycle.s.types, start = ChainCycle.s.start, seen = ChainCycle.s.seen + [n.id], t = ChainCycle.s.types[n.id].ty })
		},
		else -> id(false)
	};
}

// Shows each of the types, as written.
proc ShowAll(s: { ts: []Type, i: int, acc: []string }): []string {
	ShowAll switch {
		(this.s.i == this.s.ts.len) -> id(this.s.acc),
		else -> ShowType(t = this.s.ts[this.s.i])
	};
	ShowType -> ShowAll(s = { ts = ShowAll.s.ts, i = ShowAll.s.i + 1, acc = ShowAll.s.acc + [this] });
}

// Names a list of types as part of an identifier, for naming instances:
// `int` -> `Int`, `[]Field` -> `FieldList`, `map[string]int` ->
// `MapStringInt`.
proc IdentAll(s: { ts: []Type, types: []TypeDef, i: int, acc: string }): string {
	IdentAll switch {
		(this.s.i == this.s.ts.len) -> id(this.s.acc),
		else -> IdentOf(s = { t = this.s.ts[this.s.i], types = this.s.types })
	};
	IdentOf -> IdentAll(s = { ts = IdentAll.s.ts, types = IdentAll.s.types, i = IdentAll.s.i + 1, acc = IdentAll.s.acc + this });
}

// Names one type as part of an identifier: a primitive or typedef
// capitalized, an array its element's name and `List`, a map `Map`, its
// key's and its value's.
proc IdentOf(s: { t: Type, types: []TypeDef }): string {
	func PrimIdent(s: string): string = "sema_leaf.rs:cap";
	IdentOf -> id(this.s.t) as T;
	T switch {
		Prim(p) -> id(PrimIdent(s = p)),
		Named(n) -> id(Cap(s = IdentOf.s.types[n.id].ident)),
		Array(e) -> IdentOf(s = { t = e, types = IdentOf.s.types }) as Elem,
		Map(m) -> IdentOf(s = { t = m.key, types = IdentOf.s.types }) as Key,
		else -> id("")
	};
	Elem -> id(this + "List");
	Key -> IdentOf(s = { t = MapValue(t = T), types = IdentOf.s.types }) as Val;
	Val -> id("Map" + Key + this);
}

func MapValue(t: Type): Type = "sema_leaf.rs:map_value";

// ---- Declaring typedefs ----

// Declares all of a program's typedefs before resolving any, so they can
// refer to each other in any order: each name is checked (not a primitive,
// not a duplicate) and either declared or kept as a generic. A foreign
// typedef is declared with its type, and can't be generic. Then it checks
// the generics, resolves the rest, rejects cycles that never reach a
// structure, and checks the foreign types and where they're used.
proc DeclareTypes(s: { cx: TyCx, decls: []TypeDecl, i: int }): TyCx {
	// Adds foreign typedef d to cx, declared and resolved at once: its type is
	// Foreign, with d's implementations.
	func NewForeign(cx: TyCx, d: TypeDecl): TyCx = "sema_leaf.rs:new_foreign";
	DeclareTypes switch {
		(this.s.i == this.s.decls.len) -> CheckGenerics(s = { cx = this.s.cx, decls = this.s.decls, i = 0 }),
		(IsPrim(name = this.s.decls[this.s.i].name.name)) -> DeclareTypes(s = { cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = this.s.decls[this.s.i].name.name + " is a built-in type", span = this.s.decls[this.s.i].name.span }] }, decls = this.s.decls, i = this.s.i + 1 }),
		(this.s.decls[this.s.i].name.name in this.s.cx.names || this.s.decls[this.s.i].name.name in this.s.cx.generics) -> DeclareTypes(s = { cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = "duplicate type " + this.s.decls[this.s.i].name.name, span = this.s.decls[this.s.i].name.span }] }, decls = this.s.decls, i = this.s.i + 1 }),
		(IsForeignDecl(d = this.s.decls[this.s.i]) && this.s.decls[this.s.i].params.len > 0) -> DeclareTypes(s = { cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = "foreign type " + this.s.decls[this.s.i].name.name + " can't be generic: its implementations name one type each", span = this.s.decls[this.s.i].params[0].span }] }, decls = this.s.decls, i = this.s.i + 1 }),
		(IsForeignDecl(d = this.s.decls[this.s.i])) -> DeclareTypes(s = { cx = NewForeign(cx = this.s.cx, d = this.s.decls[this.s.i]), decls = this.s.decls, i = this.s.i + 1 }),
		(this.s.decls[this.s.i].params.len == 0) -> DeclareTypes(s = { cx = NewDef(cx = this.s.cx, name = this.s.decls[this.s.i].name.name, ident = this.s.decls[this.s.i].name.name, span = this.s.decls[this.s.i].name.span), decls = this.s.decls, i = this.s.i + 1 }),
		else -> DeclareTypes(s = { cx = { ..this.s.cx, generics = this.s.cx.generics + [this.s.decls[this.s.i].name.name: this.s.decls[this.s.i]] }, decls = this.s.decls, i = this.s.i + 1 })
	};
	CheckGenerics -> ResolveDecls(s = { cx = this, decls = DeclareTypes.s.decls, i = 0, ok = [] });
	ResolveDecls switch {
		(this.errors.len == 0) -> CheckTypedefs(s = { cx = this, from = 0 }),
		else -> id(this)
	};
	CheckTypedefs switch {
		(this.errors.len == 0) -> ForeignRefs(s = { cx = this, decls = DeclareTypes.s.decls, i = 0 }),
		else -> id(this)
	};
	ForeignRefs -> ForeignTypedefs(s = { cx = this, from = 0 });
}

// Checks each foreign typedef's implementations: a Go one names a type as Go
// writes it (`T`, `*T`, `pkg.T`, `*pkg.T`), a Rust one a path (`T`,
// `a::T`).
proc ForeignRefs(s: { cx: TyCx, decls: []TypeDecl, i: int }): TyCx {
	func Imps(d: TypeDecl): []ImplRef = "sema_leaf.rs:foreign_decl_imps";
	ForeignRefs switch {
		(this.s.i == this.s.decls.len) -> id(this.s.cx),
		(!IsForeignDecl(d = this.s.decls[this.s.i])) -> ForeignRefs(s = { ..this.s, i = this.s.i + 1 }),
		else -> RefProblems(s = { cx = this.s.cx, name = this.s.decls[this.s.i].name.name, imps = Imps(d = this.s.decls[this.s.i]), j = 0 })
	};
	RefProblems -> ForeignRefs(s = { ..ForeignRefs.s, cx = this, i = ForeignRefs.s.i + 1 });
}

// Reports each of a foreign type's implementations that its backend can't
// name, at the implementation.
proc RefProblems(s: { cx: TyCx, name: string, imps: []ImplRef, j: int }): TyCx {
	// Explains why foreign type `name`'s implementation imp can't be its
	// backend's type, or "" if it can.
	func RefProblem(name: string, imp: ImplRef): string = "sema_leaf.rs:foreign_ref_problem";
	RefProblems switch {
		(this.s.j == this.s.imps.len) -> id(this.s.cx),
		(RefProblem(name = this.s.name, imp = this.s.imps[this.s.j]) != "") -> RefProblems(s = { ..this.s, cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = RefProblem(name = this.s.name, imp = this.s.imps[this.s.j]), span = this.s.imps[this.s.j].span }] }, j = this.s.j + 1 }),
		else -> RefProblems(s = { ..this.s, j = this.s.j + 1 })
	};
}

// Reports each typedef from `from` on whose structure holds a foreign type
// (in a field, an element, a map's value or a payload, written out or
// through a typedef), at the typedef: foreign values are only passed
// directly.
proc ForeignTypedefs(s: { cx: TyCx, from: int }): TyCx {
	ForeignTypedefs switch {
		(this.s.from == this.s.cx.types.len) -> id(this.s.cx),
		else -> ForeignHeld(s = { cx = this.s.cx, t = this.s.cx.types[this.s.from].ty, shown = this.s.cx.types[this.s.from].name, span = this.s.cx.spans[this.s.from] })
	};
	ForeignHeld -> ForeignTypedefs(s = { cx = this, from = ForeignTypedefs.s.from + 1 });
}

// Reports t, shown as `shown`, at span if a foreign type is inside it: in a
// struct's field, an array's element, a map's key or value or a variant's
// payload, through structures written out but not other typedefs (each
// checked on its own).
proc ForeignHeld(s: { cx: TyCx, t: Type, shown: string, span: Span }): TyCx {
	// Names the first foreign type inside t (see ForeignHeld), if there is one.
	func ForeignInside(t: Type, defs: []TypeDef): MaybeStr = "sema_leaf.rs:foreign_inside";
	ForeignHeld -> ForeignInside(t = this.s.t, defs = this.s.cx.types);
	ForeignInside switch {
		Some(f) -> id({ ..ForeignHeld.s.cx, errors = ForeignHeld.s.cx.errors + [{ msg = ForeignHeld.s.shown + " holds " + f + ", a foreign type, which can't be inside a struct, array, map or enum", span = ForeignHeld.s.span }] }),
		else -> id(ForeignHeld.s.cx)
	};
}

// Checks each generic typedef where it's first declared: its parameters, and
// the names in its body.
proc CheckGenerics(s: { cx: TyCx, decls: []TypeDecl, i: int }): TyCx {
	CheckGenerics switch {
		(this.s.i == this.s.decls.len) -> id(this.s.cx),
		(this.s.decls[this.s.i].params.len > 0 && this.s.decls[this.s.i].name.name in this.s.cx.generics && this.s.cx.generics[this.s.decls[this.s.i].name.name].name.span.at == this.s.decls[this.s.i].name.span.at && this.s.cx.generics[this.s.decls[this.s.i].name.name].name.span.file == this.s.decls[this.s.i].name.span.file) -> CheckGeneric(s = { cx = this.s.cx, d = this.s.decls[this.s.i] }),
		else -> CheckGenerics(s = { cx = this.s.cx, decls = this.s.decls, i = this.s.i + 1 })
	};
	CheckGeneric -> CheckGenerics(s = { cx = this, decls = CheckGenerics.s.decls, i = CheckGenerics.s.i + 1 });
}

// Resolves the type of each typedef that isn't generic or foreign, once.
proc ResolveDecls(s: { cx: TyCx, decls: []TypeDecl, i: int, ok: []int }): TyCx {
	func Done(seen: []int, x: int): bool = "sema_leaf.rs:has_int";
	ResolveDecls switch {
		(this.s.i == this.s.decls.len) -> id(this.s.cx),
		(this.s.decls[this.s.i].params.len > 0 || !(this.s.decls[this.s.i].name.name in this.s.cx.names) || IsForeignDecl(d = this.s.decls[this.s.i])) -> ResolveDecls(s = { cx = this.s.cx, decls = this.s.decls, i = this.s.i + 1, ok = this.s.ok }),
		(Done(seen = this.s.ok, x = this.s.cx.names[this.s.decls[this.s.i].name.name])) -> ResolveDecls(s = { cx = this.s.cx, decls = this.s.decls, i = this.s.i + 1, ok = this.s.ok }),
		else -> Ty(s = { cx = this.s.cx, t = this.s.decls[this.s.i].ty })
	};
	Ty switch {
		{ cx = _, t = Some(t) } -> ResolveDecls(s = { cx = { ..Ty.cx, types = SetTy(types = Ty.cx.types, id = ResolveDecls.s.cx.names[ResolveDecls.s.decls[ResolveDecls.s.i].name.name], t = t) }, decls = ResolveDecls.s.decls, i = ResolveDecls.s.i + 1, ok = ResolveDecls.s.ok + [ResolveDecls.s.cx.names[ResolveDecls.s.decls[ResolveDecls.s.i].name.name]] }),
		else -> ResolveDecls(s = { cx = Ty.cx, decls = ResolveDecls.s.decls, i = ResolveDecls.s.i + 1, ok = ResolveDecls.s.ok })
	};
}

// Checks a generic typedef: that its parameters are new names, used in its
// body, and that the body names only parameters and types. A generic with
// errors is marked broken, so its instances don't report them again; the
// rest is checked per instance.
proc CheckGeneric(s: { cx: TyCx, d: TypeDecl }): TyCx {
	CheckGeneric -> CheckParams(s = { cx = this.s.cx, ps = this.s.d.params, i = 0, seen = [] });
	CheckParams -> CheckBody(s = { cx = this, t = CheckGeneric.s.d.ty, params = IdentNames(ids = CheckGeneric.s.d.params), used = [] }) as Body;
	Body -> Unused(s = { cx = this.cx, ps = CheckGeneric.s.d.params, used = this.used, i = 0 });
	Unused switch {
		(this.errors.len > CheckGeneric.s.cx.errors.len) -> id({ ..this, broken = this.broken + [CheckGeneric.s.d.name.name: true] }),
		else -> id(this)
	};
}

func IdentNames(ids: []Ident): []string = "sema_leaf.rs:ident_names";
func HasStr(xs: []string, x: string): bool = "sema_leaf.rs:has_str";

// Checks a generic's type parameters: no duplicates, and none named like a
// primitive or a typedef.
proc CheckParams(s: { cx: TyCx, ps: []Ident, i: int, seen: []string }): TyCx {
	CheckParams switch {
		(this.s.i == this.s.ps.len) -> id(this.s.cx),
		(HasStr(xs = this.s.seen, x = this.s.ps[this.s.i].name)) -> CheckParams(s = { cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = "duplicate type parameter " + this.s.ps[this.s.i].name, span = this.s.ps[this.s.i].span }] }, ps = this.s.ps, i = this.s.i + 1, seen = this.s.seen + [this.s.ps[this.s.i].name] }),
		(IsPrim(name = this.s.ps[this.s.i].name) || this.s.ps[this.s.i].name in this.s.cx.names || this.s.ps[this.s.i].name in this.s.cx.generics) -> CheckParams(s = { cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = "type parameter " + this.s.ps[this.s.i].name + " has the name of a type", span = this.s.ps[this.s.i].span }] }, ps = this.s.ps, i = this.s.i + 1, seen = this.s.seen + [this.s.ps[this.s.i].name] }),
		else -> CheckParams(s = { cx = this.s.cx, ps = this.s.ps, i = this.s.i + 1, seen = this.s.seen + [this.s.ps[this.s.i].name] })
	};
}

// Reports each of a generic's type parameters that its body never uses.
proc Unused(s: { cx: TyCx, ps: []Ident, used: []string, i: int }): TyCx {
	Unused switch {
		(this.s.i == this.s.ps.len) -> id(this.s.cx),
		(HasStr(xs = this.s.used, x = this.s.ps[this.s.i].name)) -> Unused(s = { cx = this.s.cx, ps = this.s.ps, used = this.s.used, i = this.s.i + 1 }),
		else -> Unused(s = { cx = { ..this.s.cx, errors = this.s.cx.errors + [{ msg = "type parameter " + this.s.ps[this.s.i].name + " is unused", span = this.s.ps[this.s.i].span }] }, ps = this.s.ps, used = this.s.used, i = this.s.i + 1 })
	};
}

type BodyCheck = { cx: TyCx, t: TypeExpr, params: []string, used: []string };

// Checks the names in a generic body: each is a parameter (recorded as used)
// or a type, and each instance used in it has the right number of arguments.
proc CheckBody(s: BodyCheck): { cx: TyCx, used: []string } {
	func Exprs(fs: []Field): []TypeExpr = "sema_leaf.rs:field_types";
	func Payloads(vs: []Variant): []TypeExpr = "sema_leaf.rs:payload_types";
	CheckBody -> id(this.s.t.kind) as Kind;
	Kind switch {
		Named(n) -> switch {
			(HasStr(xs = CheckBody.s.params, x = n.name)) -> id({ cx = CheckBody.s.cx, used = CheckBody.s.used + [n.name] }),
			else -> NameProblem(s = { cx = CheckBody.s.cx, name = n.name }) as NP
		},
		Inst(i) -> InstProblem(s = { cx = CheckBody.s.cx, name = i.name.name, count = i.args.len }) as IP,
		Array(e) -> CheckBodies(s = { cx = CheckBody.s.cx, ts = [e], params = CheckBody.s.params, used = CheckBody.s.used, i = 0 }) as Parts,
		Map(m) -> CheckBodies(s = { cx = CheckBody.s.cx, ts = [m.key, m.value], params = CheckBody.s.params, used = CheckBody.s.used, i = 0 }) as Parts,
		Struct(fs) -> CheckBodies(s = { cx = CheckBody.s.cx, ts = Exprs(fs = fs), params = CheckBody.s.params, used = CheckBody.s.used, i = 0 }) as Parts,
		Enum(vs) -> CheckBodies(s = { cx = CheckBody.s.cx, ts = Payloads(vs = vs), params = CheckBody.s.params, used = CheckBody.s.used, i = 0 }) as Parts,
		// A foreign typedef isn't generic (DeclareTypes says so).
		Foreign(_) -> id({ cx = CheckBody.s.cx, used = CheckBody.s.used })
	};
	NP switch {
		Some(msg) -> id({ cx = { ..CheckBody.s.cx, errors = CheckBody.s.cx.errors + [{ msg = msg, span = NameSpan(k = Kind) }] }, used = CheckBody.s.used }),
		else -> id({ cx = CheckBody.s.cx, used = CheckBody.s.used })
	};
	IP switch {
		Some(msg) -> CheckBodies(s = { cx = { ..CheckBody.s.cx, errors = CheckBody.s.cx.errors + [{ msg = msg, span = NameSpan(k = Kind) }] }, ts = InstArgExprs(k = Kind), params = CheckBody.s.params, used = CheckBody.s.used, i = 0 }) as Parts,
		else -> CheckBodies(s = { cx = CheckBody.s.cx, ts = InstArgExprs(k = Kind), params = CheckBody.s.params, used = CheckBody.s.used, i = 0 }) as Parts
	};
}

func NameSpan(k: TypeKind): Span = "sema_leaf.rs:name_span";
func InstArgExprs(k: TypeKind): []TypeExpr = "sema_leaf.rs:inst_args";

// Checks each of a generic body's parts in turn, gathering the parameters
// used.
proc CheckBodies(s: { cx: TyCx, ts: []TypeExpr, params: []string, used: []string, i: int }): { cx: TyCx, used: []string } {
	CheckBodies switch {
		(this.s.i == this.s.ts.len) -> id({ cx = this.s.cx, used = this.s.used }),
		else -> CheckBody(s = { cx = this.s.cx, t = this.s.ts[this.s.i], params = this.s.params, used = this.s.used })
	};
	CheckBody -> CheckBodies(s = { cx = this.cx, ts = CheckBodies.s.ts, params = CheckBodies.s.params, used = this.used, i = CheckBodies.s.i + 1 });
}

// ---- Recursion ----

// Marks which typedefs from `from` on are recursive, and rejects those that
// refer to themselves without being a struct or enum, or that name void.
proc CheckTypedefs(s: { cx: TyCx, from: int }): TyCx {
	CheckTypedefs -> NamedEdges(s = { types = this.s.cx.types, i = 0, acc = [] });
	NamedEdges -> MarkTypedefs(s = { cx = CheckTypedefs.s.cx, edges = this, id = CheckTypedefs.s.from });
}

// Goes through the typedefs from `id` on: one that reaches itself is
// recursive (an error unless it's a struct or enum), and one whose structure
// is void is an error.
proc MarkTypedefs(s: { cx: TyCx, edges: [][]int, id: int }): TyCx {
	func Structure(t: Type): bool = "sema_leaf.rs:is_struct_or_enum";
	MarkTypedefs switch {
		(this.s.id == this.s.cx.types.len) -> id(this.s.cx),
		else -> Reach(s = { edges = this.s.edges, stack = this.s.edges[this.s.id], seen = [:] })
	};
	Reach switch {
		(MarkTypedefs.s.id in this && !Structure(t = MarkTypedefs.s.cx.types[MarkTypedefs.s.id].ty)) -> MarkTypedefs(s = { cx = WithError(cx = Rec(cx = MarkTypedefs.s.cx, id = MarkTypedefs.s.id, rec = true), msg = "type " + MarkTypedefs.s.cx.types[MarkTypedefs.s.id].name + " refers to itself, so it must be a struct or enum", span = MarkTypedefs.s.cx.spans[MarkTypedefs.s.id]), edges = MarkTypedefs.s.edges, id = MarkTypedefs.s.id + 1 }),
		(MarkTypedefs.s.id in this) -> MarkTypedefs(s = { cx = Rec(cx = MarkTypedefs.s.cx, id = MarkTypedefs.s.id, rec = true), edges = MarkTypedefs.s.edges, id = MarkTypedefs.s.id + 1 }),
		else -> Unfold(s = { t = MarkTypedefs.s.cx.types[MarkTypedefs.s.id].ty, defs = MarkTypedefs.s.cx.types })
	};
	Unfold switch {
		(IsVoid(t = this)) -> MarkTypedefs(s = { cx = WithError(cx = Rec(cx = MarkTypedefs.s.cx, id = MarkTypedefs.s.id, rec = false), msg = "type " + MarkTypedefs.s.cx.types[MarkTypedefs.s.id].name + " names void", span = MarkTypedefs.s.cx.spans[MarkTypedefs.s.id]), edges = MarkTypedefs.s.edges, id = MarkTypedefs.s.id + 1 }),
		else -> MarkTypedefs(s = { cx = Rec(cx = MarkTypedefs.s.cx, id = MarkTypedefs.s.id, rec = false), edges = MarkTypedefs.s.edges, id = MarkTypedefs.s.id + 1 })
	};
}

func Rec(cx: TyCx, id: int, rec: bool): TyCx = "sema_leaf.rs:with_recursive";

// Finds, for each typedef, the typedefs its definition names directly (not
// through another typedef).
proc NamedEdges(s: { types: []TypeDef, i: int, acc: [][]int }): [][]int {
	NamedEdges switch {
		(this.s.i == this.s.types.len) -> id(this.s.acc),
		else -> NamedIn(s = { ts = [this.s.types[this.s.i].ty], acc = [] })
	};
	NamedIn -> NamedEdges(s = { types = NamedEdges.s.types, i = NamedEdges.s.i + 1, acc = NamedEdges.s.acc + [this] });
}

// Finds the typedefs the types mention, depth first, in order, without
// looking inside the typedefs themselves.
proc NamedIn(s: { ts: []Type, acc: []int }): []int {
	// Lists a type's direct parts, in order: an array's element, a map's key and
	// value, a struct's or enum's member types (what NamedIn looks inside).
	func Parts(t: Type): []Type = "sema_leaf.rs:parts";
	func NameOf(t: Type): []int = "sema_leaf.rs:name_of";
	NamedIn switch {
		(this.s.ts.len == 0) -> id(this.s.acc),
		else -> NamedIn(s = { ts = Parts(t = this.s.ts[0]) + Rest(ts = this.s.ts), acc = this.s.acc + NameOf(t = this.s.ts[0]) })
	};
}

func Rest(ts: []Type): []Type = "sema_leaf.rs:rest";

// Finds every typedef reachable from those on `stack` along `edges`, depth
// first.
proc Reach(s: { edges: [][]int, stack: []int, seen: map[int]bool }): map[int]bool {
	func Last(xs: []int): int = "sema_leaf.rs:last_int";
	func Pop(xs: []int): []int = "sema_leaf.rs:pop_int";
	Reach switch {
		(this.s.stack.len == 0) -> id(this.s.seen),
		(Last(xs = this.s.stack) in this.s.seen) -> Reach(s = { edges = this.s.edges, stack = Pop(xs = this.s.stack), seen = this.s.seen }),
		else -> Reach(s = { edges = this.s.edges, stack = Pop(xs = this.s.stack) + this.s.edges[Last(xs = this.s.stack)], seen = this.s.seen + [Last(xs = this.s.stack): true] })
	};
}

// Declares and resolves a program's typedefs, from an empty state.
proc TypesOf(decls: []TypeDecl): TyCx {
	TypesOf -> DeclareTypes(s = { cx = { types = [], spans = [], names = [:], generics = [:], broken = [:], insts = [:], bound = [], errors = [] }, decls = this.decls, i = 0 });
}
