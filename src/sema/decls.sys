// Declarations: every func, proc, interface func, id(..) and alias is a
// node; names resolve to nodes (src/sema.rs: declare_file .. resolve_node
// in the reference). Node ids are handed out in the reference's order.

type PendingProc = { id: int, p: Proc };
type PendingAlias = { lid: int, pid: int, t: Target };

// Sema's state while declaring. Errors are cx.ty.errors.
type Cx = {
	ty: TyCx,
	nodes: []NodeDecl,
	globals: map[string]Global,
	top: []int,
	// Procs whose graphs are still to be built.
	procs: []PendingProc,
	// Alias nodes to point at what they instance, once all are declared.
	aliases: []PendingAlias,
	// The node of each id(..) target, by where its `id` is.
	ids: map[string]int
};

type Declared = { cx: Cx, id: int };

func WithNode(cx: Cx, n: NodeDecl): Cx = "sema_leaf.rs:with_node";
func WithId(cx: Cx, at: string, id: int): Cx = "sema_leaf.rs:with_id";
// Turns where a span starts into a map key, "file:at", for finding the node
// an id(..) target became.
func SpanKey(s: Span): string = "sema_leaf.rs:span_key";
func WithAlias(cx: Cx, a: PendingAlias): Cx = "sema_leaf.rs:with_alias";
func WithProc(cx: Cx, p: PendingProc): Cx = "sema_leaf.rs:with_proc";
// Records proc `id`'s entry (its signature node) and its locals in cx.
func SetProc(cx: Cx, id: int, entry: int, locals: []int): Cx = "sema_leaf.rs:set_proc";
func SetAlias(cx: Cx, lid: int, of: int): Cx = "sema_leaf.rs:set_alias";
func ShowPath(p: Path): string = "sema_leaf.rs:show_path";
func QualName(n: NodeDecl): string = "sema_leaf.rs:qual_name";
func ProcRet(n: NodeDecl): Type = "sema_leaf.rs:proc_ret";
func IsAlias(n: NodeDecl): bool = "sema_leaf.rs:is_alias";

// Declares a file's interfaces, then its top-level funcs and procs.
proc DeclareFile(s: { cx: Cx, file: File }): Cx {
	DeclareFile -> DeclareIfaces(s = { cx = this.s.cx, ifaces = this.s.file.interfaces, i = 0 });
	DeclareIfaces -> DeclareTops(s = { cx = this, nodes = DeclareFile.s.file.nodes, i = 0 });
}

// Adds a top-level name to the globals, or reports it as a duplicate if it's
// taken.
proc DeclareGlobal(s: { cx: Cx, name: Ident, g: Global }): Cx {
	DeclareGlobal switch {
		(this.s.name.name in this.s.cx.globals) -> id({ ..this.s.cx, ty = { ..this.s.cx.ty, errors = this.s.cx.ty.errors + [{ msg = "duplicate name " + this.s.name.name, span = this.s.name.span }] } }),
		else -> id({ ..this.s.cx, globals = this.s.cx.globals + [this.s.name.name: this.s.g] })
	};
}

// Declares each interface: its funcs, then the interface itself as a global.
proc DeclareIfaces(s: { cx: Cx, ifaces: []Interface, i: int }): Cx {
	DeclareIfaces switch {
		(this.s.i == this.s.ifaces.len) -> id(this.s.cx),
		else -> IfaceFuncs(s = { cx = this.s.cx, iface = this.s.ifaces[this.s.i], i = 0, funcs = [:] })
	};
	IfaceFuncs -> DeclareIfaces(s = { cx = this, ifaces = DeclareIfaces.s.ifaces, i = DeclareIfaces.s.i + 1 });
}

// Declares an interface's funcs in turn, as nodes qualified by the
// interface's name, reporting duplicates; then the interface as a global
// mapping each func's name to its node.
proc IfaceFuncs(s: { cx: Cx, iface: Interface, i: int, funcs: map[string]int }): Cx {
	IfaceFuncs switch {
		(this.s.i == this.s.iface.funcs.len) -> DeclareGlobal(s = { cx = this.s.cx, name = this.s.iface.name, g = Interface(this.s.funcs) }),
		(this.s.iface.funcs[this.s.i].name.name in this.s.funcs) -> IfaceFuncs(s = { cx = { ..this.s.cx, ty = { ..this.s.cx.ty, errors = this.s.cx.ty.errors + [{ msg = "duplicate func " + this.s.iface.funcs[this.s.i].name.name + " in interface " + this.s.iface.name.name, span = this.s.iface.funcs[this.s.i].name.span }] } }, iface = this.s.iface, i = this.s.i + 1, funcs = this.s.funcs }),
		else -> DeclareFunc(s = { cx = this.s.cx, f = this.s.iface.funcs[this.s.i], qual = [this.s.iface.name.name] })
	};
	DeclareFunc switch {
		(this.id >= 0) -> IfaceFuncs(s = { cx = this.cx, iface = IfaceFuncs.s.iface, i = IfaceFuncs.s.i + 1, funcs = IfaceFuncs.s.funcs + [IfaceFuncs.s.iface.funcs[IfaceFuncs.s.i].name.name: this.id] }),
		else -> IfaceFuncs(s = { cx = this.cx, iface = IfaceFuncs.s.iface, i = IfaceFuncs.s.i + 1, funcs = IfaceFuncs.s.funcs })
	};
}

// Declares each top-level func and proc in turn, as a node and a global;
// procs are also listed as top-level.
proc DeclareTops(s: { cx: Cx, nodes: []Node, i: int }): Cx {
	DeclareTops switch {
		(this.s.i == this.s.nodes.len) -> id(this.s.cx),
		else -> id(this.s.nodes[this.s.i]) as N
	};
	N switch {
		Func(f) -> DeclareFunc(s = { cx = DeclareTops.s.cx, f = f, qual = [] }) as F,
		Proc(p) -> DeclareProc(s = { cx = DeclareTops.s.cx, p = p, qual = [], parent = -1 }) as P
	};
	F switch {
		(this.id >= 0) -> DeclareGlobal(s = { cx = this.cx, name = NodeName(n = N), g = Node(this.id) }) as G,
		else -> DeclareTops(s = { cx = this.cx, nodes = DeclareTops.s.nodes, i = DeclareTops.s.i + 1 })
	};
	P switch {
		(this.id >= 0) -> DeclareGlobal(s = { cx = { ..this.cx, top = this.cx.top + [this.id] }, name = NodeName(n = N), g = Node(this.id) }) as G,
		else -> DeclareTops(s = { cx = this.cx, nodes = DeclareTops.s.nodes, i = DeclareTops.s.i + 1 })
	};
	G -> DeclareTops(s = { cx = this, nodes = DeclareTops.s.nodes, i = DeclareTops.s.i + 1 });
}

func NodeName(n: Node): Ident = "sema_leaf.rs:node_name";

// Declares a func: resolves its parameters and its result type (void if
// none), then adds it as a node. A signature that doesn't resolve leaves the
// func undeclared (id -1), its errors reported.
proc DeclareFunc(s: { cx: Cx, f: Func, qual: []string }): Declared {
	DeclareFunc -> Fields(s = { cx = this.s.cx.ty, fs = this.s.f.params, i = 0, ok = true, acc = [] }) as Params;
	Params -> id(DeclareFunc.s.f.ret) as Ret;
	Ret switch {
		Some(t) -> Ty(s = { cx = Params.cx, t = t }) as RetTy,
		else -> FinishFunc(s = { cx = { ..DeclareFunc.s.cx, ty = Params.cx }, params = Params.ms, ret = Some(Prim("void")), f = DeclareFunc.s.f, qual = DeclareFunc.s.qual })
	};
	RetTy -> FinishFunc(s = { cx = { ..DeclareFunc.s.cx, ty = this.cx }, params = Params.ms, ret = this.t, f = DeclareFunc.s.f, qual = DeclareFunc.s.qual });
}

// Adds a func's node, if its parameters and result resolved, reporting any
// of their types that hold a foreign type; id -1 otherwise.
proc FinishFunc(s: { cx: Cx, params: MaybeMembers, ret: MaybeType, f: Func, qual: []string }): Declared {
	FinishFunc switch {
		{ s = { cx = _, params = Some(ps), ret = Some(r), f = _, qual = _ } } -> SigForeign(s = { cx = FinishFunc.s.cx.ty, fs = FinishFunc.s.f.params, ms = ps, ret = r, rspan = RetSpan(t = FinishFunc.s.f.ret, d = FinishFunc.s.f.name.span), i = 0 }),
		else -> id({ cx = FinishFunc.s.cx, id = -1 })
	};
	SigForeign -> id({ cx = { ..FinishFunc.s.cx, ty = this, nodes = FinishFunc.s.cx.nodes + [{ qual = FinishFunc.s.qual + [FinishFunc.s.f.name.name], span = FinishFunc.s.f.name.span, kind = Func({ params = UnwrapMs(m = FinishFunc.s.params), ret = UnwrapT(t = FinishFunc.s.ret), imps = FinishFunc.s.f.imps }), doc = FinishFunc.s.f.doc }] }, id = FinishFunc.s.cx.nodes.len });
}

func UnwrapMs(m: MaybeMembers): []Member = "sema_leaf.rs:unwrap_ms";
// Where a func's result type is written, or d if it has none (void).
func RetSpan(t: OptType, d: Span): Span = "sema_leaf.rs:ret_span";

// Reports each of a signature's types that holds a foreign type inside it,
// at the type as written: its parameters' (fs, resolved as ms), then its
// result's.
proc SigForeign(s: { cx: TyCx, fs: []Field, ms: []Member, ret: Type, rspan: Span, i: int }): TyCx {
	SigForeign switch {
		(this.s.i == this.s.ms.len) -> ShowType(t = this.s.ret) as RetShown,
		else -> ShowType(t = this.s.ms[this.s.i].ty)
	};
	ShowType -> ForeignHeld(s = { cx = SigForeign.s.cx, t = SigForeign.s.ms[SigForeign.s.i].ty, shown = this, span = SigForeign.s.fs[SigForeign.s.i].ty.span });
	ForeignHeld -> SigForeign(s = { ..SigForeign.s, cx = this, i = SigForeign.s.i + 1 });
	RetShown -> ForeignHeld(s = { cx = SigForeign.s.cx, t = SigForeign.s.ret, shown = this, span = SigForeign.s.rspan }) as RetHeld;
}

type ProcIn = { cx: Cx, p: Proc, qual: []string, parent: int };

// Declares a proc: resolves its result type and parameters, adds its node
// and its signature node, then its local funcs and procs, its id(..) nodes
// and its aliases. Its graph is built later, once every node is declared, so
// it's queued in cx.
proc DeclareProc(s: ProcIn): Declared {
	func EmptyGraph(n: int): Graph = "sema_leaf.rs:empty_graph";
	// Adds proc `pid`'s signature node after it: a local of the proc with the
	// proc's name (`P.P`), so `P` in the body names it.
	func WithSig(cx: Cx, p: Proc, qual: []string, pid: int, params: []Member): Cx = "sema_leaf.rs:with_sig";
	DeclareProc -> Ty(s = { cx = this.s.cx.ty, t = this.s.p.ret }) as Ret;
	Ret switch {
		{ cx = _, t = Some(r) } -> Fields(s = { cx = this.cx, fs = DeclareProc.s.p.params, i = 0, ok = true, acc = [] }) as Params,
		else -> id({ cx = { ..DeclareProc.s.cx, ty = Ret.cx }, id = -1 })
	};
	Params switch {
		{ cx = _, ms = Some(ms) } -> SigForeign(s = { cx = Params.cx, fs = DeclareProc.s.p.params, ms = ms, ret = UnwrapT(t = Ret.t), rspan = DeclareProc.s.p.ret.span, i = 0 }),
		else -> id({ cx = { ..DeclareProc.s.cx, ty = Params.cx }, id = -1 })
	};
	SigForeign -> DeclareLocals(s = {
		cx = WithSig(cx = WithNode(cx = { ..DeclareProc.s.cx, ty = this }, n = { qual = DeclareProc.s.qual + [DeclareProc.s.p.name.name], span = DeclareProc.s.p.name.span, kind = Proc({ parent = DeclareProc.s.parent, entry = -1, ret = UnwrapT(t = Ret.t), locals = [], graph = EmptyGraph(n = 0) }), doc = DeclareProc.s.p.doc }), p = DeclareProc.s.p, qual = DeclareProc.s.qual + [DeclareProc.s.p.name.name], pid = DeclareProc.s.cx.nodes.len, params = UnwrapMs(m = Params.ms)),
		p = DeclareProc.s.p, qual = DeclareProc.s.qual + [DeclareProc.s.p.name.name], id = DeclareProc.s.cx.nodes.len, i = 0, names = [DeclareProc.s.p.name.name: DeclareProc.s.cx.nodes.len + 1], locals = [DeclareProc.s.cx.nodes.len + 1]
	});
	DeclareLocals -> Targets(s = { edges = DeclareProc.s.p.edges, i = 0, acc = [] });
	Targets -> DeclareIds(s = { cx = DeclareLocals.cx, ts = this, i = 0, n = 0, qual = DeclareProc.s.qual + [DeclareProc.s.p.name.name], pid = DeclareProc.s.cx.nodes.len, names = DeclareLocals.names, named = [:], locals = DeclareLocals.locals });
	DeclareIds -> DeclareAliases(s = { cx = this.cx, ts = Targets, i = 0, p = DeclareProc.s.p, qual = DeclareProc.s.qual + [DeclareProc.s.p.name.name], pid = DeclareProc.s.cx.nodes.len, names = this.names, aliased = [:], locals = this.locals });
	DeclareAliases -> id({ cx = WithProc(cx = SetProc(cx = this.cx, id = DeclareProc.s.cx.nodes.len, entry = DeclareProc.s.cx.nodes.len + 1, locals = this.locals), p = { id = DeclareProc.s.cx.nodes.len, p = DeclareProc.s.p }), id = DeclareProc.s.cx.nodes.len });
}

type Locals = { cx: Cx, names: map[string]int, locals: []int };

// Declares a proc's local funcs and nested procs in turn, each a local of
// the proc, reporting names declared twice.
proc DeclareLocals(s: { cx: Cx, p: Proc, qual: []string, id: int, i: int, names: map[string]int, locals: []int }): Locals {
	DeclareLocals switch {
		(this.s.i == this.s.p.nodes.len) -> id({ cx = this.s.cx, names = this.s.names, locals = this.s.locals }),
		else -> id(this.s.p.nodes[this.s.i]) as N
	};
	N switch {
		Func(f) -> DeclareFunc(s = { cx = DeclareLocals.s.cx, f = f, qual = DeclareLocals.s.qual }) as DF,
		Proc(sub) -> DeclareProc(s = { cx = DeclareLocals.s.cx, p = sub, qual = DeclareLocals.s.qual, parent = DeclareLocals.s.id }) as DP
	};
	DF -> id(this) as D;
	DP -> id(this) as D;
	D switch {
		(this.id < 0) -> DeclareLocals(s = { cx = this.cx, p = DeclareLocals.s.p, qual = DeclareLocals.s.qual, id = DeclareLocals.s.id, i = DeclareLocals.s.i + 1, names = DeclareLocals.s.names, locals = DeclareLocals.s.locals }),
		(NodeName(n = N).name in DeclareLocals.s.names) -> DeclareLocals(s = { cx = { ..this.cx, ty = { ..this.cx.ty, errors = this.cx.ty.errors + [{ msg = "duplicate name " + NodeName(n = N).name + " in proc " + DeclareLocals.s.p.name.name, span = NodeName(n = N).span }] } }, p = DeclareLocals.s.p, qual = DeclareLocals.s.qual, id = DeclareLocals.s.id, i = DeclareLocals.s.i + 1, names = DeclareLocals.s.names + [NodeName(n = N).name: this.id], locals = DeclareLocals.s.locals + [this.id] }),
		else -> DeclareLocals(s = { cx = this.cx, p = DeclareLocals.s.p, qual = DeclareLocals.s.qual, id = DeclareLocals.s.id, i = DeclareLocals.s.i + 1, names = DeclareLocals.s.names + [NodeName(n = N).name: this.id], locals = DeclareLocals.s.locals + [this.id] })
	};
}

// Lists the edges' call targets, in order, each switch's depth first and
// each spawn's branches before its join.
proc Targets(s: { edges: []Edge, i: int, acc: []Target }): []Target {
	Targets switch {
		(this.s.i == this.s.edges.len) -> id(this.s.acc),
		else -> id(this.s.edges[this.s.i].kind) as K
	};
	K switch {
		Call(t) -> Targets(s = { edges = Targets.s.edges, i = Targets.s.i + 1, acc = Targets.s.acc + [t] }),
		Collect(c) -> Targets(s = { edges = Targets.s.edges, i = Targets.s.i + 1, acc = Targets.s.acc + [c.target] }),
		ForEach(f) -> Targets(s = { edges = Targets.s.edges, i = Targets.s.i + 1, acc = Targets.s.acc + [f.target] }),
		Spawn(sp) -> Targets(s = { edges = Targets.s.edges, i = Targets.s.i + 1, acc = Targets.s.acc + SpawnTargets(branches = sp.branches, join = sp.join) }),
		Match(arms) -> ArmTargets(s = { stack = [arms], acc = Targets.s.acc })
	};
	ArmTargets -> Targets(s = { edges = Targets.s.edges, i = Targets.s.i + 1, acc = this });
}

// Lists a spawn's targets as written: the branches', then the join's.
func SpawnTargets(branches: []Branch, join: Target): []Target = "sema_leaf.rs:spawn_targets";

// Lists the targets of switch arms, depth first: `stack` holds the arm lists
// still to visit, innermost last.
proc ArmTargets(s: { stack: [][]Arm, acc: []Target }): []Target {
	func Top(stack: [][]Arm): []Arm = "sema_leaf.rs:top_arms";
	func Popped(stack: [][]Arm): [][]Arm = "sema_leaf.rs:pop_arms";
	ArmTargets switch {
		(this.s.stack.len == 0) -> id(this.s.acc),
		(Top(stack = this.s.stack).len == 0) -> ArmTargets(s = { stack = Popped(stack = this.s.stack), acc = this.s.acc }),
		else -> id(Top(stack = this.s.stack)[0].body) as B
	};
	// Visit the first arm, then the rest of its list.
	B switch {
		Call(t) -> ArmTargets(s = { stack = Popped(stack = ArmTargets.s.stack) + [RestArms(arms = Top(stack = ArmTargets.s.stack))], acc = ArmTargets.s.acc + [t] }),
		Switch(sw) -> ArmTargets(s = { stack = Popped(stack = ArmTargets.s.stack) + [RestArms(arms = Top(stack = ArmTargets.s.stack)), sw.arms], acc = ArmTargets.s.acc })
	};
}

func RestArms(arms: []Arm): []Arm = "sema_leaf.rs:rest_arms";

type IdsOut = { cx: Cx, names: map[string]int, locals: []int };

// Declares a node for each id(..) target: P.id1, P.id2, ... for bare ones,
// and node N for `id(..) as N`, the same one for every target named N. An
// `as N` clashing with another node is reported. The type of N is found
// later, with the graph's.
proc DeclareIds(s: { cx: Cx, ts: []Target, i: int, n: int, qual: []string, pid: int, names: map[string]int, named: map[string]bool, locals: []int }): IdsOut {
	func IsId(t: Target): bool = "sema_leaf.rs:is_id";
	func AliasOf(t: Target): OptIdent = "sema_leaf.rs:alias_of";
	DeclareIds switch {
		(this.s.i == this.s.ts.len) -> id({ cx = this.s.cx, names = this.s.names, locals = this.s.locals }),
		(!IsId(t = this.s.ts[this.s.i])) -> DeclareIds(s = { ..this.s, i = this.s.i + 1 }),
		else -> AliasOf(t = this.s.ts[this.s.i])
	};
	AliasOf switch {
		Some(a) -> switch {
			(a.name in DeclareIds.s.named) -> DeclareIds(s = { ..DeclareIds.s, cx = WithId(cx = DeclareIds.s.cx, at = SpanKey(s = DeclareIds.s.ts[DeclareIds.s.i].node.span), id = DeclareIds.s.names[a.name]), i = DeclareIds.s.i + 1 }),
			(a.name in DeclareIds.s.names) -> DeclareIds(s = { ..DeclareIds.s, cx = { ..DeclareIds.s.cx, ty = { ..DeclareIds.s.cx.ty, errors = DeclareIds.s.cx.ty.errors + [{ msg = "id(..) as " + a.name + " clashes with a node of that name in proc " + DeclareIds.s.qual[DeclareIds.s.qual.len - 1], span = a.span }] } }, i = DeclareIds.s.i + 1 }),
			else -> DeclareIds(s = {
				..DeclareIds.s,
				cx = WithId(cx = { ..DeclareIds.s.cx, nodes = DeclareIds.s.cx.nodes + [{ qual = DeclareIds.s.qual + [a.name], span = a.span, kind = Id([]), doc = "" }] }, at = SpanKey(s = DeclareIds.s.ts[DeclareIds.s.i].node.span), id = DeclareIds.s.cx.nodes.len),
				i = DeclareIds.s.i + 1, names = DeclareIds.s.names + [a.name: DeclareIds.s.cx.nodes.len], named = DeclareIds.s.named + [a.name: true], locals = DeclareIds.s.locals + [DeclareIds.s.cx.nodes.len]
			})
		},
		else -> DeclareIds(s = {
			..DeclareIds.s,
			cx = WithId(cx = { ..DeclareIds.s.cx, nodes = DeclareIds.s.cx.nodes + [{ qual = DeclareIds.s.qual + ["id" + Itoa(i = DeclareIds.s.n + 1)], span = DeclareIds.s.ts[DeclareIds.s.i].node.span, kind = Id([{ name = "value", ty = ProcRet(n = DeclareIds.s.cx.nodes[DeclareIds.s.pid]) }]), doc = "" }] }, at = SpanKey(s = DeclareIds.s.ts[DeclareIds.s.i].node.span), id = DeclareIds.s.cx.nodes.len),
			i = DeclareIds.s.i + 1, n = DeclareIds.s.n + 1, locals = DeclareIds.s.locals + [DeclareIds.s.cx.nodes.len]
		})
	};
}

// Declares a node for each aliased call (`-> B(..) as B2`): B2 the first
// time, a local of the proc; later targets `as B2` must instance the same
// node. Clashes with other names are reported.
proc DeclareAliases(s: { cx: Cx, ts: []Target, i: int, p: Proc, qual: []string, pid: int, names: map[string]int, aliased: map[string]string, locals: []int }): Locals {
	func IsId(t: Target): bool = "sema_leaf.rs:is_id";
	func AliasOf(t: Target): OptIdent = "sema_leaf.rs:alias_of";
	DeclareAliases switch {
		(this.s.i == this.s.ts.len) -> id({ cx = this.s.cx, names = this.s.names, locals = this.s.locals }),
		(IsId(t = this.s.ts[this.s.i])) -> DeclareAliases(s = { cx = this.s.cx, ts = this.s.ts, i = this.s.i + 1, p = this.s.p, qual = this.s.qual, pid = this.s.pid, names = this.s.names, aliased = this.s.aliased, locals = this.s.locals }),
		else -> AliasOf(t = this.s.ts[this.s.i])
	};
	AliasOf switch {
		Some(a) -> switch {
			(a.name in DeclareAliases.s.aliased && DeclareAliases.s.aliased[a.name] == ShowPath(p = DeclareAliases.s.ts[DeclareAliases.s.i].node)) -> DeclareAliases(s = { cx = DeclareAliases.s.cx, ts = DeclareAliases.s.ts, i = DeclareAliases.s.i + 1, p = DeclareAliases.s.p, qual = DeclareAliases.s.qual, pid = DeclareAliases.s.pid, names = DeclareAliases.s.names, aliased = DeclareAliases.s.aliased, locals = DeclareAliases.s.locals }),
			(a.name in DeclareAliases.s.aliased) -> DeclareAliases(s = { cx = { ..DeclareAliases.s.cx, ty = { ..DeclareAliases.s.cx.ty, errors = DeclareAliases.s.cx.ty.errors + [{ msg = a.name + " is already an alias of " + DeclareAliases.s.aliased[a.name], span = a.span }] } }, ts = DeclareAliases.s.ts, i = DeclareAliases.s.i + 1, p = DeclareAliases.s.p, qual = DeclareAliases.s.qual, pid = DeclareAliases.s.pid, names = DeclareAliases.s.names, aliased = DeclareAliases.s.aliased, locals = DeclareAliases.s.locals }),
			(a.name in DeclareAliases.s.names) -> DeclareAliases(s = { cx = { ..DeclareAliases.s.cx, ty = { ..DeclareAliases.s.cx.ty, errors = DeclareAliases.s.cx.ty.errors + [{ msg = "alias " + a.name + " clashes with a node of that name in proc " + DeclareAliases.s.p.name.name, span = a.span }] } }, ts = DeclareAliases.s.ts, i = DeclareAliases.s.i + 1, p = DeclareAliases.s.p, qual = DeclareAliases.s.qual, pid = DeclareAliases.s.pid, names = DeclareAliases.s.names, aliased = DeclareAliases.s.aliased, locals = DeclareAliases.s.locals }),
			else -> DeclareAliases(s = {
				cx = WithAlias(cx = { ..DeclareAliases.s.cx, nodes = DeclareAliases.s.cx.nodes + [{ qual = DeclareAliases.s.qual + [a.name], span = a.span, kind = Alias(-1), doc = "" }] }, a = { lid = DeclareAliases.s.cx.nodes.len, pid = DeclareAliases.s.pid, t = DeclareAliases.s.ts[DeclareAliases.s.i] }),
				ts = DeclareAliases.s.ts, i = DeclareAliases.s.i + 1, p = DeclareAliases.s.p, qual = DeclareAliases.s.qual, pid = DeclareAliases.s.pid,
				names = DeclareAliases.s.names + [a.name: DeclareAliases.s.cx.nodes.len], aliased = DeclareAliases.s.aliased + [a.name: ShowPath(p = DeclareAliases.s.ts[DeclareAliases.s.i].node)], locals = DeclareAliases.s.locals + [DeclareAliases.s.cx.nodes.len]
			})
		},
		else -> DeclareAliases(s = { cx = DeclareAliases.s.cx, ts = DeclareAliases.s.ts, i = DeclareAliases.s.i + 1, p = DeclareAliases.s.p, qual = DeclareAliases.s.qual, pid = DeclareAliases.s.pid, names = DeclareAliases.s.names, aliased = DeclareAliases.s.aliased, locals = DeclareAliases.s.locals })
	};
}

// Points each alias at the node it instances, once every node is declared,
// reporting one that names another alias. `-> P(..) as X` inside P instances
// P itself, not its signature node.
proc ResolveAliases(s: { cx: Cx, i: int }): Cx {
	// Finds the proc a signature node belongs to; any other node is itself.
	func SigProc(n: NodeDecl, b: int): int = "sema_leaf.rs:sig_proc";
	ResolveAliases switch {
		(this.s.i == this.s.cx.aliases.len) -> id(this.s.cx),
		else -> ResolveNode(s = { nodes = this.s.cx.nodes, globals = this.s.cx.globals, pid = this.s.cx.aliases[this.s.i].pid, path = this.s.cx.aliases[this.s.i].t.node })
	};
	ResolveNode switch {
		Ok(b) -> switch {
			(IsAlias(n = ResolveAliases.s.cx.nodes[b])) -> ResolveAliases(s = { cx = { ..ResolveAliases.s.cx, ty = { ..ResolveAliases.s.cx.ty, errors = ResolveAliases.s.cx.ty.errors + [{ msg = ShowPath(p = ResolveAliases.s.cx.aliases[ResolveAliases.s.i].t.node) + " is itself an alias; alias the node it instances", span = ResolveAliases.s.cx.aliases[ResolveAliases.s.i].t.node.span }] } }, i = ResolveAliases.s.i + 1 }),
			// `-> P(..) as X` inside P: X is a call of P, not its signature node.
			else -> ResolveAliases(s = { cx = SetAlias(cx = ResolveAliases.s.cx, lid = ResolveAliases.s.cx.aliases[ResolveAliases.s.i].lid, of = SigProc(n = ResolveAliases.s.cx.nodes[b], b = b)), i = ResolveAliases.s.i + 1 })
		},
		Err(e) -> ResolveAliases(s = { cx = { ..ResolveAliases.s.cx, ty = { ..ResolveAliases.s.cx.ty, errors = ResolveAliases.s.cx.ty.errors + [{ msg = e.msg, span = e.span }] } }, i = ResolveAliases.s.i + 1 })
	};
}

// ---- Names ----

type Lookup = { nodes: []NodeDecl, globals: map[string]Global, pid: int, path: Path };
type Resolved = enum { Ok({ n: int, rest: []Ident }), Err(Diag) };
type ResolvedNode = enum { Ok(int), Err(Diag) };

// Resolves the node a path starts at, and the rest of it (field selections).
// Lookup goes through the enclosing procs' locals, innermost first, then
// globals; `Iface.Func` names an interface func. Unknown names are errors.
proc Resolve(s: Lookup): Resolved {
	// Finds the local called `name` of proc `pid` or an enclosing proc,
	// innermost first; -1 if none.
	func Local(nodes: []NodeDecl, pid: int, name: string): int = "sema_leaf.rs:find_local";
	func Segs(ids: []Ident, from: int): []Ident = "sema_leaf.rs:segs_from";
	Resolve -> Local(nodes = this.s.nodes, pid = this.s.pid, name = this.s.path.segs[0].name);
	Local switch {
		(this >= 0) -> id(Ok({ n = this, rest = Segs(ids = Resolve.s.path.segs, from = 1) })),
		(Resolve.s.path.segs[0].name in Resolve.s.globals) -> id(Resolve.s.globals[Resolve.s.path.segs[0].name]) as G,
		else -> id(Err({ msg = "unknown node " + Resolve.s.path.segs[0].name, span = Resolve.s.path.segs[0].span }))
	};
	G switch {
		Node(n) -> id(Ok({ n = n, rest = Segs(ids = Resolve.s.path.segs, from = 1) })),
		Interface(funcs) -> switch {
			(Resolve.s.path.segs.len < 2) -> id(Err({ msg = Resolve.s.path.segs[0].name + " is an interface, not a node", span = Resolve.s.path.segs[0].span })),
			(Resolve.s.path.segs[1].name in funcs) -> id(Ok({ n = funcs[Resolve.s.path.segs[1].name], rest = Segs(ids = Resolve.s.path.segs, from = 2) })),
			else -> id(Err({ msg = "interface " + Resolve.s.path.segs[0].name + " has no func " + Resolve.s.path.segs[1].name, span = Resolve.s.path.segs[1].span }))
		}
	};
}

// Resolves a path that must name a node, with no field selections after it.
proc ResolveNode(s: Lookup): ResolvedNode {
	ResolveNode -> Resolve(s = this.s);
	Resolve switch {
		Ok(r) -> switch {
			(r.rest.len > 0) -> id(Err({ msg = QualName(n = ResolveNode.s.nodes[r.n]) + " is a node; expected a node name, not a field selection", span = r.rest[0].span })),
			else -> id(Ok(r.n))
		},
		Err(e) -> id(Err(e))
	};
}

// Declares a program: its typedefs, then (if they have no errors) its
// interfaces, funcs and procs, the instances their signatures made (none may
// hold a foreign type), and finally points aliases at what they instance.
// Graphs come later.
proc Declare(file: File): Cx {
	Declare -> TypesOf(decls = this.file.types);
	TypesOf switch {
		(this.errors.len > 0) -> id({ ty = this, nodes = [], globals = [:], top = [], procs = [], aliases = [], ids = [:] }),
		else -> DeclareFile(s = { cx = { ty = this, nodes = [], globals = [:], top = [], procs = [], aliases = [], ids = [:] }, file = Declare.file })
	};
	DeclareFile switch {
		(this.ty.errors.len == 0) -> CheckTypedefs(s = { cx = this.ty, from = TypesOf.types.len }) as Insts,
		else -> ResolveAliases(s = { cx = this, i = 0 })
	};
	Insts switch {
		(this.errors.len == 0) -> ForeignTypedefs(s = { cx = this, from = TypesOf.types.len }),
		else -> id(this) as InstsHeld
	};
	ForeignTypedefs -> id(this) as InstsHeld;
	InstsHeld -> ResolveAliases(s = { cx = { ..DeclareFile, ty = this }, i = 0 });
	ResolveAliases -> id({ ..this, ty = { ..this.ty, types = TypeDocs(types = this.ty.types, decls = Declare.file.types) } });
}

// Gives each typedef the doc of its declaration (an instance, its
// generic's).
func TypeDocs(types: []TypeDef, decls: []TypeDecl): []TypeDef = "sema_leaf.rs:type_docs";
