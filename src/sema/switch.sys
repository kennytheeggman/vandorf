// Switches: arms, patterns, and whether a pattern switch covers every value
// (src/sema.rs: switch, pat; src/exhaust.rs in the reference).

type PatOut = { p: SPat, binds: []Member };

func HeadIndex(arms: []Arm, kind: string): int = "sema_leaf.rs:head_index";
// The source text of a span, trimmed: an arm's head as written.
func Slice(src: string, span: Span): string = "sema_leaf.rs:slice";

// The arms of a switch on `src`, whose output is sc.this. Arms are all
// patterns or all conditions, `else` coming last; a pattern arm may lead to
// a nested switch of conditions, which sees its bindings.
proc Switch(s: { env: Env, sc: Scope, src: Path, arms: []Arm, span: Span, nested: bool }): Res<[]SArm> {
	Switch switch {
		(HeadIndex(arms = this.s.arms, kind = "pat") >= 0 && this.s.nested) -> id(Err({ msg = "a nested switch has nothing new to match, so its arms are conditions: (expr) -> ..", span = this.s.arms[HeadIndex(arms = this.s.arms, kind = "pat")].span })),
		(HeadIndex(arms = this.s.arms, kind = "pat") >= 0 && HeadIndex(arms = this.s.arms, kind = "cond") >= 0) -> id(Err({ msg = "this switch matches patterns (like " + Slice(src = this.s.env.srcs[this.s.arms[HeadIndex(arms = this.s.arms, kind = "pat")].span.file], span = this.s.arms[HeadIndex(arms = this.s.arms, kind = "pat")].span) + "), so its arms can't be conditions; put conditions in a switch under a pattern arm: Pat -> switch { (cond) -> .., else -> .. }", span = this.s.arms[HeadIndex(arms = this.s.arms, kind = "cond")].span })),
		else -> Arms(s = { env = this.s.env, sc = this.s.sc, src = this.s.src, arms = this.s.arms, i = 0, acc = [] })
	};
	Arms switch {
		Ok(arms) -> switch {
			(HeadIndex(arms = Switch.s.arms, kind = "pat") < 0 && !EndsInElse(arms = arms)) -> id(Err({ msg = "this switch on " + ShowPath(p = Switch.s.src) + " needs an else arm, taken when no condition holds", span = Switch.s.span })),
			(HeadIndex(arms = Switch.s.arms, kind = "pat") < 0) -> id(Ok(arms)),
			else -> Unreachable(s = { env = Switch.s.env, pats = PatsOf(arms = arms), ty = Switch.s.sc.this, i = 0, rows = [] })
		},
		Err(e) -> id(Err(e))
	};
	Unreachable switch {
		(this >= 0) -> id(Err({ msg = "this arm is never taken: the arms above already match everything it does", span = Switch.s.arms[this].span })),
		else -> Missing(s = { types = Switch.s.env.types, rows = RowsOf(pats = PatsOf(arms = UnwrapArms(r = Arms))), tys = [Switch.s.sc.this] })
	};
	Missing switch {
		Some(ws) -> switch {
			(EndsInElse(arms = UnwrapArms(r = Arms))) -> id(Arms),
			else -> Render(s = { types = Switch.s.env.types, w = ws[0], t = Switch.s.sc.this }) as Shown
		},
		else -> switch {
			(EndsInElse(arms = UnwrapArms(r = Arms))) -> id(Err({ msg = "else is never taken: the arms above cover every case", span = Switch.s.arms[Switch.s.arms.len - 1].span })),
			else -> id(Arms)
		}
	};
	Shown -> id(Err({ msg = "switch on " + ShowPath(p = Switch.s.src) + " doesn't cover " + this + "; add an arm for it, or an else", span = Switch.s.span }));
}

func EndsInElse(arms: []SArm): bool = "sema_leaf.rs:ends_in_else";
func PatsOf(arms: []SArm): []SPat = "sema_leaf.rs:pats_of";
func UnwrapArms(r: Res<[]SArm>): []SArm = "sema_leaf.rs:unwrap_arms";

proc Arms(s: { env: Env, sc: Scope, src: Path, arms: []Arm, i: int, acc: []SArm }): Res<[]SArm> {
	Arms switch {
		(this.s.i == this.s.arms.len) -> id(Ok(this.s.acc)),
		else -> id(this.s.arms[this.s.i].head) as H
	};
	H switch {
		Else() -> switch {
			(Arms.s.i + 1 < Arms.s.arms.len) -> id(Err({ msg = "this arm comes after else, so it's never taken", span = Arms.s.arms[Arms.s.i + 1].span })),
			else -> ArmBody(s = { env = Arms.s.env, sc = Arms.s.sc, src = Arms.s.src, arm = Arms.s.arms[Arms.s.i], test = Else() })
		},
		Cond(c) -> Cond(s = { env = Arms.s.env, sc = Arms.s.sc, v = c }) as C,
		Pat(p) -> CheckPat(s = { env = Arms.s.env, p = p, want = Arms.s.sc.this, binds = [] }) as P
	};
	C switch {
		Ok(c) -> ArmBody(s = { env = Arms.s.env, sc = Arms.s.sc, src = Arms.s.src, arm = Arms.s.arms[Arms.s.i], test = Cond(c) }),
		Err(e) -> id(Err(e))
	};
	P switch {
		Ok(p) -> ArmBody(s = { env = Arms.s.env, sc = { this = Arms.s.sc.this, binds = Arms.s.sc.binds + p.binds }, src = Arms.s.src, arm = Arms.s.arms[Arms.s.i], test = Pat(p.p) }),
		Err(e) -> id(Err(e))
	};
	ArmBody switch {
		Ok(a) -> Arms(s = { env = Arms.s.env, sc = Arms.s.sc, src = Arms.s.src, arms = Arms.s.arms, i = Arms.s.i + 1, acc = Arms.s.acc + [a] }),
		Err(e) -> id(Err(e))
	};
}

proc ArmBody(s: { env: Env, sc: Scope, src: Path, arm: Arm, test: Test }): Res<SArm> {
	ArmBody -> id(this.s.arm.body) as B;
	B switch {
		Call(t) -> CallOf(s = { env = ArmBody.s.env, sc = ArmBody.s.sc, t = t }),
		Switch(sw) -> Switch(s = { env = ArmBody.s.env, sc = ArmBody.s.sc, src = ArmBody.s.src, arms = sw.arms, span = sw.span, nested = true })
	};
	CallOf switch {
		Ok(c) -> id(Ok({ test = ArmBody.s.test, label = Slice(src = ArmBody.s.env.srcs[ArmBody.s.arm.span.file], span = ArmBody.s.arm.span), body = Call(c) })),
		Err(e) -> id(Err(e))
	};
	Switch switch {
		Ok(arms) -> id(Ok({ test = ArmBody.s.test, label = Slice(src = ArmBody.s.env.srcs[ArmBody.s.arm.span.file], span = ArmBody.s.arm.span), body = Switch(arms) })),
		Err(e) -> id(Err(e))
	};
}

// ---- Patterns ----

// Pattern p, checked against the type of the value it matches; its
// bindings are added to `binds`.
proc CheckPat(s: { env: Env, p: Pat, want: Type, binds: []Member }): Res<PatOut> {
	CheckPat -> Unfold(s = { t = this.s.want, defs = this.s.env.types }) as Shape;
	Shape -> id(CheckPat.s.p.kind) as K;
	K switch {
		Wild() -> id(Ok({ p = { kind = Wild(), ty = CheckPat.s.want }, binds = CheckPat.s.binds })),
		Bind(b) -> switch {
			(IsEnum(t = Shape) && HasMember(ms = MembersOf(t = Shape), name = b.name)) -> ShowType(t = CheckPat.s.want) as IsVariant,
			(b.name == "this") -> id(Err({ msg = "binding " + b.name + " hides a node or this; pick another name", span = b.span })),
			else -> Resolve(s = { nodes = CheckPat.s.env.nodes, globals = CheckPat.s.env.globals, pid = CheckPat.s.env.pid, path = { segs = [b], span = b.span } }) as Hides
		},
		Variant(v) -> switch {
			(!IsEnum(t = Shape)) -> ShowType(t = CheckPat.s.want) as NotEnum,
			(!HasMember(ms = MembersOf(t = Shape), name = v.tag.name)) -> ShowType(t = CheckPat.s.want) as NoVariant,
			else -> id(v.payload) as Q
		},
		Struct(fields) -> switch {
			(IsStruct(t = Shape)) -> PatFields(s = { env = CheckPat.s.env, want = CheckPat.s.want, fs = MembersOf(t = Shape), fields = fields, i = 0, given = [:], binds = CheckPat.s.binds, span = CheckPat.s.p.span }),
			else -> ShowType(t = CheckPat.s.want) as NotStruct
		},
		Or(alts) -> PatAlts(s = { env = CheckPat.s.env, want = CheckPat.s.want, alts = alts, i = 0, acc = [], binds = CheckPat.s.binds })
	};
	IsVariant -> id(Err({ msg = BindName(k = K).name + " is a variant of " + this + "; write " + BindName(k = K).name + VariantFix(t = UnwrapT(t = Member(ms = MembersOf(t = Shape), name = BindName(k = K).name))) + " to match it", span = BindName(k = K).span }));
	Hides switch {
		Ok(_) -> id(Err({ msg = "binding " + BindName(k = K).name + " hides a node or this; pick another name", span = BindName(k = K).span })),
		Err(_) -> switch {
			(HasMember(ms = CheckPat.s.binds, name = BindName(k = K).name)) -> id(Err({ msg = BindName(k = K).name + " is bound twice in this pattern", span = BindName(k = K).span })),
			else -> id(Ok({ p = { kind = Bind(BindName(k = K).name), ty = CheckPat.s.want }, binds = CheckPat.s.binds + [{ name = BindName(k = K).name, ty = CheckPat.s.want }] }))
		}
	};
	NotEnum -> id(Err({ msg = "this matches a " + this + ", which isn't an enum, so " + VariantTag(k = K).name + "(..) can't match it", span = VariantTag(k = K).span }));
	NoVariant -> id(Err({ msg = this + " has no variant " + VariantTag(k = K).name, span = VariantTag(k = K).span }));
	NotStruct -> id(Err({ msg = "this matches a " + this + ", which isn't a struct", span = CheckPat.s.p.span }));
	Q switch {
		Some(q) -> switch {
			(IsVoid(t = UnwrapT(t = Member(ms = MembersOf(t = Shape), name = VariantTag(k = K).name)))) -> id(Err({ msg = VariantTag(k = K).name + " carries nothing; write " + VariantTag(k = K).name + "()", span = q.span })),
			else -> CheckPat(s = { env = CheckPat.s.env, p = q, want = UnwrapT(t = Member(ms = MembersOf(t = Shape), name = VariantTag(k = K).name)), binds = CheckPat.s.binds }) as Payload
		},
		else -> switch {
			(IsVoid(t = UnwrapT(t = Member(ms = MembersOf(t = Shape), name = VariantTag(k = K).name)))) -> id(Ok({ p = { kind = Variant({ tag = VariantTag(k = K).name, payload = None() }), ty = CheckPat.s.want }, binds = CheckPat.s.binds })),
			else -> ShowType(t = UnwrapT(t = Member(ms = MembersOf(t = Shape), name = VariantTag(k = K).name))) as Carries
		}
	};
	Carries -> id(Err({ msg = VariantTag(k = K).name + " carries " + this + "; write " + VariantTag(k = K).name + "(_) to ignore it", span = CheckPat.s.p.span }));
	Payload switch {
		Ok(x) -> id(Ok({ p = { kind = Variant({ tag = VariantTag(k = K).name, payload = Some(x.p) }), ty = CheckPat.s.want }, binds = x.binds })),
		Err(e) -> id(Err(e))
	};
}

func BindName(k: PatKind): Ident = "sema_leaf.rs:bind_name";
func VariantTag(k: PatKind): Ident = "sema_leaf.rs:variant_tag";
// How to match a variant: `()` for one without payload, `(_)` otherwise.
func VariantFix(t: Type): string = "sema_leaf.rs:variant_fix";

proc PatFields(s: { env: Env, want: Type, fs: []Member, fields: []PatField, i: int, given: map[string]SPat, binds: []Member, span: Span }): Res<PatOut> {
	PatFields switch {
		(this.s.i == this.s.fields.len) -> FillPatFields(s = { want = this.s.want, fs = this.s.fs, given = this.s.given, binds = this.s.binds, span = this.s.span, i = 0, acc = [] }),
		else -> Member(ms = this.s.fs, name = this.s.fields[this.s.i].name.name)
	};
	Member switch {
		Some(ft) -> CheckPat(s = { env = PatFields.s.env, p = PatFields.s.fields[PatFields.s.i].pat, want = ft, binds = PatFields.s.binds }),
		else -> ShowType(t = PatFields.s.want)
	};
	ShowType -> id(Err({ msg = this + " has no field " + PatFields.s.fields[PatFields.s.i].name.name, span = PatFields.s.fields[PatFields.s.i].name.span }));
	CheckPat switch {
		Ok(x) -> switch {
			(PatFields.s.fields[PatFields.s.i].name.name in PatFields.s.given) -> id(Err({ msg = "field " + PatFields.s.fields[PatFields.s.i].name.name + " given twice", span = PatFields.s.fields[PatFields.s.i].name.span })),
			else -> PatFields(s = { env = PatFields.s.env, want = PatFields.s.want, fs = PatFields.s.fs, fields = PatFields.s.fields, i = PatFields.s.i + 1, given = PatFields.s.given + [PatFields.s.fields[PatFields.s.i].name.name: x.p], binds = x.binds, span = PatFields.s.span })
		},
		Err(e) -> id(Err(e))
	};
}

proc FillPatFields(s: { want: Type, fs: []Member, given: map[string]SPat, binds: []Member, span: Span, i: int, acc: []PatMember }): Res<PatOut> {
	FillPatFields switch {
		(this.s.i == this.s.fs.len) -> id(Ok({ p = { kind = Struct(this.s.acc), ty = this.s.want }, binds = this.s.binds })),
		(this.s.fs[this.s.i].name in this.s.given) -> FillPatFields(s = { want = this.s.want, fs = this.s.fs, given = this.s.given, binds = this.s.binds, span = this.s.span, i = this.s.i + 1, acc = this.s.acc + [{ name = this.s.fs[this.s.i].name, pat = this.s.given[this.s.fs[this.s.i].name] }] }),
		else -> ShowType(t = this.s.want)
	};
	ShowType -> id(Err({ msg = "struct pattern is missing field " + FillPatFields.s.fs[FillPatFields.s.i].name + " of " + this + "; write " + FillPatFields.s.fs[FillPatFields.s.i].name + " = _ to ignore it", span = FillPatFields.s.span }));
}

proc PatAlts(s: { env: Env, want: Type, alts: []Pat, i: int, acc: []SPat, binds: []Member }): Res<PatOut> {
	PatAlts switch {
		(this.s.i == this.s.alts.len) -> id(Ok({ p = { kind = Or(this.s.acc), ty = this.s.want }, binds = this.s.binds })),
		else -> CheckPat(s = { env = this.s.env, p = this.s.alts[this.s.i], want = this.s.want, binds = [] })
	};
	CheckPat switch {
		Ok(x) -> switch {
			(x.binds.len > 0) -> id(Err({ msg = "or-patterns can't bind names yet (" + x.binds[0].name + ")", span = PatAlts.s.alts[PatAlts.s.i].span })),
			else -> PatAlts(s = { env = PatAlts.s.env, want = PatAlts.s.want, alts = PatAlts.s.alts, i = PatAlts.s.i + 1, acc = PatAlts.s.acc + [x.p], binds = PatAlts.s.binds })
		},
		Err(e) -> id(Err(e))
	};
}

// ---- Exhaustiveness ----
//
// The pattern-matrix algorithm (Maranget, "Warnings for pattern matching"):
// a pattern is useful after some rows if a value matches it but no row, and
// a switch is exhaustive if a wildcard isn't useful after all its arms.
// Enums have one constructor per variant, structs a single one ("{}"), and
// other types none that patterns can name.

// A pattern with bindings erased.
type P = enum { Wild, Ctor({ c: string, args: []P }), Or([]P) };
// A value no row matches, for messages.
type W = enum { Wild, Ctor({ c: string, args: []W }) };
type MaybeW = enum { None, Some([]W) };
type Ctor = { c: string, args: []Type };

func RowsOf(pats: []SPat): [][]P = "sema_leaf.rs:rows_of";
// Rows matching constructor c with `arity` arguments, the first column
// replaced by its arguments.
func Specialize(rows: [][]P, c: string, arity: int): [][]P = "sema_leaf.rs:specialize";
// Rows whose first column is a wildcard, without it.
func Default(rows: [][]P): [][]P = "sema_leaf.rs:default_rows";
// The constructors the first column names.
func Used(rows: [][]P): []string = "sema_leaf.rs:used";
// The constructors of an unfolded type and their argument types; none for
// types patterns can't take apart.
func Ctors(t: Type): []Ctor = "sema_leaf.rs:ctors";
func AllUsed(cs: []Ctor, used: []string): bool = "sema_leaf.rs:all_used";
func Wilds(n: int): []P = "sema_leaf.rs:wilds";
func RestP(ps: []P): []P = "sema_leaf.rs:rest_p";
func RestT(ts: []Type): []Type = "sema_leaf.rs:rest";

// The first arm that can never match because the arms above cover it, or -1.
proc Unreachable(s: { env: Env, pats: []SPat, ty: Type, i: int, rows: [][]P }): int {
	Unreachable switch {
		(this.s.i == this.s.pats.len) -> id(-1),
		else -> Useful(s = { types = this.s.env.types, rows = this.s.rows, q = RowsOf(pats = [this.s.pats[this.s.i]])[0], tys = [this.s.ty] })
	};
	Useful switch {
		(this) -> Unreachable(s = { env = Unreachable.s.env, pats = Unreachable.s.pats, ty = Unreachable.s.ty, i = Unreachable.s.i + 1, rows = Unreachable.s.rows + RowsOf(pats = [Unreachable.s.pats[Unreachable.s.i]]) }),
		else -> id(Unreachable.s.i)
	};
}

type UsefulIn = { types: []TypeDef, rows: [][]P, q: []P, tys: []Type };

// Is there a value matching q but no row?
proc Useful(s: UsefulIn): bool {
	Useful switch {
		(this.s.q.len == 0) -> id(this.s.rows.len == 0),
		else -> id(this.s.q[0]) as First
	};
	First switch {
		Or(alts) -> AnyUseful(s = { types = Useful.s.types, rows = Useful.s.rows, alts = alts, rest = RestP(ps = Useful.s.q), tys = Useful.s.tys, i = 0 }),
		Ctor(c) -> Unfold(s = { t = Useful.s.tys[0], defs = Useful.s.types }) as CShape,
		Wild() -> Unfold(s = { t = Useful.s.tys[0], defs = Useful.s.types }) as WShape
	};
	CShape -> Useful(s = { types = Useful.s.types, rows = Specialize(rows = Useful.s.rows, c = CtorOf(p = First).c, arity = CtorOf(p = First).args.len), q = CtorOf(p = First).args + RestP(ps = Useful.s.q), tys = CtorArgs(cs = Ctors(t = this), c = CtorOf(p = First).c) + RestT(ts = Useful.s.tys) }) as Spec;
	WShape switch {
		(Ctors(t = this).len > 0 && AllUsed(cs = Ctors(t = this), used = Used(rows = Useful.s.rows))) -> AnyCtorUseful(s = { types = Useful.s.types, rows = Useful.s.rows, cs = Ctors(t = this), rest = RestP(ps = Useful.s.q), tys = Useful.s.tys, i = 0 }),
		else -> Useful(s = { types = Useful.s.types, rows = Default(rows = Useful.s.rows), q = RestP(ps = Useful.s.q), tys = RestT(ts = Useful.s.tys) }) as Def
	};
}

func CtorOf(p: P): { c: string, args: []P } = "sema_leaf.rs:ctor_of";
func CtorArgs(cs: []Ctor, c: string): []Type = "sema_leaf.rs:ctor_args";

proc AnyUseful(s: { types: []TypeDef, rows: [][]P, alts: []P, rest: []P, tys: []Type, i: int }): bool {
	AnyUseful switch {
		(this.s.i == this.s.alts.len) -> id(false),
		else -> Useful(s = { types = this.s.types, rows = this.s.rows, q = [this.s.alts[this.s.i]] + this.s.rest, tys = this.s.tys })
	};
	Useful switch {
		(this) -> id(true),
		else -> AnyUseful(s = { types = AnyUseful.s.types, rows = AnyUseful.s.rows, alts = AnyUseful.s.alts, rest = AnyUseful.s.rest, tys = AnyUseful.s.tys, i = AnyUseful.s.i + 1 })
	};
}

proc AnyCtorUseful(s: { types: []TypeDef, rows: [][]P, cs: []Ctor, rest: []P, tys: []Type, i: int }): bool {
	AnyCtorUseful switch {
		(this.s.i == this.s.cs.len) -> id(false),
		else -> Useful(s = { types = this.s.types, rows = Specialize(rows = this.s.rows, c = this.s.cs[this.s.i].c, arity = this.s.cs[this.s.i].args.len), q = Wilds(n = this.s.cs[this.s.i].args.len) + this.s.rest, tys = this.s.cs[this.s.i].args + RestT(ts = this.s.tys) })
	};
	Useful switch {
		(this) -> id(true),
		else -> AnyCtorUseful(s = { types = AnyCtorUseful.s.types, rows = AnyCtorUseful.s.rows, cs = AnyCtorUseful.s.cs, rest = AnyCtorUseful.s.rest, tys = AnyCtorUseful.s.tys, i = AnyCtorUseful.s.i + 1 })
	};
}

type MissingIn = { types: []TypeDef, rows: [][]P, tys: []Type };

// Values (one per column) that no row matches, if any.
proc Missing(s: MissingIn): MaybeW {
	Missing switch {
		(this.s.tys.len == 0 && this.s.rows.len == 0) -> id(Some([])),
		(this.s.tys.len == 0) -> id(None()),
		else -> Unfold(s = { t = this.s.tys[0], defs = this.s.types })
	};
	Unfold switch {
		(Ctors(t = this).len > 0 && AllUsed(cs = Ctors(t = this), used = Used(rows = Missing.s.rows))) -> FirstMissing(s = { types = Missing.s.types, rows = Missing.s.rows, cs = Ctors(t = this), tys = Missing.s.tys, i = 0 }),
		else -> Missing(s = { types = Missing.s.types, rows = Default(rows = Missing.s.rows), tys = RestT(ts = Missing.s.tys) }) as Rest
	};
	// Some constructor no row names, or any value of a type without
	// constructors.
	Rest switch {
		Some(ws) -> id(Some([UnnamedCtor(cs = Ctors(t = Unfold), used = Used(rows = Missing.s.rows))] + ws)),
		else -> id(None())
	};
}

func UnnamedCtor(cs: []Ctor, used: []string): W = "sema_leaf.rs:unnamed_ctor";

proc FirstMissing(s: { types: []TypeDef, rows: [][]P, cs: []Ctor, tys: []Type, i: int }): MaybeW {
	func Regroup(c: string, n: int, ws: []W): []W = "sema_leaf.rs:regroup";
	FirstMissing switch {
		(this.s.i == this.s.cs.len) -> id(None()),
		else -> Missing(s = { types = this.s.types, rows = Specialize(rows = this.s.rows, c = this.s.cs[this.s.i].c, arity = this.s.cs[this.s.i].args.len), tys = this.s.cs[this.s.i].args + RestT(ts = this.s.tys) })
	};
	Missing switch {
		Some(ws) -> id(Some(Regroup(c = FirstMissing.s.cs[FirstMissing.s.i].c, n = FirstMissing.s.cs[FirstMissing.s.i].args.len, ws = ws))),
		else -> FirstMissing(s = { types = FirstMissing.s.types, rows = FirstMissing.s.rows, cs = FirstMissing.s.cs, tys = FirstMissing.s.tys, i = FirstMissing.s.i + 1 })
	};
}

// A missing value as a pattern: `_`, `{ a = _, b = Lit(_) }`, `Neg(_)`.
proc Render(s: { types: []TypeDef, w: W, t: Type }): string {
	Render -> Unfold(s = { t = this.s.t, defs = this.s.types });
	Unfold -> id(Render.s.w) as V;
	V switch {
		Wild() -> id("_"),
		Ctor(c) -> switch {
			(IsStruct(t = Unfold)) -> RenderFields(s = { types = Render.s.types, fs = MembersOf(t = Unfold), args = c.args, i = 0, acc = "" }),
			(c.args.len == 0) -> id(c.c + "()"),
			else -> Render(s = { types = Render.s.types, w = c.args[0], t = UnwrapT(t = Member(ms = MembersOf(t = Unfold), name = c.c)) }) as Payload
		}
	};
	RenderFields -> id("{ " + this + " }");
	Payload -> id(CtorName(w = V) + "(" + this + ")");
}

func CtorName(w: W): string = "sema_leaf.rs:ctor_name";

proc RenderFields(s: { types: []TypeDef, fs: []Member, args: []W, i: int, acc: string }): string {
	RenderFields switch {
		(this.s.i == this.s.fs.len || this.s.i == this.s.args.len) -> id(this.s.acc),
		else -> Render(s = { types = this.s.types, w = this.s.args[this.s.i], t = this.s.fs[this.s.i].ty })
	};
	Render -> RenderFields(s = { types = RenderFields.s.types, fs = RenderFields.s.fs, args = RenderFields.s.args, i = RenderFields.s.i + 1, acc = RenderFields.s.acc + Sep(i = RenderFields.s.i) + RenderFields.s.fs[RenderFields.s.i].name + " = " + this });
}
