// Expressions: checking a value against the type it's passed as, and the
// type of those that have their own (src/sema.rs: path_value .. args in the
// reference). The first error is the result.

type Res<T> = enum { Ok(T), Err(Diag) };
type Typed = { e: Expr, t: Type };
// What expressions can see: the program so far, and the proc they're in.
// srcs: the program's files' text, by file id.
type Env = { types: []TypeDef, nodes: []NodeDecl, globals: map[string]Global, ids: map[string]int, pid: int, srcs: []string };
// `this`, and the bindings of the switch arms around.
type Scope = { this: Type, binds: []Member };

type CheckIn = { env: Env, sc: Scope, v: Value, want: Type };
type SynthIn = { env: Env, sc: Scope, v: Value };

func IntToFloat(i: int): float = "sema_leaf.rs:int_to_float";
func IsPrimNamed(t: Type, p: string): bool = "sema_leaf.rs:is_prim_named";
func IsArray(t: Type): bool = "sema_leaf.rs:is_array";
func IsMap(t: Type): bool = "sema_leaf.rs:is_map";
func IsEnum(t: Type): bool = "sema_leaf.rs:is_enum";
func IsStruct(t: Type): bool = "sema_leaf.rs:is_struct";
// The fields of a struct or variants of an enum (none otherwise).
func MembersOf(t: Type): []Member = "sema_leaf.rs:members_of";
func ElemOf(t: Type): Type = "sema_leaf.rs:elem_of";
func KeyOf(t: Type): Type = "sema_leaf.rs:key_of";
// A map literal key as written in messages: 3, "a".
func LitKey(e: Expr): MaybeStr = "sema_leaf.rs:lit_key";
// A node's return and parameters (an alias's are those of what it instances).
func NodeRet(nodes: []NodeDecl, n: int): Type = "sema_leaf.rs:node_ret";
func NodeParams(nodes: []NodeDecl, n: int): []Member = "sema_leaf.rs:node_params";
func IsFunc(n: NodeDecl): bool = "sema_leaf.rs:is_func";
func IsUntypedId(n: NodeDecl): bool = "sema_leaf.rs:is_untyped_id";
func Prefixed(d: Diag, prefix: string): Diag = "sema_leaf.rs:prefixed";

// ---- Checking against a type ----

// Literals of structs, arrays, maps and variants take their type from
// `want`; anything else has its own type, which `want` must accept.
proc Check(s: CheckIn): Res<Expr> {
	Check -> Unfold(s = { t = this.s.want, defs = this.s.env.types }) as Shape;
	Shape -> id(Check.s.v.kind) as K;
	K switch {
		Int(i) -> switch {
			(IsPrimNamed(t = Shape, p = "float")) -> id(Ok(Float(IntToFloat(i = i)))),
			else -> CheckLit(s = Check.s)
		},
		Float(_) -> CheckLit(s = Check.s),
		Str(_) -> CheckLit(s = Check.s),
		Bool(_) -> CheckLit(s = Check.s),
		Array(items) -> switch {
			(IsArray(t = Shape)) -> CheckAll(s = { c = Check.s, items = items, want = ElemOf(t = Shape), i = 0, acc = [] }) as Items,
			else -> Expected(s = { c = Check.s, found = "an array literal" })
		},
		// `[x] + rest`, `["k": v] + m`: both sides take the expected type.
		Binary(b) -> switch {
			(b.op == "+" && (IsArray(t = Shape) || IsMap(t = Shape))) -> Check(s = { env = Check.s.env, sc = Check.s.sc, v = b.l, want = Check.s.want }) as L,
			else -> CheckSynth(s = Check.s)
		},
		Map(kvs) -> switch {
			(IsMap(t = Shape)) -> CheckEntries(s = { c = Check.s, kvs = kvs, kt = KeyOf(t = Shape), vt = MapValue(t = Shape), i = 0, seen = [], acc = [] }),
			else -> Expected(s = { c = Check.s, found = "a map literal" })
		},
		Update(u) -> CheckUpdate(s = { c = Check.s, shape = Shape, base = u.base, args = u.args }),
		Struct(args) -> switch {
			(IsStruct(t = Shape)) -> CheckFields(s = { c = Check.s, fs = MembersOf(t = Shape), args = args, i = 0, given = [:] }),
			else -> Expected(s = { c = Check.s, found = "a struct literal" })
		},
		Apply(a) -> switch {
			(a.name.segs.len == 1 && IsEnum(t = Shape) && IsSomeT(t = Member(ms = MembersOf(t = Shape), name = a.name.segs[0].name))) -> CheckVariant(s = { c = Check.s, tag = a.name.segs[0].name, vty = UnwrapT(t = Member(ms = MembersOf(t = Shape), name = a.name.segs[0].name)), args = a.args }),
			(a.name.segs.len == 1 && IsEnum(t = Shape)) -> Resolve(s = { nodes = Check.s.env.nodes, globals = Check.s.env.globals, pid = Check.s.env.pid, path = a.name }) as R,
			else -> CheckSynth(s = Check.s)
		},
		else -> CheckSynth(s = Check.s)
	};
	Items switch {
		Ok(xs) -> id(Ok(Array(xs))),
		Err(e) -> id(Err(e))
	};
	L switch {
		Ok(l) -> Check(s = { env = Check.s.env, sc = Check.s.sc, v = BinaryR(k = K), want = Check.s.want }) as RR,
		Err(e) -> id(Err(e))
	};
	RR switch {
		Ok(r) -> id(Ok(Merge({ l = UnwrapE(r = L), r = r, ty = Check.s.want }))),
		Err(e) -> id(Err(e))
	};
	R switch {
		Ok(_) -> CheckSynth(s = Check.s),
		Err(_) -> ShowType(t = Check.s.want) as NoVariant
	};
	NoVariant -> id(Err({ msg = this + " has no variant " + ApplyName(k = K).segs[0].name, span = ApplyName(k = K).span }));
}

func IsSomeT(t: MaybeType): bool = "sema_leaf.rs:is_some";
func BinaryR(k: ValueKind): Value = "sema_leaf.rs:binary_r";
func ApplyName(k: ValueKind): Path = "sema_leaf.rs:apply_name";
func UnwrapE(r: Res<Expr>): Expr = "sema_leaf.rs:unwrap_e";

// "expected <want>, found <found>"
proc Expected(s: { c: CheckIn, found: string }): Res<Expr> {
	Expected -> ShowType(t = this.s.c.want);
	ShowType -> id(Err({ msg = "expected " + this + ", found " + Expected.s.found, span = Expected.s.c.v.span }));
}

// A primitive literal, which has its own type.
proc CheckLit(s: CheckIn): Res<Expr> {
	func Article(k: ValueKind): string = "sema_leaf.rs:article";
	CheckLit -> Synth(s = { env = this.s.env, sc = this.s.sc, v = this.s.v });
	Synth switch {
		Ok(x) -> Accepts(s = { a = CheckLit.s.want, b = x.t, defs = CheckLit.s.env.types, assumed = [] }),
		Err(e) -> id(Err(e))
	};
	Accepts switch {
		(this) -> id(Ok(UnwrapTyped(r = Synth).e)),
		else -> ShowType(t = UnwrapTyped(r = Synth).t) as Found
	};
	Found -> Expected(s = { c = CheckLit.s, found = Article(k = CheckLit.s.v.kind) + " " + this + " literal" });
}

func UnwrapTyped(r: Res<Typed>): Typed = "sema_leaf.rs:unwrap_typed";

// Anything with its own type, which `want` must accept.
proc CheckSynth(s: CheckIn): Res<Expr> {
	func What(v: Value): string = "sema_leaf.rs:what";
	CheckSynth -> Synth(s = { env = this.s.env, sc = this.s.sc, v = this.s.v });
	Synth switch {
		Ok(x) -> Accepts(s = { a = CheckSynth.s.want, b = x.t, defs = CheckSynth.s.env.types, assumed = [] }),
		Err(e) -> id(Err(e))
	};
	Accepts switch {
		(this) -> id(Ok(UnwrapTyped(r = Synth).e)),
		else -> ShowType(t = UnwrapTyped(r = Synth).t) as Found
	};
	Found -> ShowType(t = CheckSynth.s.want) as Want;
	Want -> id(Err({ msg = What(v = CheckSynth.s.v) + " has type " + Found + ", but " + this + " is expected", span = CheckSynth.s.v.span }));
}

// Each item checked against `want`.
proc CheckAll(s: { c: CheckIn, items: []Value, want: Type, i: int, acc: []Expr }): Res<[]Expr> {
	CheckAll switch {
		(this.s.i == this.s.items.len) -> id(Ok(this.s.acc)),
		else -> Check(s = { env = this.s.c.env, sc = this.s.c.sc, v = this.s.items[this.s.i], want = this.s.want })
	};
	Check switch {
		Ok(x) -> CheckAll(s = { c = CheckAll.s.c, items = CheckAll.s.items, want = CheckAll.s.want, i = CheckAll.s.i + 1, acc = CheckAll.s.acc + [x] }),
		Err(e) -> id(Err(e))
	};
}

proc CheckEntries(s: { c: CheckIn, kvs: []Entry, kt: Type, vt: Type, i: int, seen: []string, acc: []ExprEntry }): Res<Expr> {
	CheckEntries switch {
		(this.s.i == this.s.kvs.len) -> id(Ok(Map(this.s.acc))),
		else -> Check(s = { env = this.s.c.env, sc = this.s.c.sc, v = this.s.kvs[this.s.i].key, want = this.s.kt }) as K
	};
	K switch {
		Ok(k) -> LitKey(e = k),
		Err(e) -> id(Err(e))
	};
	LitKey switch {
		Some(lit) -> switch {
			(HasStr(xs = CheckEntries.s.seen, x = lit)) -> id(Err({ msg = "key " + lit + " given twice", span = CheckEntries.s.kvs[CheckEntries.s.i].value.span })),
			else -> Check(s = { env = CheckEntries.s.c.env, sc = CheckEntries.s.c.sc, v = CheckEntries.s.kvs[CheckEntries.s.i].value, want = CheckEntries.s.vt }) as V
		},
		else -> Check(s = { env = CheckEntries.s.c.env, sc = CheckEntries.s.c.sc, v = CheckEntries.s.kvs[CheckEntries.s.i].value, want = CheckEntries.s.vt }) as V
	};
	V switch {
		Ok(x) -> CheckEntries(s = { c = CheckEntries.s.c, kvs = CheckEntries.s.kvs, kt = CheckEntries.s.kt, vt = CheckEntries.s.vt, i = CheckEntries.s.i + 1, seen = CheckEntries.s.seen + LitKeys(m = LitKey), acc = CheckEntries.s.acc + [{ key = UnwrapE(r = K), value = x }] }),
		Err(e) -> id(Err(e))
	};
}

func LitKeys(m: MaybeStr): []string = "sema_leaf.rs:some_strs";

// A struct literal: every field of the type, each once.
proc CheckFields(s: { c: CheckIn, fs: []Member, args: []Arg, i: int, given: map[string]Expr }): Res<Expr> {
	CheckFields switch {
		(this.s.i == this.s.args.len) -> FillFields(s = { c = this.s.c, fs = this.s.fs, given = this.s.given, i = 0, acc = [] }),
		else -> Member(ms = this.s.fs, name = this.s.args[this.s.i].name.name)
	};
	Member switch {
		Some(ft) -> Check(s = { env = CheckFields.s.c.env, sc = CheckFields.s.c.sc, v = CheckFields.s.args[CheckFields.s.i].value, want = ft }),
		else -> ShowType(t = CheckFields.s.c.want) as NoField
	};
	NoField -> id(Err({ msg = this + " has no field " + CheckFields.s.args[CheckFields.s.i].name.name, span = CheckFields.s.args[CheckFields.s.i].name.span }));
	Check switch {
		Ok(x) -> switch {
			(CheckFields.s.args[CheckFields.s.i].name.name in CheckFields.s.given) -> id(Err({ msg = "field " + CheckFields.s.args[CheckFields.s.i].name.name + " given twice", span = CheckFields.s.args[CheckFields.s.i].name.span })),
			else -> CheckFields(s = { c = CheckFields.s.c, fs = CheckFields.s.fs, args = CheckFields.s.args, i = CheckFields.s.i + 1, given = CheckFields.s.given + [CheckFields.s.args[CheckFields.s.i].name.name: x] })
		},
		Err(e) -> id(Err(e))
	};
}

proc FillFields(s: { c: CheckIn, fs: []Member, given: map[string]Expr, i: int, acc: []ExprMember }): Res<Expr> {
	FillFields switch {
		(this.s.i == this.s.fs.len) -> id(Ok(Struct(this.s.acc))),
		(this.s.fs[this.s.i].name in this.s.given) -> FillFields(s = { c = this.s.c, fs = this.s.fs, given = this.s.given, i = this.s.i + 1, acc = this.s.acc + [{ name = this.s.fs[this.s.i].name, e = this.s.given[this.s.fs[this.s.i].name] }] }),
		else -> ShowType(t = this.s.c.want)
	};
	ShowType -> id(Err({ msg = "struct literal is missing field " + FillFields.s.fs[FillFields.s.i].name + " of " + this, span = FillFields.s.c.v.span }));
}

// `Tag(..)` where an enum with that variant is expected.
proc CheckVariant(s: { c: CheckIn, tag: string, vty: Type, args: []ApplyArg }): Res<Expr> {
	func FirstName(args: []ApplyArg): OptIdent = "sema_leaf.rs:first_arg_name";
	CheckVariant -> FirstName(args = this.s.args);
	FirstName switch {
		Some(n) -> id(Err({ msg = "variant " + CheckVariant.s.tag + " takes its payload without a name: " + CheckVariant.s.tag + "(value)", span = n.span })),
		else -> switch {
			(CheckVariant.s.args.len == 0 && IsVoid(t = CheckVariant.s.vty)) -> id(Ok(Variant({ tag = CheckVariant.s.tag, payload = None() }))),
			(CheckVariant.s.args.len == 0) -> ShowType(t = CheckVariant.s.vty) as Carries,
			(CheckVariant.s.args.len == 1) -> Check(s = { env = CheckVariant.s.c.env, sc = CheckVariant.s.c.sc, v = CheckVariant.s.args[0].value, want = CheckVariant.s.vty }),
			else -> id(Err({ msg = "variant " + CheckVariant.s.tag + " takes one payload", span = CheckVariant.s.c.v.span }))
		}
	};
	Carries -> id(Err({ msg = "variant " + CheckVariant.s.tag + " carries " + this + "; write " + CheckVariant.s.tag + "(value)", span = CheckVariant.s.c.v.span }));
	// `S(this)` with a void `this` is allowed, and carries nothing.
	Check switch {
		Ok(x) -> switch {
			(IsVoid(t = CheckVariant.s.vty)) -> id(Ok(Variant({ tag = CheckVariant.s.tag, payload = None() }))),
			else -> id(Ok(Variant({ tag = CheckVariant.s.tag, payload = Some(x) })))
		},
		Err(e) -> id(Err(e))
	};
}

// ---- An expression's own type ----

proc Synth(s: SynthIn): Res<Typed> {
	Synth -> id(this.s.v.kind) as K;
	K switch {
		Ref(p) -> PathValue(s = { env = Synth.s.env, sc = Synth.s.sc, path = p }),
		Field(f) -> Synth(s = { env = Synth.s.env, sc = Synth.s.sc, v = f.e }) as FE,
		Index(x) -> Synth(s = { env = Synth.s.env, sc = Synth.s.sc, v = x.e }) as IE,
		In(x) -> Synth(s = { env = Synth.s.env, sc = Synth.s.sc, v = x.map }) as InMap,
		Int(i) -> id(Ok({ e = Int(i), t = Prim("int") })),
		Float(f) -> id(Ok({ e = Float(f), t = Prim("float") })),
		Str(s) -> id(Ok({ e = Str(s), t = Prim("string") })),
		Bool(b) -> id(Ok({ e = Bool(b), t = Prim("bool") })),
		Apply(a) -> SynthCall(s = { env = Synth.s.env, sc = Synth.s.sc, name = a.name, args = a.args }),
		// `{ ..base, .. }` has its base's type.
		Update(u) -> Synth(s = { env = Synth.s.env, sc = Synth.s.sc, v = u.base }) as UB,
		Unary(u) -> switch {
			(u.op == "!") -> Check(s = { env = Synth.s.env, sc = Synth.s.sc, v = u.e, want = Prim("bool") }) as Not,
			else -> Synth(s = { env = Synth.s.env, sc = Synth.s.sc, v = u.e }) as Neg
		},
		Binary(b) -> switch {
			(b.op == "&&" || b.op == "||") -> Check(s = { env = Synth.s.env, sc = Synth.s.sc, v = b.l, want = Prim("bool") }) as AndL,
			else -> Synth(s = { env = Synth.s.env, sc = Synth.s.sc, v = b.l }) as BL
		},
		// `{ a = .., b = .. }` with no expected type: a struct of its fields'
		// types.
		Struct(args) -> SynthFields(s = { env = Synth.s.env, sc = Synth.s.sc, args = args, i = 0, ms = [], es = [] }),
		else -> id(Err({ msg = "the type of this literal isn't known here; it can only be passed where a type is expected", span = Synth.s.v.span }))
	};
	UB switch {
		Ok(b) -> Check(s = { env = Synth.s.env, sc = Synth.s.sc, v = Synth.s.v, want = b.t }) as UC,
		Err(e) -> id(Err(e))
	};
	UC switch {
		Ok(e) -> id(Ok({ e = e, t = UnwrapTyped(r = UB).t })),
		Err(e) -> id(Err(e))
	};
	FE switch {
		Ok(x) -> Select(s = { env = Synth.s.env, e = x.e, t = x.t, name = FieldName(k = K) }),
		Err(e) -> id(Err(e))
	};
	IE switch {
		Ok(x) -> Unfold(s = { t = x.t, defs = Synth.s.env.types }) as IShape,
		Err(e) -> id(Err(e))
	};
	IShape switch {
		(IsMap(t = this)) -> Check(s = { env = Synth.s.env, sc = Synth.s.sc, v = IndexKey(k = K), want = KeyOf(t = this) }) as IK,
		(IsArray(t = this)) -> Check(s = { env = Synth.s.env, sc = Synth.s.sc, v = IndexKey(k = K), want = Prim("int") }) as IK,
		else -> ShowType(t = UnwrapTyped(r = IE).t) as NotIndexable
	};
	NotIndexable -> id(Err({ msg = "only maps and arrays can be indexed, not " + this, span = IndexOf(k = K).span }));
	IK switch {
		Ok(key) -> id(Ok({ e = Index({ e = UnwrapTyped(r = IE).e, key = key, ty = UnwrapTyped(r = IE).t }), t = IndexedValue(t = IShape) })),
		Err(e) -> id(Err(e))
	};
	InMap switch {
		Ok(x) -> Unfold(s = { t = x.t, defs = Synth.s.env.types }) as MShape,
		Err(e) -> id(Err(e))
	};
	MShape switch {
		(IsMap(t = this)) -> Check(s = { env = Synth.s.env, sc = Synth.s.sc, v = InKey(k = K), want = KeyOf(t = this) }) as InK,
		else -> ShowType(t = UnwrapTyped(r = InMap).t) as NotMap
	};
	NotMap -> id(Err({ msg = "in needs a map on the right, found " + this, span = InMapValue(k = K).span }));
	InK switch {
		Ok(key) -> id(Ok({ e = In({ key = key, map = UnwrapTyped(r = InMap).e }), t = Prim("bool") })),
		Err(e) -> id(Err(e))
	};
	Not switch {
		Ok(x) -> id(Ok({ e = Unary({ op = "!", e = x }), t = Prim("bool") })),
		Err(e) -> id(Err(e))
	};
	Neg switch {
		Ok(x) -> Unfold(s = { t = x.t, defs = Synth.s.env.types }) as NegShape,
		Err(e) -> id(Err(e))
	};
	NegShape switch {
		(IsPrimNamed(t = this, p = "int") || IsPrimNamed(t = this, p = "float")) -> id(Ok({ e = Unary({ op = "-", e = UnwrapTyped(r = Neg).e }), t = this })),
		else -> ShowType(t = UnwrapTyped(r = Neg).t) as NotNum
	};
	NotNum -> id(Err({ msg = "- needs an int or float, found " + this, span = UnaryOperand(k = K).span }));
	AndL switch {
		Ok(l) -> Check(s = { env = Synth.s.env, sc = Synth.s.sc, v = BinaryR(k = K), want = Prim("bool") }) as AndR,
		Err(e) -> id(Err(e))
	};
	AndR switch {
		Ok(r) -> id(Ok({ e = Binary({ op = BinaryOp(k = K), l = UnwrapE(r = AndL), r = r, operand = "bool" }), t = Prim("bool") })),
		Err(e) -> id(Err(e))
	};
	BL switch {
		Ok(l) -> SynthBinary(s = { env = Synth.s.env, sc = Synth.s.sc, v = Synth.s.v, op = BinaryOp(k = K), l = l, r = BinaryR(k = K) }),
		Err(e) -> id(Err(e))
	};
}

func FieldName(k: ValueKind): Ident = "sema_leaf.rs:field_name";
func IndexKey(k: ValueKind): Value = "sema_leaf.rs:index_key";
func IndexOf(k: ValueKind): Value = "sema_leaf.rs:index_of";
func InKey(k: ValueKind): Value = "sema_leaf.rs:in_key";
func InMapValue(k: ValueKind): Value = "sema_leaf.rs:in_map";
func UnaryOperand(k: ValueKind): Value = "sema_leaf.rs:unary_operand";
func BinaryOp(k: ValueKind): string = "sema_leaf.rs:binary_op";
// The value type of a map, or element type of an array.
func IndexedValue(t: Type): Type = "sema_leaf.rs:indexed_value";

// A binary operator other than && and ||, its left operand already typed.
proc SynthFields(s: { env: Env, sc: Scope, args: []Arg, i: int, ms: []Member, es: []ExprMember }): Res<Typed> {
	SynthFields switch {
		(this.s.i == this.s.args.len) -> id(Ok({ e = Struct(this.s.es), t = Struct(this.s.ms) })),
		(HasMember(ms = this.s.ms, name = this.s.args[this.s.i].name.name)) -> id(Err({ msg = "field " + this.s.args[this.s.i].name.name + " given twice", span = this.s.args[this.s.i].name.span })),
		else -> Synth(s = { env = this.s.env, sc = this.s.sc, v = this.s.args[this.s.i].value })
	};
	Synth switch {
		Ok(x) -> SynthFields(s = { ..SynthFields.s, i = SynthFields.s.i + 1, ms = SynthFields.s.ms + [{ name = SynthFields.s.args[SynthFields.s.i].name.name, ty = x.t }], es = SynthFields.s.es + [{ name = SynthFields.s.args[SynthFields.s.i].name.name, e = x.e }] }),
		Err(e) -> id(Err(Prefixed(d = e, prefix = "field " + SynthFields.s.args[SynthFields.s.i].name.name + ": ")))
	};
}

proc SynthBinary(s: { env: Env, sc: Scope, v: Value, op: string, l: Typed, r: Value }): Res<Typed> {
	SynthBinary -> Unfold(s = { t = this.s.l.t, defs = this.s.env.types }) as LShape;
	LShape switch {
		// `xs + ys`: a new array with both.
		(IsArray(t = this) && SynthBinary.s.op == "+") -> Check(s = { env = SynthBinary.s.env, sc = SynthBinary.s.sc, v = SynthBinary.s.r, want = SynthBinary.s.l.t }) as Joined,
		(IsArray(t = this)) -> id(Err({ msg = SynthBinary.s.op + " doesn't apply to arrays; + joins them", span = SynthBinary.s.v.span })),
		(IsMap(t = this) && SynthBinary.s.op == "+") -> Check(s = { env = SynthBinary.s.env, sc = SynthBinary.s.sc, v = SynthBinary.s.r, want = SynthBinary.s.l.t }) as Joined,
		(IsMap(t = this) && SynthBinary.s.op == "-") -> Check(s = { env = SynthBinary.s.env, sc = SynthBinary.s.sc, v = SynthBinary.s.r, want = Array(KeyOf(t = this)) }) as Keys,
		else -> Synth(s = { env = SynthBinary.s.env, sc = SynthBinary.s.sc, v = SynthBinary.s.r }) as R
	};
	Joined switch {
		Ok(r) -> id(Ok({ e = Merge({ l = SynthBinary.s.l.e, r = r, ty = SynthBinary.s.l.t }), t = SynthBinary.s.l.t })),
		Err(e) -> id(Err(e))
	};
	Keys switch {
		Ok(r) -> id(Ok({ e = Remove({ m = SynthBinary.s.l.e, keys = r, ty = SynthBinary.s.l.t }), t = SynthBinary.s.l.t })),
		Err(e) -> id(Err(e))
	};
	R switch {
		Ok(r) -> Unfold(s = { t = r.t, defs = SynthBinary.s.env.types }) as RShape,
		Err(e) -> id(Err(e))
	};
	RShape -> Operands(s = { op = SynthBinary.s.op, l = SynthBinary.s.l.e, lp = PrimName(t = LShape), r = UnwrapTyped(r = R).e, rp = PrimName(t = this) });
	Operands switch {
		(this.ok) -> id(Ok({ e = Binary({ op = SynthBinary.s.op, l = this.l, r = this.r, operand = this.operand }), t = OpResult(op = SynthBinary.s.op, operand = this.operand) })),
		else -> ShowType(t = SynthBinary.s.l.t) as LT
	};
	LT -> ShowType(t = UnwrapTyped(r = R).t) as RT;
	RT -> id(Err({ msg = SynthBinary.s.op + " needs two operands of the same type (" + Allowed(op = SynthBinary.s.op) + "), found " + LT + " and " + this, span = SynthBinary.s.v.span }));
}

// The primitive behind a type, or "" if it isn't one.
func PrimName(t: Type): string = "sema_leaf.rs:prim_name";
// Whether the operator applies to the two primitives, an int literal next
// to a float becoming a float.
func Operands(s: { op: string, l: Expr, lp: string, r: Expr, rp: string }): { ok: bool, op: string, l: Expr, r: Expr, operand: string } = "sema_leaf.rs:operands";
func OpResult(op: string, operand: string): Type = "sema_leaf.rs:op_result";
func Allowed(op: string): string = "sema_leaf.rs:allowed";

// `F(param = value)` in an expression: calls the func's implementation.
proc SynthCall(s: { env: Env, sc: Scope, name: Path, args: []ApplyArg }): Res<Typed> {
	func Named(args: []ApplyArg): MaybeArgs = "sema_leaf.rs:named_args";
	SynthCall -> ResolveNode(s = { nodes = this.s.env.nodes, globals = this.s.env.globals, pid = this.s.env.pid, path = this.s.name });
	ResolveNode switch {
		Ok(n) -> switch {
			(!IsFunc(n = SynthCall.s.env.nodes[n])) -> id(Err({ msg = ShowPath(p = SynthCall.s.name) + " is not a func; only funcs can be called in expressions", span = SynthCall.s.name.span })),
			(IsVoid(t = NodeRet(nodes = SynthCall.s.env.nodes, n = n))) -> id(Err({ msg = ShowPath(p = SynthCall.s.name) + " returns nothing, so it can't be used as a value", span = SynthCall.s.name.span })),
			else -> Named(args = SynthCall.s.args)
		},
		Err(e) -> switch {
			(SynthCall.s.name.segs.len == 1) -> id(Err({ msg = ShowPath(p = SynthCall.s.name) + " is neither a func nor a variant of the expected type", span = SynthCall.s.name.span })),
			else -> id(Err(e))
		}
	};
	Named switch {
		Some(given) -> Args(s = { env = SynthCall.s.env, sc = SynthCall.s.sc, target = UnwrapN(r = ResolveNode), given = given, span = SynthCall.s.name.span, i = 0, seen = [:] }),
		None(at) -> id(Err({ msg = "arguments of " + ShowPath(p = SynthCall.s.name) + " need names: " + ShowPath(p = SynthCall.s.name) + "(param = value)", span = at }))
	};
	Args switch {
		Ok(c) -> id(Ok({ e = Call(c), t = NodeRet(nodes = SynthCall.s.env.nodes, n = c.target) })),
		Err(e) -> id(Err(e))
	};
}

// The arguments, all named; or where the first one without a name is.
type MaybeArgs = enum { Some([]Arg), None(Span) };
func UnwrapN(r: ResolvedNode): int = "sema_leaf.rs:unwrap_n";

// e.name, where e has type t: a struct field, or .len, .keys, .values.
proc Select(s: { env: Env, e: Expr, t: Type, name: Ident }): Res<Typed> {
	Select -> Unfold(s = { t = this.s.t, defs = this.s.env.types });
	Unfold switch {
		(IsStruct(t = this) && IsSomeT(t = Member(ms = MembersOf(t = this), name = Select.s.name.name))) -> id(Ok({ e = Field({ e = Select.s.e, ty = Select.s.t, name = Select.s.name.name }), t = UnwrapT(t = Member(ms = MembersOf(t = this), name = Select.s.name.name)) })),
		((IsMap(t = this) || IsArray(t = this) || IsPrimNamed(t = this, p = "string")) && Select.s.name.name == "len") -> id(Ok({ e = Query({ e = Select.s.e, ty = Select.s.t, q = "len" }), t = Prim("int") })),
		(IsMap(t = this) && Select.s.name.name == "keys") -> id(Ok({ e = Query({ e = Select.s.e, ty = Select.s.t, q = "keys" }), t = Array(KeyOf(t = this)) })),
		(IsMap(t = this) && Select.s.name.name == "values") -> id(Ok({ e = Query({ e = Select.s.e, ty = Select.s.t, q = "values" }), t = Array(MapValue(t = this)) })),
		else -> ShowType(t = Select.s.t)
	};
	ShowType -> id(Err({ msg = this + " has no field " + Select.s.name.name, span = Select.s.name.span }));
}

type RefUpto = { r: Ref, rest: []Ident };

// A path's value: its struct fields as a Ref, then any .len, .keys, .values.
proc PathValue(s: { env: Env, sc: Scope, path: Path }): Res<Typed> {
	PathValue -> RefUpto(s = this.s);
	RefUpto switch {
		Ok(x) -> Selects(s = { env = PathValue.s.env, e = Ref(x.r), t = x.r.ty, rest = x.rest, i = 0 }),
		Err(e) -> id(Err(e))
	};
}

proc Selects(s: { env: Env, e: Expr, t: Type, rest: []Ident, i: int }): Res<Typed> {
	Selects switch {
		(this.s.i == this.s.rest.len) -> id(Ok({ e = this.s.e, t = this.s.t })),
		else -> Select(s = { env = this.s.env, e = this.s.e, t = this.s.t, name = this.s.rest[this.s.i] })
	};
	Select switch {
		Ok(x) -> Selects(s = { env = Selects.s.env, e = x.e, t = x.t, rest = Selects.s.rest, i = Selects.s.i + 1 }),
		Err(e) -> id(Err(e))
	};
}

// The root of a path (this, a binding or a node) and its struct fields,
// stopping at the first segment that isn't one; the rest are returned.
proc RefUpto(s: { env: Env, sc: Scope, path: Path }): Res<RefUpto> {
	func Segs(ids: []Ident, from: int): []Ident = "sema_leaf.rs:segs_from";
	RefUpto switch {
		(this.s.path.segs[0].name == "this") -> RefFields(s = { env = this.s.env, root = This(), root_ty = this.s.sc.this, bind = "", ty = this.s.sc.this, rest = Segs(ids = this.s.path.segs, from = 1), fields = [], span = this.s.path.span }),
		(HasMember(ms = this.s.sc.binds, name = this.s.path.segs[0].name)) -> RefFields(s = { env = this.s.env, root = Bind(), root_ty = UnwrapT(t = Member(ms = this.s.sc.binds, name = this.s.path.segs[0].name)), bind = this.s.path.segs[0].name, ty = UnwrapT(t = Member(ms = this.s.sc.binds, name = this.s.path.segs[0].name)), rest = Segs(ids = this.s.path.segs, from = 1), fields = [], span = this.s.path.span }),
		else -> Resolve(s = { nodes = this.s.env.nodes, globals = this.s.env.globals, pid = this.s.env.pid, path = this.s.path })
	};
	Resolve switch {
		Ok(r) -> switch {
			(IsUntypedId(n = RefUpto.s.env.nodes[r.n])) -> id(Err(Untyped(n = RefUpto.s.env.nodes[r.n], span = RefUpto.s.path.segs[0].span))),
			else -> RefFields(s = { env = RefUpto.s.env, root = Node(r.n), root_ty = NodeRet(nodes = RefUpto.s.env.nodes, n = r.n), bind = "", ty = NodeRet(nodes = RefUpto.s.env.nodes, n = r.n), rest = r.rest, fields = [], span = RefUpto.s.path.span })
		},
		Err(e) -> id(Err(e))
	};
}

// The error for using `id(..) as N` before any value passed to it has a
// type.
func Untyped(n: NodeDecl, span: Span): Diag = "sema_leaf.rs:untyped";

proc RefFields(s: { env: Env, root: Root, root_ty: Type, bind: string, ty: Type, rest: []Ident, fields: []string, span: Span }): Res<RefUpto> {
	func Segs(ids: []Ident, from: int): []Ident = "sema_leaf.rs:segs_from";
	RefFields -> Unfold(s = { t = this.s.ty, defs = this.s.env.types });
	Unfold switch {
		(RefFields.s.rest.len == 0 || !IsStruct(t = this)) -> id(Ok({ r = { root = RefFields.s.root, root_ty = RefFields.s.root_ty, bind = RefFields.s.bind, fields = RefFields.s.fields, ty = RefFields.s.ty, span = RefFields.s.span }, rest = RefFields.s.rest })),
		(IsSomeT(t = Member(ms = MembersOf(t = this), name = RefFields.s.rest[0].name))) -> RefFields(s = { env = RefFields.s.env, root = RefFields.s.root, root_ty = RefFields.s.root_ty, bind = RefFields.s.bind, ty = UnwrapT(t = Member(ms = MembersOf(t = this), name = RefFields.s.rest[0].name)), rest = Segs(ids = RefFields.s.rest, from = 1), fields = RefFields.s.fields + [RefFields.s.rest[0].name], span = RefFields.s.span }),
		else -> ShowType(t = RefFields.s.ty)
	};
	ShowType -> id(Err({ msg = this + " has no field " + RefFields.s.rest[0].name, span = RefFields.s.rest[0].span }));
}

// ---- Calls ----

type ArgsIn = { env: Env, sc: Scope, target: int, given: []Arg, span: Span, i: int, seen: map[string]Expr };

// Named arguments checked against the target's parameters.
proc Args(s: ArgsIn): Res<Call> {
	Args switch {
		(this.s.i == this.s.given.len) -> FillArgs(s = { env = this.s.env, target = this.s.target, seen = this.s.seen, span = this.s.span, ps = NodeParams(nodes = this.s.env.nodes, n = this.s.target), i = 0, acc = [] }),
		else -> Member(ms = NodeParams(nodes = this.s.env.nodes, n = this.s.target), name = this.s.given[this.s.i].name.name)
	};
	Member switch {
		Some(pty) -> Check(s = { env = Args.s.env, sc = Args.s.sc, v = Args.s.given[Args.s.i].value, want = pty }),
		else -> id(Err({ msg = QualName(n = Args.s.env.nodes[Args.s.target]) + " has no parameter " + Args.s.given[Args.s.i].name.name, span = Args.s.given[Args.s.i].name.span }))
	};
	Check switch {
		Ok(x) -> switch {
			(Args.s.given[Args.s.i].name.name in Args.s.seen) -> id(Err({ msg = "argument " + Args.s.given[Args.s.i].name.name + " given twice", span = Args.s.given[Args.s.i].name.span })),
			else -> Args(s = { env = Args.s.env, sc = Args.s.sc, target = Args.s.target, given = Args.s.given, span = Args.s.span, i = Args.s.i + 1, seen = Args.s.seen + [Args.s.given[Args.s.i].name.name: x] })
		},
		Err(e) -> id(Err(Prefixed(d = e, prefix = "argument " + Args.s.given[Args.s.i].name.name + " of " + QualName(n = Args.s.env.nodes[Args.s.target]) + ": ")))
	};
}

proc FillArgs(s: { env: Env, target: int, seen: map[string]Expr, span: Span, ps: []Member, i: int, acc: []CallArg }): Res<Call> {
	FillArgs switch {
		(this.s.i == this.s.ps.len) -> id(Ok({ target = this.s.target, args = this.s.acc, span = this.s.span, text = "" })),
		(this.s.ps[this.s.i].name in this.s.seen) -> FillArgs(s = { env = this.s.env, target = this.s.target, seen = this.s.seen, span = this.s.span, ps = this.s.ps, i = this.s.i + 1, acc = this.s.acc + [{ name = this.s.ps[this.s.i].name, param = this.s.ps[this.s.i].ty, value = this.s.seen[this.s.ps[this.s.i].name] }] }),
		else -> id(Err({ msg = "call to " + QualName(n = this.s.env.nodes[this.s.target]) + " is missing argument " + this.s.ps[this.s.i].name, span = this.s.span }))
	};
}

// The call a target makes: id(value) ends the proc with value; `as B2`
// calls the alias instance.
proc CallOf(s: { env: Env, sc: Scope, t: Target }): Res<Call> {
	func IdValue(t: Target): OptValue = "sema_leaf.rs:id_value";
	func AliasOf(t: Target): OptIdent = "sema_leaf.rs:alias_of";
	func OwnLocal(nodes: []NodeDecl, pid: int, name: string): int = "sema_leaf.rs:own_local";
	func CallTarget(nodes: []NodeDecl, pid: int, n: int): int = "sema_leaf.rs:call_target";
	CallOf -> IdValue(t = this.s.t);
	IdValue switch {
		// `id(..) as N` takes the type of the first value passed to it.
		Some(v) -> switch {
			(IsUntypedId(n = CallOf.s.env.nodes[CallOf.s.env.ids[SpanKey(s = CallOf.s.t.node.span)]])) -> Synth(s = { env = CallOf.s.env, sc = CallOf.s.sc, v = v }) as IdS,
			else -> Check(s = { env = CallOf.s.env, sc = CallOf.s.sc, v = v, want = NodeRet(nodes = CallOf.s.env.nodes, n = CallOf.s.env.ids[SpanKey(s = CallOf.s.t.node.span)]) }) as IdV
		},
		else -> AliasOf(t = CallOf.s.t)
	};
	IdS switch {
		Ok(x) -> id(Ok({ target = CallOf.s.env.ids[SpanKey(s = CallOf.s.t.node.span)], args = [{ name = "value", param = x.t, value = x.e }], span = CallOf.s.t.node.span, text = Squash(src = CallOf.s.env.srcs[CallOf.s.t.inner.file], span = CallOf.s.t.inner) })),
		Err(e) -> id(Err(Prefixed(d = e, prefix = "id: ")))
	};
	IdV switch {
		Ok(x) -> id(Ok({ target = CallOf.s.env.ids[SpanKey(s = CallOf.s.t.node.span)], args = [{ name = "value", param = NodeRet(nodes = CallOf.s.env.nodes, n = CallOf.s.env.ids[SpanKey(s = CallOf.s.t.node.span)]), value = x }], span = CallOf.s.t.node.span, text = Squash(src = CallOf.s.env.srcs[CallOf.s.t.inner.file], span = CallOf.s.t.inner) })),
		Err(e) -> id(Err(Prefixed(d = e, prefix = "id: ")))
	};
	AliasOf switch {
		Some(a) -> Args(s = { env = CallOf.s.env, sc = CallOf.s.sc, target = OwnLocal(nodes = CallOf.s.env.nodes, pid = CallOf.s.env.pid, name = a.name), given = CallOf.s.t.args, span = CallOf.s.t.node.span, i = 0, seen = [:] }) as AliasCall,
		else -> ResolveNode(s = { nodes = CallOf.s.env.nodes, globals = CallOf.s.env.globals, pid = CallOf.s.env.pid, path = CallOf.s.t.node })
	};
	ResolveNode switch {
		Ok(n) -> Args(s = { env = CallOf.s.env, sc = CallOf.s.sc, target = CallTarget(nodes = CallOf.s.env.nodes, pid = CallOf.s.env.pid, n = n), given = CallOf.s.t.args, span = CallOf.s.t.node.span, i = 0, seen = [:] }) as NodeCall,
		Err(e) -> id(Err(e))
	};
	AliasCall -> id(this) as Called;
	NodeCall -> id(this) as Called;
	Called switch {
		Ok(c) -> id(Ok({ ..c, text = Squash(src = CallOf.s.env.srcs[CallOf.s.t.inner.file], span = CallOf.s.t.inner) })),
		Err(e) -> id(Err(e))
	};
}

// The source text of a span on one line: whitespace runs become a space.
func Squash(src: string, span: Span): string = "sema_leaf.rs:squash";

// A bool condition or guard.
proc Cond(s: SynthIn): Res<Expr> {
	Cond -> id(this.s.v.kind) as K;
	K switch {
		Str(s) -> id(Err({ msg = "conditions are expressions now: write (" + s + "), without quotes", span = Cond.s.v.span })),
		else -> Check(s = { env = Cond.s.env, sc = Cond.s.sc, v = Cond.s.v, want = Prim("bool") })
	};
	Check switch {
		Ok(x) -> id(Ok(x)),
		Err(e) -> id(Err(Prefixed(d = e, prefix = "condition: ")))
	};
}

// `{ ..base, f = v }`: the fields given, checked against `want`; the rest
// read from base, which must be a path.
proc CheckUpdate(s: { c: CheckIn, shape: Type, base: Value, args: []Arg }): Res<Expr> {
	func What(v: Value): string = "sema_leaf.rs:what";
	CheckUpdate -> Synth(s = { env = this.s.c.env, sc = this.s.c.sc, v = this.s.base });
	Synth switch {
		Ok(x) -> id(x.e) as E,
		Err(e) -> id(Err(e))
	};
	E switch {
		Ref(r) -> Unfold(s = { t = UnwrapTyped(r = Synth).t, defs = CheckUpdate.s.c.env.types }) as BShape,
		else -> id(Err({ msg = "the base of a struct update must be a path (a node, this, a binding, or a field of one)", span = CheckUpdate.s.base.span }))
	};
	BShape switch {
		(!IsStruct(t = this)) -> ShowType(t = UnwrapTyped(r = Synth).t) as NotStruct,
		(!IsStruct(t = CheckUpdate.s.shape)) -> Expected(s = { c = CheckUpdate.s.c, found = "a struct update" }),
		// The base may lack fields that are given, but has none the result
		// doesn't.
		(Extra(bfs = MembersOf(t = this), fs = MembersOf(t = CheckUpdate.s.shape)) != "") -> ShowType(t = CheckUpdate.s.c.want) as HasExtra,
		else -> UpdateFields(s = { c = CheckUpdate.s.c, fs = MembersOf(t = CheckUpdate.s.shape), base = RefOf(e = UnwrapTyped(r = Synth).e), bfs = MembersOf(t = this), what = What(v = CheckUpdate.s.base), args = CheckUpdate.s.args, i = 0, given = [:] })
	};
	NotStruct -> id(Err({ msg = What(v = CheckUpdate.s.base) + " has type " + this + ", which isn't a struct, so it can't be updated", span = CheckUpdate.s.base.span }));
	HasExtra -> id(Err({ msg = What(v = CheckUpdate.s.base) + " has field " + Extra(bfs = MembersOf(t = BShape), fs = MembersOf(t = CheckUpdate.s.shape)) + ", which " + this + " doesn't", span = CheckUpdate.s.base.span }));
}

// The first of bfs not among fs, or "".
func Extra(bfs: []Member, fs: []Member): string = "sema_leaf.rs:extra_member";

type UpdateIn = { c: CheckIn, fs: []Member, base: Ref, bfs: []Member, what: string, args: []Arg, i: int, given: map[string]Expr };

proc UpdateFields(s: UpdateIn): Res<Expr> {
	UpdateFields switch {
		(this.s.i == this.s.args.len) -> FillUpdate(s = { ..this.s, i = 0, acc = [] }),
		else -> Member(ms = this.s.fs, name = this.s.args[this.s.i].name.name)
	};
	Member switch {
		Some(ft) -> Check(s = { env = UpdateFields.s.c.env, sc = UpdateFields.s.c.sc, v = UpdateFields.s.args[UpdateFields.s.i].value, want = ft }),
		else -> ShowType(t = UpdateFields.s.c.want)
	};
	ShowType -> id(Err({ msg = this + " has no field " + UpdateFields.s.args[UpdateFields.s.i].name.name, span = UpdateFields.s.args[UpdateFields.s.i].name.span }));
	Check switch {
		Ok(x) -> switch {
			(UpdateFields.s.args[UpdateFields.s.i].name.name in UpdateFields.s.given) -> id(Err({ msg = "field " + UpdateFields.s.args[UpdateFields.s.i].name.name + " given twice", span = UpdateFields.s.args[UpdateFields.s.i].name.span })),
			else -> UpdateFields(s = { ..UpdateFields.s, i = UpdateFields.s.i + 1, given = UpdateFields.s.given + [UpdateFields.s.args[UpdateFields.s.i].name.name: x] })
		},
		Err(e) -> id(Err(e))
	};
}

// The fields in the type's order: given, or read from the base.
proc FillUpdate(s: { c: CheckIn, fs: []Member, base: Ref, bfs: []Member, what: string, args: []Arg, i: int, given: map[string]Expr, acc: []ExprMember }): Res<Expr> {
	FillUpdate switch {
		(this.s.i == this.s.fs.len) -> id(Ok(Struct(this.s.acc))),
		(this.s.fs[this.s.i].name in this.s.given) -> FillUpdate(s = { ..this.s, i = this.s.i + 1, acc = this.s.acc + [{ name = this.s.fs[this.s.i].name, e = this.s.given[this.s.fs[this.s.i].name] }] }),
		(!HasMember(ms = this.s.bfs, name = this.s.fs[this.s.i].name)) -> ShowType(t = this.s.c.want) as Missing,
		else -> Accepts(s = { a = this.s.fs[this.s.i].ty, b = UnwrapT(t = Member(ms = this.s.bfs, name = this.s.fs[this.s.i].name)), defs = this.s.c.env.types, assumed = [] })
	};
	Missing -> id(Err({ msg = "struct update is missing field " + FillUpdate.s.fs[FillUpdate.s.i].name + " of " + this + ", which " + FillUpdate.s.what + " doesn't have", span = FillUpdate.s.c.v.span }));
	Accepts switch {
		(this) -> FillUpdate(s = { ..FillUpdate.s, i = FillUpdate.s.i + 1, acc = FillUpdate.s.acc + [{ name = FillUpdate.s.fs[FillUpdate.s.i].name, e = Ref({ ..FillUpdate.s.base, fields = FillUpdate.s.base.fields + [FillUpdate.s.fs[FillUpdate.s.i].name], ty = UnwrapT(t = Member(ms = FillUpdate.s.bfs, name = FillUpdate.s.fs[FillUpdate.s.i].name)) }) }] }),
		else -> ShowType(t = UnwrapT(t = Member(ms = FillUpdate.s.bfs, name = FillUpdate.s.fs[FillUpdate.s.i].name))) as Got
	};
	Got -> ShowType(t = FillUpdate.s.fs[FillUpdate.s.i].ty) as Want;
	Want -> id(Err({ msg = FillUpdate.s.what + "." + FillUpdate.s.fs[FillUpdate.s.i].name + " has type " + Got + ", but " + this + " is expected", span = FillUpdate.s.base.span }));
}
