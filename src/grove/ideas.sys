// grove's idea routes: the tree, and branching, discarding, restoring,
// renaming and laying out ideas (rename and layout take pins too). Reads are
// open; writes pass WriteGate.
//   GET  /api/ideas                      the repository, its pins and ideas, and the interiors
//   POST /api/ideas/branch {from, name?} a new idea at from's head (a pin's or an idea's), its id
//   POST /api/ideas/discard {id}         removes its worktree and its subtree's, keeps their branches
//   POST /api/ideas/delete {id}          permanently deletes a discarded or merged idea without children
//   POST /api/ideas/restore {id}         a discarded idea's worktree back
//   POST /api/ideas/rename {id, name}
//   POST /api/ideas/layout {id, sections}

// A write request, let through with its repository and JSON body, or the
// response that turns it away.
type Writing = enum { Go({ repo: Repo, j: Json }), Stop(HttpResponse) };

// Builds the tree's JSON: the repository itself (id "", kind hub), each pin
// (kind branch, tag or commit: its ref, head, worktree and sections), each
// idea that has a branch (kind idea: its parent, the pin its line hangs
// from, its worktree, head and sections; one with no worktree is
// discarded), and the interiors that can be opened. An idea is merged when
// its metadata says so, or when its branch has commits of its own (its head
// isn't its fork, or with no fork, its pin's head) and they're all in its
// pin (merged: by pin, `git for-each-ref --merged <head>` lines). It's
// behind when it's active and its fork isn't its parent's head. agents:
// what agents said of each pin and idea.
func TreeJson(repo: Repo, worktrees: string, forest: Forest, merged: map[string]string, interiors: []Interior, agents: map[string]AgentStatus, failures: map[string]string): Json = "grove_leaf.rs:tree_json";
// Answers with {"ok": true, key: value}, or the error.
func Answer(r: Res<string>, key: string): HttpResponse = "grove_leaf.rs:answer";
// a, or d if a is "".
func OrStr(a: string, d: string): string = "grove_leaf.rs:or_str";

// Lets a write through with the repository and the request's JSON body:
// the session token first (WriteGate), then the body, then the repository.
proc GroveWrite(req: HttpRequest): Writing {
	GroveWrite -> WriteGate(req = this.req);
	WriteGate switch {
		Shut(r) -> id(Stop(r)),
		else -> ParseJson(text = GroveWrite.req.body)
	};
	ParseJson switch {
		Ok(_) -> Grove.Repo(n = 0),
		Err(e) -> id(Stop(ApiErr(msg = "bad request: " + e.msg)))
	};
	Grove.Repo switch {
		Ok(r) -> id(Go({ repo = r, j = UnwrapJ(r = ParseJson) })),
		Err(e) -> id(Stop(ApiErr(msg = e.msg)))
	};
}

// Serves GET /api/ideas: the repository, its pins and ideas, and the
// interiors that can be opened.
proc IdeasRoute(req: HttpRequest): HttpResponse {
	IdeasRoute -> Grove.Repo(n = 0);
	Grove.Repo switch {
		Ok(r) -> LoadTree(repo = r),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	LoadTree switch {
		Ok(j) -> id(Api(j = j)),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
}

// Loads the tree's JSON (TreeJson): the repository, its pins and ideas
// (LoadForest), and the interiors that can be opened.
proc LoadTree(repo: Repo): Res<Json> {
	LoadTree -> Grove.Git(dir = this.repo.top, args = ["worktree", "list", "--porcelain"]) as Worktrees;
	Worktrees switch {
		Ok(_) -> LoadForest(repo = LoadTree.repo),
		Err(e) -> id(Err(e))
	};
	LoadForest switch {
		Ok(f) -> MergedInto(s = { repo = LoadTree.repo, pins = f.pins, heads = f.heads, i = 0, acc = [:] }),
		Err(e) -> id(Err(e))
	};
	MergedInto -> LoadInteriors(repo = LoadTree.repo);
	LoadInteriors switch {
		Ok(xs) -> Grove.Statuses(n = 0),
		Err(e) -> id(Err(e))
	};
	Grove.Statuses -> Grove.RebaseFailures(n = 0);
	Grove.RebaseFailures -> id(Ok(TreeJson(repo = LoadTree.repo, worktrees = UnwrapR2(r = Worktrees), forest = UnwrapForest(r = LoadForest), merged = MergedInto, interiors = UnwrapInteriors(r = LoadInteriors), agents = Grove.Statuses, failures = this)));
}

// Serves POST /api/ideas/branch {from, name?}: a new idea branched from
// from's head, its id.
proc BranchRoute(req: HttpRequest): HttpResponse {
	BranchRoute -> GroveWrite(req = this.req);
	GroveWrite switch {
		Stop(r) -> id(r),
		Go(w) -> BranchIdea(s = { repo = w.repo, from = StrOr(j = w.j, key = "from", d = ""), name = StrOr(j = w.j, key = "name", d = "") })
	};
	BranchIdea -> id(Answer(r = this, key = "id"));
}

// Serves POST /api/ideas/discard {id}: discards the idea and every idea
// under it (DiscardTree): their worktrees, terminals and the interiors
// started for them go, their branches and metadata stay, so each can be
// restored.
proc DiscardRoute(req: HttpRequest): HttpResponse {
	DiscardRoute -> GroveWrite(req = this.req);
	GroveWrite switch {
		Stop(r) -> id(r),
		Go(w) -> DiscardTree(s = { repo = w.repo, id = StrOr(j = w.j, key = "id", d = "") })
	};
	DiscardTree -> Grove.Changed(n = 0);
	Grove.Changed -> id(Answer(r = DiscardTree, key = "id"));
}

// Permanently deletes a discarded or merged idea after checking that it has no children.
proc DeleteRoute(req: HttpRequest): HttpResponse {
	DeleteRoute -> GroveWrite(req = this.req);
	GroveWrite switch {
		Stop(r) -> id(r),
		Go(w) -> DeleteIdea(s = { repo = w.repo, id = StrOr(j = w.j, key = "id", d = "") })
	};
	DeleteIdea switch {
		Ok(_) -> Grove.Changed(n = 0),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Grove.Changed -> id(Answer(r = DeleteIdea, key = "id"));
}

// Permanently deletes a discarded or merged idea (Grove.Delete), merged
// meaning in the head of the pin its line hangs from. Gives its id.
proc DeleteIdea(s: { repo: Repo, id: string }): Res<string> {
	DeleteIdea -> LoadForest(repo = this.s.repo);
	LoadForest switch {
		Ok(f) -> Grove.Delete(repo = DeleteIdea.s.repo, id = DeleteIdea.s.id, base = HeadOf(heads = f.heads, id = PinOf(xs = f.ideas, id = DeleteIdea.s.id))),
		Err(e) -> id(Err(e))
	};
	Grove.Delete -> id(this);
}

// Serves POST /api/ideas/restore {id}: gives a discarded idea its worktree
// back.
proc RestoreRoute(req: HttpRequest): HttpResponse {
	RestoreRoute -> GroveWrite(req = this.req);
	GroveWrite switch {
		Stop(r) -> id(r),
		Go(w) -> RestoreIdea(s = { repo = w.repo, id = StrOr(j = w.j, key = "id", d = "") })
	};
	RestoreIdea -> id(Answer(r = this, key = "id"));
}

// Serves POST /api/ideas/rename {id, name}.
proc RenameRoute(req: HttpRequest): HttpResponse {
	RenameRoute -> GroveWrite(req = this.req);
	GroveWrite switch {
		Stop(r) -> id(r),
		Go(w) -> RenameIdea(s = { repo = w.repo, id = StrOr(j = w.j, key = "id", d = ""), name = StrOr(j = w.j, key = "name", d = "") })
	};
	RenameIdea -> id(Answer(r = this, key = "id"));
}

// Serves POST /api/ideas/layout {id, sections}: stores the idea's sections,
// their order and which are expanded.
proc LayoutRoute(req: HttpRequest): HttpResponse {
	LayoutRoute -> GroveWrite(req = this.req);
	GroveWrite switch {
		Stop(r) -> id(r),
		Go(w) -> LayoutIdea(s = { repo = w.repo, id = StrOr(j = w.j, key = "id", d = ""), j = w.j })
	};
	LayoutIdea -> id(Answer(r = this, key = "id"));
}

// Branches a new idea from a pin or an idea (from): a branch idea/<new id>
// and a worktree for it at from's head (a pin's branch, tag or commit; an
// idea's worktree's HEAD), with its base (refs/worktree/base) set there,
// and from's sections. The repository itself ("") is no git source to
// branch from. Gives its id.
proc BranchIdea(s: { repo: Repo, from: string, name: string }): Res<string> {
	BranchIdea switch {
		(this.s.from == "") -> id(Err(GroveErr(msg = "the repository itself isn't a git source: branch from a pin or an idea"))),
		(IsPinId(id = this.s.from)) -> LoadPin(s = { repo = this.s.repo, id = this.s.from }),
		else -> LoadIdea(s = { repo = this.s.repo, id = this.s.from })
	};
	LoadPin switch {
		Ok(p) -> PinHead(s = { repo = BranchIdea.s.repo, pin = p }),
		Err(e) -> id(Err(e))
	};
	PinHead -> id({ head = this, sections = UnwrapPin(r = LoadPin).sections }) as Src;
	LoadIdea switch {
		Ok(i) -> IdeaWorktree(s = { repo = BranchIdea.s.repo, id = BranchIdea.s.from }),
		Err(e) -> id(Err(e))
	};
	IdeaWorktree switch {
		Ok(dir) -> Grove.Git(dir = dir, args = ["rev-parse", "HEAD"]) as Head,
		Err(e) -> id(Err(e))
	};
	Head -> id({ head = this, sections = UnwrapIdea(r = LoadIdea).sections }) as Src;
	Src switch {
		{ head = Ok(_), sections = _ } -> Grove.NewId(n = 0),
		{ head = Err(e), sections = _ } -> id(Err(GroveErr(msg = "no commit to branch from: " + e.msg)))
	};
	Grove.NewId -> Grove.Git(dir = BranchIdea.s.repo.top, args = ["worktree", "add", "-b", "idea/" + this, WorktreePath(common = BranchIdea.s.repo.common, id = this), UnwrapR2(r = Src.head)]) as Add;
	Add switch {
		Ok(_) -> Grove.Git(dir = WorktreePath(common = BranchIdea.s.repo.common, id = Grove.NewId), args = ["update-ref", "refs/worktree/base", UnwrapR2(r = Src.head)]) as SetBase,
		Err(e) -> id(Err(GroveErr(msg = "cannot make the worktree: " + e.msg)))
	};
	SetBase switch {
		Ok(_) -> SaveIdea(s = { repo = BranchIdea.s.repo, idea = { id = Grove.NewId, name = OrStr(a = BranchIdea.s.name, d = Grove.NewId), parent = BranchIdea.s.from, fork = UnwrapR2(r = Src.head), status = "active", sections = FreshSections(xs = Src.sections) } }),
		Err(e) -> id(Err(GroveErr(msg = "cannot set the base: " + e.msg)))
	};
}

// Discards an idea: removes its worktree (git refuses one with changes not
// committed), kills its terminals and stops the interiors started for it,
// and marks it discarded. Its branch stays. Gives its id.
proc DiscardIdea(s: { repo: Repo, id: string }): Res<string> {
	DiscardIdea switch {
		(this.s.id == "") -> id(Err(GroveErr(msg = "the repository itself can't be discarded"))),
		(IsPinId(id = this.s.id)) -> id(Err(GroveErr(msg = "a pin isn't discarded: unpin it"))),
		else -> LoadIdea(s = this.s)
	};
	LoadIdea switch {
		Ok(i) -> id(i) as I,
		Err(e) -> id(Err(e))
	};
	I -> IdeaWorktree(s = DiscardIdea.s);
	IdeaWorktree switch {
		Ok(dir) -> Grove.Git(dir = DiscardIdea.s.repo.top, args = ["worktree", "remove", dir]) as Remove,
		Err(e) -> id(Err(GroveErr(msg = "cannot discard " + DiscardIdea.s.id + ": " + e.msg)))
	};
	Remove switch {
		Ok(_) -> Interiors.Stop(worktree = UnwrapR2(r = IdeaWorktree)),
		Err(e) -> id(Err(GroveErr(msg = "cannot discard " + DiscardIdea.s.id + ": " + e.msg)))
	};
	Interiors.Stop for each (I.sections) -> Term.Kill(id = this.term) as Killed;
	Killed collect each (Killed) -> SaveIdea(s = { repo = DiscardIdea.s.repo, idea = { ..I, status = "discarded", sections = FreshSections(xs = I.sections) } });
}

// Restores a discarded idea, or one whose worktree was removed outside
// grove: a worktree for its branch again, with its base where it was
// branched. Gives its id.
proc RestoreIdea(s: { repo: Repo, id: string }): Res<string> {
	RestoreIdea switch {
		(this.s.id == "" || IsPinId(id = this.s.id)) -> id(Err(GroveErr(msg = this.s.id + " isn't an idea to restore"))),
		else -> LoadIdea(s = this.s)
	};
	LoadIdea switch {
		Ok(i) -> id(i) as I,
		Err(e) -> id(Err(e))
	};
	I -> IdeaWorktree(s = RestoreIdea.s);
	IdeaWorktree switch {
		Ok(_) -> id(Err(GroveErr(msg = "idea " + I.id + " isn't discarded"))),
		Err(_) -> Grove.Git(dir = RestoreIdea.s.repo.top, args = ["worktree", "add", WorktreePath(common = RestoreIdea.s.repo.common, id = I.id), "idea/" + I.id]) as Add
	};
	Add switch {
		Ok(_) -> switch {
			(I.fork == "") -> SaveIdea(s = { repo = RestoreIdea.s.repo, idea = { ..I, status = "active" } }),
			else -> Grove.Git(dir = WorktreePath(common = RestoreIdea.s.repo.common, id = I.id), args = ["update-ref", "refs/worktree/base", I.fork]) as SetBase
		},
		Err(e) -> id(Err(GroveErr(msg = "cannot restore " + I.id + ": " + e.msg)))
	};
	SetBase switch {
		Ok(_) -> SaveIdea(s = { repo = RestoreIdea.s.repo, idea = { ..I, status = "active" } }),
		Err(e) -> id(Err(GroveErr(msg = "cannot set the base: " + e.msg)))
	};
}

// Renames an idea or a pin (not the repository itself). Gives its id.
proc RenameIdea(s: { repo: Repo, id: string, name: string }): Res<string> {
	RenameIdea switch {
		(this.s.name == "") -> id(Err(GroveErr(msg = "a name can't be empty"))),
		(this.s.id == "") -> id(Err(GroveErr(msg = "the repository itself isn't renamed: rename a pin or an idea"))),
		else -> LoadNode(s = { repo = this.s.repo, id = this.s.id })
	};
	LoadNode switch {
		Ok(i) -> SaveNode(s = { repo = RenameIdea.s.repo, idea = { ..i, name = RenameIdea.s.name } }),
		Err(e) -> id(Err(e))
	};
}

// Stores the sections from a layout request, for a pin or an idea that has
// a branch. Gives its id.
proc LayoutIdea(s: { repo: Repo, id: string, j: Json }): Res<string> {
	LayoutIdea -> id(ParseSections(j = this.s.j)) as Secs;
	Secs switch {
		Err(e) -> id(Err(e)),
		Ok(_) -> switch {
			(IsPinId(id = LayoutIdea.s.id)) -> LoadNode(s = { repo = LayoutIdea.s.repo, id = LayoutIdea.s.id }),
			(!ValidId(id = LayoutIdea.s.id)) -> id(Err(GroveErr(msg = "invalid idea id: " + LayoutIdea.s.id))),
			else -> Grove.Git(dir = LayoutIdea.s.repo.top, args = ["rev-parse", "--verify", "--quiet", "refs/heads/idea/" + LayoutIdea.s.id]) as Known
		}
	};
	Known switch {
		Ok(_) -> LoadNode(s = { repo = LayoutIdea.s.repo, id = LayoutIdea.s.id }),
		Err(_) -> id(Err(GroveErr(msg = "no such idea: " + LayoutIdea.s.id)))
	};
	LoadNode switch {
		Ok(i) -> SaveNode(s = { repo = LayoutIdea.s.repo, idea = { ..i, sections = UnwrapSections(r = Secs) } }),
		Err(e) -> id(Err(e))
	};
}

func UnwrapSections(r: Res<[]Section>): []Section = "grove_leaf.rs:unwrap_sections";
func UnwrapInteriors(r: Res<[]Interior>): []Interior = "grove_leaf.rs:unwrap_interiors";
