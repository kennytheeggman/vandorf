// grove for agents: the command line (`grove branch` and the rest, the cli
// of [http.grove]), which works on the repository directly and then tells
// a running grove, and the routes that hear it. grove's terminals and
// interiors get $GROVE_URL and $GROVE_TOKEN, the agents' token, which only
// the agent routes take: an agent can branch, rename and restore ideas, pin
// branches, tags and commits, open terminals in them and run commands
// there, but discarding (unpinning a pin with ideas on it, too) is left to
// people, in the tree.
//   POST /api/agent/notify {idea, open, run}   a change; with open, a terminal in the idea
//   POST /api/agent/run {idea, cmd, new}       cmd typed into one of the idea's terminals
//   GET  /api/ideas/wait?v=                    the count of changes, once it isn't v
//   POST /api/agent/status {idea, state, message}   (lifecycle.sys)

// A command line, read: the command, its positional arguments, and its
// flags (--from, --idea, --run, --no-terminal, --new as fresh, --continue
// as cont). err: why it can't run.
type CliArgs = { cmd: string, args: []string, from: string, has_from: bool, idea: string, has_idea: bool, run: string, terminal: bool, fresh: bool, cont: bool, err: string };

// Reads grove's command line: a command first (help for -h, --help or
// none), then its arguments and flags, as `--flag value` or `--flag=value`;
// err says what's wrong, for an unknown command or flag or the wrong number
// of arguments.
func ParseCli(argv: []string): CliArgs = "grove_leaf.rs:parse_cli";
// grove's usage, for `grove help`.
func CliUsage(n: int): string = "grove_leaf.rs:cli_usage";
// Prints nothing: what a command that succeeds quietly gives.
func Silent(n: int): void = "grove_leaf.rs:silent";
// A status's JSON body: {"idea", "state", "message"}, the state "" for
// `clear`.
func StatusBody(idea: string, a: CliArgs): string = "grove_leaf.rs:status_body";
// Fails with msg, which grove prints as its error.
func CliFail(msg: string): void = "grove_leaf.rs:cli_fail";
// The id of the idea a branch is checked out for: idea/<id> gives id; an
// error for any other branch.
func IdeaOfBranch(branch: string): Res<string> = "grove_leaf.rs:idea_of_branch";
// The idea whose grove worktree (grove/worktrees/<id>) path is, or "".
func IdOfPath(path: string): string = "grove_leaf.rs:id_of_path";
// The value of r, or d if it's an error.
func OkOr(r: Res<string>, d: string): string = "grove_leaf.rs:ok_or";
// The first positional argument, or "".
func Arg0(a: CliArgs): string = "grove_leaf.rs:arg0";
// The command `grove run` types: its one argument as it is (a command line
// for the shell), or its several each quoted for the shell, joined by
// spaces.
func RunCmd(a: CliArgs): string = "grove_leaf.rs:run_cmd";
// A run's JSON body: {"idea", "cmd", "new"}.
func RunBody(idea: string, cmd: string, fresh: bool): string = "grove_leaf.rs:run_body";
// The terminal of an idea's sections to run a command in: the first
// terminal section's whose terminal is one of mine (opened in the idea's
// worktree) and idle (its shell at its prompt); 0 if there's none.
func RunTerminal(xs: []Section, mine: []int, idle: []int): int = "grove_leaf.rs:run_terminal";
// What `grove run` says it did, from grove's answer: where it ran cmd, and
// whether in a new terminal; an error if grove couldn't be asked or
// turned it away, which without $GROVE_URL says grove run needs grove
// running.
func RanText(idea: string, cmd: string, answer: Res<string>): Res<string> = "grove_leaf.rs:ran_text";
// A notification's JSON body: {"idea", "open", "run"}.
func NotifyBody(idea: string, open: bool, run: string): string = "grove_leaf.rs:notify_body";
// Reads a bool field, or d if it's missing or not a bool.
func BoolOr(j: Json, key: string, d: bool): bool = "grove_leaf.rs:bool_or";
// What's typed into a new terminal for run: run and a return, or nothing.
func Typed(run: string): string = "grove_leaf.rs:typed";
// An idea's sections with a terminal kept in them: its first terminal
// section with none running gets it, expanded; else a new expanded terminal
// section is added last.
func WithTerminal(xs: []Section, term: int): []Section = "grove_leaf.rs:with_terminal";
// The tree (TreeJson) as text, a pin or an idea a line, the pins first and
// each idea indented under its parent, with * on here's (none if here is
// "-").
func TreeText(tree: Json, here: string): string = "grove_leaf.rs:tree_text";
// A pin or an idea of the tree (TreeJson) as text: its id, name, branch,
// worktree, parent and pin; an error if the tree hasn't it.
func IdeaText(tree: Json, id: string): Res<string> = "grove_leaf.rs:idea_text";
// What `grove branch` says it did: the new idea, where its worktree is, and
// whether grove opened a terminal in it (notified: grove's answer, or why it
// couldn't be told).
func BranchedText(id: string, name: string, from: string, worktree: string, open: bool, run: string, notified: Res<string>): string = "grove_leaf.rs:branched_text";
// What a command says after a change, and whether grove was told:
// done, then a note if notified is an error.
func ToldText(done: string, notified: Res<string>): string = "grove_leaf.rs:told_text";

// Lets an agent's request through only with the agents' token (the one in
// $GROVE_TOKEN), and on a loopback address a loopback Host; a 403
// otherwise. The session's token doesn't pass, nor does this one pass
// WriteGate.
proc AgentGate(req: HttpRequest): Gate {
	AgentGate -> Grove.AgentToken(n = 0);
	Grove.AgentToken -> Session.Loopback(n = 0);
	Session.Loopback switch {
		(Authorized(headers = AgentGate.req.headers, token = Grove.AgentToken, loopback = this)) -> id(Open()),
		else -> id(Shut(Forbidden(n = 0)))
	};
}

// Serves GET /api/ideas/wait?v=: waits a while for the count of changes to
// the tree to differ from v, and gives it, so the page catches up as soon
// as an agent tells grove of one. Without v it answers at once.
proc WaitRoute(req: HttpRequest): HttpResponse {
	WaitRoute -> Grove.Wait(v = QueryInt(s = { q = this.req.query, k = "v" }));
	Grove.Wait -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "v", value = Num(this) }])));
}

// Serves POST /api/agent/notify {idea, open, run}: counts a change to the
// tree, made by `grove` on the command line; with open, first opens a
// terminal in the idea (OpenTerminal), typing run into it.
proc NotifyRoute(req: HttpRequest): HttpResponse {
	NotifyRoute -> AgentGate(req = this.req);
	AgentGate switch {
		Shut(r) -> id(r),
		else -> ParseJson(text = NotifyRoute.req.body)
	};
	ParseJson switch {
		Ok(_) -> Grove.Repo(n = 0),
		Err(e) -> id(ApiErr(msg = "bad request: " + e.msg))
	};
	Grove.Repo switch {
		Ok(r) -> switch {
			(BoolOr(j = UnwrapJ(r = ParseJson), key = "rebase", d = false)) -> Grove.SetRebaseFailure(id = StrOr(j = UnwrapJ(r = ParseJson), key = "idea", d = ""), message = ""),
			(BoolOr(j = UnwrapJ(r = ParseJson), key = "open", d = false)) -> OpenTerminal(s = { repo = r, id = StrOr(j = UnwrapJ(r = ParseJson), key = "idea", d = ""), run = StrOr(j = UnwrapJ(r = ParseJson), key = "run", d = "") }),
			else -> id(Ok(StrOr(j = UnwrapJ(r = ParseJson), key = "idea", d = ""))) as Told
		},
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Grove.SetRebaseFailure -> id(Ok(StrOr(j = UnwrapJ(r = ParseJson), key = "idea", d = ""))) as Told;
	OpenTerminal -> id(this) as Told;
	Told -> Grove.Changed(n = 0);
	Grove.Changed -> id(Answer(r = Told, key = "idea"));
}

// Opens a terminal in an idea's worktree, with grove's agent variables,
// typing run into it if it isn't "" once its shell's line editor reads
// (Term.Ready: typed sooner, a long run is lost), and keeps it in the
// idea's sections (WithTerminal), so the page shows it there. Gives the
// idea's id.
proc OpenTerminal(s: { repo: Repo, id: string, run: string }): Res<string> {
	OpenTerminal -> Session.Loopback(n = 0);
	Session.Loopback switch {
		(!this) -> id(Err(GroveErr(msg = "terminals are off: grove isn't listening on a loopback address"))),
		else -> LoadNode(s = { repo = OpenTerminal.s.repo, id = OpenTerminal.s.id })
	};
	LoadNode switch {
		Ok(i) -> id(i) as I,
		Err(e) -> id(Err(e))
	};
	I -> IdeaWorktree(s = { repo = OpenTerminal.s.repo, id = OpenTerminal.s.id });
	IdeaWorktree switch {
		Ok(dir) -> Grove.Spawn(cwd = dir),
		Err(e) -> id(Err(e))
	};
	Grove.Spawn switch {
		Ok(n) -> switch {
			(OpenTerminal.s.run == "") -> id(false) as Settled,
			else -> Term.Ready(id = n)
		},
		Err(e) -> id(Err(GroveErr(msg = "cannot open a terminal: " + e.msg)))
	};
	Term.Ready -> id(this) as Settled;
	Settled -> Term.Input(id = UnwrapI(r = Grove.Spawn), data = Typed(run = OpenTerminal.s.run));
	Term.Input -> SaveNode(s = { repo = OpenTerminal.s.repo, idea = { ..I, sections = WithTerminal(xs = I.sections, term = UnwrapI(r = Grove.Spawn)) } });
}

func UnwrapI(r: Res<int>): int = "grove_leaf.rs:unwrap_i";

// Serves POST /api/agent/run {idea, cmd, new}: types cmd into a terminal of
// the idea (RunIn), and counts a change, as it may have opened one. Answers
// {idea, opened}.
proc RunRoute(req: HttpRequest): HttpResponse {
	RunRoute -> AgentGate(req = this.req);
	AgentGate switch {
		Shut(r) -> id(r),
		else -> ParseJson(text = RunRoute.req.body)
	};
	ParseJson switch {
		Ok(_) -> Grove.Repo(n = 0),
		Err(e) -> id(ApiErr(msg = "bad request: " + e.msg))
	};
	Grove.Repo switch {
		Ok(r) -> RunIn(s = { repo = r, id = StrOr(j = UnwrapJ(r = ParseJson), key = "idea", d = ""), cmd = StrOr(j = UnwrapJ(r = ParseJson), key = "cmd", d = ""), fresh = BoolOr(j = UnwrapJ(r = ParseJson), key = "new", d = false) }),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	RunIn switch {
		Ok(o) -> id(o) as Opened,
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Opened -> Grove.Changed(n = 0);
	Grove.Changed -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "idea", value = Str(StrOr(j = UnwrapJ(r = ParseJson), key = "idea", d = "")) }, { key = "opened", value = Bool(Opened) }])));
}

// Runs cmd in a terminal of an idea, typed with a return: into its first
// terminal section whose terminal grove opened in the idea's worktree and
// whose shell is at its prompt (RunTerminal), so never into another idea's
// terminal or into a program running in one (an agent, an editor); else,
// or with fresh, into a new one (OpenTerminal). Gives whether it opened one.
proc RunIn(s: { repo: Repo, id: string, cmd: string, fresh: bool }): Res<bool> {
	RunIn switch {
		(this.s.cmd == "") -> id(Err(GroveErr(msg = "no command to run"))),
		else -> Session.Loopback(n = 0)
	};
	Session.Loopback switch {
		(!this) -> id(Err(GroveErr(msg = "terminals are off: grove isn't listening on a loopback address"))),
		else -> LoadNode(s = { repo = RunIn.s.repo, id = RunIn.s.id })
	};
	LoadNode switch {
		Ok(i) -> id(i) as I,
		Err(e) -> id(Err(e))
	};
	I -> IdeaWorktree(s = { repo = RunIn.s.repo, id = RunIn.s.id });
	IdeaWorktree switch {
		Ok(dir) -> Grove.OpenedIn(dir = dir),
		Err(e) -> id(Err(e))
	};
	Grove.OpenedIn -> Term.Idle(n = 0);
	Term.Idle switch {
		(RunIn.s.fresh || RunTerminal(xs = I.sections, mine = Grove.OpenedIn, idle = this) == 0) -> OpenTerminal(s = { repo = RunIn.s.repo, id = RunIn.s.id, run = RunIn.s.cmd }),
		else -> Term.Input(id = RunTerminal(xs = I.sections, mine = Grove.OpenedIn, idle = this), data = Typed(run = RunIn.s.cmd))
	};
	OpenTerminal switch {
		Ok(_) -> id(Ok(true)),
		Err(e) -> id(Err(e))
	};
	Term.Input switch {
		Ok(_) -> id(Ok(false)),
		Err(e) -> id(Err(GroveErr(msg = "cannot type into the terminal: " + e.msg)))
	};
}

// grove's command line, the cli of [http.grove]: `grove <command> ...`.
// Each command works on the repository directly, in the idea whose worktree
// it's run in unless told otherwise, then tells grove if it's running
// ($GROVE_URL), so the tree catches up at once. Discarding is left to
// people.
proc GroveCli(argv: []string): void {
	GroveCli -> id(ParseCli(argv = this.argv)) as A;
	A switch {
		(this.err != "") -> CliFail(msg = this.err + " (see grove help)"),
		(this.cmd == "help") -> Console.Out(text = CliUsage(n = 0)) as Help,
		(this.cmd == "discard") -> CliFail(msg = "discarding is left to people: discard an idea in grove's tree (right-click its node)") as NoDiscard,
		(this.cmd == "merge") -> CliFail(msg = "merging is left to people: merge an idea in grove's tree (right-click its node); grove rebase gets it ready") as NoMerge,
		else -> Grove.Repo(n = 0)
	};
	Grove.Repo switch {
		Ok(r) -> CliRun(s = { repo = r, a = A }),
		Err(e) -> CliFail(msg = e.msg) as NoRepo
	};
	CliRun switch {
		Ok(text) -> switch {
			(text == "") -> Silent(n = 0),
			else -> Console.Out(text = text)
		},
		Err(e) -> CliFail(msg = e.msg) as Failed
	};
}

// Runs one of grove's commands, giving what it prints.
proc CliRun(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliRun switch {
		(this.s.a.cmd == "list") -> CliList(repo = this.s.repo),
		(this.s.a.cmd == "current") -> CliCurrent(repo = this.s.repo),
		(this.s.a.cmd == "branch") -> CliBranch(s = this.s),
		(this.s.a.cmd == "rename") -> CliRename(s = this.s),
		(this.s.a.cmd == "run") -> CliRunIn(s = this.s),
		(this.s.a.cmd == "status") -> CliStatus(s = this.s),
		(this.s.a.cmd == "rebase") -> CliRebase(s = this.s),
		(this.s.a.cmd == "pin") -> CliPin(s = this.s),
		(this.s.a.cmd == "unpin") -> CliUnpin(s = this.s),
		else -> CliRestore(s = this.s)
	};
}

// The pin or idea whose worktree the working directory is in: the pin whose
// worktree it is (PinAt), else the idea whose branch is checked out there
// (or, with a detached HEAD, as while a rebase is stopped, whose grove
// worktree it is); an error for any other worktree, the repository's own
// too when its branch isn't pinned.
proc Here(repo: Repo): Res<string> {
	Here -> Grove.Toplevel(n = 0);
	Grove.Toplevel switch {
		Ok(top) -> LoadPins(repo = Here.repo),
		Err(e) -> id(Err(e))
	};
	LoadPins switch {
		Ok(_) -> Grove.Git(dir = Here.repo.top, args = ["worktree", "list", "--porcelain"]) as Worktrees,
		Err(e) -> id(Err(e))
	};
	Worktrees switch {
		Ok(out) -> id(PinAt(porcelain = out, pins = UnwrapPins(r = LoadPins), top = UnwrapR2(r = Grove.Toplevel))) as Pinned,
		Err(e) -> id(Err(e))
	};
	Pinned switch {
		(this != "") -> id(Ok(this)),
		else -> Grove.Git(dir = UnwrapR2(r = Grove.Toplevel), args = ["symbolic-ref", "--short", "-q", "HEAD"]) as Branch
	};
	Branch switch {
		Ok(b) -> switch {
			(UnwrapR2(r = Grove.Toplevel) == Here.repo.top) -> id(Err(GroveErr(msg = "the repository's own worktree isn't a pin's: pin its branch with grove pin " + b))),
			else -> id(IdeaOfBranch(branch = b))
		},
		Err(_) -> switch {
			(IdOfPath(path = UnwrapR2(r = Grove.Toplevel)) != "") -> id(Ok(IdOfPath(path = UnwrapR2(r = Grove.Toplevel)))),
			else -> id(Err(GroveErr(msg = "this worktree isn't a pin's or an idea's: its HEAD is detached")))
		}
	};
}

// `grove list`: the ideas, as a tree, with * on the one here.
proc CliList(repo: Repo): Res<string> {
	CliList -> Here(repo = this.repo);
	Here -> LoadTree(repo = CliList.repo);
	LoadTree switch {
		Ok(j) -> id(Ok(TreeText(tree = j, here = OkOr(r = Here, d = "-")))),
		Err(e) -> id(Err(e))
	};
}

// `grove current`: the idea here.
proc CliCurrent(repo: Repo): Res<string> {
	CliCurrent -> Here(repo = this.repo);
	Here switch {
		Ok(_) -> LoadTree(repo = CliCurrent.repo),
		Err(e) -> id(Err(e))
	};
	LoadTree switch {
		Ok(j) -> id(IdeaText(tree = j, id = UnwrapR2(r = Here))),
		Err(e) -> id(Err(e))
	};
}

// What --from or --idea names: a pin's or an idea's id, as it is, or else
// the pin of the branch, tag or commit it names (PinNamed), so --from main
// is main's pin.
proc Named(s: { repo: Repo, name: string }): string {
	Named switch {
		(this.s.name == "" || IsPinId(id = this.s.name)) -> id(this.s.name),
		else -> Grove.Git(dir = this.s.repo.top, args = ["rev-parse", "--verify", "--quiet", "refs/heads/idea/" + this.s.name])
	};
	Grove.Git switch {
		Ok(_) -> id(Named.s.name),
		Err(_) -> LoadPins(repo = Named.s.repo)
	};
	LoadPins switch {
		Ok(ps) -> id(OrStr(a = PinNamed(pins = ps, name = Named.s.name), d = Named.s.name)),
		Err(_) -> id(Named.s.name)
	};
}

// `grove branch [name] [--from <pin|idea>] [--run <cmd>] [--no-terminal]`: a
// new idea branched from the pin or idea here (or --from), then grove told,
// opening a terminal in it unless --no-terminal, with --run typed there.
proc CliBranch(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliBranch switch {
		(this.s.a.has_from) -> Named(s = { repo = this.s.repo, name = this.s.a.from }),
		else -> Here(repo = this.s.repo)
	};
	Named -> id(Ok(this)) as From;
	Here -> id(this) as From;
	From switch {
		Ok(f) -> BranchIdea(s = { repo = CliBranch.s.repo, from = f, name = Arg0(a = CliBranch.s.a) }),
		Err(e) -> id(Err(GroveErr(msg = e.msg + "; pass --from <idea> to branch from one")))
	};
	BranchIdea switch {
		Ok(nid) -> Grove.Notify(path = "/api/agent/notify", body = NotifyBody(idea = nid, open = CliBranch.s.a.terminal, run = CliBranch.s.a.run)),
		Err(e) -> id(Err(e))
	};
	Grove.Notify -> id(Ok(BranchedText(id = UnwrapR2(r = BranchIdea), name = Arg0(a = CliBranch.s.a), from = UnwrapR2(r = From), worktree = WorktreePath(common = CliBranch.s.repo.common, id = UnwrapR2(r = BranchIdea)), open = CliBranch.s.a.terminal, run = CliBranch.s.a.run, notified = this)));
}

// `grove rename <name> [--idea <idea>]`: renames the pin or idea here (or
// --idea), then tells grove.
proc CliRename(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliRename switch {
		(this.s.a.has_idea) -> Named(s = { repo = this.s.repo, name = this.s.a.idea }),
		else -> Here(repo = this.s.repo)
	};
	Named -> id(Ok(this)) as Which;
	Here -> id(this) as Which;
	Which switch {
		Ok(i) -> RenameIdea(s = { repo = CliRename.s.repo, id = i, name = Arg0(a = CliRename.s.a) }),
		Err(e) -> id(Err(GroveErr(msg = e.msg + "; pass --idea <idea> to rename one")))
	};
	RenameIdea switch {
		Ok(i) -> Grove.Notify(path = "/api/agent/notify", body = NotifyBody(idea = i, open = false, run = "")),
		Err(e) -> id(Err(e))
	};
	Grove.Notify -> id(Ok(ToldText(done = "renamed " + OrStr(a = UnwrapR2(r = RenameIdea), d = "the repository") + " to " + Arg0(a = CliRename.s.a), notified = this)));
}

// `grove restore <idea>`: gives a discarded idea its worktree back, then
// tells grove.
proc CliRestore(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliRestore -> RestoreIdea(s = { repo = this.s.repo, id = Arg0(a = this.s.a) });
	RestoreIdea switch {
		Ok(i) -> Grove.Notify(path = "/api/agent/notify", body = NotifyBody(idea = i, open = false, run = "")),
		Err(e) -> id(Err(e))
	};
	Grove.Notify -> id(Ok(ToldText(done = "restored " + UnwrapR2(r = RestoreIdea) + " in " + WorktreePath(common = CliRestore.s.repo.common, id = UnwrapR2(r = RestoreIdea)), notified = this)));
}

// `grove run [--idea <idea>] [--new] [--] <cmd...>`: asks grove to type cmd
// into a terminal of the idea here (or --idea's), one whose shell is at its
// prompt, or a new one (always, with --new). Unlike the other commands, it
// needs grove running.
proc CliRunIn(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliRunIn switch {
		(this.s.a.has_idea) -> Named(s = { repo = this.s.repo, name = this.s.a.idea }),
		else -> Here(repo = this.s.repo)
	};
	Named -> id(Ok(this)) as Which;
	Here -> id(this) as Which;
	Which switch {
		Ok(i) -> Grove.Notify(path = "/api/agent/run", body = RunBody(idea = i, cmd = RunCmd(a = CliRunIn.s.a), fresh = CliRunIn.s.a.fresh)),
		Err(e) -> id(Err(GroveErr(msg = e.msg + "; pass --idea <idea> to run in one")))
	};
	Grove.Notify -> id(RanText(idea = UnwrapR2(r = Which), cmd = RunCmd(a = CliRunIn.s.a), answer = this));
}

// `grove status <working|attention|done|clear> [message...] [--idea <idea>]`:
// tells grove what the agent in this idea (or --idea) is doing, shown on its
// node. Quiet when grove hears it, so it can run from an agent's hooks.
proc CliStatus(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliStatus switch {
		(this.s.a.has_idea) -> Named(s = { repo = this.s.repo, name = this.s.a.idea }),
		else -> Here(repo = this.s.repo)
	};
	Named -> id(Ok(this)) as Which;
	Here -> id(this) as Which;
	Which switch {
		Ok(i) -> Grove.Notify(path = "/api/agent/status", body = StatusBody(idea = i, a = CliStatus.s.a)),
		Err(e) -> id(Err(GroveErr(msg = e.msg + "; pass --idea <idea> to report on one")))
	};
	Grove.Notify switch {
		Ok(_) -> id(Ok("")),
		Err(e) -> id(Err(e))
	};
}

// Tells the server a failed rebase has been retried.
func RebaseNotice(idea: string): string = "grove_leaf.rs:rebase_notice";

// `grove rebase [--idea <idea>] [--continue]`: rebases this idea (or --idea)
// onto its parent's head, in its worktree. On a conflict it stops there to
// be resolved, then `grove rebase --continue` finishes it. Tells grove, which
// clears its failed rebase flag.
proc CliRebase(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliRebase switch {
		(this.s.a.has_idea) -> Named(s = { repo = this.s.repo, name = this.s.a.idea }),
		else -> Here(repo = this.s.repo)
	};
	Named -> id(Ok(this)) as Which;
	Here -> id(this) as Which;
	Which switch {
		Ok(i) -> switch {
			(CliRebase.s.a.cont) -> ContinueRebase(s = { repo = CliRebase.s.repo, id = i }),
			else -> RebaseOne(s = { repo = CliRebase.s.repo, id = i, keep = true })
		},
		Err(e) -> id(Err(GroveErr(msg = e.msg + "; pass --idea <idea> to rebase one")))
	};
	ContinueRebase -> id(this) as Done;
	RebaseOne -> id(this) as Done;
	Done switch {
		Ok(_) -> Grove.Notify(path = "/api/agent/notify", body = RebaseNotice(idea = UnwrapR2(r = Which))),
		Err(e) -> id(Err(e))
	};
	Grove.Notify -> id(Ok(ToldText(done = UnwrapR2(r = Done) + ": " + OrStr(a = UnwrapR2(r = Which), d = "the root"), notified = this)));
}

// `grove pin <branch|tag|commit>`: pins it (PinRef), with a worktree of its
// own unless its branch is checked out already, then tells grove.
proc CliPin(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliPin -> PinRef(s = { repo = this.s.repo, ref = Arg0(a = this.s.a) });
	PinRef switch {
		Ok(p) -> IdeaWorktree(s = { repo = CliPin.s.repo, id = p }),
		Err(e) -> id(Err(e))
	};
	IdeaWorktree -> Grove.Notify(path = "/api/agent/notify", body = NotifyBody(idea = UnwrapR2(r = PinRef), open = false, run = ""));
	Grove.Notify -> id(Ok(ToldText(done = "pinned " + UnwrapR2(r = PinRef) + "\nworktree: " + OkOr(r = IdeaWorktree, d = "(none)"), notified = this)));
}

// `grove unpin <pin>`: unpins a pin (named by its id, or by the branch, tag
// or commit it pins: PinNamed), then tells grove. Unpinning discards the
// ideas on a pin, so one with any that are active is left to people, in
// the tree.
proc CliUnpin(s: { repo: Repo, a: CliArgs }): Res<string> {
	CliUnpin -> LoadForest(repo = this.s.repo);
	LoadForest switch {
		Ok(f) -> Grove.Git(dir = CliUnpin.s.repo.top, args = ["worktree", "list", "--porcelain"]) as Worktrees,
		Err(e) -> id(Err(e))
	};
	Worktrees switch {
		Ok(out) -> id(PinNamed(pins = UnwrapForest(r = LoadForest).pins, name = Arg0(a = CliUnpin.s.a))) as Which,
		Err(e) -> id(Err(e))
	};
	Which -> id(ActiveNames(xs = Beneath(xs = UnwrapForest(r = LoadForest).ideas, id = this), porcelain = UnwrapR2(r = Worktrees))) as Live;
	Live switch {
		(Which == "") -> id(Err(GroveErr(msg = "no pin " + Arg0(a = CliUnpin.s.a) + ": grove list shows the pins"))),
		(this.len > 0) -> id(Err(GroveErr(msg = "unpinning " + Which + " discards the ideas on it (" + JoinWith(xs = this, sep = ", ") + "), which is left to people: unpin it in grove's tree (right-click its node)"))),
		else -> Unpin(s = { repo = CliUnpin.s.repo, id = Which })
	};
	Unpin switch {
		Ok(p) -> Grove.Notify(path = "/api/agent/notify", body = NotifyBody(idea = p, open = false, run = "")),
		Err(e) -> id(Err(e))
	};
	Grove.Notify -> id(Ok(ToldText(done = "unpinned " + Which, notified = this)));
}
