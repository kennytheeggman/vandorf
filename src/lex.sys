// Tokens. Lexing is a pure leaf (vandorf strings have no character access);
// everything from here on is .sys.

// kind: "ident", "int", "float", "str", "sym" or "eof". `text` is the
// token as written, except for "str", where it's the decoded value. `at`
// and `end` are byte offsets into the source. `doc`: the comment lines
// directly above the token, if it's the first on its line: each without its
// `//` and one space after it, joined by newlines. A blank line, or code,
// between them and the token leaves it empty. The parser keeps it as the doc
// of a declaration's keyword (`func`, `proc`, `type`, `interface`).
type Tok = { kind: string, text: string, at: int, end: int, file: int, doc: string };

func Lex(src: string, file: int): []Tok = "leaf.rs:lex";

// Pure helpers the parser calls in expressions.
func MkIdent(t: Tok): Ident = "leaf.rs:mk_ident";
func SpanOf(t: Tok): Span = "leaf.rs:span_of";
func IntOf(t: Tok): int = "leaf.rs:int_of";
func FloatOf(t: Tok): float = "leaf.rs:float_of";
// Splits a "file:function" string token, failing if it isn't one.
func ImplOf(t: Tok): ImplRef = "leaf.rs:impl_of";
