// The Go backend (src/codegen/go.rs in the reference): types_vandorf.go,
// one file of state machines per top-level proc, inputs, stubs, the
// runtime, and mains. The generator's state is threaded: the lines of the
// proc being written, the imports of its file, the coercion helpers made so
// far, stubs for funcs without a .go implementation, a temporaries counter,
// and the first error.

type GGen = {
	prog: Program,
	table: Table,
	// Qualifier of named types in the code package: "types." or "".
	tq: string,
	import_base: MaybeStr,
	// Impl imports of the file being written: path -> alias.
	imports: map[string]string,
	// "src -> dst" -> the helper's name.
	coercions: map[string]string,
	helpers: []string,
	stubs: map[int]bool,
	// The first error from writing an expression, and the first that stops
	// the generator.
	failed: MaybeStr,
	fatal: MaybeStr,
	// Temporaries holding call results in expressions, never reset.
	temps: int,
	proc_name: string,
	// The proc being written.
	w: []Line
};
type GEmit = { g: GGen, s: string };
type GParts = { g: GGen, parts: []string };
type GLines = { g: GGen, lines: []string };
type GCall = { g: GGen, s: string, err: MaybeStr };
type GCoerceAt = { g: GGen, expr: string, from: Type, to: Type };

// Where the types go. pkg: the types package's name; import: its import
// path, if it isn't the code package; dir: relative to the code package.
type GoSetup = { pkg: string, import: MaybeStr, dir: string, tq: string, err: MaybeStr };
type GoImport = { path: string, alias: string };
// An executable: path is its package's directory, relative to the output.
type GoMainSpec = { name: string, entry: string, path: string };
// A server's static file: its URL path, the file as the manifest names it,
// its content type and its contents.
type GoStatic = { url: string, file: string, ctype: string, text: string };
// An HTTP server (as rust_http's ServerSpec; setup "" for none): path is
// its main package's directory, relative to the output.
type GoServerSpec = { name: string, addr: string, setup: string, routes: []Route, raw: []Route, statics: []GoStatic, path: string };
type GoGenIn = { prog: Program, package: string, import_base: MaybeStr, types_dir: string, mains: []GoMainSpec, servers: []GoServerSpec };
// dir: relative to the output directory. kind: types, code or main.
type GoFile = { dir: string, name: string, text: string, kind: string };
type GoOut = { files: []GoFile, err: MaybeStr };
// The Go function a func node calls: s; a stub (its node, or -1); an
// import it needs (path and alias, or ""); or why there isn't one.
type GoCallee = { s: string, stub: int, path: string, alias: string, err: MaybeStr };

func GoSetupOf(package: string, import_base: MaybeStr, types_dir: string): GoSetup = "go_leaf.rs:go_setup";
func GoHeader(pkg: string, imports: []GoImport): string = "go_leaf.rs:go_header";
func GoRender(t: Table, r: TyRef, qual: string): string = "go_leaf.rs:go_render";
func GoType(g: GGen, ty: Type): string = "go_leaf.rs:go_type";
func GoDoc(t: Table, n: NamedType): []Line = "go_leaf.rs:go_doc";
func GoAliasDoc(t: Table, name: string): []Line = "go_leaf.rs:go_alias_doc";
func GoTagDoc(ms: []RefMember): string = "go_leaf.rs:go_tag_doc";
// A field's type, a pointer where it would make the type contain itself.
func GoFieldType(t: Table, i: int, m: RefMember): string = "go_leaf.rs:go_field_type";
// Programs whose names would collide or be invalid in Go.
func GoNameCheck(prog: Program, t: Table): MaybeStr = "go_leaf.rs:go_name_check";
// Appends lines to the proc being written.
func GW(g: GGen, ls: []string): GGen = "go_leaf.rs:gw";
// Keep the first error.
func GoFailed(g: GGen, msg: string): GGen = "go_leaf.rs:go_failed";
func GoFatal(g: GGen, msg: string): GGen = "go_leaf.rs:go_fatal";
func GoRef(g: GGen, r: Ref): string = "go_leaf.rs:go_ref";
func GoFloat(f: float): string = "go_leaf.rs:go_float";
func GoBoxIf(b: bool, s: string): string = "go_leaf.rs:go_box_if";
// Whether evaluating e can fail (it calls a func or indexes).
func CanFail(e: Expr): bool = "go_leaf.rs:can_fail";
func InMapE(e: Expr): Expr = "go_leaf.rs:in_map_e";
func GoInType(nodes: []NodeDecl, n: int): string = "go_leaf.rs:go_in_type";
func GoPc(nodes: []NodeDecl, pid: int, n: int): string = "go_leaf.rs:go_pc";

// ---- types_vandorf.go ----

proc GoTypegen(s: { t: Table, pkg: string }): string {
	GoTypegen -> GoTypeLines(s = { t = this.s.t, i = 0, acc = [Raw(GoHeader(pkg = this.s.pkg, imports = []))] });
	GoTypeLines -> GoAliasLines(s = { t = GoTypegen.s.t, i = 0, acc = this });
	GoAliasLines -> id(Lines(lines = this, indent = "\t"));
}

proc GoTypeLines(s: { t: Table, i: int, acc: []Line }): []Line {
	GoTypeLines switch {
		(this.s.i == this.s.t.types.len) -> id(this.s.acc),
		else -> id(this.s.t.types[this.s.i].shape) as S
	};
	S switch {
		Struct(fs) -> GoMemberLines(s = { t = GoTypeLines.s.t, i = GoTypeLines.s.i, ms = fs, j = 0, acc = GoTypeLines.s.acc + GoDoc(t = GoTypeLines.s.t, n = GoTypeLines.s.t.types[GoTypeLines.s.i]) + [L("type " + GoTypeLines.s.t.types[GoTypeLines.s.i].name + " struct {")] }) as Ms,
		Enum(vs) -> GoMemberLines(s = { t = GoTypeLines.s.t, i = GoTypeLines.s.i, ms = vs, j = 0, acc = GoTypeLines.s.acc + GoDoc(t = GoTypeLines.s.t, n = GoTypeLines.s.t.types[GoTypeLines.s.i]) + [L(GoTagDoc(ms = vs)), L("type " + GoTypeLines.s.t.types[GoTypeLines.s.i].name + " struct {"), L("Tag string")] }) as Ms
	};
	Ms -> GoTypeLines(s = { t = GoTypeLines.s.t, i = GoTypeLines.s.i + 1, acc = this + [L("}"), L("")] });
}

proc GoMemberLines(s: { t: Table, i: int, ms: []RefMember, j: int, acc: []Line }): []Line {
	GoMemberLines switch {
		(this.s.j == this.s.ms.len) -> id(this.s.acc),
		else -> GoMemberLines(s = { ..this.s, j = this.s.j + 1, acc = this.s.acc + [L(Exported(s = this.s.ms[this.s.j].name) + " " + GoFieldType(t = this.s.t, i = this.s.i, m = this.s.ms[this.s.j]))] })
	};
}

proc GoAliasLines(s: { t: Table, i: int, acc: []Line }): []Line {
	GoAliasLines switch {
		(this.s.i == this.s.t.aliases.len) -> id(this.s.acc),
		else -> GoAliasLines(s = { t = this.s.t, i = this.s.i + 1, acc = this.s.acc + GoAliasDoc(t = this.s.t, name = this.s.t.aliases[this.s.i].name) + [L("type " + this.s.t.aliases[this.s.i].name + " = " + GoRender(t = this.s.t, r = this.s.t.aliases[this.s.i].r, qual = "")), L("")] })
	};
}

// ---- Coercions ----

func GoCoerceKey(at: GCoerceAt): string = "go_leaf.rs:go_coerce_key";
func GoCoercionName(at: GCoerceAt): string = "go_leaf.rs:go_coercion_name";
// Records the helper about to be written, so its parts can call it.
func GoNewCoercion(at: GCoerceAt): GGen = "go_leaf.rs:go_new_coercion";
// `func coerceN(v src) (r dst) {`
func GoCoerceHead(at: GCoerceAt): string = "go_leaf.rs:go_coerce_head";
func GoLines(ls: []string): string = "go_leaf.rs:go_lines";

// expr, of type `from`, as a `to`, which sema checked accepts it: through a
// helper per pair of Go types.
proc GCoerce(s: GCoerceAt): GEmit {
	GCoerce switch {
		(GoType(g = this.s.g, ty = this.s.from) == GoType(g = this.s.g, ty = this.s.to)) -> id({ g = this.s.g, s = this.s.expr }),
		(GoCoerceKey(at = this.s) in this.s.g.coercions) -> id({ g = this.s.g, s = this.s.g.coercions[GoCoerceKey(at = this.s)] + "(" + this.s.expr + ")" }),
		else -> id({ f = Unfolded(defs = this.s.g.prog.types, t = this.s.from), t = Unfolded(defs = this.s.g.prog.types, t = this.s.to) }) as Both
	};
	Both switch {
		{ f = Array(f), t = Array(t) } -> GCoerce(s = { g = GoNewCoercion(at = GCoerce.s), expr = "v[i]", from = f, to = t }) as Elems,
		{ f = Map(f), t = Map(t) } -> GCoerce(s = { g = GoNewCoercion(at = GCoerce.s), expr = "x", from = f.value, to = t.value }) as Values,
		{ f = Struct(_), t = Struct(tfs) } -> GCoerceFields(s = { at = GCoerce.s, g = GoNewCoercion(at = GCoerce.s), ms = tfs, i = 0, acc = [GoCoerceHead(at = GCoerce.s)] }) as Fs,
		{ f = Enum(fvs), t = Enum(_) } -> GCoerceVariants(s = { at = GCoerce.s, g = GoNewCoercion(at = GCoerce.s), ms = fvs, i = 0, acc = [GoCoerceHead(at = GCoerce.s), "r.Tag = v.Tag", "switch v.Tag {"] }) as Vs,
		else -> id({ g = GoFatal(g = GCoerce.s.g, msg = "sema admitted coercion " + GoType(g = GCoerce.s.g, ty = GCoerce.s.from) + " -> " + GoType(g = GCoerce.s.g, ty = GCoerce.s.to)), s = GCoerce.s.expr })
	};
	Elems -> GHelper(s = { at = GCoerce.s, g = this.g, lines = [GoCoerceHead(at = GCoerce.s), "r = make(" + GoType(g = GCoerce.s.g, ty = GCoerce.s.to) + ", len(v))", "for i := range v {", "r[i] = " + this.s, "}", "return r", "}"] });
	Values -> GHelper(s = { at = GCoerce.s, g = this.g, lines = [GoCoerceHead(at = GCoerce.s), "r = make(" + GoType(g = GCoerce.s.g, ty = GCoerce.s.to) + ", len(v))", "for k, x := range v {", "r[k] = " + this.s, "}", "return r", "}"] });
	Fs -> GHelper(s = { at = GCoerce.s, g = this.g, lines = this.lines + ["return r", "}"] });
	Vs -> GHelper(s = { at = GCoerce.s, g = this.g, lines = this.lines + ["}", "return r", "}"] });
}

// Pushes the helper and calls it.
proc GHelper(s: { at: GCoerceAt, g: GGen, lines: []string }): GEmit {
	GHelper -> id({ g = { ..this.s.g, helpers = this.s.g.helpers + [GoLines(ls = this.s.lines)] }, s = GoCoercionName(at = this.s.at) + "(" + this.s.at.expr + ")" });
}

// Copies part n (a field, or variant n's payload), through pointers where
// either side boxes it.
proc GCoercePart(s: { at: GCoerceAt, g: GGen, n: string, f: Type, t: Type }): GLines {
	GCoercePart switch {
		(TyBoxed(t = this.s.g.table, ty = this.s.at.from, part = this.s.n)) -> GCoerce(s = { g = this.s.g, expr = "(*v." + Exported(s = this.s.n) + ")", from = this.s.f, to = this.s.t }) as Boxed,
		else -> GCoerce(s = { g = this.s.g, expr = "v." + Exported(s = this.s.n), from = this.s.f, to = this.s.t }) as Plain
	};
	Boxed -> id({ g = this.g, lines = ["if v." + Exported(s = GCoercePart.s.n) + " != nil {", "r." + Exported(s = GCoercePart.s.n) + " = " + GoBoxIf(b = TyBoxed(t = GCoercePart.s.g.table, ty = GCoercePart.s.at.to, part = GCoercePart.s.n), s = this.s), "}"] });
	Plain -> id({ g = this.g, lines = ["r." + Exported(s = GCoercePart.s.n) + " = " + GoBoxIf(b = TyBoxed(t = GCoercePart.s.g.table, ty = GCoercePart.s.at.to, part = GCoercePart.s.n), s = this.s)] });
}

proc GCoerceFields(s: { at: GCoerceAt, g: GGen, ms: []Member, i: int, acc: []string }): GLines {
	GCoerceFields switch {
		(this.s.i == this.s.ms.len) -> id({ g = this.s.g, lines = this.s.acc }),
		else -> GCoercePart(s = { at = this.s.at, g = this.s.g, n = this.s.ms[this.s.i].name, f = MemberOf(defs = this.s.g.prog.types, t = this.s.at.from, name = this.s.ms[this.s.i].name), t = this.s.ms[this.s.i].ty })
	};
	GCoercePart -> GCoerceFields(s = { ..GCoerceFields.s, g = this.g, i = GCoerceFields.s.i + 1, acc = GCoerceFields.s.acc + this.lines });
}

proc GCoerceVariants(s: { at: GCoerceAt, g: GGen, ms: []Member, i: int, acc: []string }): GLines {
	GCoerceVariants switch {
		(this.s.i == this.s.ms.len) -> id({ g = this.s.g, lines = this.s.acc }),
		(IsVoid(t = this.s.ms[this.s.i].ty)) -> GCoerceVariants(s = { ..this.s, i = this.s.i + 1, acc = this.s.acc + ["case " + Quote(s = this.s.ms[this.s.i].name) + ":"] }),
		else -> GCoercePart(s = { at = this.s.at, g = this.s.g, n = this.s.ms[this.s.i].name, f = this.s.ms[this.s.i].ty, t = MemberOf(defs = this.s.g.prog.types, t = this.s.at.to, name = this.s.ms[this.s.i].name) })
	};
	GCoercePart -> GCoerceVariants(s = { ..GCoerceVariants.s, g = this.g, i = GCoerceVariants.s.i + 1, acc = GCoerceVariants.s.acc + ["case " + Quote(s = GCoerceVariants.s.ms[GCoerceVariants.s.i].name) + ":"] + this.lines });
}

// ---- Expressions ----

type GValueIn = { g: GGen, e: Expr, want: Type };

// e as a Go expression of type `want`. Calls in e can fail, so they're
// evaluated by statements written first, which return on error.
proc GValue(s: GValueIn): GEmit {
	GValue -> id(this.s.e) as E;
	E switch {
		Ref(r) -> GCoerce(s = { g = GValue.s.g, expr = GoRef(g = GValue.s.g, r = r), from = r.ty, to = GValue.s.want }) as Out,
		Call(c) -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Called,
		Array(es) -> GValues(s = { g = GValue.s.g, es = es, want = ElemOf(t = Unfolded(defs = GValue.s.g.prog.types, t = GValue.s.want)), i = 0, acc = [] }) as Items,
		Map(kvs) -> GEntries(s = { g = GValue.s.g, kvs = kvs, kt = KeyOf(t = Unfolded(defs = GValue.s.g.prog.types, t = GValue.s.want)), vt = MapValue(t = Unfolded(defs = GValue.s.g.prog.types, t = GValue.s.want)), i = 0, acc = [] }) as Entries,
		Index(x) -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Indexed,
		Field(x) -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Selected,
		Merge(x) -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Merged,
		Remove(x) -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Removed,
		Query(q) -> switch {
			(q.q == "keys") -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Keys,
			(q.q == "values") -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Vals,
			else -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Own
		},
		Struct(fs) -> GFields(s = { g = GValue.s.g, fs = fs, want = GValue.s.want, i = 0, acc = [] }) as Fields,
		Variant(v) -> switch {
			(IsSomeE(m = v.payload)) -> GValue(s = { g = GValue.s.g, e = UnwrapME(m = v.payload), want = MemberOf(defs = GValue.s.g.prog.types, t = GValue.s.want, name = v.tag) }) as Payload,
			else -> id({ g = GValue.s.g, s = GoType(g = GValue.s.g, ty = GValue.s.want) + "{Tag: " + Quote(s = v.tag) + "}" })
		},
		// Primitives, whose Go types match whenever sema accepted them.
		else -> GOwn(s = { g = GValue.s.g, e = GValue.s.e }) as Own
	};
	Called -> GCoerce(s = { g = this.g, expr = this.s, from = NodeRet(nodes = GValue.s.g.prog.nodes, n = CallOfE(e = GValue.s.e).target), to = GValue.s.want }) as Out;
	Items -> id({ g = this.g, s = GoType(g = GValue.s.g, ty = GValue.s.want) + "{" + Join(parts = this.parts, sep = ", ") + "}" });
	Entries -> id({ g = this.g, s = GoType(g = GValue.s.g, ty = GValue.s.want) + "{" + Join(parts = this.parts, sep = ", ") + "}" });
	Fields -> id({ g = this.g, s = GoType(g = GValue.s.g, ty = GValue.s.want) + "{" + Join(parts = this.parts, sep = ", ") + "}" });
	Indexed -> GCoerce(s = { g = this.g, expr = this.s, from = IndexedValue(t = Unfolded(defs = GValue.s.g.prog.types, t = IndexTy(e = GValue.s.e))), to = GValue.s.want }) as Out;
	Selected -> GCoerce(s = { g = this.g, expr = this.s, from = MemberOf(defs = GValue.s.g.prog.types, t = FieldTy(e = GValue.s.e), name = FieldNameE(e = GValue.s.e)), to = GValue.s.want }) as Out;
	Merged -> GCoerce(s = { g = this.g, expr = this.s, from = MergeTy(e = GValue.s.e), to = GValue.s.want }) as Out;
	Removed -> GCoerce(s = { g = this.g, expr = this.s, from = MergeTy(e = GValue.s.e), to = GValue.s.want }) as Out;
	Keys -> GCoerce(s = { g = this.g, expr = this.s, from = Array(KeyOf(t = Unfolded(defs = GValue.s.g.prog.types, t = QueryTy(e = GValue.s.e)))), to = GValue.s.want }) as Out;
	Vals -> GCoerce(s = { g = this.g, expr = this.s, from = Array(MapValue(t = Unfolded(defs = GValue.s.g.prog.types, t = QueryTy(e = GValue.s.e)))), to = GValue.s.want }) as Out;
	Payload -> id({ g = this.g, s = GoType(g = GValue.s.g, ty = GValue.s.want) + "{Tag: " + Quote(s = VariantTagE(e = GValue.s.e)) + ", " + Exported(s = VariantTagE(e = GValue.s.e)) + ": " + GoBoxIf(b = TyBoxed(t = GValue.s.g.table, ty = GValue.s.want, part = VariantTagE(e = GValue.s.e)), s = this.s) + "}" });
}

proc GValues(s: { g: GGen, es: []Expr, want: Type, i: int, acc: []string }): GParts {
	GValues switch {
		(this.s.i == this.s.es.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> GValue(s = { g = this.s.g, e = this.s.es[this.s.i], want = this.s.want })
	};
	GValue -> GValues(s = { ..GValues.s, g = this.g, i = GValues.s.i + 1, acc = GValues.s.acc + [this.s] });
}

proc GEntries(s: { g: GGen, kvs: []ExprEntry, kt: Type, vt: Type, i: int, acc: []string }): GParts {
	GEntries switch {
		(this.s.i == this.s.kvs.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> GValue(s = { g = this.s.g, e = this.s.kvs[this.s.i].key, want = this.s.kt }) as K
	};
	K -> GValue(s = { g = this.g, e = GEntries.s.kvs[GEntries.s.i].value, want = GEntries.s.vt }) as V;
	V -> GEntries(s = { ..GEntries.s, g = this.g, i = GEntries.s.i + 1, acc = GEntries.s.acc + [K.s + ": " + this.s] });
}

proc GFields(s: { g: GGen, fs: []ExprMember, want: Type, i: int, acc: []string }): GParts {
	GFields switch {
		(this.s.i == this.s.fs.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> GValue(s = { g = this.s.g, e = this.s.fs[this.s.i].e, want = MemberOf(defs = this.s.g.prog.types, t = this.s.want, name = this.s.fs[this.s.i].name) })
	};
	GValue -> GFields(s = { ..GFields.s, g = this.g, i = GFields.s.i + 1, acc = GFields.s.acc + [Exported(s = GFields.s.fs[GFields.s.i].name) + ": " + GoBoxIf(b = TyBoxed(t = GFields.s.g.table, ty = GFields.s.want, part = GFields.s.fs[GFields.s.i].name), s = this.s)] });
}

// `t, err := call` and its error check; `if t {` (or `if !t {`) for a
// short-circuit; mapGet or sliceGet into t.
func GoCallLines(t: string, call: string, qual: string): []string = "go_leaf.rs:go_call_lines";
func GoShortIf(op: string, t: string): string = "go_leaf.rs:go_short_if";
func GoIndexLines(t: string, x: string, k: string, map: bool, proc: string): []string = "go_leaf.rs:go_index_lines";
// `(x).F`, dereferenced if F is boxed.
func GoSelect(x: string, name: string, boxed: bool): string = "go_leaf.rs:go_select";

// An expression that has its own type (not a struct, array, map or
// variant literal), at that type.
proc GOwn(s: { g: GGen, e: Expr }): GEmit {
	GOwn -> id(this.s.e) as E;
	E switch {
		Ref(r) -> id({ g = GOwn.s.g, s = GoRef(g = GOwn.s.g, r = r) }),
		Int(i) -> id({ g = GOwn.s.g, s = Itoa(i = i) }),
		Float(f) -> id({ g = GOwn.s.g, s = GoFloat(f = f) }),
		Str(s) -> id({ g = GOwn.s.g, s = Quote(s = s) }),
		Bool(b) -> switch {
			(b) -> id({ g = GOwn.s.g, s = "true" }),
			else -> id({ g = GOwn.s.g, s = "false" })
		},
		Unary(u) -> GOwn(s = { g = GOwn.s.g, e = u.e }) as Operand,
		Binary(b) -> switch {
			((b.op == "&&" || b.op == "||") && CanFail(e = b.r)) -> GOwn(s = { g = GOwn.s.g, e = b.l }) as SL,
			else -> GOwn(s = { g = GOwn.s.g, e = b.l }) as BL
		},
		Call(c) -> GCallee(s = { g = GOwn.s.g, n = c.target }) as Callee,
		Index(x) -> GOwn(s = { g = GOwn.s.g, e = x.e }) as IE,
		// The struct may be a literal (`{ ..x, f = v }.g`).
		Field(f) -> GValue(s = { g = GOwn.s.g, e = f.e, want = f.ty }) as FE,
		In(x) -> GOwn(s = { g = GOwn.s.g, e = x.key }) as InK,
		Query(q) -> GOwn(s = { g = GOwn.s.g, e = q.e }) as QE,
		Merge(m) -> GValue(s = { g = GOwn.s.g, e = m.l, want = m.ty }) as ML,
		Remove(m) -> GOwn(s = { g = GOwn.s.g, e = m.m }) as RM,
		else -> id({ g = GoFatal(g = GOwn.s.g, msg = "literal without a type"), s = "" })
	};
	Operand switch {
		(UnaryOp(e = GOwn.s.e) == "!") -> id({ g = this.g, s = "(!" + this.s + ")" }),
		else -> id({ g = this.g, s = "(-" + this.s + ")" })
	};
	// Keeps short-circuiting: the right side's calls only run if needed.
	SL -> GOwn(s = { g = GW(g = { ..this.g, temps = this.g.temps + 1 }, ls = ["v" + Itoa(i = this.g.temps + 1) + " := " + this.s, GoShortIf(op = BinaryOpE(e = GOwn.s.e), t = "v" + Itoa(i = this.g.temps + 1))]), e = BinaryRE(e = GOwn.s.e) }) as SR;
	SR -> id({ g = GW(g = this.g, ls = ["v" + Itoa(i = SL.g.temps + 1) + " = " + this.s, "}"]), s = "v" + Itoa(i = SL.g.temps + 1) });
	BL -> GOwn(s = { g = this.g, e = BinaryRE(e = GOwn.s.e) }) as BR;
	BR -> id({ g = this.g, s = "(" + BL.s + " " + BinaryOpE(e = GOwn.s.e) + " " + this.s + ")" });
	// A callee error is reported once the whole program is written.
	Callee switch {
		(IsSomeS(m = this.err)) -> GArgs(s = { g = GoFailed(g = this.g, msg = UnwrapS(m = this.err)), args = CallOfE(e = GOwn.s.e).args, i = 0, acc = [] }) as Args,
		else -> GArgs(s = { g = this.g, args = CallOfE(e = GOwn.s.e).args, i = 0, acc = [] }) as Args
	};
	Args -> id({ g = GW(g = { ..this.g, temps = this.g.temps + 1 }, ls = GoCallLines(t = "v" + Itoa(i = this.g.temps + 1), call = Callee.s + "(" + Join(parts = ["ctx"] + this.parts, sep = ", ") + ")", qual = QualName(n = GOwn.s.g.prog.nodes[CallOfE(e = GOwn.s.e).target]))), s = "v" + Itoa(i = this.g.temps + 1) });
	IE -> GOwn(s = { g = this.g, e = IndexKeyE(e = GOwn.s.e) }) as IK;
	IK -> id({ g = GW(g = { ..this.g, temps = this.g.temps + 1 }, ls = GoIndexLines(t = "v" + Itoa(i = this.g.temps + 1), x = IE.s, k = this.s, map = IsMap(t = Unfolded(defs = GOwn.s.g.prog.types, t = IndexTy(e = GOwn.s.e))), proc = GOwn.s.g.proc_name)), s = "v" + Itoa(i = this.g.temps + 1) });
	FE -> id({ g = this.g, s = GoSelect(x = this.s, name = FieldNameE(e = GOwn.s.e), boxed = TyBoxed(t = GOwn.s.g.table, ty = FieldTy(e = GOwn.s.e), part = FieldNameE(e = GOwn.s.e))) });
	InK -> GOwn(s = { g = this.g, e = InMapE(e = GOwn.s.e) }) as InM;
	InM -> id({ g = this.g, s = "mapHas(" + this.s + ", " + InK.s + ")" });
	QE switch {
		(QueryQ(e = GOwn.s.e) == "len") -> id({ g = this.g, s = "len(" + this.s + ")" }),
		(QueryQ(e = GOwn.s.e) == "keys") -> id({ g = this.g, s = "mapKeys(" + this.s + ")" }),
		else -> id({ g = this.g, s = "mapValues(" + this.s + ")" })
	};
	ML -> GValue(s = { g = this.g, e = MergeRE(e = GOwn.s.e), want = MergeTy(e = GOwn.s.e) }) as MR;
	MR switch {
		(IsArray(t = Unfolded(defs = GOwn.s.g.prog.types, t = MergeTy(e = GOwn.s.e)))) -> id({ g = this.g, s = "sliceConcat(" + ML.s + ", " + this.s + ")" }),
		else -> id({ g = this.g, s = "mapMerge(" + ML.s + ", " + this.s + ")" })
	};
	RM -> GValue(s = { g = this.g, e = RemoveKeysE(e = GOwn.s.e), want = Array(KeyOf(t = Unfolded(defs = GOwn.s.g.prog.types, t = MergeTy(e = GOwn.s.e)))) }) as RK;
	RK -> id({ g = this.g, s = "mapRemove(" + RM.s + ", " + this.s + ")" });
}

proc GArgs(s: { g: GGen, args: []CallArg, i: int, acc: []string }): GParts {
	GArgs switch {
		(this.s.i == this.s.args.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> GValue(s = { g = this.s.g, e = this.s.args[this.s.i].value, want = this.s.args[this.s.i].param })
	};
	GValue -> GArgs(s = { ..GArgs.s, g = this.g, i = GArgs.s.i + 1, acc = GArgs.s.acc + [this.s] });
}

func GoCalleeOf(g: GGen, n: int): GoCallee = "go_leaf.rs:go_callee";

// The Go function a func node (or an alias of one) calls: its .go
// implementation, imported if it's in another directory, or a stub. On an
// error, the call is "unresolved".
proc GCallee(s: { g: GGen, n: int }): GCall {
	GCallee -> GoCalleeOf(g = this.s.g, n = this.s.n);
	GoCalleeOf switch {
		(IsSomeS(m = this.err)) -> id({ g = GCallee.s.g, s = "unresolved", err = this.err }),
		(this.stub >= 0) -> id({ g = { ..GCallee.s.g, stubs = GCallee.s.g.stubs + [this.stub: true] }, s = this.s, err = None() }),
		(this.path != "") -> id({ g = { ..GCallee.s.g, imports = GCallee.s.g.imports + [this.path: this.alias] }, s = this.s, err = None() }),
		else -> id({ g = GCallee.s.g, s = this.s, err = None() })
	};
}

// `in<Target>{Param: value, ..}`
proc GInput(s: { g: GGen, c: Call }): GEmit {
	GInput -> GNamedArgs(s = { g = this.s.g, args = this.s.c.args, i = 0, acc = [] });
	GNamedArgs -> id({ g = this.g, s = GoInType(nodes = GInput.s.g.prog.nodes, n = GInput.s.c.target) + "{" + Join(parts = this.parts, sep = ", ") + "}" });
}

proc GNamedArgs(s: { g: GGen, args: []CallArg, i: int, acc: []string }): GParts {
	GNamedArgs switch {
		(this.s.i == this.s.args.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> GValue(s = { g = this.s.g, e = this.s.args[this.s.i].value, want = this.s.args[this.s.i].param })
	};
	GValue -> GNamedArgs(s = { ..GNamedArgs.s, g = this.g, i = GNamedArgs.s.i + 1, acc = GNamedArgs.s.acc + [Exported(s = GNamedArgs.s.args[GNamedArgs.s.i].name) + ": " + this.s] });
}

// ---- Procs ----

// The target's input, then a jump to it.
proc GTransition(s: { g: GGen, pid: int, c: Call }): GGen {
	GTransition -> GInput(s = { g = this.s.g, c = this.s.c });
	// Outputs no later state reads go, so the collector can reclaim them.
	GInput -> id(GW(g = this.g, ls = ["env.in" + Gname(n = GTransition.s.g.prog.nodes[GTransition.s.c.target]) + " = " + this.s] + GoLastReads(g = GTransition.s.g, pid = GTransition.s.pid, c = GTransition.s.c) + ["pc = " + GoPc(nodes = GTransition.s.g.prog.nodes, pid = GTransition.s.pid, n = GTransition.s.c.target), "continue"]));
}

// zeroOut(&env.out<N>) for each node the call reads for the last time.
func GoLastReads(g: GGen, pid: int, c: Call): []string = "go_leaf.rs:go_last_reads";

type GSwitchIn = { g: GGen, pid: int, n: int, arms: []SArm, top: bool, i: int, always: bool };

// `{` or `if <tests> {`, then the bindings, matching p against this.
func GoPatHead(t: Table, p: SPat): []string = "go_leaf.rs:go_pat_head";
// Whether p matches every value.
func GoPatAlways(t: Table, p: SPat): bool = "go_leaf.rs:go_pat_always";

// Arms in order; a transition ends with `continue`, so the first arm that
// matches is taken.
proc GSwitch(s: GSwitchIn): GGen {
	GSwitch switch {
		(this.s.i == this.s.arms.len && this.s.top && !this.s.always) -> id(GW(g = this.s.g, ls = ["return zero, fmt.Errorf(" + Quote(s = QualName(n = this.s.g.prog.nodes[this.s.n]) + ": no match arm for %v") + ", this)"])),
		(this.s.i == this.s.arms.len) -> id(this.s.g),
		else -> id(this.s.arms[this.s.i].test) as T
	};
	T switch {
		Else() -> GBody(s = { g = GSwitch.s.g, pid = GSwitch.s.pid, n = GSwitch.s.n, body = GSwitch.s.arms[GSwitch.s.i].body }) as ElseBody,
		Cond(c) -> GOwn(s = { g = GW(g = GSwitch.s.g, ls = ["{"]), e = c }) as C,
		Pat(p) -> GBody(s = { g = GW(g = GSwitch.s.g, ls = GoPatHead(t = GSwitch.s.g.table, p = p)), pid = GSwitch.s.pid, n = GSwitch.s.n, body = GSwitch.s.arms[GSwitch.s.i].body }) as PatBody
	};
	ElseBody -> GSwitch(s = { ..GSwitch.s, g = this, i = GSwitch.s.i + 1, always = true });
	C -> GBody(s = { g = GW(g = this.g, ls = ["if " + this.s + " {"]), pid = GSwitch.s.pid, n = GSwitch.s.n, body = GSwitch.s.arms[GSwitch.s.i].body }) as CondBody;
	CondBody -> GSwitch(s = { ..GSwitch.s, g = GW(g = this, ls = ["}", "}"]), i = GSwitch.s.i + 1 });
	PatBody -> GSwitch(s = { ..GSwitch.s, g = GW(g = this, ls = ["}"]), i = GSwitch.s.i + 1, always = GoPatAlways(t = GSwitch.s.g.table, p = PatOfTest(t = T)) });
}

proc GBody(s: { g: GGen, pid: int, n: int, body: SBody }): GGen {
	GBody -> id(this.s.body) as B;
	B switch {
		Call(c) -> GTransition(s = { g = GBody.s.g, pid = GBody.s.pid, c = c }),
		Switch(arms) -> GSwitch(s = { g = GBody.s.g, pid = GBody.s.pid, n = GBody.s.n, arms = arms, top = false, i = 0, always = false })
	};
}

// One state of a proc's machine: run the node, keep its output, then its
// edge.
proc GNode(s: { g: GGen, pid: int, n: int }): GGen {
	GNode -> id(this.s.g.prog.nodes[BaseOf(nodes = this.s.g.prog.nodes, n = this.s.n)].kind) as K;
	K switch {
		Proc(_) -> GNodeBody(s = { g = GNode.s.g, pid = GNode.s.pid, n = GNode.s.n, call = "Run" + Gname(n = GNode.s.g.prog.nodes[BaseOf(nodes = GNode.s.g.prog.nodes, n = GNode.s.n)]) }),
		Id(_) | Sig(_) -> GNodeBody(s = { g = GNode.s.g, pid = GNode.s.pid, n = GNode.s.n, call = "" }),
		else -> GCallee(s = { g = GNode.s.g, n = GNode.s.n })
	};
	// A callee error here stops the generator.
	GCallee switch {
		(IsSomeS(m = this.err)) -> id(GoFatal(g = GNode.s.g, msg = UnwrapS(m = this.err))),
		else -> GNodeBody(s = { g = this.g, pid = GNode.s.pid, n = GNode.s.n, call = this.s })
	};
}

// `case pc..:` through `env.out.. = this`.
func GoNodeHead(g: GGen, pid: int, n: int, call: string): []string = "go_leaf.rs:go_node_head";
// The for each's fanOut, through the `{` the collect's transition is in.
func GoFanOut(g: GGen, pid: int, n: int, dim: string): []string = "go_leaf.rs:go_fan_out";

proc GNodeBody(s: { g: GGen, pid: int, n: int, call: string }): GGen {
	GNodeBody switch {
		(this.s.n in GraphOf(n = this.s.g.prog.nodes[this.s.pid]).edges) -> id(GraphOf(n = this.s.g.prog.nodes[this.s.pid]).edges[this.s.n]) as E,
		else -> GCoerce(s = { g = GW(g = this.s.g, ls = GoNodeHead(g = this.s.g, pid = this.s.pid, n = this.s.n, call = this.s.call)), expr = "this", from = NodeRet(nodes = this.s.g.prog.nodes, n = this.s.n), to = ProcRet(n = this.s.g.prog.nodes[this.s.pid]) }) as Ret
	};
	Ret -> id(GW(g = this.g, ls = ["return " + this.s + ", nil"]));
	E switch {
		Call(c) -> GTransition(s = { g = GW(g = GNodeBody.s.g, ls = GoNodeHead(g = GNodeBody.s.g, pid = GNodeBody.s.pid, n = GNodeBody.s.n, call = GNodeBody.s.call)), pid = GNodeBody.s.pid, c = c }),
		Collect(_) -> id(GW(g = GNodeBody.s.g, ls = GoNodeHead(g = GNodeBody.s.g, pid = GNodeBody.s.pid, n = GNodeBody.s.n, call = GNodeBody.s.call) + ["return this, nil"])),
		Match(arms) -> GSwitch(s = { g = GW(g = GNodeBody.s.g, ls = GoNodeHead(g = GNodeBody.s.g, pid = GNodeBody.s.pid, n = GNodeBody.s.n, call = GNodeBody.s.call)), pid = GNodeBody.s.pid, n = GNodeBody.s.n, arms = arms, top = true, i = 0, always = false }),
		ForEach(f) -> GOwn(s = { g = GW(g = GNodeBody.s.g, ls = GoNodeHead(g = GNodeBody.s.g, pid = GNodeBody.s.pid, n = GNodeBody.s.n, call = GNodeBody.s.call)), e = f.dim }) as Dim,
		Spawn(sp) -> GSpawn(s = { g = GW(g = GNodeBody.s.g, ls = GoNodeHead(g = GNodeBody.s.g, pid = GNodeBody.s.pid, n = GNodeBody.s.n, call = GNodeBody.s.call) + ["{"]), branches = sp.branches, i = 0, calls = [] })
	};
	GSpawn -> GTransition(s = { g = GW(g = this.g, ls = GoSpawnLines(g = this.g, sp = E, calls = this.parts)), pid = GNodeBody.s.pid, c = SpawnJoin(e = E) }) as Joined;
	Joined -> id(GW(g = this, ls = ["}"]));
	Dim -> GTransition(s = { g = GW(g = this.g, ls = GoFanOut(g = GNodeBody.s.g, pid = GNodeBody.s.pid, n = GNodeBody.s.n, dim = this.s)), pid = GNodeBody.s.pid, c = CollectCall(g = GraphOf(n = GNodeBody.s.g.prog.nodes[GNodeBody.s.pid]), n = GNodeBody.s.n) }) as Collected;
	Collected -> id(GW(g = this, ls = ["}"]));
}

// Detached branches through spawnDetached, joined ones through joinAll,
// then this: the joined outputs.
func GoSpawnLines(g: GGen, sp: SEdge, calls: []string): []string = "go_leaf.rs:go_spawn_lines";

// A spawn's branches, each a call of its node (emit_spawn in the
// reference): every branch's arguments into variables, and the calls.
proc GSpawn(s: { g: GGen, branches: []SBranch, i: int, calls: []string }): GParts {
	GSpawn switch {
		(this.s.i == this.s.branches.len || IsSomeS(m = this.s.g.fatal)) -> id({ g = this.s.g, parts = this.s.calls }),
		else -> id(this.s.g.prog.nodes[BaseOf(nodes = this.s.g.prog.nodes, n = this.s.branches[this.s.i].call.target)].kind) as K
	};
	K switch {
		Proc(_) -> id({ g = GSpawn.s.g, callee = "Run" + Gname(n = GSpawn.s.g.prog.nodes[BaseOf(nodes = GSpawn.s.g.prog.nodes, n = GSpawn.s.branches[GSpawn.s.i].call.target)]) }) as Called,
		else -> GCallee(s = { g = GSpawn.s.g, n = GSpawn.s.branches[GSpawn.s.i].call.target })
	};
	// A callee error here stops the generator.
	GCallee switch {
		(IsSomeS(m = this.err)) -> id({ g = GoFatal(g = GSpawn.s.g, msg = UnwrapS(m = this.err)), parts = GSpawn.s.calls }),
		else -> id({ g = this.g, callee = this.s }) as Called
	};
	Called -> GSpawnArgs(s = { g = this.g, i = GSpawn.s.i, args = GSpawn.s.branches[GSpawn.s.i].call.args, j = 0, acc = [] });
	GSpawnArgs -> GSpawn(s = { ..GSpawn.s, g = this.g, i = GSpawn.s.i + 1, calls = GSpawn.s.calls + [Called.callee + "(" + Join(parts = ["ctx"] + this.parts, sep = ", ") + ")"] });
}

// `a<i><Arg> := <value>` per argument of branch i; the variables.
proc GSpawnArgs(s: { g: GGen, i: int, args: []CallArg, j: int, acc: []string }): GParts {
	GSpawnArgs switch {
		(this.s.j == this.s.args.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> GValue(s = { g = this.s.g, e = this.s.args[this.s.j].value, want = this.s.args[this.s.j].param })
	};
	GValue -> GSpawnArgs(s = { ..GSpawnArgs.s, g = GW(g = this.g, ls = ["a" + Itoa(i = GSpawnArgs.s.i) + Exported(s = GSpawnArgs.s.args[GSpawnArgs.s.j].name) + " := " + this.s]), j = GSpawnArgs.s.j + 1, acc = GSpawnArgs.s.acc + ["a" + Itoa(i = GSpawnArgs.s.i) + Exported(s = GSpawnArgs.s.args[GSpawnArgs.s.j].name)] });
}

// A region's state machine: a loop over its nodes' states.
proc GLoop(s: { g: GGen, pid: int, r: int }): GGen {
	GLoop -> GNodes(s = { g = GW(g = this.s.g, ls = ["for {", "if err := ctx.Err(); err != nil {", "return zero, err", "}", "switch pc {"]), pid = this.s.pid, nodes = GraphOf(n = this.s.g.prog.nodes[this.s.pid]).regions[this.s.r].nodes, i = 0 });
	GNodes switch {
		(IsSomeS(m = this.fatal)) -> id(this),
		else -> id(GW(g = this, ls = ["default:", "return zero, fmt.Errorf(" + Quote(s = QualName(n = GLoop.s.g.prog.nodes[GLoop.s.pid]) + ": invalid state %d") + ", pc)", "}", "}"]))
	};
}

proc GNodes(s: { g: GGen, pid: int, nodes: []int, i: int }): GGen {
	GNodes switch {
		(this.s.i == this.s.nodes.len || IsSomeS(m = this.s.g.fatal)) -> id(this.s.g),
		else -> GNode(s = { g = this.s.g, pid = this.s.pid, n = this.s.nodes[this.s.i] })
	};
	GNode -> GNodes(s = { ..GNodes.s, g = this, i = GNodes.s.i + 1 });
}

// The env struct, the pc constants, and Run<Proc> through `pc := ..`.
func GoPrelude(g: GGen, pid: int): []string = "go_leaf.rs:go_prelude";

proc GProc(s: { g: GGen, pid: int }): GGen {
	func Opens(g: Graph): []int = "gen_leaf.rs:opens_by_region";
	GProc -> GLoop(s = { g = GW(g = { ..this.s.g, proc_name = QualName(n = this.s.g.prog.nodes[this.s.pid]) }, ls = GoPrelude(g = this.s.g, pid = this.s.pid)), pid = this.s.pid, r = 0 });
	GLoop -> GRegions(s = { g = GW(g = this, ls = ["}", ""]), pid = GProc.s.pid, opens = Opens(g = GraphOf(n = GProc.s.g.prog.nodes[GProc.s.pid])), i = 0 });
}

// run<Proc>Region<r>'s head, through `_ = this`.
func GoRegionHead(g: GGen, pid: int, opener: int): []string = "go_leaf.rs:go_region_head";
// `env.in<Entry> = input` and `pc := ..` for the region opener opens.
func GoRegionEntry(g: GGen, pid: int, opener: int, input: string): []string = "go_leaf.rs:go_region_entry";

// One func per for each region, run per element.
proc GRegions(s: { g: GGen, pid: int, opens: []int, i: int }): GGen {
	func EntryCall(g: Graph, opener: int): Call = "gen_leaf.rs:for_each_call_of";
	GRegions switch {
		(this.s.i == this.s.opens.len || IsSomeS(m = this.s.g.fatal)) -> id(this.s.g),
		else -> GInput(s = { g = GW(g = this.s.g, ls = GoRegionHead(g = this.s.g, pid = this.s.pid, opener = this.s.opens[this.s.i])), c = EntryCall(g = GraphOf(n = this.s.g.prog.nodes[this.s.pid]), opener = this.s.opens[this.s.i]) })
	};
	GInput -> GLoop(s = { g = GW(g = this.g, ls = GoRegionEntry(g = GRegions.s.g, pid = GRegions.s.pid, opener = GRegions.s.opens[GRegions.s.i], input = this.s)), pid = GRegions.s.pid, r = GraphOf(n = GRegions.s.g.prog.nodes[GRegions.s.pid]).opens[GRegions.s.opens[GRegions.s.i]] });
	GLoop -> GRegions(s = { ..GRegions.s, g = GW(g = this, ls = ["}", ""]), i = GRegions.s.i + 1 });
}

// A top-level proc and the procs local to it, parents first.
proc GTree(s: { g: GGen, procs: []int, i: int, acc: string }): GEmit {
	GTree switch {
		(this.s.i == this.s.procs.len || IsSomeS(m = this.s.g.fatal)) -> id({ g = this.s.g, s = this.s.acc }),
		else -> GProc(s = { g = { ..this.s.g, w = [] }, pid = this.s.procs[this.s.i] })
	};
	GProc -> GTree(s = { ..GTree.s, g = this, i = GTree.s.i + 1, acc = GTree.s.acc + Lines(lines = this.w, indent = "\t") });
}

// `<proc>_vandorf.go`
func GoProcFile(n: NodeDecl): string = "go_leaf.rs:go_proc_file";
// context and fmt, then the impls' imports.
func GoProcImports(imports: map[string]string): []GoImport = "go_leaf.rs:go_proc_imports";
// A file of the code package: the header, importing the types package if
// the code mentions it.
func GoFileText(pkg: string, body: string, imports: []GoImport, setup: GoSetup): string = "go_leaf.rs:go_file_text";

// A file per top-level proc.
proc GFiles(s: { g: GGen, package: string, setup: GoSetup, procs: []int, i: int, acc: []GoFile }): { g: GGen, files: []GoFile } {
	func Order(nodes: []NodeDecl, top: []int): []int = "gen_leaf.rs:all_procs_ordered";
	GFiles switch {
		(this.s.i == this.s.procs.len || IsSomeS(m = this.s.g.fatal)) -> id({ g = this.s.g, files = this.s.acc }),
		else -> GTree(s = { g = { ..this.s.g, imports = [:] }, procs = Order(nodes = this.s.g.prog.nodes, top = [this.s.procs[this.s.i]]), i = 0, acc = "" })
	};
	GTree -> GFiles(s = { ..GFiles.s, g = this.g, i = GFiles.s.i + 1, acc = GFiles.s.acc + [{ dir = "", name = GoProcFile(n = GFiles.s.g.prog.nodes[GFiles.s.procs[GFiles.s.i]]), text = GoFileText(pkg = GFiles.s.package, body = this.s, imports = GoProcImports(imports = this.g.imports), setup = GFiles.s.setup), kind = "code" }] });
}

// ---- The whole backend ----

// inputs_vandorf.go, stubs_vandorf.go (if any stubs) and runtime_vandorf.go.
func GoRestFiles(g: GGen, package: string, setup: GoSetup): []GoFile = "go_leaf.rs:go_rest_files";
// The mains, each a package main in its directory; or the first error.
func GoMainFiles(prog: Program, t: Table, package: string, import_base: MaybeStr, mains: []GoMainSpec): GoOut = "go_leaf.rs:go_main_files";

// The Go for a program: files sorted by directory and name, or the first
// error, in the reference's order: the types' import path, names, an error
// that stopped the generator, one from an expression, then the mains.
// http_vandorf.go, if there are servers: the runtime, JSON for every type,
// and a handler per server (src/codegen/go_http.rs).
func GoHttpFiles(prog: Program, t: Table, package: string, setup: GoSetup, servers: []GoServerSpec): GoOut = "go_leaf.rs:go_http_files";
// Each server's package main.
func GoServerMains(package: string, import_base: MaybeStr, servers: []GoServerSpec): GoOut = "go_leaf.rs:go_server_mains";

proc GoGenerate(s: GoGenIn): GoOut {
	func Sorted(files: []GoFile): []GoFile = "go_leaf.rs:go_sort_files";
	GoGenerate -> id(GoSetupOf(package = this.s.package, import_base = this.s.import_base, types_dir = this.s.types_dir)) as Setup;
	Setup switch {
		(IsSomeS(m = this.err)) -> id({ files = [], err = this.err }),
		else -> BuildTable(prog = GoGenerate.s.prog)
	};
	BuildTable switch {
		(IsSomeS(m = GoNameCheck(prog = GoGenerate.s.prog, t = this))) -> id({ files = [], err = GoNameCheck(prog = GoGenerate.s.prog, t = this) }),
		else -> GoTypegen(s = { t = this, pkg = Setup.pkg })
	};
	GoTypegen -> GFiles(s = {
		g = { prog = GoGenerate.s.prog, table = BuildTable, tq = Setup.tq, import_base = GoGenerate.s.import_base, imports = [:], coercions = [:], helpers = [], stubs = [:], failed = None(), fatal = None(), temps = 0, proc_name = "", w = [] },
		package = GoGenerate.s.package, setup = Setup, procs = GoGenerate.s.prog.top, i = 0, acc = []
	});
	GFiles switch {
		(IsSomeS(m = this.g.fatal)) -> id({ files = [], err = this.g.fatal }),
		(IsSomeS(m = this.g.failed)) -> id({ files = [], err = this.g.failed }),
		else -> id(GoHttpFiles(prog = GoGenerate.s.prog, t = BuildTable, package = GoGenerate.s.package, setup = Setup, servers = GoGenerate.s.servers)) as Http
	};
	Http switch {
		(IsSomeS(m = this.err)) -> id(this),
		else -> id(GoMainFiles(prog = GoGenerate.s.prog, t = BuildTable, package = GoGenerate.s.package, import_base = GoGenerate.s.import_base, mains = GoGenerate.s.mains)) as Mains
	};
	Mains switch {
		(IsSomeS(m = this.err)) -> id(this),
		else -> id(GoServerMains(package = GoGenerate.s.package, import_base = GoGenerate.s.import_base, servers = GoGenerate.s.servers)) as Servers
	};
	Servers switch {
		(IsSomeS(m = this.err)) -> id(this),
		else -> id({ files = Sorted(files = [{ dir = Setup.dir, name = "types_vandorf.go", text = GoTypegen, kind = "types" }] + GFiles.files + GoRestFiles(g = GFiles.g, package = GoGenerate.s.package, setup = Setup) + Http.files + Mains.files + this.files), err = None() })
	};
}
