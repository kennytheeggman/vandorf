// The type table shared by the backends (src/codegen/types.rs in the
// reference): one name for every distinct struct or enum shape, so
// backends can emit a named type per shape. Shapes compare structurally
// (field and variant order ignored) and are named after where they first
// appear; a typedef's shape is named after it.

// A type as backends see it: primitives, arrays and maps inline, structs and
// enums by index into the table.
type TyRef = enum { Prim(string), Array(TyRef), Map({ key: TyRef, value: TyRef }), Named(int) };
type RefMember = { name: string, r: TyRef };
type Shape = enum { Struct([]RefMember), Enum([]RefMember) };
// origin: where it was first seen, for doc comments ("return of Bar.Start").
type NamedType = { name: string, shape: Shape, origin: string };
type Alias = { name: string, r: TyRef };

type Table = {
	types: []NamedType,
	// Typedefs without a type of their own: their name and what it names.
	aliases: []Alias,
	by_key: map[string]int,
	// "type:field" stored behind a pointer.
	boxed: map[string]bool,
	// Typedef names, kept for the typedefs themselves.
	reserved: map[string]bool,
	defs: []TypeDef
};

type Registered = { t: Table, r: TyRef };

func Exported(s: string): string = "../sema/sema_leaf.rs:cap";
func WithType(t: Table, n: NamedType): Table = "gen_leaf.rs:with_type";
func WithShape(t: Table, i: int, s: Shape): Table = "gen_leaf.rs:with_shape";
func WithKey(t: Table, key: string, i: int): Table = "gen_leaf.rs:with_key";
// A fresh name based on hint; typedef names are reserved for the typedef
// itself (typedef: the name of the typedef being registered, or "").
func Unique(t: Table, hint: string, typedef: string): string = "gen_leaf.rs:unique";
// The canonical structural key: fields and variants sorted; non-recursive
// typedefs expanded, a recursive one `#id` (except at the top).
func Key(t: Type, defs: []TypeDef): string = "gen_leaf.rs:shape_key";
// Gname: a node's name in generated code (`Bar.Start` -> `BarStart`).
func Gname(n: NodeDecl): string = "gen_leaf.rs:gname";
func IsAliasNode(n: NodeDecl): bool = "../sema/sema_leaf.rs:is_alias";
// Boxes every field i -> j where j leads back to i through fields that hold
// their type directly.
func FindBoxed(t: Table): map[string]bool = "gen_leaf.rs:find_boxed";

// The table for a program: its typedefs first, then every func parameter
// and every node's return, then what each spawn's join receives.
proc BuildTable(prog: Program): Table {
	func Reserved(types: []TypeDef): map[string]bool = "gen_leaf.rs:reserved";
	BuildTable -> TypedefTypes(s = { t = { types = [], aliases = [], by_key = [:], boxed = [:], reserved = Reserved(types = this.prog.types), defs = this.prog.types }, i = 0 });
	TypedefTypes -> NodeTypes(s = { t = this, prog = BuildTable.prog, i = 0 });
	NodeTypes -> JoinedTypes(s = { t = this, prog = BuildTable.prog, joins = SpawnJoins(prog = BuildTable.prog), i = 0 });
	JoinedTypes -> id({ ..this, boxed = FindBoxed(t = this) });
}

type SpawnJoin = { src: int, joined: Type };
// Each spawn's joined type, by proc, spawners in node order.
func SpawnJoins(prog: Program): []SpawnJoin = "gen_leaf.rs:spawn_joins";

proc JoinedTypes(s: { t: Table, prog: Program, joins: []SpawnJoin, i: int }): Table {
	JoinedTypes switch {
		(this.s.i == this.s.joins.len) -> id(this.s.t),
		else -> Register(s = { t = this.s.t, ty = this.s.joins[this.s.i].joined, hint = Gname(n = this.s.prog.nodes[this.s.joins[this.s.i].src]) + "Joined", origin = "joined branches of " + QualName(n = this.s.prog.nodes[this.s.joins[this.s.i].src]) + "'s spawn" })
	};
	Register -> JoinedTypes(s = { t = this.t, prog = JoinedTypes.s.prog, joins = JoinedTypes.s.joins, i = JoinedTypes.s.i + 1 });
}

proc TypedefTypes(s: { t: Table, i: int }): Table {
	TypedefTypes switch {
		(this.s.i == this.s.t.defs.len) -> id(this.s.t),
		else -> Register(s = { t = this.s.t, ty = Named({ id = this.s.i, name = this.s.t.defs[this.s.i].name }), hint = Exported(s = this.s.t.defs[this.s.i].ident), origin = "typedef " + this.s.t.defs[this.s.i].name })
	};
	Register switch {
		{ t = _, r = Named(i) } -> switch {
			(this.t.types[i].name == Exported(s = TypedefTypes.s.t.defs[TypedefTypes.s.i].ident)) -> TypedefTypes(s = { t = this.t, i = TypedefTypes.s.i + 1 }),
			else -> TypedefTypes(s = { t = { ..this.t, aliases = this.t.aliases + [{ name = Exported(s = TypedefTypes.s.t.defs[TypedefTypes.s.i].ident), r = this.r }] }, i = TypedefTypes.s.i + 1 })
		},
		else -> TypedefTypes(s = { t = { ..this.t, aliases = this.t.aliases + [{ name = Exported(s = TypedefTypes.s.t.defs[TypedefTypes.s.i].ident), r = this.r }] }, i = TypedefTypes.s.i + 1 })
	};
}

proc NodeTypes(s: { t: Table, prog: Program, i: int }): Table {
	func ParamsIfFunc(n: NodeDecl): []Member = "gen_leaf.rs:func_params";
	// What a node's types are named after: the node, or for a signature
	// node its proc (`PS` for P's param s, `PArgs` for its output).
	func HintBase(nodes: []NodeDecl, n: int): string = "gen_leaf.rs:hint_base";
	func RetHint(nodes: []NodeDecl, n: int): string = "gen_leaf.rs:ret_hint";
	func RetOrigin(nodes: []NodeDecl, n: int): string = "gen_leaf.rs:ret_origin";
	NodeTypes switch {
		(this.s.i == this.s.prog.nodes.len) -> id(this.s.t),
		else -> RegisterParams(s = { t = this.s.t, ps = ParamsIfFunc(n = this.s.prog.nodes[this.s.i]), g = HintBase(nodes = this.s.prog.nodes, n = this.s.i), q = QualName(n = this.s.prog.nodes[this.s.i]), j = 0 })
	};
	RegisterParams switch {
		(IsAliasNode(n = NodeTypes.s.prog.nodes[NodeTypes.s.i])) -> NodeTypes(s = { t = this, prog = NodeTypes.s.prog, i = NodeTypes.s.i + 1 }),
		else -> Register(s = { t = this, ty = NodeRet(nodes = NodeTypes.s.prog.nodes, n = NodeTypes.s.i), hint = RetHint(nodes = NodeTypes.s.prog.nodes, n = NodeTypes.s.i), origin = RetOrigin(nodes = NodeTypes.s.prog.nodes, n = NodeTypes.s.i) })
	};
	Register -> NodeTypes(s = { t = this.t, prog = NodeTypes.s.prog, i = NodeTypes.s.i + 1 });
}

proc RegisterParams(s: { t: Table, ps: []Member, g: string, q: string, j: int }): Table {
	RegisterParams switch {
		(this.s.j == this.s.ps.len) -> id(this.s.t),
		else -> Register(s = { t = this.s.t, ty = this.s.ps[this.s.j].ty, hint = this.s.g + Exported(s = this.s.ps[this.s.j].name), origin = "parameter " + this.s.ps[this.s.j].name + " of " + this.s.q })
	};
	Register -> RegisterParams(s = { t = this.t, ps = RegisterParams.s.ps, g = RegisterParams.s.g, q = RegisterParams.s.q, j = RegisterParams.s.j + 1 });
}

type RegisterIn = { t: Table, ty: Type, hint: string, origin: string };

// Registers ty and its parts, naming new shapes after hint.
proc Register(s: RegisterIn): Registered {
	Register -> id(this.s.ty) as T;
	T switch {
		Prim(p) -> id({ t = Register.s.t, r = Prim(p) }),
		Array(e) -> Register(s = { t = Register.s.t, ty = e, hint = Register.s.hint + "Item", origin = Register.s.origin }) as Elem,
		Map(m) -> Register(s = { t = Register.s.t, ty = m.key, hint = Register.s.hint + "Key", origin = Register.s.origin }) as Key,
		Named(n) -> switch {
			(!Register.s.t.defs[n.id].recursive && IsStructOrEnum(t = Register.s.t.defs[n.id].ty)) -> RegShape(s = { t = Register.s.t, ty = Register.s.t.defs[n.id].ty, hint = Exported(s = Register.s.t.defs[n.id].ident), origin = "typedef " + n.name, typedef = Exported(s = Register.s.t.defs[n.id].ident), rec = -1 }),
			(!Register.s.t.defs[n.id].recursive) -> Register(s = { t = Register.s.t, ty = Register.s.t.defs[n.id].ty, hint = Exported(s = Register.s.t.defs[n.id].ident), origin = "typedef " + n.name }) as Def,
			(("#" + Itoa(i = n.id)) in Register.s.t.by_key) -> id({ t = Register.s.t, r = Named(Register.s.t.by_key["#" + Itoa(i = n.id)]) }),
			else -> RegShape(s = { t = Register.s.t, ty = Register.s.t.defs[n.id].ty, hint = Exported(s = Register.s.t.defs[n.id].ident), origin = "typedef " + n.name, typedef = Exported(s = Register.s.t.defs[n.id].ident), rec = n.id })
		},
		else -> RegShape(s = { t = Register.s.t, ty = Register.s.ty, hint = Register.s.hint, origin = Register.s.origin, typedef = "", rec = -1 })
	};
	Elem -> id({ t = this.t, r = Array(this.r) });
	Key -> Register(s = { t = this.t, ty = MapValue(t = T), hint = Register.s.hint + "Value", origin = Register.s.origin }) as Val;
	Val -> id({ t = this.t, r = Map({ key = Key.r, value = this.r }) });
	Def -> id(this);
}

func IsStructOrEnum(t: Type): bool = "../sema/sema_leaf.rs:is_struct_or_enum";

// Registers a struct or enum. typedef: the name of the typedef it defines,
// which may use that reserved name (or ""); rec: that typedef's id if its
// references (`#id`) should point here (or -1).
proc RegShape(s: { t: Table, ty: Type, hint: string, origin: string, typedef: string, rec: int }): Registered {
	RegShape -> id(Key(t = this.s.ty, defs = this.s.t.defs)) as K;
	K switch {
		(this in RegShape.s.t.by_key && RegShape.s.rec >= 0) -> id({ t = { ..RegShape.s.t, by_key = RegShape.s.t.by_key + ["#" + Itoa(i = RegShape.s.rec): RegShape.s.t.by_key[this]] }, r = Named(RegShape.s.t.by_key[this]) }),
		(this in RegShape.s.t.by_key) -> id({ t = RegShape.s.t, r = Named(RegShape.s.t.by_key[this]) }),
		(RegShape.s.rec >= 0) -> Parts(s = { t = WithType(t = WithKey(t = { ..RegShape.s.t, by_key = RegShape.s.t.by_key + ["#" + Itoa(i = RegShape.s.rec): RegShape.s.t.types.len] }, key = this, i = RegShape.s.t.types.len), n = { name = Unique(t = RegShape.s.t, hint = RegShape.s.hint, typedef = RegShape.s.typedef), shape = Struct([]), origin = RegShape.s.origin }), ms = MembersOf(t = RegShape.s.ty), hint = RegShape.s.hint, origin = RegShape.s.origin, i = 0, acc = [] }),
		// Reserve the slot so the parent is listed before its parts.
		else -> Parts(s = { t = WithType(t = { ..RegShape.s.t, by_key = RegShape.s.t.by_key + [this: RegShape.s.t.types.len] }, n = { name = Unique(t = RegShape.s.t, hint = RegShape.s.hint, typedef = RegShape.s.typedef), shape = Struct([]), origin = RegShape.s.origin }), ms = MembersOf(t = RegShape.s.ty), hint = RegShape.s.hint, origin = RegShape.s.origin, i = 0, acc = [] })
	};
	Parts switch {
		(IsStruct(t = RegShape.s.ty)) -> id({ t = WithShape(t = this.t, i = RegShape.s.t.types.len, s = Struct(this.ms)), r = Named(RegShape.s.t.types.len) }),
		else -> id({ t = WithShape(t = this.t, i = RegShape.s.t.types.len, s = Enum(this.ms)), r = Named(RegShape.s.t.types.len) })
	};
}

proc Parts(s: { t: Table, ms: []Member, hint: string, origin: string, i: int, acc: []RefMember }): { t: Table, ms: []RefMember } {
	Parts switch {
		(this.s.i == this.s.ms.len) -> id({ t = this.s.t, ms = this.s.acc }),
		else -> Register(s = { t = this.s.t, ty = this.s.ms[this.s.i].ty, hint = this.s.hint + Exported(s = this.s.ms[this.s.i].name), origin = this.s.origin })
	};
	Register -> Parts(s = { t = this.t, ms = Parts.s.ms, hint = Parts.s.hint, origin = Parts.s.origin, i = Parts.s.i + 1, acc = Parts.s.acc + [{ name = Parts.s.ms[Parts.s.i].name, r = this.r }] });
}

// The backend view of a type: every struct and enum of a checked program is
// in the table.
