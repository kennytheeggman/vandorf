// http.rs and server executables (src/codegen/rust.rs: http,
// server_artifact in the reference): Json for every type, a call per proc
// a route runs, and a handler per server.

type Route = { method: string, path: string, proc: string };
// file: as the server's source file reaches it; ctype: its content type.
type StaticFile = { url: string, file: string, ctype: string };
// path: the server's file, relative to the crate's src/.
// routes: JSON in and out; raw: the proc takes the request, returns the response.
// setup: a proc run before serving, whose result each route takes as ctx ("" if none).
type ServerSpec = { name: string, addr: string, setup: string, routes: []Route, raw: []Route, statics: []StaticFile, path: string };

func HttpRuntime(n: int): string = "gen_leaf.rs:http_runtime";
// A server's name as part of a Rust identifier: `web-api` -> `web_api`.
func ServerIdent(name: string): string = "gen_leaf.rs:server_ident";
func SortStrs(xs: []string): []string = "gen_leaf.rs:sort_strs";
func FindTop(prog: Program, name: string): int = "gen_leaf.rs:find_top";
// "" or `<server>_`: the prefix of a server's calls (its own if it has a setup).
func Own(srv: ServerSpec): string = "gen_leaf.rs:own_prefix";

// http.rs, or why it can't be written.
proc RustHttp(s: { g: RGen, servers: []ServerSpec }): { text: string, err: MaybeStr } {
	// The procs routes of servers without a setup run (those with one get
	// calls of their own).
	func RouteProcs(servers: []ServerSpec): []string = "gen_leaf.rs:route_procs";
	RustHttp -> JsonImpls(s = { g = this.s.g, i = 0, acc = [
		L("// Code generated by vandorf. DO NOT EDIT."),
		L("//! HTTP servers for the procs: requests and results as JSON."),
		L("#![allow(unused, non_snake_case, clippy::all)]"),
		L(""),
		L("use super::types;"),
		Raw(HttpRuntime(n = 0)),
		L("")
	] });
	JsonImpls -> HttpCalls(s = { g = RustHttp.s.g, servers = RustHttp.s.servers, procs = SortStrs(xs = RouteProcs(servers = RustHttp.s.servers)), i = 0, acc = this });
	HttpCalls switch {
		{ lines = _, err = Some(e) } -> id({ text = "", err = Some(e) }),
		else -> RawCalls(s = { g = RustHttp.s.g, servers = RustHttp.s.servers, procs = SortStrs(xs = RawProcs(servers = RustHttp.s.servers)), i = 0, acc = this.lines })
	};
	func RawProcs(servers: []ServerSpec): []string = "gen_leaf.rs:raw_procs";
	RawCalls switch {
		{ lines = _, err = Some(e) } -> id({ text = "", err = Some(e) }),
		else -> SetupCalls(g = RustHttp.s.g, servers = RustHttp.s.servers)
	};
	// A server with a setup proc, for each server that has one: its context,
	// setup_<server> to run the setup before serving, and a call per route
	// and raw route passing the context as ctx (never read from the request).
	func SetupCalls(g: RGen, servers: []ServerSpec): { lines: []Line, err: MaybeStr } = "gen_leaf.rs:setup_calls";
	SetupCalls switch {
		{ lines = _, err = Some(e) } -> id({ text = "", err = Some(e) }),
		else -> Handlers(s = { g = RustHttp.s.g, servers = RustHttp.s.servers, i = 0, acc = RawCalls.lines + this.lines })
	};
	Handlers -> id({ text = Lines(lines = this, indent = "    "), err = None() });
}

func Q2(s: string): string = "gen_leaf.rs:quote_twice";

// `impl Json` for each type of the table.
proc JsonImpls(s: { g: RGen, i: int, acc: []Line }): []Line {
	JsonImpls switch {
		(this.s.i == this.s.g.table.types.len) -> id(this.s.acc),
		else -> id(this.s.g.table.types[this.s.i].shape) as S
	};
	S switch {
		Struct(fs) -> StructJson(s = { name = "types::" + JsonImpls.s.g.table.types[JsonImpls.s.i].name, tname = JsonImpls.s.g.table.types[JsonImpls.s.i].name, fs = fs, i = 0, to = [], from = [] }) as SJ,
		Enum(vs) -> EnumJson(s = { name = "types::" + JsonImpls.s.g.table.types[JsonImpls.s.i].name, tname = JsonImpls.s.g.table.types[JsonImpls.s.i].name, vs = vs, i = 0, to = [], bare = [], payload = [] }) as EJ
	};
	SJ -> id(this) as Impl;
	EJ -> id(this) as Impl;
	Impl -> JsonImpls(s = { ..JsonImpls.s, i = JsonImpls.s.i + 1, acc = JsonImpls.s.acc + [L("impl Json for types::" + JsonImpls.s.g.table.types[JsonImpls.s.i].name + " {")] + this + [L("}"), L("")] });
}

proc StructJson(s: { name: string, tname: string, fs: []RefMember, i: int, to: []Line, from: []Line }): []Line {
	func Comma(i: int): string = "gen_leaf.rs:comma";
	StructJson switch {
		(this.s.i == this.s.fs.len) -> id([L("fn to_json(&self, out: &mut String) {"), L("out.push('{');")] + this.s.to + [L("out.push('}');"), L("}"),
			L("fn from_json(v: &Value) -> Result<Self, String> {"), L("let fs = v.object(" + Quote(s = this.s.tname) + ")?;"), L("Ok(" + this.s.name + " {")] + this.s.from + [L("})"), L("}")]),
		else -> StructJson(s = { ..this.s, i = this.s.i + 1,
			to = this.s.to + [L("out.push_str(" + Quote(s = Comma(i = this.s.i) + Quote(s = this.s.fs[this.s.i].name) + ":") + ");"), L("self." + RustIdent(s = this.s.fs[this.s.i].name) + ".to_json(out);")],
			from = this.s.from + [L(RustIdent(s = this.s.fs[this.s.i].name) + ": Json::from_json(field(fs, " + Quote(s = this.s.fs[this.s.i].name) + ")?).map_err(|e| format!(\"" + this.s.fs[this.s.i].name + ": {e}\"))?,")] })
	};
}

proc EnumJson(s: { name: string, tname: string, vs: []RefMember, i: int, to: []Line, bare: []Line, payload: []Line }): []Line {
	func IsVoidRef(r: TyRef): bool = "gen_leaf.rs:is_void_ref";
	EnumJson switch {
		(this.s.i == this.s.vs.len) -> id([L("fn to_json(&self, out: &mut String) {"), L("match self {")] + this.s.to + [L("}"), L("}"),
			L("fn from_json(v: &Value) -> Result<Self, String> {"), L("match v {"), L("Value::Str(tag) => match tag.as_str() {")] + this.s.bare + [
			L("t => Err(format!(\"" + this.s.tname + " has no variant {t} without a payload\")),"), L("},"),
			L("Value::Obj(fs) if fs.len() == 1 => match fs[0].0.as_str() {")] + this.s.payload + [
			L("t => Err(format!(\"" + this.s.tname + " has no variant {t} with a payload\")),"), L("},"),
			L("_ => Err(" + Quote(s = "expected a variant of " + this.s.tname + ": \"Tag\" or {\"Tag\": payload}") + ".into()),"), L("}"), L("}")]),
		(IsVoidRef(r = this.s.vs[this.s.i].r)) -> EnumJson(s = { ..this.s, i = this.s.i + 1,
			to = this.s.to + [L(this.s.name + "::" + RustIdent(s = this.s.vs[this.s.i].name) + " => out.push_str(" + Q2(s = this.s.vs[this.s.i].name) + "),")],
			bare = this.s.bare + [L(Quote(s = this.s.vs[this.s.i].name) + " => Ok(" + this.s.name + "::" + RustIdent(s = this.s.vs[this.s.i].name) + "),")] }),
		else -> EnumJson(s = { ..this.s, i = this.s.i + 1,
			to = this.s.to + [L(this.s.name + "::" + RustIdent(s = this.s.vs[this.s.i].name) + "(p) => {"), L("out.push_str(" + Quote(s = "{" + Quote(s = this.s.vs[this.s.i].name) + ":") + ");"), L("p.to_json(out);"), L("out.push('}');"), L("}")],
			payload = this.s.payload + [L(Quote(s = this.s.vs[this.s.i].name) + " => Ok(" + this.s.name + "::" + RustIdent(s = this.s.vs[this.s.i].name) + "(Json::from_json(&fs[0].1)?)),")] })
	};
}

// A call per proc a route runs: the request's parameters decoded, the proc
// run, its result encoded.
proc HttpCalls(s: { g: RGen, servers: []ServerSpec, procs: []string, i: int, acc: []Line }): { lines: []Line, err: MaybeStr } {
	func Decodes(g: RGen, pid: int): []Line = "gen_leaf.rs:http_decodes";
	func ArgNames(g: RGen, pid: int): string = "gen_leaf.rs:http_args";
	func ServerOf(servers: []ServerSpec, proc: string): string = "gen_leaf.rs:server_of";
	HttpCalls switch {
		(this.s.i == this.s.procs.len) -> id({ lines = this.s.acc, err = None() }),
		(FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i]) < 0) -> id({ lines = [], err = Some("http server " + ServerOf(servers = this.s.servers, proc = this.s.procs[this.s.i]) + " runs proc " + this.s.procs[this.s.i] + ", but there is no top-level proc " + this.s.procs[this.s.i]) }),
		else -> HttpCalls(s = { ..this.s, i = this.s.i + 1, acc = this.s.acc + [
			L("/// Runs proc " + this.s.procs[this.s.i] + " with the request's parameters."),
			L("fn call_" + SnakeG(n = this.s.g.prog.nodes[FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i])]) + "(params: &Value) -> Result<String, (u16, String)> {")
		] + Decodes(g = this.s.g, pid = FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i])) + [
			L("let result = super::run_" + SnakeG(n = this.s.g.prog.nodes[FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i])]) + "(" + ArgNames(g = this.s.g, pid = FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i])) + ").map_err(|e| (500, e.to_string()))?;"),
			L("Ok(json(&result))"), L("}"), L("")
		] })
	};
}

// A call per proc a raw route runs: the request as the proc's struct, its
// result as the response.
proc RawCalls(s: { g: RGen, servers: []ServerSpec, procs: []string, i: int, acc: []Line }): { lines: []Line, err: MaybeStr } {
	func ServerOf(servers: []ServerSpec, proc: string): string = "gen_leaf.rs:raw_server_of";
	// Whether proc pid takes a raw request and returns a raw response; or the
	// error saying what it must.
	func ShapeError(prog: Program, pid: int, server: string, name: string): MaybeStr = "gen_leaf.rs:raw_shape_error";
	func ParamType(g: RGen, pid: int): string = "gen_leaf.rs:raw_param_type";
	RawCalls switch {
		(this.s.i == this.s.procs.len) -> id({ lines = this.s.acc, err = None() }),
		(FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i]) < 0) -> id({ lines = [], err = Some("http server " + ServerOf(servers = this.s.servers, proc = this.s.procs[this.s.i]) + " runs proc " + this.s.procs[this.s.i] + ", but there is no top-level proc " + this.s.procs[this.s.i]) }),
		(IsSomeS(m = ShapeError(prog = this.s.g.prog, pid = FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i]), server = ServerOf(servers = this.s.servers, proc = this.s.procs[this.s.i]), name = this.s.procs[this.s.i]))) -> id({ lines = [], err = ShapeError(prog = this.s.g.prog, pid = FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i]), server = ServerOf(servers = this.s.servers, proc = this.s.procs[this.s.i]), name = this.s.procs[this.s.i]) }),
		else -> RawCalls(s = { ..this.s, i = this.s.i + 1, acc = this.s.acc + [
			L("/// Runs proc " + this.s.procs[this.s.i] + " on the raw request."),
			L("fn raw_" + SnakeG(n = this.s.g.prog.nodes[FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i])]) + "(req: &Request) -> Response {"),
			L("let r = " + ParamType(g = this.s.g, pid = FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i])) + " {"),
			L("method: types::Str::from(req.method.as_str()),"),
			L("path: types::Str::from(req.path.as_str()),"),
			L("query: query_pairs(&req.query).into_iter().map(|(k, v)| (types::Str::from(k.as_str()), types::Str::from(v.as_str()))).collect(),"),
			L("headers: req.headers.iter().map(|(k, v)| (types::Str::from(k.as_str()), types::Str::from(v.as_str()))).collect(),"),
			L("body: types::Str::from(req.body.as_str()),"),
			L("};"),
			L("match super::run_" + SnakeG(n = this.s.g.prog.nodes[FindTop(prog = this.s.g.prog, name = this.s.procs[this.s.i])]) + "(r) {"),
			L("Ok(res) => Response {"),
			L("status: res.status as u16,"),
			L("headers: res.headers.iter().map(|(k, v)| (k.to_string(), v.to_string())).collect(),"),
			L("body: res.body.as_bytes().to_vec(),"),
			L("},"),
			L("Err(e) => error_response(500, &e.to_string()),"),
			L("}"), L("}"), L("")
		] })
	};
}

proc Handlers(s: { g: RGen, servers: []ServerSpec, i: int, acc: []Line }): []Line {
	Handlers switch {
		(this.s.i == this.s.servers.len) -> id(this.s.acc),
		else -> RouteLines(s = { g = this.s.g, routes = this.s.servers[this.s.i].routes, call = "json_route(req, call_" + Own(srv = this.s.servers[this.s.i]), close = ")", i = 0, acc = [] }) as Json
	};
	Json -> RouteLines(s = { g = Handlers.s.g, routes = Handlers.s.servers[Handlers.s.i].raw, call = "raw_" + Own(srv = Handlers.s.servers[Handlers.s.i]), close = "(req)", i = 0, acc = this }) as Raw;
	Raw -> Handlers(s = { ..Handlers.s, i = Handlers.s.i + 1, acc = Handlers.s.acc + [
		L("/// The routes of http server " + Handlers.s.servers[Handlers.s.i].name + "."),
		L("pub fn handle_" + ServerIdent(name = Handlers.s.servers[Handlers.s.i].name) + "(req: &Request) -> Option<Response> {"),
		L("match (req.method.as_str(), req.path.as_str()) {")
	] + this + [L("_ => None,"), L("}"), L("}"), L("")] });
}

proc RouteLines(s: { g: RGen, routes: []Route, call: string, close: string, i: int, acc: []Line }): []Line {
	RouteLines switch {
		(this.s.i == this.s.routes.len) -> id(this.s.acc),
		else -> RouteLines(s = { ..this.s, i = this.s.i + 1, acc = this.s.acc + [L("(" + Quote(s = this.s.routes[this.s.i].method) + ", " + Quote(s = this.s.routes[this.s.i].path) + ") => Some(" + this.s.call + SnakeG(n = this.s.g.prog.nodes[FindTop(prog = this.s.g.prog, name = this.s.routes[this.s.i].proc)]) + this.s.close + "),")] })
	};
}

// A server's executable: its routes and static files. Its directory
// relative to the module, file name and text.
proc RustServer(s: { srv: ServerSpec, module_dir: MaybeStr, krate: string }): { dir: string, file: string, text: string, err: MaybeStr } {
	// The directory, relative to the module, of a file under src/.
	func MainDir(module_dir: string, path: string): { dir: string, file: string } = "gen_leaf.rs:main_dir";
	RustServer -> id(this.s.module_dir) as D;
	D switch {
		Some(dir) -> ModulePath(file = dir) as MP,
		else -> id({ dir = "", file = "", text = "", err = Some(RustServer.s.srv.path + " goes in the crate's src/, so the output's place under it must be known: run inside a crate or pass --module-dir") })
	};
	MP switch {
		Some(mp) -> switch {
			(RustServer.s.krate == "") -> id({ dir = "", file = "", text = "", err = Some(RustServer.s.srv.path + " serves the procs through the library crate, whose name is unknown: run inside a crate with a src/lib.rs") }),
			else -> ServerLines(s = { srv = RustServer.s.srv, http = ReplaceCrate(path = mp, krate = RustServer.s.krate) + "::http", i = 0, acc = [] })
		},
		else -> id({ dir = "", file = "", text = "", err = Some(RustServer.s.srv.path + " goes in the crate's src/, so the output's place under it must be known: run inside a crate or pass --module-dir") })
	};
	ServerLines -> id({ dir = MainDir(module_dir = UnwrapS(m = D), path = RustServer.s.srv.path).dir, file = MainDir(module_dir = UnwrapS(m = D), path = RustServer.s.srv.path).file, text = Lines(lines = this, indent = "    "), err = None() });
}

func ReplaceCrate(path: string, krate: string): string = "gen_leaf.rs:replace_crate";

proc ServerLines(s: { srv: ServerSpec, http: string, i: int, acc: []Line }): []Line {
	func RouteDocs(srv: ServerSpec): []Line = "gen_leaf.rs:route_docs";
	// A server's main: run, or run_setup if it has a setup.
	func RunCall(srv: ServerSpec, http: string): string = "gen_leaf.rs:run_call";
	ServerLines switch {
		(this.s.i == this.s.srv.statics.len) -> id([
			L("// Code generated by vandorf. DO NOT EDIT."),
			L("//! HTTP server " + this.s.srv.name + " on " + this.s.srv.addr + " (or --addr host:port):"),
			L("//!")
		] + RouteDocs(srv = this.s.srv) + [L(""), L("static STATICS: &[" + this.s.http + "::Static] = &[")] + this.s.acc + [
			L("];"), L(""), L("fn main() {"),
			L(RunCall(srv = this.s.srv, http = this.s.http)),
			L("}")
		]),
		else -> ServerLines(s = { ..this.s, i = this.s.i + 1, acc = this.s.acc + [L("(" + Quote(s = this.s.srv.statics[this.s.i].url) + ", " + Quote(s = this.s.srv.statics[this.s.i].ctype) + ", include_str!(" + Quote(s = this.s.srv.statics[this.s.i].file) + ")),")] })
	};
}
