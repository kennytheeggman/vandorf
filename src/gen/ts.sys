// The TypeScript backend, for the [react] target: types.ts, a type per shape
// in the shared type table; client.ts, a typed function per route of each
// HTTP server, speaking the servers' JSON; and hooks.ts, a React hook per
// route. types.ts and client.ts are framework-neutral; React is only in
// hooks.ts.

// A server as the client sees it: its name, its setup proc ("" if none),
// whose routes' procs take a ctx the request doesn't carry, and its JSON
// routes.
type TsServer = { name: string, setup: string, routes: []Route };
// api_base: put before each route's path in the client's URLs.
type TsGenIn = { prog: Program, api_base: string, servers: []TsServer };
// name: the file's name in the output directory. kind: types or code.
type TsFile = { name: string, text: string, kind: string };
type TsOut = { files: []TsFile, err: MaybeStr };
// A route as the client calls it: its function's and its hook's names, its
// server, method and path, the proc it runs (pid: its node) and the
// parameters its request carries.
type TsRoute = { name: string, hook: string, server: string, method: string, path: string, proc: string, pid: int, params: []Member };

// Writes a table type as TypeScript: int and float as number, bool as
// boolean, string and void as themselves, arrays as `readonly T[]`, maps as
// `ReadonlyMap<K, V>`, and named types by their table name after qual.
func TsRender(t: Table, r: TyRef, qual: string): string = "ts_leaf.rs:ts_render";
// Writes a vandorf type as TsRender does, through the table.
func TsType(t: Table, ty: Type, qual: string): string = "ts_leaf.rs:ts_type";
// Writes a string as a TypeScript string literal, escaped as JSON.
func TsQuote(s: string): string = "ts_leaf.rs:ts_quote";
func TyRefOf(t: Table, ty: Type): TyRef = "gen_leaf.rs:get";

// ---- types.ts ----

// Writes a type's doc comment: its typedef's (or "A typedef." if it has
// none), or "The type of the <origin>." for a shape named where it first
// appears.
func TsDoc(t: Table, n: NamedType): []Line = "ts_leaf.rs:ts_doc";
// Writes the doc comment of the typedef alias `name`: its typedef's, or "A
// typedef.".
func TsAliasDoc(t: Table, name: string): []Line = "ts_leaf.rs:ts_alias_doc";
// Writes an enum's variant as a member of its union: `{ readonly tag:
// "Tag"; readonly value: T }`, without value if it has no payload.
func TsVariant(t: Table, m: RefMember): string = "ts_leaf.rs:ts_variant";

// Generates types.ts: an interface per struct and a union per enum in the
// table, named as the Go and Rust backends name them, then the typedef
// aliases.
proc TsTypegen(t: Table): string {
	TsTypegen -> TsTypeLines(s = { t = this.t, i = 0, acc = [
		L("// Code generated by vandorf. DO NOT EDIT."),
		L("// The program's types, named as in its Go and Rust: structs as interfaces,"),
		L("// enums as unions discriminated by tag, arrays and maps read-only."),
		L("")
	] });
	TsTypeLines -> TsAliasLines(s = { t = TsTypegen.t, i = 0, acc = this });
	TsAliasLines -> id(Lines(lines = this, indent = "  "));
}

// Writes each named shape in the table with its doc comment: a struct as an
// interface of read-only fields, an enum as a union of `{ tag, value }`.
proc TsTypeLines(s: { t: Table, i: int, acc: []Line }): []Line {
	TsTypeLines switch {
		(this.s.i == this.s.t.types.len) -> id(this.s.acc),
		else -> id(this.s.t.types[this.s.i].shape) as S
	};
	S switch {
		Struct(fs) -> TsFieldLines(s = { t = TsTypeLines.s.t, ms = fs, j = 0, acc = TsTypeLines.s.acc + TsDoc(t = TsTypeLines.s.t, n = TsTypeLines.s.t.types[TsTypeLines.s.i]) + [L("export interface " + TsTypeLines.s.t.types[TsTypeLines.s.i].name + " {")] }) as Fs,
		Enum(vs) -> TsVariantLines(s = { t = TsTypeLines.s.t, ms = vs, j = 0, acc = TsTypeLines.s.acc + TsDoc(t = TsTypeLines.s.t, n = TsTypeLines.s.t.types[TsTypeLines.s.i]) + [L("export type " + TsTypeLines.s.t.types[TsTypeLines.s.i].name + " =")] }) as Vs
	};
	Fs -> TsTypeLines(s = { ..TsTypeLines.s, i = TsTypeLines.s.i + 1, acc = this + [L("}"), L("")] });
	Vs -> TsTypeLines(s = { ..TsTypeLines.s, i = TsTypeLines.s.i + 1, acc = this + [L("")] });
}

// Writes a struct's fields as `readonly name: T;`.
proc TsFieldLines(s: { t: Table, ms: []RefMember, j: int, acc: []Line }): []Line {
	TsFieldLines switch {
		(this.s.j == this.s.ms.len) -> id(this.s.acc),
		else -> TsFieldLines(s = { ..this.s, j = this.s.j + 1, acc = this.s.acc + [L("readonly " + this.s.ms[this.s.j].name + ": " + TsRender(t = this.s.t, r = this.s.ms[this.s.j].r, qual = "") + ";")] })
	};
}

// Writes an enum's variants as the members of its union, one per line; an
// enum without variants is never.
proc TsVariantLines(s: { t: Table, ms: []RefMember, j: int, acc: []Line }): []Line {
	TsVariantLines switch {
		(this.s.ms.len == 0) -> id(this.s.acc + [Raw("  never;\n")]),
		(this.s.j == this.s.ms.len) -> id(this.s.acc),
		(this.s.j + 1 == this.s.ms.len) -> TsVariantLines(s = { ..this.s, j = this.s.j + 1, acc = this.s.acc + [Raw("  | " + TsVariant(t = this.s.t, m = this.s.ms[this.s.j]) + ";\n")] }),
		else -> TsVariantLines(s = { ..this.s, j = this.s.j + 1, acc = this.s.acc + [Raw("  | " + TsVariant(t = this.s.t, m = this.s.ms[this.s.j]) + "\n")] })
	};
}

// Writes each typedef alias as `export type Name = T;`, with its doc
// comment.
proc TsAliasLines(s: { t: Table, i: int, acc: []Line }): []Line {
	TsAliasLines switch {
		(this.s.i == this.s.t.aliases.len) -> id(this.s.acc),
		else -> TsAliasLines(s = { t = this.s.t, i = this.s.i + 1, acc = this.s.acc + TsAliasDoc(t = this.s.t, name = this.s.t.aliases[this.s.i].name) + [L("export type " + this.s.t.aliases[this.s.i].name + " = " + TsRender(t = this.s.t, r = this.s.t.aliases[this.s.i].r, qual = "") + ";"), L("")] })
	};
}

// ---- client.ts: JSON ----

// Writes a function encoding a value of a table type as the servers' JSON:
// a named type's `$enc_<Name>`, the runtime's for the rest
// (`$encList($enc_Shape)`).
func TsEnc(t: Table, r: TyRef): string = "ts_leaf.rs:ts_enc";
// Writes a function decoding a value of a table type from the servers'
// JSON, given where the value is, for errors: `$dec_<Name>`, or the
// runtime's (`$decList($dec_Shape)`).
func TsDec(t: Table, r: TyRef): string = "ts_leaf.rs:ts_dec";

// Writes an encoder and a decoder for each named shape in the table:
// `$enc_<Name>`, from its type in types.ts to the servers' JSON, and
// `$dec_<Name>`, back.
proc TsCodecs(s: { t: Table, i: int, acc: []Line }): []Line {
	TsCodecs switch {
		(this.s.i == this.s.t.types.len) -> id(this.s.acc),
		else -> id(this.s.t.types[this.s.i].shape) as S
	};
	S switch {
		Struct(fs) -> TsStructCodec(s = { t = TsCodecs.s.t, name = TsCodecs.s.t.types[TsCodecs.s.i].name, ms = fs, j = 0, enc = [], dec = [] }) as SC,
		Enum(vs) -> TsEnumCodec(s = { t = TsCodecs.s.t, name = TsCodecs.s.t.types[TsCodecs.s.i].name, ms = vs, j = 0, enc = [], dec = [] }) as EC
	};
	SC -> TsCodecs(s = { ..TsCodecs.s, i = TsCodecs.s.i + 1, acc = TsCodecs.s.acc + this });
	EC -> TsCodecs(s = { ..TsCodecs.s, i = TsCodecs.s.i + 1, acc = TsCodecs.s.acc + this });
}

// A shape's codec being written: its name and members, the next member (j),
// and the encoder's and the decoder's lines so far.
type TsCodecIn = { t: Table, name: string, ms: []RefMember, j: int, enc: []Line, dec: []Line };

// Picks some if n isn't 0, none if it is: a codec of a shape without
// members names nothing it doesn't read (a strict tsconfig's
// noUnusedLocals and noUnusedParameters refuse that).
func TsPick(n: int, none: string, some: string): string = "ts_leaf.rs:ts_pick";

// Writes a struct's codec: a JSON object with each field by name, encoded
// and decoded at its type. Decoding fails on a missing field and ignores
// others, as the servers do.
proc TsStructCodec(s: TsCodecIn): []Line {
	TsStructCodec switch {
		(this.s.j == this.s.ms.len) -> id([
			L("export function $enc_" + this.s.name + "(" + TsPick(n = this.s.ms.len, none = "_x", some = "x") + ": $t." + this.s.name + "): unknown {"),
			L("return {")
		] + this.s.enc + [
			L("};"),
			L("}"),
			L(""),
			L("export function $dec_" + this.s.name + "(v: unknown, at: string): $t." + this.s.name + " {"),
			L(TsPick(n = this.s.ms.len, none = "", some = "const o = ") + "$object(v, at);"),
			L("return {")
		] + this.s.dec + [
			L("};"),
			L("}"),
			L("")
		]),
		else -> TsStructCodec(s = { ..this.s, j = this.s.j + 1,
			enc = this.s.enc + [L(TsQuote(s = this.s.ms[this.s.j].name) + ": " + TsEnc(t = this.s.t, r = this.s.ms[this.s.j].r) + "(x." + this.s.ms[this.s.j].name + "),")],
			dec = this.s.dec + [L(this.s.ms[this.s.j].name + ": " + TsDec(t = this.s.t, r = this.s.ms[this.s.j].r) + "($field(o, " + TsQuote(s = this.s.ms[this.s.j].name) + ", at), at + " + TsQuote(s = "." + this.s.ms[this.s.j].name) + "),")] })
	};
}

// Writes an enum's codec: a variant without a payload as `"Tag"`, one with as
// `{"Tag": payload}`, as the servers write them. Decoding fails on anything
// else.
proc TsEnumCodec(s: TsCodecIn): []Line {
	func IsVoidRef(r: TyRef): bool = "gen_leaf.rs:is_void_ref";
	TsEnumCodec switch {
		(this.s.j == this.s.ms.len) -> id([
			L("export function $enc_" + this.s.name + "(x: $t." + this.s.name + "): unknown {")
		] + this.s.enc + [
			L("return $notA(x, " + TsQuote(s = this.s.name) + ");"),
			L("}"),
			L(""),
			L("export function $dec_" + this.s.name + "(v: unknown, at: string): $t." + this.s.name + " {"),
			L(TsPick(n = this.s.ms.len, none = "", some = "const [tag, p] = ") + "$variant(v, at);")
		] + this.s.dec + [
			L("return $noVariant(v, at, " + TsQuote(s = this.s.name) + ");"),
			L("}"),
			L("")
		]),
		(IsVoidRef(r = this.s.ms[this.s.j].r)) -> TsEnumCodec(s = { ..this.s, j = this.s.j + 1,
			enc = this.s.enc + [L("if (x.tag === " + TsQuote(s = this.s.ms[this.s.j].name) + ") return " + TsQuote(s = this.s.ms[this.s.j].name) + ";")],
			dec = this.s.dec + [L("if (tag === " + TsQuote(s = this.s.ms[this.s.j].name) + " && p === $bare) return { tag: " + TsQuote(s = this.s.ms[this.s.j].name) + " };")] }),
		else -> TsEnumCodec(s = { ..this.s, j = this.s.j + 1,
			enc = this.s.enc + [L("if (x.tag === " + TsQuote(s = this.s.ms[this.s.j].name) + ") return { " + TsQuote(s = this.s.ms[this.s.j].name) + ": " + TsEnc(t = this.s.t, r = this.s.ms[this.s.j].r) + "(x.value) };")],
			dec = this.s.dec + [L("if (tag === " + TsQuote(s = this.s.ms[this.s.j].name) + " && p !== $bare) return { tag: " + TsQuote(s = this.s.ms[this.s.j].name) + ", value: " + TsDec(t = this.s.t, r = this.s.ms[this.s.j].r) + "(p, at + " + TsQuote(s = "." + this.s.ms[this.s.j].name) + ") };")] })
	};
}

// ---- client.ts and hooks.ts: routes ----

// Lists the parameters a route's request carries: proc pid's, without the
// ctx a server with a setup fills itself.
func TsRouteParams(prog: Program, pid: int, setup: bool): []Member = "ts_leaf.rs:ts_route_params";
// Names a route's client function after its proc: `Measure` -> `measure`,
// with `_` after a name JavaScript reserves (`delete_`).
func TsFuncName(proc: string): string = "ts_leaf.rs:ts_func_name";
// Finds two routes whose client functions would have the same name: the
// error naming them, or none.
func TsClash(routes: []TsRoute): MaybeStr = "ts_leaf.rs:ts_clash";
// Writes the type of a route's arguments: an object of its request's
// parameters, `{ readonly name: T; .. }`, or `Record<string, never>` for
// none.
func TsArgsType(t: Table, params: []Member): string = "ts_leaf.rs:ts_args_type";
// Writes the parameter a route's function takes its arguments as: `args`
// of their type, or `_args` defaulting to `{}` for none.
func TsArgsParam(t: Table, params: []Member): string = "ts_leaf.rs:ts_args_param";
// Writes a doc comment for a route's function or hook: the proc's doc, if
// it has one, then what.
func TsRouteDoc(doc: string, what: string): []Line = "ts_leaf.rs:ts_route_doc";

// Resolves each route of each server to the proc it runs, its function's and
// hook's names, and the parameters its request carries. Fails if a route
// names no top-level proc, or two routes' functions would share a name.
proc TsRoutes(s: { prog: Program, servers: []TsServer, i: int, j: int, acc: []TsRoute }): { routes: []TsRoute, err: MaybeStr } {
	TsRoutes switch {
		(this.s.i == this.s.servers.len) -> id({ routes = this.s.acc, err = TsClash(routes = this.s.acc) }),
		(this.s.j == this.s.servers[this.s.i].routes.len) -> TsRoutes(s = { ..this.s, i = this.s.i + 1, j = 0 }),
		(FindTop(prog = this.s.prog, name = this.s.servers[this.s.i].routes[this.s.j].proc) < 0) -> id({ routes = [], err = Some("http server " + this.s.servers[this.s.i].name + " runs proc " + this.s.servers[this.s.i].routes[this.s.j].proc + ", but there is no top-level proc " + this.s.servers[this.s.i].routes[this.s.j].proc) }),
		else -> TsRoutes(s = { ..this.s, j = this.s.j + 1, acc = this.s.acc + [{
			name = TsFuncName(proc = this.s.servers[this.s.i].routes[this.s.j].proc),
			hook = "use" + Exported(s = this.s.servers[this.s.i].routes[this.s.j].proc),
			server = this.s.servers[this.s.i].name,
			method = this.s.servers[this.s.i].routes[this.s.j].method,
			path = this.s.servers[this.s.i].routes[this.s.j].path,
			proc = this.s.servers[this.s.i].routes[this.s.j].proc,
			pid = FindTop(prog = this.s.prog, name = this.s.servers[this.s.i].routes[this.s.j].proc),
			params = TsRouteParams(prog = this.s.prog, pid = FindTop(prog = this.s.prog, name = this.s.servers[this.s.i].routes[this.s.j].proc), setup = this.s.servers[this.s.i].setup != "")
		}] })
	};
}

// The routes whose functions or hooks are being written, the next (i), and
// the lines so far.
type TsRoutesIn = { t: Table, prog: Program, routes: []TsRoute, i: int, acc: []Line };

// Writes each route's client function: its arguments encoded as the
// request's parameters, the call, and its result decoded.
proc TsClientLines(s: TsRoutesIn): []Line {
	TsClientLines switch {
		(this.s.i == this.s.routes.len) -> id(this.s.acc),
		else -> TsArgLines(s = { t = this.s.t, ps = this.s.routes[this.s.i].params, j = 0, acc = [] })
	};
	TsArgLines -> TsClientLines(s = { ..TsClientLines.s, i = TsClientLines.s.i + 1, acc = TsClientLines.s.acc + TsRouteDoc(doc = TsClientLines.s.prog.nodes[TsClientLines.s.routes[TsClientLines.s.i].pid].doc, what = "Runs proc " + TsClientLines.s.routes[TsClientLines.s.i].proc + ": `" + TsClientLines.s.routes[TsClientLines.s.i].method + " " + TsClientLines.s.routes[TsClientLines.s.i].path + "` on http server " + TsClientLines.s.routes[TsClientLines.s.i].server + ".") + [
		L("export async function " + TsClientLines.s.routes[TsClientLines.s.i].name + "(" + TsArgsParam(t = TsClientLines.s.t, params = TsClientLines.s.routes[TsClientLines.s.i].params) + ", opts: CallOptions = {}): Promise<" + TsType(t = TsClientLines.s.t, ty = ProcRet(n = TsClientLines.s.prog.nodes[TsClientLines.s.routes[TsClientLines.s.i].pid]), qual = "$t.") + "> {"),
		L("const v = await $call(" + TsQuote(s = TsClientLines.s.routes[TsClientLines.s.i].method) + ", " + TsQuote(s = TsClientLines.s.routes[TsClientLines.s.i].path) + ", {")
	] + this + [
		L("}, opts);"),
		L("return " + TsDec(t = TsClientLines.s.t, r = TyRefOf(t = TsClientLines.s.t, ty = ProcRet(n = TsClientLines.s.prog.nodes[TsClientLines.s.routes[TsClientLines.s.i].pid]))) + "(v, \"result\");"),
		L("}"),
		L("")
	] });
}

// Writes each parameter of a route's request as `"name": <encoded>,`.
proc TsArgLines(s: { t: Table, ps: []Member, j: int, acc: []Line }): []Line {
	TsArgLines switch {
		(this.s.j == this.s.ps.len) -> id(this.s.acc),
		else -> TsArgLines(s = { ..this.s, j = this.s.j + 1, acc = this.s.acc + [L(TsQuote(s = this.s.ps[this.s.j].name) + ": " + TsEnc(t = this.s.t, r = TyRefOf(t = this.s.t, ty = this.s.ps[this.s.j].ty)) + "(args." + this.s.ps[this.s.j].name + "),")] })
	};
}

// Writes each route's hook, `use<Proc>`, running its client function in
// React state.
proc TsHookLines(s: TsRoutesIn): []Line {
	TsHookLines switch {
		(this.s.i == this.s.routes.len) -> id(this.s.acc),
		else -> TsHookLines(s = { ..this.s, i = this.s.i + 1, acc = this.s.acc + TsRouteDoc(doc = this.s.prog.nodes[this.s.routes[this.s.i].pid].doc, what = "Runs proc " + this.s.routes[this.s.i].proc + " through " + this.s.routes[this.s.i].name + " (`" + this.s.routes[this.s.i].method + " " + this.s.routes[this.s.i].path + "` on http server " + this.s.routes[this.s.i].server + "): with args, whenever they change; any time with run.") + [
			L("export function " + this.s.routes[this.s.i].hook + "(args?: " + TsArgsType(t = this.s.t, params = this.s.routes[this.s.i].params) + " | null, opts?: HookOptions): CallState<" + TsArgsType(t = this.s.t, params = this.s.routes[this.s.i].params) + ", " + TsType(t = this.s.t, ty = ProcRet(n = this.s.prog.nodes[this.s.routes[this.s.i].pid]), qual = "$t.") + "> {"),
			L("return $useCall($c." + this.s.routes[this.s.i].name + ", args, opts);"),
			L("}"),
			L("")
		] })
	};
}

// ---- The whole backend ----

// Writes client.ts's runtime: HttpError and CallOptions, the call, and the
// JSON codecs of primitives, arrays and maps, which the generated code
// builds on.
func TsClientRuntime(n: int): string = "ts_leaf.rs:ts_client_runtime";
// Writes hooks.ts's runtime: CallState and HookOptions, and the hook every
// route's hook runs.
func TsHooksRuntime(n: int): string = "ts_leaf.rs:ts_hooks_runtime";
// Whether text mentions what (a module's `$t.`, say), so it needs that
// import.
func TsMentions(text: string, what: string): bool = "ts_leaf.rs:ts_mentions";

// Generates a program's TypeScript: types.ts; client.ts, with a function per
// route, the codecs and the runtime; and hooks.ts, with a hook per route.
// Or why it can't be written: a route naming no top-level proc, or two
// routes whose functions would share a name.
proc TsGenerate(s: TsGenIn): TsOut {
	TsGenerate -> BuildTable(prog = this.s.prog);
	BuildTable -> TsRoutes(s = { prog = TsGenerate.s.prog, servers = TsGenerate.s.servers, i = 0, j = 0, acc = [] });
	TsRoutes switch {
		{ routes = _, err = Some(e) } -> id({ files = [], err = Some(e) }),
		else -> TsClientLines(s = { t = BuildTable, prog = TsGenerate.s.prog, routes = this.routes, i = 0, acc = [] })
	};
	TsClientLines -> TsCodecs(s = { t = BuildTable, i = 0, acc = [] });
	TsCodecs -> TsHookLines(s = { t = BuildTable, prog = TsGenerate.s.prog, routes = TsRoutes.routes, i = 0, acc = [] });
	TsHookLines -> TsTypegen(t = BuildTable);
	TsTypegen -> TsModule(s = {
		head = [
			L("// Code generated by vandorf. DO NOT EDIT."),
			L("// A typed function per route of each HTTP server, sending its arguments and"),
			L("// decoding its result as the servers' JSON. Framework-neutral: hooks.ts adds"),
			L("// React on top.")
		],
		uses = [],
		consts = [L("// [react]'s api_base, which each route's path goes after."), L("export const $base = " + TsQuote(s = TsGenerate.s.api_base) + ";"), L("")],
		body = Lines(lines = TsClientLines + TsCodecs, indent = "  "),
		runtime = TsClientRuntime(n = 0)
	}) as Client;
	Client -> TsModule(s = {
		head = [
			L("// Code generated by vandorf. DO NOT EDIT."),
			L("// A React hook per route of each HTTP server, over client.ts: each gives the"),
			L("// route's last result or error and whether a call is in flight, and cancels"),
			L("// calls that are no longer wanted.")
		],
		uses = [L("import * as React from \"react\";"), L("import * as $c from \"./client\";")],
		consts = [],
		body = Lines(lines = TsHookLines, indent = "  "),
		runtime = TsHooksRuntime(n = 0)
	}) as Hooks;
	Hooks -> id({ files = [
		{ name = "types.ts", text = TsTypegen, kind = "types" },
		{ name = "client.ts", text = Client, kind = "code" },
		{ name = "hooks.ts", text = this, kind = "code" }
	], err = None() });
}

// Writes a module: its head comment, its imports (types.ts's as $t, if the
// body or the runtime mentions it), its constants, the body, then the
// runtime.
proc TsModule(s: { head: []Line, uses: []Line, consts: []Line, body: string, runtime: string }): string {
	TsModule switch {
		(TsMentions(text = this.s.body + this.s.runtime, what = "$t.")) -> id(Lines(lines = this.s.head + [L("")] + this.s.uses + [L("import type * as $t from \"./types\";"), L("")] + this.s.consts + [Raw(this.s.body), Raw(this.s.runtime)], indent = "  ")),
		else -> id(Lines(lines = this.s.head + [L("")] + this.s.uses + [L("")] + this.s.consts + [Raw(this.s.body), Raw(this.s.runtime)], indent = "  "))
	};
}
