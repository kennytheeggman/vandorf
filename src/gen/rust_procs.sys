// procs.rs: one state machine per proc (src/codegen/rust.rs: coerce ..
// emit_switch in the reference). The generator's state is threaded: the
// coercion helpers made so far, stubs for funcs without a .rs
// implementation, the move analysis of the transition being written, and
// the first error.

type MaybeImpl = enum { None, Some(ImplRef) };
type RefPathOut = { path: string, boxed: bool, through: bool };
type PatBind = { name: string, expr: string };
// A read in a transition: its owner ("this", "node:<id>", "bind:<name>"),
// node id (or -1) and field path.
type Seen = { owner: string, node: int, path: []string };
type Moves = { active: bool, recording: bool, seen: []Seen, moved: map[int]bool, taken: map[int]bool, next: int };

type RGen = {
	prog: Program,
	table: Table,
	module_dir: MaybeStr,
	// "src -> dst" -> the helper's name.
	coercions: map[string]string,
	helpers: []string,
	stubs: map[int]bool,
	// The first error from writing an expression, and the first that stops
	// the generator.
	failed: MaybeStr,
	fatal: MaybeStr,
	proc_name: string,
	moves: Moves,
	// Implementation files outside the crate's src/, mounted in mod.rs:
	// module name -> path relative to the module.
	mounts: map[string]string
};
type Emit = { g: RGen, s: string };
type EmitLines = { g: RGen, lines: []Line };

// Writes a vandorf type as procs.rs does, with types:: before named ones.
func RustType(t: Table, ty: Type): string = "gen_leaf.rs:rust_type";
// Whether part of ty (a field, or variant's payload) is behind an Arc, being
// boxed against recursion.
func TyBoxed(t: Table, ty: Type, part: string): bool = "gen_leaf.rs:ty_boxed";
// Writes a Ref's field path, `.a.b`, and says whether its last field is
// boxed and whether an earlier one is (a value can't move out from behind an
// Arc).
func RefPath(t: Table, r: Ref): RefPathOut = "gen_leaf.rs:ref_path";
func FloatLit(f: float): string = "gen_leaf.rs:float_lit";
func InType(nodes: []NodeDecl, n: int): string = "gen_leaf.rs:in_type";
func BaseOf(nodes: []NodeDecl, n: int): int = "gen_leaf.rs:base_of";
// Finds the func's implementation in a `.rs` file (the one whose extension
// is ext), if it names one.
func RsImpl(n: NodeDecl, ext: string): MaybeImpl = "gen_leaf.rs:rs_impl";
func JoinPath(base: string, rel: string): MaybeStr = "gen_leaf.rs:join_path";
// Turns a file under the crate's src/ into its module path: `impls.rs` ->
// `crate::impls`, `a/mod.rs` -> `crate::a`, `lib.rs` -> `crate`.
func ModulePath(file: string): MaybeStr = "gen_leaf.rs:module_path";
// Writes a bool expression testing whether x (a `&T`) matches p; none if p
// always matches.
func PatTest(t: Table, p: SPat, x: string): MaybeStr = "gen_leaf.rs:pat_test";
// Writes expressions (of type `&T`) for p's bindings, given x matches p,
// each cloned out of x.
func PatBinds(t: Table, p: SPat, x: string): []PatBind = "gen_leaf.rs:pat_binds";
// Decides which reads of a transition move instead of cloning: for each
// owner, the reads no later read of the same owner overlaps (one path a
// prefix of the other); a node's only if its slot is taken.
func MovedReads(seen: []Seen, taken: map[int]bool): map[int]bool = "gen_leaf.rs:moved_reads";
// Finds the type of a struct's field or a variant's payload, through typedef
// names.
func MemberOf(defs: []TypeDef, t: Type, name: string): Type = "gen_leaf.rs:member_of";
func Unfolded(defs: []TypeDef, t: Type): Type = "gen_leaf.rs:unfolded";
// Struct updates of the generator's state.

func GFailed(g: RGen, msg: string): RGen = "gen_leaf.rs:g_failed";
func GFatal(g: RGen, msg: string): RGen = "gen_leaf.rs:g_fatal";
// Records a read in the transition being written, and says whether it moves
// (see Moves): only while moving, and only at the last read of its value.
func Move(m: Moves, owner: string, node: int, path: []string): { m: Moves, moving: bool } = "gen_leaf.rs:move_read";
func NoMoves(n: int): Moves = "gen_leaf.rs:no_moves";
func SortedTaken(taken: map[int]bool): []int = "gen_leaf.rs:sorted_keys";
func SnakeG(n: NodeDecl): string = "gen_leaf.rs:snake_gname";

// ---- Coercions ----

// Writes expr, of type `from`, as a `to`, which sema checked accepts it.
// Equal Rust types need nothing; otherwise a helper per pair of Rust types
// converts it, recursively through arrays, maps, struct fields and enum
// variants, made once and reused.
proc RCoerce(s: { g: RGen, expr: string, from: Type, to: Type }): Emit {
	RCoerce switch {
		(RustType(t = this.s.g.table, ty = this.s.from) == RustType(t = this.s.g.table, ty = this.s.to)) -> id({ g = this.s.g, s = this.s.expr }),
		((RustType(t = this.s.g.table, ty = this.s.from) + " -> " + RustType(t = this.s.g.table, ty = this.s.to)) in this.s.g.coercions) -> id({ g = this.s.g, s = this.s.g.coercions[RustType(t = this.s.g.table, ty = this.s.from) + " -> " + RustType(t = this.s.g.table, ty = this.s.to)] + "(" + this.s.expr + ")" }),
		else -> id({ f = Unfolded(defs = this.s.g.prog.types, t = this.s.from), t = Unfolded(defs = this.s.g.prog.types, t = this.s.to) }) as Both
	};
	Both switch {
		{ f = Array(f), t = Array(t) } -> RCoerce(s = { g = NewCoercion(at = RCoerce.s), expr = "x", from = f, to = t }) as Elems,
		{ f = Map(f), t = Map(t) } -> RCoerce(s = { g = NewCoercion(at = RCoerce.s), expr = "x", from = f.value, to = t.value }) as Values,
		{ f = Struct(_), t = Struct(tfs) } -> CoerceFields(s = { at = RCoerce.s, g = NewCoercion(at = RCoerce.s), ms = tfs, i = 0, acc = [L("fn " + CoercionName(at = RCoerce.s) + "(v: " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.from) + ") -> " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.to) + " {"), L(RustType(t = RCoerce.s.g.table, ty = RCoerce.s.to) + " {")] }) as Fields,
		{ f = Enum(fvs), t = Enum(_) } -> CoerceVariants(s = { at = RCoerce.s, g = NewCoercion(at = RCoerce.s), ms = fvs, i = 0, acc = [L("fn " + CoercionName(at = RCoerce.s) + "(v: " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.from) + ") -> " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.to) + " {"), L("match v {")] }) as Variants,
		else -> id({ g = GFatal(g = RCoerce.s.g, msg = "sema admitted coercion " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.from) + " -> " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.to)), s = RCoerce.s.expr })
	};
	Elems -> Helper(s = { at = RCoerce.s, g = this.g, lines = [L("fn " + CoercionName(at = RCoerce.s) + "(v: " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.from) + ") -> " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.to) + " {"), L("v.into_iter().map(|x| " + this.s + ").collect()"), L("}")] });
	Values -> Helper(s = { at = RCoerce.s, g = this.g, lines = [L("fn " + CoercionName(at = RCoerce.s) + "(v: " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.from) + ") -> " + RustType(t = RCoerce.s.g.table, ty = RCoerce.s.to) + " {"), L("v.into_iter().map(|(k, x)| (k, " + this.s + ")).collect()"), L("}")] });
	Fields -> Helper(s = { at = RCoerce.s, g = this.g, lines = this.lines + [L("}"), L("}")] });
	Variants -> Helper(s = { at = RCoerce.s, g = this.g, lines = this.lines + [L("}"), L("}")] });
}

func CoercionName(at: { g: RGen, expr: string, from: Type, to: Type }): string = "gen_leaf.rs:coercion_name";
func NewCoercion(at: { g: RGen, expr: string, from: Type, to: Type }): RGen = "gen_leaf.rs:new_coercion";

// Records a coercion helper's code and writes the call of it on the
// expression.
proc Helper(s: { at: { g: RGen, expr: string, from: Type, to: Type }, g: RGen, lines: []Line }): Emit {
	Helper -> id({ g = { ..this.s.g, helpers = this.s.g.helpers + [Lines(lines = this.s.lines, indent = "    ")] }, s = CoercionName(at = this.s.at) + "(" + this.s.at.expr + ")" });
}

// Converts part n (a field, or variant n's payload) held in expr, unboxing
// and boxing it where either side has an Arc.
proc CoercePart(s: { at: { g: RGen, expr: string, from: Type, to: Type }, g: RGen, expr: string, n: string, f: Type, t: Type }): Emit {
	CoercePart switch {
		(TyBoxed(t = this.s.g.table, ty = this.s.at.from, part = this.s.n)) -> RCoerce(s = { g = this.s.g, expr = "(*" + this.s.expr + ").clone()", from = this.s.f, to = this.s.t }),
		else -> RCoerce(s = { g = this.s.g, expr = this.s.expr, from = this.s.f, to = this.s.t })
	};
	RCoerce switch {
		(TyBoxed(t = CoercePart.s.g.table, ty = CoercePart.s.at.to, part = CoercePart.s.n)) -> id({ g = this.g, s = "std::sync::Arc::new(" + this.s + ")" }),
		else -> id(this)
	};
}

// Writes a struct coercion helper's fields, each converted to the target's
// field type.
proc CoerceFields(s: { at: { g: RGen, expr: string, from: Type, to: Type }, g: RGen, ms: []Member, i: int, acc: []Line }): EmitLines {
	CoerceFields switch {
		(this.s.i == this.s.ms.len) -> id({ g = this.s.g, lines = this.s.acc }),
		else -> CoercePart(s = { at = this.s.at, g = this.s.g, expr = "v." + RustIdent(s = this.s.ms[this.s.i].name), n = this.s.ms[this.s.i].name, f = MemberOf(defs = this.s.g.prog.types, t = this.s.at.from, name = this.s.ms[this.s.i].name), t = this.s.ms[this.s.i].ty })
	};
	CoercePart -> CoerceFields(s = { at = CoerceFields.s.at, g = this.g, ms = CoerceFields.s.ms, i = CoerceFields.s.i + 1, acc = CoerceFields.s.acc + [L(RustIdent(s = CoerceFields.s.ms[CoerceFields.s.i].name) + ": " + this.s + ",")] });
}

// Writes an enum coercion helper's match arms, each variant's payload
// converted to the target's.
proc CoerceVariants(s: { at: { g: RGen, expr: string, from: Type, to: Type }, g: RGen, ms: []Member, i: int, acc: []Line }): EmitLines {
	CoerceVariants switch {
		(this.s.i == this.s.ms.len) -> id({ g = this.s.g, lines = this.s.acc }),
		(IsVoid(t = this.s.ms[this.s.i].ty)) -> CoerceVariants(s = { at = this.s.at, g = this.s.g, ms = this.s.ms, i = this.s.i + 1, acc = this.s.acc + [L(RustType(t = this.s.g.table, ty = this.s.at.from) + "::" + RustIdent(s = this.s.ms[this.s.i].name) + " => " + RustType(t = this.s.g.table, ty = this.s.at.to) + "::" + RustIdent(s = this.s.ms[this.s.i].name) + ",")] }),
		else -> CoercePart(s = { at = this.s.at, g = this.s.g, expr = "p", n = this.s.ms[this.s.i].name, f = this.s.ms[this.s.i].ty, t = MemberOf(defs = this.s.g.prog.types, t = this.s.at.to, name = this.s.ms[this.s.i].name) })
	};
	CoercePart -> CoerceVariants(s = { at = CoerceVariants.s.at, g = this.g, ms = CoerceVariants.s.ms, i = CoerceVariants.s.i + 1, acc = CoerceVariants.s.acc + [L(RustType(t = CoerceVariants.s.g.table, ty = CoerceVariants.s.at.from) + "::" + RustIdent(s = CoerceVariants.s.ms[CoerceVariants.s.i].name) + "(p) => " + RustType(t = CoerceVariants.s.g.table, ty = CoerceVariants.s.at.to) + "::" + RustIdent(s = CoerceVariants.s.ms[CoerceVariants.s.i].name) + "(" + this.s + "),")] });
}

// ---- Expressions ----

// Writes a read of a node's output, `this` or a binding: moved at its last
// read (see Moves), cloned otherwise, and unboxed where its last field is
// behind an Arc.
proc RRef(s: { g: RGen, r: Ref }): Emit {
	RRef -> id(this.s.r.root) as R;
	R switch {
		This() -> Move(m = RRef.s.g.moves, owner = "this", node = -1, path = RRef.s.r.fields) as M,
		Node(n) -> Move(m = RRef.s.g.moves, owner = "node:" + Itoa(i = n), node = n, path = RRef.s.r.fields) as M,
		Bind() -> Move(m = RRef.s.g.moves, owner = "bind:" + RRef.s.r.bind, node = -1, path = RRef.s.r.fields) as M
	};
	M -> RefText(s = { g = { ..RRef.s.g, moves = this.m }, r = RRef.s.r, moving = this.moving && !RefPath(t = RRef.s.g.table, r = RRef.s.r).through, rp = RefPath(t = RRef.s.g.table, r = RRef.s.r) });
}

// Writes the text of a read: `this`, a binding's `b_<name>`, a node's taken
// slot or its output from env (failing if the node hasn't run), with the
// field path; then moves, clones or unboxes it.
proc RefText(s: { g: RGen, r: Ref, moving: bool, rp: RefPathOut }): Emit {
	RefText -> id(this.s.r.root) as R;
	R switch {
		This() -> id("this" + RefText.s.rp.path) as Text,
		Node(n) -> switch {
			(n in RefText.s.g.moves.taken) -> id("slot_" + SnakeG(n = RefText.s.g.prog.nodes[n]) + RefText.s.rp.path) as Text,
			else -> id("get(&env.out_" + SnakeG(n = RefText.s.g.prog.nodes[n]) + ", " + Quote(s = QualName(n = RefText.s.g.prog.nodes[n])) + ")?" + RefText.s.rp.path) as Text
		},
		Bind() -> id("b_" + RefText.s.r.bind + RefText.s.rp.path) as Text
	};
	Text switch {
		(RefText.s.moving && RefText.s.rp.boxed) -> id({ g = RefText.s.g, s = "std::sync::Arc::unwrap_or_clone(" + this + ")" }),
		(RefText.s.moving) -> id({ g = RefText.s.g, s = this }),
		(RefText.s.rp.boxed) -> id({ g = RefText.s.g, s = "(*" + this + ").clone()" }),
		else -> id({ g = RefText.s.g, s = this + ".clone()" })
	};
}

type ValueIn = { g: RGen, e: Expr, want: Type };

// Writes e as a Rust expression of type `want`: literals of structs, arrays,
// maps and variants at `want`, anything else at its own type, then coerced
// to `want`.
proc RValue(s: ValueIn): Emit {
	RValue -> id(this.s.e) as E;
	E switch {
		Ref(r) -> RRef(s = { g = RValue.s.g, r = r }) as Ref,
		Call(c) -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Called,
		Array(es) -> RValues(s = { g = RValue.s.g, es = es, want = ElemOf(t = Unfolded(defs = RValue.s.g.prog.types, t = RValue.s.want)), i = 0, acc = [] }) as Items,
		Struct(fs) -> RFields(s = { g = RValue.s.g, fs = fs, want = RValue.s.want, i = 0, acc = [] }) as Fields,
		Map(kvs) -> REntries(s = { g = RValue.s.g, kvs = kvs, kt = KeyOf(t = Unfolded(defs = RValue.s.g.prog.types, t = RValue.s.want)), vt = MapValue(t = Unfolded(defs = RValue.s.g.prog.types, t = RValue.s.want)), i = 0, acc = [] }) as Entries,
		Index(x) -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Indexed,
		Field(x) -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Selected,
		Merge(x) -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Merged,
		Remove(x) -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Removed,
		Query(q) -> switch {
			(q.q == "keys") -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Keys,
			(q.q == "values") -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Vals,
			else -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Own
		},
		Variant(v) -> switch {
			(IsSomeE(m = v.payload)) -> RValue(s = { g = RValue.s.g, e = UnwrapME(m = v.payload), want = MemberOf(defs = RValue.s.g.prog.types, t = RValue.s.want, name = v.tag) }) as Payload,
			else -> id({ g = RValue.s.g, s = RustType(t = RValue.s.g.table, ty = RValue.s.want) + "::" + RustIdent(s = v.tag) })
		},
		// Primitives, whose Rust types match whenever sema accepted them.
		else -> ROwn(s = { g = RValue.s.g, e = RValue.s.e }) as Own
	};
	Ref -> RCoerce(s = { g = this.g, expr = this.s, from = RefOf(e = RValue.s.e).ty, to = RValue.s.want }) as Out;
	Called -> RCoerce(s = { g = this.g, expr = this.s, from = NodeRet(nodes = RValue.s.g.prog.nodes, n = CallOfE(e = RValue.s.e).target), to = RValue.s.want }) as Out;
	Items -> id({ g = this.g, s = "types::List::from(vec![" + Join(parts = this.parts, sep = ", ") + "])" });
	Fields -> id({ g = this.g, s = RustType(t = RValue.s.g.table, ty = RValue.s.want) + " { " + Join(parts = this.parts, sep = ", ") + " }" });
	Entries -> id({ g = this.g, s = "types::Map::from_iter([" + Join(parts = this.parts, sep = ", ") + "])" });
	Indexed -> RCoerce(s = { g = this.g, expr = this.s, from = IndexedValue(t = Unfolded(defs = RValue.s.g.prog.types, t = IndexTy(e = RValue.s.e))), to = RValue.s.want }) as Out;
	Selected -> RCoerce(s = { g = this.g, expr = this.s, from = MemberOf(defs = RValue.s.g.prog.types, t = FieldTy(e = RValue.s.e), name = FieldNameE(e = RValue.s.e)), to = RValue.s.want }) as Out;
	Merged -> RCoerce(s = { g = this.g, expr = this.s, from = MergeTy(e = RValue.s.e), to = RValue.s.want }) as Out;
	Removed -> RCoerce(s = { g = this.g, expr = this.s, from = MergeTy(e = RValue.s.e), to = RValue.s.want }) as Out;
	Keys -> RCoerce(s = { g = this.g, expr = this.s, from = Array(KeyOf(t = Unfolded(defs = RValue.s.g.prog.types, t = QueryTy(e = RValue.s.e)))), to = RValue.s.want }) as Out;
	Vals -> RCoerce(s = { g = this.g, expr = this.s, from = Array(MapValue(t = Unfolded(defs = RValue.s.g.prog.types, t = QueryTy(e = RValue.s.e)))), to = RValue.s.want }) as Out;
	Payload switch {
		(TyBoxed(t = RValue.s.g.table, ty = RValue.s.want, part = VariantTagE(e = RValue.s.e))) -> id({ g = this.g, s = RustType(t = RValue.s.g.table, ty = RValue.s.want) + "::" + RustIdent(s = VariantTagE(e = RValue.s.e)) + "(std::sync::Arc::new(" + this.s + "))" }),
		else -> id({ g = this.g, s = RustType(t = RValue.s.g.table, ty = RValue.s.want) + "::" + RustIdent(s = VariantTagE(e = RValue.s.e)) + "(" + this.s + ")" })
	};
}

func IsSomeE(m: MaybeExpr): bool = "gen_leaf.rs:is_some_e";
func UnwrapME(m: MaybeExpr): Expr = "gen_leaf.rs:unwrap_me";
func RefOf(e: Expr): Ref = "gen_leaf.rs:ref_of";
func CallOfE(e: Expr): Call = "gen_leaf.rs:call_of";
func IndexTy(e: Expr): Type = "gen_leaf.rs:index_ty";
func FieldTy(e: Expr): Type = "gen_leaf.rs:field_ty";
func FieldNameE(e: Expr): string = "gen_leaf.rs:field_name_e";
func MergeTy(e: Expr): Type = "gen_leaf.rs:merge_ty";
func QueryTy(e: Expr): Type = "gen_leaf.rs:query_ty";
func VariantTagE(e: Expr): string = "gen_leaf.rs:variant_tag_e";

type Parts = { g: RGen, parts: []string };

// Writes each item of an array literal at the element type.
proc RValues(s: { g: RGen, es: []Expr, want: Type, i: int, acc: []string }): Parts {
	RValues switch {
		(this.s.i == this.s.es.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> RValue(s = { g = this.s.g, e = this.s.es[this.s.i], want = this.s.want })
	};
	RValue -> RValues(s = { g = this.g, es = RValues.s.es, want = RValues.s.want, i = RValues.s.i + 1, acc = RValues.s.acc + [this.s] });
}

// Writes a struct literal's fields as `name: value`, boxing those that are
// behind an Arc.
proc RFields(s: { g: RGen, fs: []ExprMember, want: Type, i: int, acc: []string }): Parts {
	RFields switch {
		(this.s.i == this.s.fs.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> RValue(s = { g = this.s.g, e = this.s.fs[this.s.i].e, want = MemberOf(defs = this.s.g.prog.types, t = this.s.want, name = this.s.fs[this.s.i].name) })
	};
	RValue switch {
		(TyBoxed(t = RFields.s.g.table, ty = RFields.s.want, part = RFields.s.fs[RFields.s.i].name)) -> RFields(s = { g = this.g, fs = RFields.s.fs, want = RFields.s.want, i = RFields.s.i + 1, acc = RFields.s.acc + [RustIdent(s = RFields.s.fs[RFields.s.i].name) + ": std::sync::Arc::new(" + this.s + ")"] }),
		else -> RFields(s = { g = this.g, fs = RFields.s.fs, want = RFields.s.want, i = RFields.s.i + 1, acc = RFields.s.acc + [RustIdent(s = RFields.s.fs[RFields.s.i].name) + ": " + this.s] })
	};
}

// Writes each entry of a map literal as `(key, value)` at the map's key and
// value types.
proc REntries(s: { g: RGen, kvs: []ExprEntry, kt: Type, vt: Type, i: int, acc: []string }): Parts {
	REntries switch {
		(this.s.i == this.s.kvs.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> RValue(s = { g = this.s.g, e = this.s.kvs[this.s.i].key, want = this.s.kt }) as K
	};
	K -> RValue(s = { g = this.g, e = REntries.s.kvs[REntries.s.i].value, want = REntries.s.vt }) as V;
	V -> REntries(s = { g = this.g, kvs = REntries.s.kvs, kt = REntries.s.kt, vt = REntries.s.vt, i = REntries.s.i + 1, acc = REntries.s.acc + ["(" + K.s + ", " + this.s + ")"] });
}

// Writes an expression that has its own type (not a struct, array, map or
// variant literal), at that type: primitives, operators, calls of funcs
// (their errors wrapped with the proc's name), indexes that fail on a
// missing key, field selections, `in`, .len/.keys/.values, joins and
// removals.
proc ROwn(s: { g: RGen, e: Expr }): Emit {
	ROwn -> id(this.s.e) as E;
	E switch {
		Ref(r) -> RRef(s = { g = ROwn.s.g, r = r }) as Done,
		Int(i) -> id({ g = ROwn.s.g, s = Itoa(i = i) + "_i64" }),
		Float(f) -> id({ g = ROwn.s.g, s = FloatLit(f = f) }),
		Str(s) -> id({ g = ROwn.s.g, s = "types::Str::from(" + Quote(s = s) + ")" }),
		Bool(b) -> switch {
			(b) -> id({ g = ROwn.s.g, s = "true" }),
			else -> id({ g = ROwn.s.g, s = "false" })
		},
		Unary(u) -> ROwn(s = { g = ROwn.s.g, e = u.e }) as Operand,
		Binary(b) -> ROwn(s = { g = ROwn.s.g, e = b.l }) as BL,
		Call(c) -> RCallee(s = { g = ROwn.s.g, n = c.target }) as Callee,
		Index(x) -> ROwn(s = { g = ROwn.s.g, e = x.e }) as IE,
		// The struct may be a literal (`{ ..x, f = v }.g`): render it at its type.
		Field(f) -> RValue(s = { g = ROwn.s.g, e = f.e, want = f.ty }) as FE,
		In(x) -> ROwn(s = { g = ROwn.s.g, e = x.map }) as InMap,
		Query(q) -> ROwn(s = { g = ROwn.s.g, e = q.e }) as QE,
		Merge(m) -> RValue(s = { g = ROwn.s.g, e = m.l, want = m.ty }) as ML,
		Remove(m) -> ROwn(s = { g = ROwn.s.g, e = m.m }) as RM,
		else -> id({ g = GFatal(g = ROwn.s.g, msg = "literal without a type"), s = "" })
	};
	Done -> id(this);
	Operand switch {
		(UnaryOp(e = ROwn.s.e) == "!") -> id({ g = this.g, s = "(!" + this.s + ")" }),
		else -> id({ g = this.g, s = "(-" + this.s + ")" })
	};
	BL -> ROwn(s = { g = this.g, e = BinaryRE(e = ROwn.s.e) }) as BR;
	BR switch {
		(BinaryOpE(e = ROwn.s.e) == "+" && BinaryOperand(e = ROwn.s.e) == "string") -> id({ g = this.g, s = "types::Str::from(format!(\"{}{}\", " + BL.s + ", " + this.s + "))" }),
		else -> id({ g = this.g, s = "(" + BL.s + " " + BinaryOpE(e = ROwn.s.e) + " " + this.s + ")" })
	};
	Callee -> RArgs(s = { g = this.g, args = CallOfE(e = ROwn.s.e).args, i = 0, acc = [] });
	RArgs -> id({ g = this.g, s = Callee.s + "(" + Join(parts = this.parts, sep = ", ") + ").map_err(|e| wrap(" + Quote(s = QualName(n = ROwn.s.g.prog.nodes[CallOfE(e = ROwn.s.e).target])) + ", e.into()))?" });
	IE -> ROwn(s = { g = this.g, e = IndexKeyE(e = ROwn.s.e) }) as IK;
	IK switch {
		(IsMap(t = Unfolded(defs = ROwn.s.g.prog.types, t = IndexTy(e = ROwn.s.e)))) -> id({ g = this.g, s = "map_get(&" + IE.s + ", &" + this.s + ").map_err(|e| wrap(" + Quote(s = ROwn.s.g.proc_name) + ", e))?" }),
		else -> id({ g = this.g, s = "slice_get(&" + IE.s + ", &" + this.s + ").map_err(|e| wrap(" + Quote(s = ROwn.s.g.proc_name) + ", e))?" })
	};
	FE switch {
		(TyBoxed(t = ROwn.s.g.table, ty = FieldTy(e = ROwn.s.e), part = FieldNameE(e = ROwn.s.e))) -> id({ g = this.g, s = "(*(" + this.s + ")." + RustIdent(s = FieldNameE(e = ROwn.s.e)) + ")" }),
		else -> id({ g = this.g, s = "(" + this.s + ")." + RustIdent(s = FieldNameE(e = ROwn.s.e)) })
	};
	InMap -> ROwn(s = { g = this.g, e = InKeyE(e = ROwn.s.e) }) as InK;
	InK -> id({ g = this.g, s = "(" + InMap.s + ").contains_key(&" + this.s + ")" });
	QE switch {
		(QueryQ(e = ROwn.s.e) == "len") -> id({ g = this.g, s = "((" + this.s + ").len() as i64)" }),
		(QueryQ(e = ROwn.s.e) == "keys") -> id({ g = this.g, s = "(" + this.s + ").keys().cloned().collect::<types::List<_>>()" }),
		else -> id({ g = this.g, s = "(" + this.s + ").values().cloned().collect::<types::List<_>>()" })
	};
	ML -> RValue(s = { g = this.g, e = MergeRE(e = ROwn.s.e), want = MergeTy(e = ROwn.s.e) }) as MR;
	MR switch {
		(IsArray(t = Unfolded(defs = ROwn.s.g.prog.types, t = MergeTy(e = ROwn.s.e)))) -> id({ g = this.g, s = "(" + ML.s + ").concat(&" + this.s + ")" }),
		else -> id({ g = this.g, s = "(" + ML.s + ").merge(&" + this.s + ")" })
	};
	RM -> RValue(s = { g = this.g, e = RemoveKeysE(e = ROwn.s.e), want = Array(KeyOf(t = Unfolded(defs = ROwn.s.g.prog.types, t = MergeTy(e = ROwn.s.e)))) }) as RK;
	RK -> id({ g = this.g, s = "(" + RM.s + ").without(&" + this.s + ")" });
}

func UnaryOp(e: Expr): string = "gen_leaf.rs:unary_op";
func BinaryRE(e: Expr): Expr = "gen_leaf.rs:binary_r_e";
func BinaryOpE(e: Expr): string = "gen_leaf.rs:binary_op_e";
func BinaryOperand(e: Expr): string = "gen_leaf.rs:binary_operand";
func IndexKeyE(e: Expr): Expr = "gen_leaf.rs:index_key_e";
func InKeyE(e: Expr): Expr = "gen_leaf.rs:in_key_e";
func QueryQ(e: Expr): string = "gen_leaf.rs:query_q";
func MergeRE(e: Expr): Expr = "gen_leaf.rs:merge_r_e";
func RemoveKeysE(e: Expr): Expr = "gen_leaf.rs:remove_keys_e";

// Writes each argument of a func call at its parameter's type.
proc RArgs(s: { g: RGen, args: []CallArg, i: int, acc: []string }): Parts {
	RArgs switch {
		(this.s.i == this.s.args.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> RValue(s = { g = this.s.g, e = this.s.args[this.s.i].value, want = this.s.args[this.s.i].param })
	};
	RValue -> RArgs(s = { g = this.g, args = RArgs.s.args, i = RArgs.s.i + 1, acc = RArgs.s.acc + [this.s] });
}

// Names the Rust function a func node calls: its .rs implementation, or a
// stub if it names none. An implementation that can't be reached records the
// generator's first error, and the call is "unresolved".
proc RCallee(s: { g: RGen, n: int }): Emit {
	RCallee -> RsImpl(n = this.s.g.prog.nodes[BaseOf(nodes = this.s.g.prog.nodes, n = this.s.n)], ext = "rs");
	RsImpl switch {
		Some(imp) -> RImplPath(s = { g = RCallee.s.g, n = BaseOf(nodes = RCallee.s.g.prog.nodes, n = RCallee.s.n), imp = imp }),
		else -> id({ g = { ..RCallee.s.g, stubs = RCallee.s.g.stubs + [BaseOf(nodes = RCallee.s.g.prog.nodes, n = RCallee.s.n): true] }, s = "unimplemented_" + SnakeG(n = RCallee.s.g.prog.nodes[BaseOf(nodes = RCallee.s.g.prog.nodes, n = RCallee.s.n)]) })
	};
	RImplPath switch {
		{ path = Some(p), err = _, mount = m } -> switch {
			(m == "") -> id({ g = RCallee.s.g, s = p }),
			else -> id({ g = { ..RCallee.s.g, mounts = RCallee.s.g.mounts + [m: RsImplFile(n = RCallee.s.g.prog.nodes[BaseOf(nodes = RCallee.s.g.prog.nodes, n = RCallee.s.n)])] }, s = p })
		},
		{ path = _, err = Some(e), mount = _ } -> id({ g = GFailed(g = RCallee.s.g, msg = e), s = "unresolved" }),
		else -> id({ g = RCallee.s.g, s = "unresolved" })
	};
}

// Finds the file of a func's .rs implementation, relative to the module.
func RsImplFile(n: NodeDecl): string = "gen_leaf.rs:rs_impl_file";
// Writes mod.rs's lines mounting implementation files outside the crate's
// src/, each as a module by its path.
func MountLines(mounts: map[string]string): string = "gen_leaf.rs:mount_lines";

// Works out how generated code calls an implementation:
// `crate::a::b::function`, or why it can't. A file outside the crate's src/
// is mounted in mod.rs (mount: its module name) and called as
// `super::<module>::function`; two such files can't share a name.
proc RImplPath(s: { g: RGen, n: int, imp: ImplRef }): { path: MaybeStr, err: MaybeStr, mount: string } {
	RImplPath -> id(this.s.g.module_dir) as Dir;
	Dir switch {
		Some(dir) -> JoinPath(base = dir, rel = RImplPath.s.imp.file),
		else -> id({ path = None(), err = Some(QualName(n = RImplPath.s.g.prog.nodes[RImplPath.s.n]) + " is implemented in " + RImplPath.s.imp.file + ", but the output module's place in the crate is unknown (pass --module-dir or generate under a crate's src/)"), mount = "" })
	};
	JoinPath switch {
		Some(file) -> ModulePath(file = file),
		else -> switch {
			(!MountableStem(file = RImplPath.s.imp.file)) -> id({ path = None(), err = Some(QualName(n = RImplPath.s.g.prog.nodes[RImplPath.s.n]) + ": " + RImplPath.s.imp.file + " is outside the crate's src/, and its name can't be a module of the output"), mount = "" }),
			(Stem(file = RImplPath.s.imp.file) in RImplPath.s.g.mounts && RImplPath.s.g.mounts[Stem(file = RImplPath.s.imp.file)] != RImplPath.s.imp.file) -> id({ path = None(), err = Some(QualName(n = RImplPath.s.g.prog.nodes[RImplPath.s.n]) + ": " + RImplPath.s.imp.file + " and " + RImplPath.s.g.mounts[Stem(file = RImplPath.s.imp.file)] + " are both outside the crate's src/ and would both be module " + Stem(file = RImplPath.s.imp.file)), mount = "" }),
			else -> id({ path = Some("super::" + RustIdent(s = Stem(file = RImplPath.s.imp.file)) + "::" + RustIdent(s = RImplPath.s.imp.function)), err = None(), mount = Stem(file = RImplPath.s.imp.file) })
		}
	};
	ModulePath switch {
		Some(m) -> id({ path = Some(m + "::" + RustIdent(s = RImplPath.s.imp.function)), err = None(), mount = "" }),
		else -> id({ path = None(), err = Some(QualName(n = RImplPath.s.g.prog.nodes[RImplPath.s.n]) + ": " + RImplPath.s.imp.file + " is not a Rust module file"), mount = "" })
	};
}

// Takes a file's name without .rs: the module a mounted implementation file
// becomes.
func Stem(file: string): string = "gen_leaf.rs:rs_stem";
func MountableStem(file: string): bool = "gen_leaf.rs:mountable_stem";

// Writes the input of c's target: `In<Target> { param: value, .. }`.
proc RInput(s: { g: RGen, c: Call }): Emit {
	RInput -> RNamedArgs(s = { g = this.s.g, args = this.s.c.args, i = 0, acc = [] });
	RNamedArgs -> id({ g = this.g, s = InType(nodes = RInput.s.g.prog.nodes, n = RInput.s.c.target) + " { " + Join(parts = this.parts, sep = ", ") + " }" });
}

// Writes each of a call's arguments as `param: value`, at its parameter's
// type.
proc RNamedArgs(s: { g: RGen, args: []CallArg, i: int, acc: []string }): Parts {
	RNamedArgs switch {
		(this.s.i == this.s.args.len) -> id({ g = this.s.g, parts = this.s.acc }),
		else -> RValue(s = { g = this.s.g, e = this.s.args[this.s.i].value, want = this.s.args[this.s.i].param })
	};
	RValue -> RNamedArgs(s = { g = this.g, args = RNamedArgs.s.args, i = RNamedArgs.s.i + 1, acc = RNamedArgs.s.acc + [RustIdent(s = RNamedArgs.s.args[RNamedArgs.s.i].name) + ": " + this.s] });
}

// ---- Procs ----

// Writes the step to c's target: its input stored in env, then a jump to it.
// The input is written twice: first recording reads, then moving each at its
// last read, taking a node's output out of env when nothing reads it again.
proc RTransition(s: { g: RGen, pid: int, c: Call }): EmitLines {
	func Taken(seen: []Seen, g: Graph, target: int): map[int]bool = "gen_leaf.rs:taken_slots";
	func Recording(n: int): Moves = "gen_leaf.rs:recording";
	func Moving(moved: map[int]bool, taken: map[int]bool): Moves = "gen_leaf.rs:moving";
	func SlotLines(g: RGen, taken: []int): []Line = "gen_leaf.rs:slot_lines";
	RTransition -> RInput(s = { g = { ..this.s.g, moves = Recording(n = 0) }, c = this.s.c }) as First;
	First -> RInput(s = { g = { ..this.g, moves = Moving(moved = MovedReads(seen = this.g.moves.seen, taken = Taken(seen = this.g.moves.seen, g = GraphOf(n = RTransition.s.g.prog.nodes[RTransition.s.pid]), target = RTransition.s.c.target)), taken = Taken(seen = this.g.moves.seen, g = GraphOf(n = RTransition.s.g.prog.nodes[RTransition.s.pid]), target = RTransition.s.c.target)) }, c = RTransition.s.c }) as Second;
	Second -> id({
		g = { ..this.g, moves = NoMoves(n = 0) },
		lines = SlotLines(g = RTransition.s.g, taken = SortedTaken(taken = this.g.moves.taken)) + [
			L("env.in_" + SnakeG(n = RTransition.s.g.prog.nodes[RTransition.s.c.target]) + " = Some(" + this.s + ");"),
			L("pc = Pc" + Gname(n = RTransition.s.g.prog.nodes[RTransition.s.pid]) + "::" + Gname(n = RTransition.s.g.prog.nodes[RTransition.s.c.target]) + ";"),
			L("continue;")
		]
	});
}

type SwitchIn = { g: RGen, pid: int, n: int, arms: []SArm, top: bool, i: int, always: bool, acc: []Line };

// Writes a switch's arms in order, as an if chain: each tests its pattern
// (binding what it binds) or its condition, and a transition ends with
// continue, so the first arm that matches is taken. A top-level switch that
// can fall through ends with an error.
proc RSwitch(s: SwitchIn): EmitLines {
	func BindLines(bs: []PatBind): []Line = "gen_leaf.rs:bind_lines";
	RSwitch switch {
		(this.s.i == this.s.arms.len && this.s.top && !this.s.always) -> id({ g = this.s.g, lines = this.s.acc + [L("return Err(format!(" + Quote(s = QualName(n = this.s.g.prog.nodes[this.s.n]) + ": no match arm for {:?}") + ", this).into());")] }),
		(this.s.i == this.s.arms.len) -> id({ g = this.s.g, lines = this.s.acc }),
		else -> id(this.s.arms[this.s.i].test) as T
	};
	T switch {
		Else() -> RBody(s = { g = RSwitch.s.g, pid = RSwitch.s.pid, n = RSwitch.s.n, body = RSwitch.s.arms[RSwitch.s.i].body }) as ElseBody,
		Cond(c) -> ROwn(s = { g = RSwitch.s.g, e = c }) as C,
		Pat(p) -> switch {
			(IsSomeS(m = PatTest(t = RSwitch.s.g.table, p = p, x = "(&this)"))) -> RBody(s = { g = RSwitch.s.g, pid = RSwitch.s.pid, n = RSwitch.s.n, body = RSwitch.s.arms[RSwitch.s.i].body }) as PatIf,
			else -> RBody(s = { g = RSwitch.s.g, pid = RSwitch.s.pid, n = RSwitch.s.n, body = RSwitch.s.arms[RSwitch.s.i].body }) as PatAlways
		}
	};
	ElseBody -> RSwitch(s = { g = this.g, pid = RSwitch.s.pid, n = RSwitch.s.n, arms = RSwitch.s.arms, top = RSwitch.s.top, i = RSwitch.s.i + 1, always = true, acc = RSwitch.s.acc + this.lines });
	C -> RBody(s = { g = this.g, pid = RSwitch.s.pid, n = RSwitch.s.n, body = RSwitch.s.arms[RSwitch.s.i].body }) as CondBody;
	CondBody -> RSwitch(s = { g = this.g, pid = RSwitch.s.pid, n = RSwitch.s.n, arms = RSwitch.s.arms, top = RSwitch.s.top, i = RSwitch.s.i + 1, always = RSwitch.s.always, acc = RSwitch.s.acc + [L("if " + C.s + " {")] + this.lines + [L("}")] });
	PatIf -> RSwitch(s = { g = this.g, pid = RSwitch.s.pid, n = RSwitch.s.n, arms = RSwitch.s.arms, top = RSwitch.s.top, i = RSwitch.s.i + 1, always = false, acc = RSwitch.s.acc + [L("if " + UnwrapS(m = PatTest(t = RSwitch.s.g.table, p = PatOfTest(t = T), x = "(&this)")) + " {")] + BindLines(bs = PatBinds(t = RSwitch.s.g.table, p = PatOfTest(t = T), x = "(&this)")) + this.lines + [L("}")] });
	PatAlways -> RSwitch(s = { g = this.g, pid = RSwitch.s.pid, n = RSwitch.s.n, arms = RSwitch.s.arms, top = RSwitch.s.top, i = RSwitch.s.i + 1, always = true, acc = RSwitch.s.acc + [L("{")] + BindLines(bs = PatBinds(t = RSwitch.s.g.table, p = PatOfTest(t = T), x = "(&this)")) + this.lines + [L("}")] });
}

func IsSomeS(m: MaybeStr): bool = "gen_leaf.rs:is_some_s";
func UnwrapS(m: MaybeStr): string = "gen_leaf.rs:unwrap_s";
func PatOfTest(t: Test): SPat = "gen_leaf.rs:pat_of_test";

// Writes an arm's body: a transition to its call, or a nested switch.
proc RBody(s: { g: RGen, pid: int, n: int, body: SBody }): EmitLines {
	RBody -> id(this.s.body) as B;
	B switch {
		Call(c) -> RTransition(s = { g = RBody.s.g, pid = RBody.s.pid, c = c }),
		Switch(arms) -> RSwitch(s = { g = RBody.s.g, pid = RBody.s.pid, n = RBody.s.n, arms = arms, top = false, i = 0, always = false, acc = [] })
	};
}

// Writes one state of a proc's machine: run the node (a func through its
// implementation, a proc through its run_ function, an id or signature node
// from its input), keep its output if it's read later, then its edge.
proc RNode(s: { g: RGen, pid: int, n: int }): EmitLines {
	func ArgList(nodes: []NodeDecl, n: int): string = "gen_leaf.rs:input_args";
	// Writes a signature node's output: its input's fields, as the struct of
	// them.
	func SigValue(g: RGen, n: int): string = "gen_leaf.rs:sig_value";
	RNode -> id(this.s.g.prog.nodes[BaseOf(nodes = this.s.g.prog.nodes, n = this.s.n)].kind) as K;
	K switch {
		Proc(_) -> RNodeBody(s = { g = RNode.s.g, pid = RNode.s.pid, n = RNode.s.n, run = "let this = run_" + SnakeG(n = RNode.s.g.prog.nodes[BaseOf(nodes = RNode.s.g.prog.nodes, n = RNode.s.n)]) + "(" + ArgList(nodes = RNode.s.g.prog.nodes, n = RNode.s.n) + ").map_err(|e| wrap(" + Quote(s = QualName(n = RNode.s.g.prog.nodes[RNode.s.n])) + ", e.into()))?;" }),
		Id(_) -> RNodeBody(s = { g = RNode.s.g, pid = RNode.s.pid, n = RNode.s.n, run = "let this = input.value;" }),
		Sig(_) -> RNodeBody(s = { g = RNode.s.g, pid = RNode.s.pid, n = RNode.s.n, run = SigValue(g = RNode.s.g, n = RNode.s.n) }),
		else -> RCallee(s = { g = RNode.s.g, n = RNode.s.n })
	};
	// A callee error here stops the generator.
	RCallee switch {
		(IsSomeS(m = this.g.failed) && !IsSomeS(m = RNode.s.g.failed)) -> RNodeBody(s = { g = GFatal(g = RNode.s.g, msg = UnwrapS(m = this.g.failed)), pid = RNode.s.pid, n = RNode.s.n, run = "" }),
		else -> RNodeBody(s = { g = this.g, pid = RNode.s.pid, n = RNode.s.n, run = "let this = " + this.s + "(" + ArgList(nodes = RNode.s.g.prog.nodes, n = RNode.s.n) + ").map_err(|e| wrap(" + Quote(s = QualName(n = RNode.s.g.prog.nodes[RNode.s.n])) + ", e.into()))?;" })
	};
}

// Writes a node's state after its run line: its edge (a transition, a
// switch, a for each fanning out over its region's function and collecting
// the results, or a spawn and its join), or, with none, returning its output
// as the proc's.
proc RNodeBody(s: { g: RGen, pid: int, n: int, run: string }): EmitLines {
	func Head(g: RGen, pid: int, n: int, run: string): []Line = "gen_leaf.rs:node_head";
	RNodeBody switch {
		(this.s.n in GraphOf(n = this.s.g.prog.nodes[this.s.pid]).edges) -> id(GraphOf(n = this.s.g.prog.nodes[this.s.pid]).edges[this.s.n]) as E,
		else -> RCoerce(s = { g = this.s.g, expr = "this", from = NodeRet(nodes = this.s.g.prog.nodes, n = this.s.n), to = ProcRet(n = this.s.g.prog.nodes[this.s.pid]) }) as Ret
	};
	Ret -> id({ g = this.g, lines = Head(g = RNodeBody.s.g, pid = RNodeBody.s.pid, n = RNodeBody.s.n, run = RNodeBody.s.run) + [L("return Ok(" + this.s + ");"), L("}")] });
	E switch {
		Call(c) -> RTransition(s = { g = RNodeBody.s.g, pid = RNodeBody.s.pid, c = c }) as Jump,
		Collect(_) -> id({ g = RNodeBody.s.g, lines = Head(g = RNodeBody.s.g, pid = RNodeBody.s.pid, n = RNodeBody.s.n, run = RNodeBody.s.run) + [L("return Ok(this);"), L("}")] }),
		Match(arms) -> RSwitch(s = { g = RNodeBody.s.g, pid = RNodeBody.s.pid, n = RNodeBody.s.n, arms = arms, top = true, i = 0, always = false, acc = [] }) as Arms,
		ForEach(f) -> ROwn(s = { g = RNodeBody.s.g, e = f.dim }) as Dim,
		Spawn(sp) -> RSpawn(s = { g = RNodeBody.s.g, branches = sp.branches, joined = sp.joined, i = 0, lines = [], calls = [] })
	};
	RSpawn -> RTransition(s = { g = this.g, pid = RNodeBody.s.pid, c = SpawnJoin(e = E) }) as Joined;
	Joined -> id({ g = this.g, lines = Head(g = RNodeBody.s.g, pid = RNodeBody.s.pid, n = RNodeBody.s.n, run = RNodeBody.s.run) + RSpawn.lines + this.lines + [L("}")] });
	Jump -> id(this) as EdgeLines;
	Arms -> id(this) as EdgeLines;
	EdgeLines -> id({ g = this.g, lines = Head(g = RNodeBody.s.g, pid = RNodeBody.s.pid, n = RNodeBody.s.n, run = RNodeBody.s.run) + this.lines + [L("}")] });
	Dim -> RTransition(s = { g = this.g, pid = RNodeBody.s.pid, c = CollectCall(g = GraphOf(n = RNodeBody.s.g.prog.nodes[RNodeBody.s.pid]), n = RNodeBody.s.n) }) as Collected;
	Collected -> id({ g = this.g, lines = Head(g = RNodeBody.s.g, pid = RNodeBody.s.pid, n = RNodeBody.s.n, run = RNodeBody.s.run) + [
		L("let dim = " + Dim.s + ";"),
		L("let results = fan_out(dim.to_vec(), |elem| " + RegionFn(g = RNodeBody.s.g, pid = RNodeBody.s.pid, r = GraphOf(n = RNodeBody.s.g.prog.nodes[RNodeBody.s.pid]).opens[RNodeBody.s.n]) + "(env.clone(), elem))?;"),
		L("let this = types::List::from(results);")
	] + this.lines + [L("}")] });
}

func CollectCall(g: Graph, n: int): Call = "gen_leaf.rs:collect_call";
func SpawnJoin(e: SEdge): Call = "gen_leaf.rs:spawn_join";

// Writes a spawn's branches, each a call of its node (emit_spawn in the
// reference): every branch's arguments into variables, then the threads.
proc RSpawn(s: { g: RGen, branches: []SBranch, joined: Type, i: int, lines: []Line, calls: []string }): EmitLines {
	// Writes `let a<i>_<arg> = <value>;` for each of a branch's arguments.
	func ArgLines(i: int, args: []CallArg, values: []string): []Line = "gen_leaf.rs:spawn_arg_lines";
	func ArgVars(i: int, args: []CallArg): string = "gen_leaf.rs:spawn_arg_vars";
	// Writes a spawn's threads: detached branches on threads of their own,
	// joined ones on scoped threads, then this: the joined outputs.
	func Threads(g: RGen, branches: []SBranch, joined: Type, calls: []string): []Line = "gen_leaf.rs:spawn_threads";
	RSpawn switch {
		(this.s.i == this.s.branches.len) -> id({ g = this.s.g, lines = this.s.lines + Threads(g = this.s.g, branches = this.s.branches, joined = this.s.joined, calls = this.s.calls) }),
		else -> RArgs(s = { g = this.s.g, args = this.s.branches[this.s.i].call.args, i = 0, acc = [] })
	};
	RArgs -> id(this.g.prog.nodes[BaseOf(nodes = this.g.prog.nodes, n = RSpawn.s.branches[RSpawn.s.i].call.target)].kind) as K;
	K switch {
		Proc(_) -> id({ g = RArgs.g, callee = "run_" + SnakeG(n = RArgs.g.prog.nodes[BaseOf(nodes = RArgs.g.prog.nodes, n = RSpawn.s.branches[RSpawn.s.i].call.target)]) }) as Called,
		else -> RCallee(s = { g = RArgs.g, n = RSpawn.s.branches[RSpawn.s.i].call.target })
	};
	// A callee error here stops the generator.
	RCallee switch {
		(IsSomeS(m = this.g.failed) && !IsSomeS(m = RArgs.g.failed)) -> id({ g = GFatal(g = RArgs.g, msg = UnwrapS(m = this.g.failed)), callee = "" }) as Called,
		else -> id({ g = this.g, callee = this.s }) as Called
	};
	Called -> RSpawn(s = {
		g = this.g, branches = RSpawn.s.branches, joined = RSpawn.s.joined, i = RSpawn.s.i + 1,
		lines = RSpawn.s.lines + ArgLines(i = RSpawn.s.i, args = RSpawn.s.branches[RSpawn.s.i].call.args, values = RArgs.parts),
		calls = RSpawn.s.calls + [this.callee + "(" + ArgVars(i = RSpawn.s.i, args = RSpawn.s.branches[RSpawn.s.i].call.args) + ").map_err(|e| wrap(" + Quote(s = QualName(n = RSpawn.s.g.prog.nodes[RSpawn.s.branches[RSpawn.s.i].call.target])) + ", e.into()))"]
	});
}
func RegionFn(g: RGen, pid: int, r: int): string = "gen_leaf.rs:region_fn";

// Writes a region's state machine: a loop over a match on pc, one state per
// node, failing on a state that isn't there.
proc RLoop(s: { g: RGen, pid: int, nodes: []int, i: int, acc: []Line }): EmitLines {
	RLoop switch {
		(this.s.i == this.s.nodes.len) -> id({ g = this.s.g, lines = [L("loop {"), L("match pc {")] + this.s.acc + [L("_ => return Err(format!(" + Quote(s = QualName(n = this.s.g.prog.nodes[this.s.pid]) + ": invalid state {pc:?}") + ").into()),"), L("}"), L("}")] }),
		else -> RNode(s = { g = this.s.g, pid = this.s.pid, n = this.s.nodes[this.s.i] })
	};
	RNode -> RLoop(s = { g = this.g, pid = RLoop.s.pid, nodes = RLoop.s.nodes, i = RLoop.s.i + 1, acc = RLoop.s.acc + this.lines });
}

// Writes a proc: its env and pc, run_<proc> with its machine over the body,
// then a function per for each region.
proc RProc(s: { g: RGen, pid: int }): EmitLines {
	func Prelude(g: RGen, pid: int): []Line = "gen_leaf.rs:proc_prelude";
	func Opens(g: Graph): []int = "gen_leaf.rs:opens_by_region";
	RProc -> RLoop(s = { g = { ..this.s.g, proc_name = QualName(n = this.s.g.prog.nodes[this.s.pid]) }, pid = this.s.pid, nodes = GraphOf(n = this.s.g.prog.nodes[this.s.pid]).regions[0].nodes, i = 0, acc = [] });
	RLoop -> RRegions(s = { g = this.g, pid = RProc.s.pid, opens = Opens(g = GraphOf(n = RProc.s.g.prog.nodes[RProc.s.pid])), i = 0, acc = Prelude(g = RProc.s.g, pid = RProc.s.pid) + this.lines + [L("}"), L("")] });
}

// Writes one function per for each region, which runs the region on one
// element: its input, then its own machine.
proc RRegions(s: { g: RGen, pid: int, opens: []int, i: int, acc: []Line }): EmitLines {
	func RegionHead(g: RGen, pid: int, opener: int): []Line = "gen_leaf.rs:region_head";
	func EntryCall(g: Graph, opener: int): Call = "gen_leaf.rs:for_each_call_of";
	RRegions switch {
		(this.s.i == this.s.opens.len) -> id({ g = this.s.g, lines = this.s.acc }),
		else -> RInput(s = { g = this.s.g, c = EntryCall(g = GraphOf(n = this.s.g.prog.nodes[this.s.pid]), opener = this.s.opens[this.s.i]) })
	};
	RInput -> RLoop(s = { g = this.g, pid = RRegions.s.pid, nodes = GraphOf(n = RRegions.s.g.prog.nodes[RRegions.s.pid]).regions[GraphOf(n = RRegions.s.g.prog.nodes[RRegions.s.pid]).opens[RRegions.s.opens[RRegions.s.i]]].nodes, i = 0, acc = [] });
	RLoop -> RRegions(s = { g = this.g, pid = RRegions.s.pid, opens = RRegions.s.opens, i = RRegions.s.i + 1, acc = RRegions.s.acc + RegionHead(g = RRegions.s.g, pid = RRegions.s.pid, opener = RRegions.s.opens[RRegions.s.i]) + [
		L("env.in_" + SnakeG(n = RRegions.s.g.prog.nodes[GraphOf(n = RRegions.s.g.prog.nodes[RRegions.s.pid]).regions[GraphOf(n = RRegions.s.g.prog.nodes[RRegions.s.pid]).opens[RRegions.s.opens[RRegions.s.i]]].entry]) + " = Some(" + RInput.s + ");"),
		L("let mut pc = Pc" + Gname(n = RRegions.s.g.prog.nodes[RRegions.s.pid]) + "::" + Gname(n = RRegions.s.g.prog.nodes[GraphOf(n = RRegions.s.g.prog.nodes[RRegions.s.pid]).regions[GraphOf(n = RRegions.s.g.prog.nodes[RRegions.s.pid]).opens[RRegions.s.opens[RRegions.s.i]]].entry]) + ";")
	] + this.lines + [L("}"), L("")] });
}

// ---- The whole backend ----

// http: "" without servers.
type RustOut = { types: string, procs: string, modrs: string, http: string, err: MaybeStr };

// Generates a program's Rust: types.rs, procs.rs, mod.rs and, with servers,
// http.rs. Fails on a bad module_dir or names that would clash in Rust, and
// on the first error writing the procs or servers.
proc RustGenerate(s: { prog: Program, module_dir: MaybeStr, servers: []ServerSpec }): RustOut {
	func NameClash(prog: Program): MaybeStr = "gen_leaf.rs:name_clash";
	func BadModuleDir(d: MaybeStr): MaybeStr = "gen_leaf.rs:bad_module_dir";
	func Trimmed(d: MaybeStr): MaybeStr = "gen_leaf.rs:trim_dir";
	// Lists all procs, parents before children, in source order.
	func Order(nodes: []NodeDecl, top: []int): []int = "gen_leaf.rs:all_procs_ordered";
	RustGenerate -> BuildTable(prog = this.s.prog);
	BuildTable switch {
		(IsSomeS(m = BadModuleDir(d = Trimmed(d = RustGenerate.s.module_dir)))) -> id({ types = "", procs = "", modrs = "", http = "", err = BadModuleDir(d = Trimmed(d = RustGenerate.s.module_dir)) }),
		(IsSomeS(m = NameClash(prog = RustGenerate.s.prog))) -> id({ types = "", procs = "", modrs = "", http = "", err = NameClash(prog = RustGenerate.s.prog) }),
		else -> RustTypegen(t = this)
	};
	RustTypegen -> RProcs(s = {
		g = { prog = RustGenerate.s.prog, table = BuildTable, module_dir = Trimmed(d = RustGenerate.s.module_dir), coercions = [:], helpers = [], stubs = [:], failed = None(), fatal = None(), proc_name = "", moves = NoMoves(n = 0), mounts = [:] },
		procs = Order(nodes = RustGenerate.s.prog.nodes, top = RustGenerate.s.prog.top), i = 0, acc = []
	});
	RProcs switch {
		(RustGenerate.s.servers.len == 0) -> id({ types = RustTypegen, procs = ProcsFile(g = this.g, body = Lines(lines = this.lines, indent = "    ")), modrs = ModRs(n = 0) + MountLines(mounts = this.g.mounts), http = "", err = FirstError(g = this.g) }),
		else -> RustHttp(s = { g = this.g, servers = RustGenerate.s.servers })
	};
	// As in the reference: an error that stopped the generator, then one in
	// http.rs, then one from an expression.
	RustHttp switch {
		{ text = _, err = Some(e) } -> switch {
			(IsSomeS(m = RProcs.g.fatal)) -> id({ types = RustTypegen, procs = "", modrs = "", http = "", err = RProcs.g.fatal }),
			else -> id({ types = RustTypegen, procs = "", modrs = "", http = "", err = Some(e) })
		},
		else -> switch {
			(IsSomeS(m = FirstError(g = RProcs.g))) -> id({ types = RustTypegen, procs = "", modrs = "", http = "", err = FirstError(g = RProcs.g) }),
			else -> id({ types = RustTypegen, procs = ProcsFile(g = RProcs.g, body = Lines(lines = RProcs.lines, indent = "    ")), modrs = ModRs(n = 0) + MountLines(mounts = RProcs.g.mounts) + "pub mod http;\n", http = this.text, err = None() })
		}
	};
}

func ModRs(n: int): string = "gen_leaf.rs:mod_rs";
// Writes the rest of procs.rs around the procs' code: the header and
// runtime, the input structs, the stubs and the coercion helpers.
func ProcsFile(g: RGen, body: string): string = "gen_leaf.rs:procs_file";
func FirstError(g: RGen): MaybeStr = "gen_leaf.rs:first_error";

// Writes each proc in turn, stopping at an error that stops the generator.
proc RProcs(s: { g: RGen, procs: []int, i: int, acc: []Line }): EmitLines {
	RProcs switch {
		(this.s.i == this.s.procs.len || IsSomeS(m = this.s.g.fatal)) -> id({ g = this.s.g, lines = this.s.acc }),
		else -> RProc(s = { g = this.s.g, pid = this.s.procs[this.s.i] })
	};
	RProc -> RProcs(s = { g = this.g, procs = RProcs.s.procs, i = RProcs.s.i + 1, acc = RProcs.s.acc + this.lines });
}
