// The Rust backend (src/codegen/rust.rs in the reference): types.rs, one
// state machine per proc in procs.rs, mod.rs, and mains.

type Line = enum { L(string), Raw(string) };

// Renders lines of generated code as the reference's Writer does, indenting
// each by `indent` per level: a line starting with a closer dedents, one
// ending with an opener indents, and Go `case`/`default:` lines hang one
// level out. Raw chunks are copied as they are.
func Lines(lines: []Line, indent: string): string = "gen_leaf.rs:render_lines";
func RustShared(n: int): string = "gen_leaf.rs:rust_shared";
// Makes a vandorf name a Rust identifier: a keyword raw (`r#type`), and
// `self`, `Self`, `super` and `crate`, which can't be, with `_` after them.
func RustIdent(s: string): string = "gen_leaf.rs:rust_ident";
// Writes a string as a literal in Rust (and Go) source, escaped.
func Quote(s: string): string = "gen_leaf.rs:quote";
// Writes a table type as Rust source: primitives as i64, f64, bool and Str,
// arrays as List, maps as Map, named types by their table name, each
// prefixed with `qual`.
func RustRender(t: Table, r: TyRef, qual: string): string = "gen_leaf.rs:rust_render";

// ---- types.rs ----

// Generates types.rs: the shared runtime types (Str, List, Map), a struct or
// enum per shape in the table, then the typedef aliases.
proc RustTypegen(t: Table): string {
	RustTypegen -> TypeLines(s = { t = this.t, i = 0, acc = [L("// Code generated by vandorf. DO NOT EDIT."), L("#![allow(non_camel_case_types, non_snake_case, dead_code)]"), Raw(RustShared(n = 0))] });
	TypeLines -> AliasLines(s = { t = RustTypegen.t, i = 0, acc = this });
	AliasLines -> id(Lines(lines = this, indent = "    "));
}

// Writes each named shape in the table as a Rust struct or enum, with its
// doc comment and derives.
proc TypeLines(s: { t: Table, i: int, acc: []Line }): []Line {
	TypeLines switch {
		(this.s.i == this.s.t.types.len) -> id(this.s.acc),
		else -> id(this.s.t.types[this.s.i].shape) as S
	};
	S switch {
		Struct(fs) -> MemberLines(s = { t = TypeLines.s.t, i = TypeLines.s.i, ms = fs, variants = false, j = 0, acc = TypeLines.s.acc + Doc(t = TypeLines.s.t, n = TypeLines.s.t.types[TypeLines.s.i]) + [L("#[derive(Debug, Clone, PartialEq)]"), L("pub struct " + TypeLines.s.t.types[TypeLines.s.i].name + " {")] }) as Ms,
		Enum(vs) -> MemberLines(s = { t = TypeLines.s.t, i = TypeLines.s.i, ms = vs, variants = true, j = 0, acc = TypeLines.s.acc + Doc(t = TypeLines.s.t, n = TypeLines.s.t.types[TypeLines.s.i]) + [L("#[derive(Debug, Clone, PartialEq)]"), L("pub enum " + TypeLines.s.t.types[TypeLines.s.i].name + " {")] }) as Ms
	};
	Ms -> TypeLines(s = { t = TypeLines.s.t, i = TypeLines.s.i + 1, acc = this + [L("}"), L("")] });
}

// Writes a type's doc comment: its typedef's (or "/// A typedef." if it has
// none), or "/// The type of the <origin>." for a shape named where it first
// appears.
func Doc(t: Table, n: NamedType): []Line = "gen_leaf.rs:rust_doc";
// Writes the doc comment of the typedef alias `name`: its typedef's, or "///
// A typedef.".
func AliasDoc(t: Table, name: string): []Line = "gen_leaf.rs:rust_alias_doc";

// Writes a struct's fields as `pub name: type,` or an enum's variants as
// `Name(type),` (`Name,` without a payload), boxing those that would make
// the type contain itself.
proc MemberLines(s: { t: Table, i: int, ms: []RefMember, variants: bool, j: int, acc: []Line }): []Line {
	func IsVoidRef(r: TyRef): bool = "gen_leaf.rs:is_void_ref";
	MemberLines switch {
		(this.s.j == this.s.ms.len) -> id(this.s.acc),
		(this.s.variants && IsVoidRef(r = this.s.ms[this.s.j].r)) -> MemberLines(s = { t = this.s.t, i = this.s.i, ms = this.s.ms, variants = this.s.variants, j = this.s.j + 1, acc = this.s.acc + [L(RustIdent(s = this.s.ms[this.s.j].name) + ",")] }),
		(this.s.variants) -> MemberLines(s = { t = this.s.t, i = this.s.i, ms = this.s.ms, variants = this.s.variants, j = this.s.j + 1, acc = this.s.acc + [L(RustIdent(s = this.s.ms[this.s.j].name) + "(" + FieldType(t = this.s.t, i = this.s.i, m = this.s.ms[this.s.j]) + "),")] }),
		else -> MemberLines(s = { t = this.s.t, i = this.s.i, ms = this.s.ms, variants = this.s.variants, j = this.s.j + 1, acc = this.s.acc + [L("pub " + RustIdent(s = this.s.ms[this.s.j].name) + ": " + FieldType(t = this.s.t, i = this.s.i, m = this.s.ms[this.s.j]) + ",")] })
	};
}

// Writes a field's type, behind an Arc where it would make the type contain
// itself.
func FieldType(t: Table, i: int, m: RefMember): string = "gen_leaf.rs:rust_field_type";

// Writes each typedef alias as `pub type Name = type;`, with its doc
// comment; a foreign type's is written with the procs, where its
// implementation's place is known.
proc AliasLines(s: { t: Table, i: int, acc: []Line }): []Line {
	func IsForeignRef(r: TyRef): bool = "gen_leaf.rs:is_foreign_ref";
	AliasLines switch {
		(this.s.i == this.s.t.aliases.len) -> id(this.s.acc),
		(IsForeignRef(r = this.s.t.aliases[this.s.i].r)) -> AliasLines(s = { ..this.s, i = this.s.i + 1 }),
		else -> AliasLines(s = { t = this.s.t, i = this.s.i + 1, acc = this.s.acc + AliasDoc(t = this.s.t, name = this.s.t.aliases[this.s.i].name) + [L("pub type " + this.s.t.aliases[this.s.i].name + " = " + RustRender(t = this.s.t, r = this.s.t.aliases[this.s.i].r, qual = "") + ";"), L("")] })
	};
}
