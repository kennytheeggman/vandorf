// The terminal routes: shells on a pty, read by long polling. Each passes
// TermGate first.
//   POST /api/term?cwd=..                 a new terminal, its id
//   GET  /api/term/list                   the terminals' ids
//   GET  /api/term/read?id=&from=         output from an offset (X-Next, X-Closed)
//   POST /api/term/input?id=              the body, typed
//   POST /api/term/resize?id=&cols=&rows=
//   POST /api/term/kill?id=

func Chunk(c: TermChunk): HttpResponse = "ide_leaf.rs:chunk_response";
func Ints(xs: []int): []Json = "ide_leaf.rs:ints";
func OkJson(n: int): HttpResponse = "ide_leaf.rs:ok_json";
// Reads q[k] as an int, or -1 if it isn't one.
func QueryInt(s: { q: map[string]string, k: string }): int = "ide_leaf.rs:query_int";
// Whether the query names a terminal: an id that's a number, not negative.
func HasId(q: map[string]string): bool = "ide_leaf.rs:has_id";
func IdIn(seen: []int, x: int): bool = "../sema/sema_leaf.rs:has_int";
// Whether q[k] is a terminal dimension: an integer in 1..=65535.
func Dim(s: { q: map[string]string, k: string }): bool = "ide_leaf.rs:is_dim";

// Serves POST /api/term?cwd=..: starts a terminal in cwd if it's a directory
// under the source directory, else in the source directory, and gives its
// id.
proc TermNewRoute(req: HttpRequest): HttpResponse {
	TermNewRoute -> TermGate(req = this.req);
	TermGate switch {
		Shut(r) -> id(r),
		else -> Session.Base(n = 0)
	};
	Session.Base switch {
		("cwd" in TermNewRoute.req.query && TermNewRoute.req.query["cwd"] != "") -> ResolvePath(s = { base = this, p = TermNewRoute.req.query["cwd"] }),
		else -> Term.Spawn(cwd = this)
	};
	ResolvePath switch {
		Ok(dir) -> Fs.IsDir(path = dir),
		Err(_) -> Term.Spawn(cwd = Session.Base)
	};
	Fs.IsDir switch {
		(this) -> Term.Spawn(cwd = UnwrapR2(r = ResolvePath)),
		else -> Term.Spawn(cwd = Session.Base)
	};
	Term.Spawn switch {
		Ok(n) -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "id", value = Num(n) }]))),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
}

// Serves GET /api/term/list: the ids of the running terminals.
proc TermListRoute(req: HttpRequest): HttpResponse {
	TermListRoute -> TermGate(req = this.req);
	TermGate switch {
		Shut(r) -> id(r),
		else -> Term.List(n = 0)
	};
	Term.List -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "ids", value = Arr(Ints(xs = this)) }])));
}

// Serves GET /api/term/read?id=&from=: the terminal's output from `from`,
// waiting a while for some.
proc TermReadRoute(req: HttpRequest): HttpResponse {
	TermReadRoute -> TermGate(req = this.req);
	TermGate switch {
		Shut(r) -> id(r),
		else -> switch {
			(!HasId(q = TermReadRoute.req.query)) -> id(ApiErr(msg = "no such terminal")),
			else -> Term.Read(id = QueryInt(s = { q = TermReadRoute.req.query, k = "id" }), from = QueryInt(s = { q = TermReadRoute.req.query, k = "from" }))
		}
	};
	Term.Read switch {
		(this.ok) -> id(Chunk(c = this)),
		else -> id(ApiErr(msg = "no such terminal"))
	};
}

// Serves POST /api/term/input?id=: types the body into the terminal.
proc TermInputRoute(req: HttpRequest): HttpResponse {
	TermInputRoute -> TermGate(req = this.req);
	TermGate switch {
		Shut(r) -> id(r),
		else -> switch {
			(!HasId(q = TermInputRoute.req.query)) -> id(ApiErr(msg = "no such terminal")),
			else -> Term.Input(id = QueryInt(s = { q = TermInputRoute.req.query, k = "id" }), data = TermInputRoute.req.body)
		}
	};
	Term.Input switch {
		Ok(_) -> id(OkJson(n = 0)),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
}

// Serves POST /api/term/resize?id=&cols=&rows=: resizes the terminal, if the
// size is valid.
proc TermResizeRoute(req: HttpRequest): HttpResponse {
	TermResizeRoute -> TermGate(req = this.req);
	TermGate switch {
		Shut(r) -> id(r),
		else -> Term.List(n = 0)
	};
	// The terminal first, then its size (each a u16 above zero).
	Term.List switch {
		(!HasId(q = TermResizeRoute.req.query) || !IdIn(seen = this, x = QueryInt(s = { q = TermResizeRoute.req.query, k = "id" }))) -> id(ApiErr(msg = "no such terminal")),
		(Dim(s = { q = TermResizeRoute.req.query, k = "cols" }) && Dim(s = { q = TermResizeRoute.req.query, k = "rows" })) -> Term.Resize(id = QueryInt(s = { q = TermResizeRoute.req.query, k = "id" }), cols = QueryInt(s = { q = TermResizeRoute.req.query, k = "cols" }), rows = QueryInt(s = { q = TermResizeRoute.req.query, k = "rows" })),
		else -> id(ApiErr(msg = "need cols and rows"))
	};
	Term.Resize switch {
		Ok(_) -> id(OkJson(n = 0)),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
}

// Serves POST /api/term/kill?id=: ends the terminal.
proc TermKillRoute(req: HttpRequest): HttpResponse {
	TermKillRoute -> TermGate(req = this.req);
	TermGate switch {
		Shut(r) -> id(r),
		else -> switch {
			(!HasId(q = TermKillRoute.req.query)) -> id(ApiErr(msg = "no such terminal")),
			else -> Term.Kill(id = QueryInt(s = { q = TermKillRoute.req.query, k = "id" }))
		}
	};
	Term.Kill switch {
		(this) -> id(OkJson(n = 0)),
		else -> id(ApiErr(msg = "no such terminal"))
	};
}
