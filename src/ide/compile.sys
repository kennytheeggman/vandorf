// POST /api/compile {source} or {path}: the document, symbols and generated
// code, or diagnostics; with previews: false, no generated code (the
// diagram's part, quick). If the file belongs to a project (a vandorf.toml at
// or above it, inside the source directory), the whole project is compiled
// with the editor's text in place of the file, and previewed with the
// manifest's settings; otherwise just the text, with nominal output
// locations. Nothing is written.

type MaybeProject = enum { None, Some(Project) };
// The files compiled: names as shown, texts, the root names are relative to,
// and which is the editor's; previews: whether to generate code.
type Unit = { names: []string, srcs: []string, root: string, here: int, project: MaybeProject, previews: bool };
// Whether a compile request wants generated code: unless it says `previews:
// false`.
func WantsPreviews(j: Json): bool = "ide_leaf.rs:wants_previews";

func NonBlank(m: MaybeStr): bool = "ide_leaf.rs:non_blank";
func NonEmpty(m: MaybeStr): bool = "ide_leaf.rs:non_empty";
func PathIndex(paths: []string, root: string, abs: string): int = "ide_leaf.rs:index_of_path";
func SetAt(xs: []string, i: int, x: string): []string = "ide_leaf.rs:set_at";

// Serves POST /api/compile {source} or {path}: the document, symbols and
// generated code, or diagnostics. With previews: false there's no generated
// code (the diagram's part, quick). If the file belongs to a project (a
// vandorf.toml at or above it, inside the source directory), the whole
// project is compiled with the editor's text in place of the file, and
// previewed with the manifest's settings; otherwise just the text, with
// nominal output locations. Nothing is written.
proc CompileRoute(req: HttpRequest): HttpResponse {
	CompileRoute -> Session.Base(n = 0);
	Session.Base -> ParseJson(text = CompileRoute.req.body);
	ParseJson switch {
		Ok(j) -> switch {
			(NonBlank(m = JsonStr(j = j, key = "source"))) -> id(UnwrapS(m = JsonStr(j = j, key = "source"))) as Text,
			(NonEmpty(m = JsonStr(j = j, key = "path"))) -> ReadSource(s = { base = Session.Base, p = UnwrapS(m = JsonStr(j = j, key = "path")) }),
			else -> id(ApiErr(msg = "provide either \"path\" or \"source\""))
		},
		Err(e) -> id(ApiErr(msg = "bad request: " + e.msg))
	};
	ReadSource switch {
		Ok(text) -> id(text) as Text,
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Text switch {
		(NonEmpty(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "path"))) -> ResolvePath(s = { base = Session.Base, p = UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "path")) }),
		else -> CompileUnit(s = { base = Session.Base, unit = { names = [EditorName(j = UnwrapJ(r = ParseJson))], srcs = [this], root = Session.Base, here = 0, project = None(), previews = WantsPreviews(j = UnwrapJ(r = ParseJson)) } }) as Single
	};
	ResolvePath switch {
		Ok(abs) -> FindUp(s = { dir = Parent(p = abs), marker = "vandorf.toml" }),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	FindUp switch {
		(this != "" && (this == Session.Base || HasPrefix(text = this, prefix = Session.Base + "/"))) -> LoadProject(path = JoinP(a = this, b = "vandorf.toml")),
		else -> CompileUnit(s = { base = Session.Base, unit = { names = [EditorName(j = UnwrapJ(r = ParseJson))], srcs = [Text], root = Session.Base, here = 0, project = None(), previews = WantsPreviews(j = UnwrapJ(r = ParseJson)) } }) as Alone
	};
	LoadProject switch {
		Ok(p) -> switch {
			(PathIndex(paths = p.paths, root = p.root, abs = UnwrapR2(r = ResolvePath)) < 0) -> id(ApiErr(msg = UnwrapR2(r = ResolvePath) + " is not under the sources of " + JoinP(a = FindUp, b = "vandorf.toml"))),
			else -> CompileUnit(s = { base = Session.Base, unit = { names = p.paths, srcs = SetAt(xs = p.srcs, i = PathIndex(paths = p.paths, root = p.root, abs = UnwrapR2(r = ResolvePath)), x = Text), root = p.root, here = PathIndex(paths = p.paths, root = p.root, abs = UnwrapR2(r = ResolvePath)), project = Some({ ..p, srcs = SetAt(xs = p.srcs, i = PathIndex(paths = p.paths, root = p.root, abs = UnwrapR2(r = ResolvePath)), x = Text) }), previews = WantsPreviews(j = UnwrapJ(r = ParseJson)) } }) as InProject
		},
		Err(e) -> id(ApiErr(msg = e.msg))
	};
}

// Names the editor's file in messages: its path, its "name", or <editor>.
func EditorName(j: Json): string = "ide_leaf.rs:editor_name";
func UnwrapR2(r: Res<string>): string = "ide_leaf.rs:unwrap_res_string";

// Makes a cache key of what a unit is checked from, its sources: two hashes
// of them, so a collision is out of reach. Their names, and the file asked
// about, only change how the result is shown.
func CheckKey(srcs: []string): string = "ide_leaf.rs:check_key";
// Gives the program of a check that failed to parse: an empty one.
func NoProgram(n: int): Program = "ide_leaf.rs:no_program";

// Compiles a unit: its check is kept from an earlier compile or made
// (parsed, then analyzed) and kept. Then it answers with the diagnostics, or
// the document and symbols, and with previews the generated Rust and Go.
proc CompileUnit(s: { base: string, unit: Unit }): HttpResponse {
	// The unit's check: kept from an earlier compile, or made and kept.
	CompileUnit -> Checks.Claim(key = CheckKey(srcs = this.s.unit.srcs));
	Checks.Claim switch {
		Some(c) -> id(c) as Have,
		else -> ParseUnit(s = { srcs = CompileUnit.s.unit.srcs, i = 0, file = { types = [], interfaces = [], nodes = [] }, errors = [] })
	};
	ParseUnit switch {
		(this.errors.len > 0) -> Checks.Put(key = CheckKey(srcs = CompileUnit.s.unit.srcs), c = { parse_errors = this.errors, sema_errors = [], prog = NoProgram(n = 0) }) as KeepParse,
		else -> Analyze(s = { srcs = CompileUnit.s.unit.srcs, file = this.file })
	};
	Analyze -> Checks.Put(key = CheckKey(srcs = CompileUnit.s.unit.srcs), c = { parse_errors = [], sema_errors = this.errors, prog = this.prog }) as KeepSema;
	KeepParse -> id({ parse_errors = ParseUnit.errors, sema_errors = [], prog = NoProgram(n = 0) }) as Have;
	KeepSema -> id({ parse_errors = [], sema_errors = Analyze.errors, prog = Analyze.prog }) as Have;
	Have switch {
		(this.parse_errors.len > 0) -> Diagnostics(s = { unit = CompileUnit.s.unit, errors = this.parse_errors }) as ParseErrors,
		(this.sema_errors.len > 0) -> Diagnostics(s = { unit = CompileUnit.s.unit, errors = this.sema_errors }) as SemaErrors,
		else -> Symbols(s = { base = CompileUnit.s.base, unit = CompileUnit.s.unit, prog = this.prog })
	};
	Symbols switch {
		(CompileUnit.s.unit.previews) -> RustPreview(s = { unit = CompileUnit.s.unit, prog = Have.prog }),
		else -> DocumentJson(prog = Have.prog) as DiagramOnly
	};
	RustPreview -> GoPreview(s = { unit = CompileUnit.s.unit, prog = Have.prog });
	GoPreview -> PythonPreview(unit = CompileUnit.s.unit, prog = Have.prog);
	PythonPreview -> DocumentJson(prog = Have.prog);
	DiagramOnly -> id(Api(j = Obj([
		{ key = "ok", value = Bool(true) },
		{ key = "name", value = Str(CompileUnit.s.unit.names[CompileUnit.s.unit.here]) },
		{ key = "project", value = ProjectName(p = CompileUnit.s.unit.project) },
		{ key = "grids", value = Num(Procs(nodes = Have.prog.nodes).len) },
		{ key = "document", value = this },
		{ key = "symbols", value = Symbols }
	])));
	DocumentJson -> id(Api(j = Obj([
		{ key = "ok", value = Bool(true) },
		{ key = "name", value = Str(CompileUnit.s.unit.names[CompileUnit.s.unit.here]) },
		{ key = "project", value = ProjectName(p = CompileUnit.s.unit.project) },
		{ key = "grids", value = Num(Procs(nodes = Have.prog.nodes).len) },
		{ key = "document", value = this },
		{ key = "symbols", value = Symbols },
		{ key = "go", value = GoPreview },
		{ key = "rust", value = RustPreview },
		{ key = "python", value = PythonPreview }
	])));
}

func ProjectName(p: MaybeProject): Json = "ide_leaf.rs:project_name_json";

// Parses each of a unit's files in turn, merging what they declare; parse
// errors are kept, as diagnostics, not failures.
proc ParseUnit(s: { srcs: []string, i: int, file: File, errors: []Diag }): { file: File, errors: []Diag } {
	ParseUnit switch {
		(this.s.i == this.s.srcs.len) -> id({ file = this.s.file, errors = this.s.errors }),
		else -> TryParse(src = this.s.srcs[this.s.i], file = this.s.i)
	};
	TryParse switch {
		Ok(f) -> ParseUnit(s = { ..ParseUnit.s, i = ParseUnit.s.i + 1, file = { types = ParseUnit.s.file.types + f.types, interfaces = ParseUnit.s.file.interfaces + f.interfaces, nodes = ParseUnit.s.file.nodes + f.nodes } }),
		Err(e) -> ParseUnit(s = { ..ParseUnit.s, i = ParseUnit.s.i + 1, errors = ParseUnit.s.errors + [e] })
	};
}

// Answers with a unit's errors, each with its file and position, and all of
// them rendered: 200 with ok: false, so the client can still read them.
proc Diagnostics(s: { unit: Unit, errors: []Diag }): HttpResponse {
	func List(names: []string, srcs: []string, here: int, errors: []Diag): Json = "ide_leaf.rs:diagnostics_json";
	func Rendered(names: []string, srcs: []string, errors: []Diag): string = "ide_leaf.rs:render_diagnostics";
	Diagnostics -> id(Api(j = Obj([
		{ key = "ok", value = Bool(false) },
		{ key = "error", value = Str(Rendered(names = this.s.unit.names, srcs = this.s.unit.srcs, errors = this.s.errors)) },
		{ key = "diagnostics", value = List(names = this.s.unit.names, srcs = this.s.unit.srcs, here = this.s.unit.here, errors = this.s.errors) }
	])));
}

// ---- Symbols, for the viewer's preview drawer ----

// Lists the program's symbols for the viewer's preview drawer: typedefs,
// funcs and procs, with their doc comments, where they're declared (paths
// relative to the source directory, 0-based lines) and, for funcs, their
// implementation files resolved the same way.
proc Symbols(s: { base: string, unit: Unit, prog: Program }): Json {
	Symbols -> TypeSymbols(s = { types = this.s.prog.types, i = 0, acc = [] });
	TypeSymbols -> NodeSymbols(s = { base = Symbols.s.base, unit = Symbols.s.unit, prog = Symbols.s.prog, i = 0, acc = [] });
	NodeSymbols -> id(Obj([{ key = "types", value = Obj(TypeSymbols) }, { key = "nodes", value = Obj(this) }]));
}

// Lists each typedef as a symbol: its definition shown, whether it's
// recursive, and its doc.
proc TypeSymbols(s: { types: []TypeDef, i: int, acc: []JsonField }): []JsonField {
	TypeSymbols switch {
		(this.s.i == this.s.types.len) -> id(this.s.acc),
		else -> ShowType(t = this.s.types[this.s.i].ty)
	};
	ShowType -> TypeSymbols(s = { ..TypeSymbols.s, i = TypeSymbols.s.i + 1, acc = TypeSymbols.s.acc + [{ key = TypeSymbols.s.types[TypeSymbols.s.i].name, value = Obj([{ key = "def", value = Str(this) }, { key = "recursive", value = Bool(TypeSymbols.s.types[TypeSymbols.s.i].recursive) }, { key = "doc", value = Str(TypeSymbols.s.types[TypeSymbols.s.i].doc) }]) }] });
}

// Lists each func and proc as a symbol by its qualified name: its kind, doc,
// parameters and result, where it's declared, and a func's implementations
// or a proc's entry.
proc NodeSymbols(s: { base: string, unit: Unit, prog: Program, i: int, acc: []JsonField }): []JsonField {
	// Places a node for the viewer: { file, line }, its file relative to base
	// (or null).
	func Loc(base: string, unit: Unit, span: Span): Json = "ide_leaf.rs:loc_json";
	// Lists a func's implementations for the viewer: each as written, its path
	// (relative to base), function and language.
	func Imps(base: string, unit: Unit, span: Span, imps: []ImplRef): Json = "ide_leaf.rs:imps_json";
	NodeSymbols switch {
		(this.s.i == this.s.prog.nodes.len) -> id(this.s.acc),
		else -> id(this.s.prog.nodes[this.s.i].kind) as K
	};
	K switch {
		Func(f) -> ShowParams(s = { ps = f.params, i = 0, acc = "" }) as FP,
		Proc(p) -> ShowParams(s = { ps = NodeParams(nodes = NodeSymbols.s.prog.nodes, n = p.entry), i = 0, acc = "" }) as PP,
		else -> NodeSymbols(s = { ..NodeSymbols.s, i = NodeSymbols.s.i + 1 })
	};
	FP -> ShowType(t = NodeRet(nodes = NodeSymbols.s.prog.nodes, n = NodeSymbols.s.i)) as FR;
	FR -> NodeSymbols(s = { ..NodeSymbols.s, i = NodeSymbols.s.i + 1, acc = NodeSymbols.s.acc + [{ key = QualName(n = NodeSymbols.s.prog.nodes[NodeSymbols.s.i]), value = Obj([
		{ key = "kind", value = Str("func") },
		{ key = "doc", value = Str(NodeSymbols.s.prog.nodes[NodeSymbols.s.i].doc) },
		{ key = "params", value = Str(FP) },
		{ key = "ret", value = Str(this) },
		{ key = "imps", value = Imps(base = NodeSymbols.s.base, unit = NodeSymbols.s.unit, span = NodeSymbols.s.prog.nodes[NodeSymbols.s.i].span, imps = FuncImps(n = NodeSymbols.s.prog.nodes[NodeSymbols.s.i])) },
		{ key = "loc", value = Loc(base = NodeSymbols.s.base, unit = NodeSymbols.s.unit, span = NodeSymbols.s.prog.nodes[NodeSymbols.s.i].span) }
	]) }] });
	PP -> ShowType(t = NodeRet(nodes = NodeSymbols.s.prog.nodes, n = NodeSymbols.s.i)) as PR;
	PR -> NodeSymbols(s = { ..NodeSymbols.s, i = NodeSymbols.s.i + 1, acc = NodeSymbols.s.acc + [{ key = QualName(n = NodeSymbols.s.prog.nodes[NodeSymbols.s.i]), value = Obj([
		{ key = "kind", value = Str("proc") },
		{ key = "doc", value = Str(NodeSymbols.s.prog.nodes[NodeSymbols.s.i].doc) },
		{ key = "params", value = Str(PP) },
		{ key = "ret", value = Str(this) },
		{ key = "entry", value = Str(EntryName(prog = NodeSymbols.s.prog, pid = NodeSymbols.s.i)) },
		{ key = "loc", value = Loc(base = NodeSymbols.s.base, unit = NodeSymbols.s.unit, span = NodeSymbols.s.prog.nodes[NodeSymbols.s.i].span) }
	]) }] });
}

func FuncImps(n: NodeDecl): []ImplRef = "ide_leaf.rs:func_imps";
func EntryName(prog: Program, pid: int): string = "ide_leaf.rs:entry_name";

// ---- The Rust preview: what `vcc build` would generate ----

// Previews what vcc build would generate in Rust: with [rust]'s settings, or
// nominal ones (module app in my_crate) for a file outside a project.
proc RustPreview(s: { unit: Unit, prog: Program }): Json {
	func NominalMains(prog: Program): map[string]Bin = "ide_leaf.rs:nominal_mains";
	func Dirs(root: string, paths: []string): []string = "../cli/cli_leaf.rs:dirs";
	RustPreview -> id(this.s.unit.project) as P;
	P switch {
		Some(p) -> id(p.manifest.rust) as R,
		// Nominal locations: impl paths as written, as if the output were
		// next to the file.
		else -> Preview(s = { prog = RustPreview.s.prog, module_dir = Some("app"), krate = "my_crate", bins = NominalMains(prog = RustPreview.s.prog) }) as Nominal
	};
	R switch {
		Some(r) -> FindUp(s = { dir = JoinP(a = RustPreview.s.unit.root, b = r.out), marker = "Cargo.toml" }),
		else -> id(Obj([{ key = "ok", value = Bool(false) }, { key = "error", value = Str("not configured in vandorf.toml") }]))
	};
	FindUp -> CrateName(dir = this);
	CrateName -> Preview(s = {
		prog = RebaseImpls(prog = RustPreview.s.prog, dirs = Dirs(root = RustPreview.s.unit.root, paths = RustPreview.s.unit.names), out = JoinP(a = RustPreview.s.unit.root, b = UnwrapR(r = R).out)),
		module_dir = ModuleDir(target = UnwrapR(r = R), out = JoinP(a = RustPreview.s.unit.root, b = UnwrapR(r = R).out), croot = FindUp),
		krate = this,
		bins = UnwrapPr(p = P).manifest.bins
	}) as Configured;
}

func UnwrapPr(p: MaybeProject): Project = "ide_leaf.rs:unwrap_project";

// Previews what vcc build would generate in Go: with [go]'s settings, or
// nominal ones (package app in example.com/app) for a file outside a
// project.
proc GoPreview(s: { unit: Unit, prog: Program }): Json {
	func NominalGoMains(prog: Program): []GoMainSpec = "ide_leaf.rs:nominal_go_mains";
	func UnwrapG(g: MaybeGo): GoTarget = "ide_leaf.rs:unwrap_go";
	func Dirs(root: string, paths: []string): []string = "../cli/cli_leaf.rs:dirs";
	GoPreview -> id(this.s.unit.project) as P;
	P switch {
		Some(p) -> id(p.manifest.go) as G,
		else -> GoPreviewJson(s = { prog = GoPreview.s.prog, package = "app", import_base = Some("example.com/app"), types_dir = "types", mains = NominalGoMains(prog = GoPreview.s.prog), servers = [] }) as Nominal
	};
	G switch {
		Some(g) -> FindUp(s = { dir = JoinP(a = GoPreview.s.unit.root, b = g.out), marker = "go.mod" }),
		else -> id(Obj([{ key = "ok", value = Bool(false) }, { key = "error", value = Str("not configured in vandorf.toml") }]))
	};
	FindUp switch {
		(this == "") -> id(GoImportBase(g = UnwrapG(g = G), root = "", gomod = "", out = JoinP(a = GoPreview.s.unit.root, b = UnwrapG(g = G).out))) as Base,
		else -> Fs.Read(path = JoinP(a = this, b = "go.mod"))
	};
	Fs.Read -> id(GoImportBase(g = UnwrapG(g = G), root = FindUp, gomod = this, out = JoinP(a = GoPreview.s.unit.root, b = UnwrapG(g = G).out))) as Base;
	Base -> GoPreviewJson(s = {
		prog = RebaseImpls(prog = GoPreview.s.prog, dirs = Dirs(root = GoPreview.s.unit.root, paths = GoPreview.s.unit.names), out = JoinP(a = GoPreview.s.unit.root, b = UnwrapG(g = G).out)),
		package = GoPackage(g = UnwrapG(g = G), out = JoinP(a = GoPreview.s.unit.root, b = UnwrapG(g = G).out)),
		import_base = this,
		types_dir = UnwrapOr(m = UnwrapG(g = G).types_dir, d = "types"),
		mains = GoMainSpecs(c = { project = UnwrapPr(p = P), prog = GoPreview.s.prog }, g = UnwrapG(g = G), names = UnwrapPr(p = P).manifest.bins.keys),
		servers = []
	}) as Configured;
}

// Generates a program's Go and gives the files as JSON (artifacts: types,
// code, mains) with the implementations they call; or the error.
proc GoPreviewJson(s: GoGenIn): Json {
	func Output(o: GoOut, prog: Program, t: Table, setup: GoSetup): Json = "ide_leaf.rs:go_output_json";
	GoPreviewJson -> GoGenerate(s = this.s);
	GoGenerate -> BuildTable(prog = GoPreviewJson.s.prog);
	BuildTable -> id(Output(o = GoGenerate, prog = GoPreviewJson.s.prog, t = this, setup = GoSetupOf(package = GoPreviewJson.s.package, import_base = GoPreviewJson.s.import_base, types_dir = GoPreviewJson.s.types_dir)));
}

// Generates a program's Rust and gives the files as JSON (artifacts: types,
// code, mains) with the implementations they call; or the error.
proc Preview(s: { prog: Program, module_dir: MaybeStr, krate: string, bins: map[string]Bin }): Json {
	func Output(types: string, modrs: string, procs: string, mains: []OutFile, impls: Json): Json = "ide_leaf.rs:output_json";
	func Impls(prog: Program, t: Table, module_dir: MaybeStr): Json = "ide_leaf.rs:impls_json";
	func Error(msg: string): Json = "ide_leaf.rs:error_json";
	Preview -> RustGenerate(s = { prog = this.s.prog, module_dir = this.s.module_dir, servers = [] });
	RustGenerate switch {
		{ types = _, procs = _, modrs = _, http = _, err = Some(e) } -> id(Error(msg = e)),
		else -> PreviewMains(s = { prog = Preview.s.prog, bins = Preview.s.bins, names = Preview.s.bins.keys, module_dir = Preview.s.module_dir, krate = Preview.s.krate, i = 0, acc = [] })
	};
	PreviewMains switch {
		Ok(mains) -> BuildTable(prog = Preview.s.prog),
		Err(e) -> id(Error(msg = e.msg))
	};
	BuildTable -> id(Output(types = RustGenerate.types, modrs = RustGenerate.modrs, procs = RustGenerate.procs, mains = UnwrapOut(r = PreviewMains), impls = Impls(prog = Preview.s.prog, t = this, module_dir = Preview.s.module_dir)));
}

func UnwrapOut(r: Res<[]OutFile>): []OutFile = "ide_leaf.rs:unwrap_out";

// Generates each bin's Rust main for the preview, its directory (relative to
// the module) as its path and its file name as its kind.
proc PreviewMains(s: { prog: Program, bins: map[string]Bin, names: []string, module_dir: MaybeStr, krate: string, i: int, acc: []OutFile }): Res<[]OutFile> {
	// Generates an executable running proc `entry` (src/codegen/rust.rs:
	// main_artifact): its directory relative to the output module, its file name
	// and its text, or why the proc can't be one.
	func RustMain(prog: Program, t: Table, name: string, entry: string, path: string, module_dir: MaybeStr, krate: string): { dir: string, file: string, text: string, err: MaybeStr } = "../gen/gen_leaf.rs:rust_main";
	func BinPath(b: Bin, name: string): string = "../cli/cli_leaf.rs:bin_path";
	PreviewMains switch {
		(this.s.i == this.s.names.len) -> id(Ok(this.s.acc)),
		else -> BuildTable(prog = this.s.prog)
	};
	BuildTable -> RustMain(prog = PreviewMains.s.prog, t = this, name = PreviewMains.s.names[PreviewMains.s.i], entry = PreviewMains.s.bins[PreviewMains.s.names[PreviewMains.s.i]].entry, path = BinPath(b = PreviewMains.s.bins[PreviewMains.s.names[PreviewMains.s.i]], name = PreviewMains.s.names[PreviewMains.s.i]), module_dir = PreviewMains.s.module_dir, krate = PreviewMains.s.krate);
	RustMain switch {
		{ dir = _, file = _, text = _, err = Some(e) } -> id(Err({ msg = e, span = { at = 0, end = 0, file = 0 } })),
		else -> PreviewMains(s = { ..PreviewMains.s, i = PreviewMains.s.i + 1, acc = PreviewMains.s.acc + [{ path = this.dir, text = this.text, kind = this.file }] })
	};
}

// Previews the generated Python package and launchers without writing files.
func PythonPreview(unit: Unit, prog: Program): Json = "ide_leaf.rs:python_preview";
