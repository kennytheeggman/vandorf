// GET /api/project?dir=..: a project's overview: its manifest's settings,
// entry points (each with where its proc is declared), files and counts.

proc ProjectRoute(req: HttpRequest): HttpResponse {
	ProjectRoute -> Session.Base(n = 0);
	Session.Base switch {
		(!("dir" in ProjectRoute.req.query)) -> id(ApiErr(msg = "missing ?dir=")),
		(ProjectRoute.req.query["dir"] == "" || ProjectRoute.req.query["dir"] == ".") -> id(Ok(this)) as Root,
		else -> ResolvePath(s = { base = this, p = ProjectRoute.req.query["dir"] })
	};
	ResolvePath -> id(this) as Root;
	Root switch {
		Ok(root) -> Fs.IsFile(path = JoinP(a = root, b = "vandorf.toml")),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Fs.IsFile switch {
		(this) -> Files.Read(path = JoinP(a = UnwrapR2(r = Root), b = "vandorf.toml")),
		else -> id(ApiErr(msg = "no vandorf.toml in " + ProjectRoute.req.query["dir"]))
	};
	Files.Read switch {
		Ok(text) -> LoadProject(path = JoinP(a = UnwrapR2(r = Root), b = "vandorf.toml")),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	LoadProject switch {
		Ok(p) -> Outlines(s = { p = p, i = 0, acc = [] }),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Outlines -> id(Api(j = ProjectJson(base = Session.Base, p = UnwrapP(r = LoadProject), text = UnwrapR2(r = Files.Read), outlines = this)));
}

// The project's overview from its files' outlines.
func ProjectJson(base: string, p: Project, text: string, outlines: []Outlined): Json = "ide_leaf.rs:project_json";

// A file's outline, or that it doesn't parse.
type Outlined = { ok: bool, items: []Item };

proc Outlines(s: { p: Project, i: int, acc: []Outlined }): []Outlined {
	Outlines switch {
		(this.s.i == this.s.p.srcs.len) -> id(this.s.acc),
		else -> TryParse(src = this.s.p.srcs[this.s.i], file = 0)
	};
	TryParse switch {
		Ok(f) -> Outline(s = { src = Outlines.s.p.srcs[Outlines.s.i], f = f }),
		Err(_) -> Outlines(s = { ..Outlines.s, i = Outlines.s.i + 1, acc = Outlines.s.acc + [{ ok = false, items = [] }] })
	};
	Outline -> Outlines(s = { ..Outlines.s, i = Outlines.s.i + 1, acc = Outlines.s.acc + [{ ok = true, items = this }] });
}
