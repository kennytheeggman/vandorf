// The IDE (src/serve.rs in the reference): explorer, diagram and text
// viewer, terminals, over the working directory. Served as [http.ide] in
// vandorf.toml: each path is a raw route to its own proc, named for it
// (PageRoute, TreeRoute, CompileRoute, TermReadRoute, ..), which does its
// own checks and reads the session as it needs.
//
// Writes and terminals need the per-run token the pages are served with
// (X-Vandorf-Token), so other sites can't drive them, and, on a loopback
// address, a loopback Host, against DNS rebinding (WriteGate). Terminals are
// offered only on a loopback address (TermGate).

type HttpRequest = { method: string, path: string, query: map[string]string, headers: map[string]string, body: string };
type HttpResponse = { status: int, headers: map[string]string, body: string };
type TermChunk = { ok: bool, data: string, next: int, closed: bool };

interface Session {
	// A random token for this run, which writes and terminals must present.
	func Token(n: int): string = "ide_io.rs:token";
	// The source directory: the working directory, canonical.
	func Base(n: int): string = "ide_io.rs:base";
	// Whether the server listens on a loopback address: terminals are
	// offered only then.
	func Loopback(n: int): bool = "ide_io.rs:loopback";
}

interface Pages {
	// An IDE page by name ("" if there's none).
	func Get(name: string): string = "ide_io.rs:page";
}

interface Files {
	func Canon(path: string): Res<string> = "ide_io.rs:canon";
	func Read(path: string): Res<string> = "ide_io.rs:try_read";
	func Write(path: string, text: string): Res<string> = "ide_io.rs:try_write";
	// The .sys files under base, relative to it, sorted.
	func Walk(base: string): []string = "ide_io.rs:walk_rel";
}

interface Term {
	// The user's shell on a pty in cwd; its id.
	func Spawn(cwd: string): Res<int> = "ide_io.rs:term_spawn";
	func List(n: int): []int = "ide_io.rs:term_list";
	// Output from stream offset `from`, waiting up to 20 s for some. Only whole
	// UTF-8 characters: `next` is where the next read starts.
	func Read(id: int, from: int): TermChunk = "ide_io.rs:term_read";
	func Input(id: int, data: string): Res<string> = "ide_io.rs:term_input";
	func Resize(id: int, cols: int, rows: int): Res<string> = "ide_io.rs:term_resize";
	func Kill(id: int): bool = "ide_io.rs:term_kill";
}

// A compile unit's sources, parsed and checked: the parse errors, or the
// sema errors, or the program.
type UnitCheck = { parse_errors: []Diag, sema_errors: []Diag, prog: Program };
type MaybeCheck = enum { None, Some(UnitCheck) };

// Checks kept by the sources they were made from (CheckKey), so a project's
// tabs, and a recompile with nothing changed, skip parsing and sema.
interface Checks {
	// The check of key: kept, or once another request making it has put it
	// (waiting for that). None: this request is to make it and Put it.
	func Claim(key: string): MaybeCheck = "ide_io.rs:check_claim";
	// Keeps a check, dropping the least recently used past eight, and wakes
	// the requests waiting for it.
	func Put(key: string, c: UnitCheck): bool = "ide_io.rs:check_put";
}

// Parses a file, its failure a value: the message and where it is.
func TryParse(src: string, file: int): Res<File> = "ide_io.rs:try_parse";
func Compact(j: Json): string = "../doc/doc_leaf.rs:compact";
// A JSON text as a Json; numbers that aren't ints are an error.
func ParseJson(text: string): Res<Json> = "../doc/doc_leaf.rs:parse_json";
// A string field of a JSON object, if it is one.
func JsonStr(j: Json, key: string): MaybeStr = "../doc/doc_leaf.rs:json_str";
// The page served at a path ("" if none), and one carrying the token.
func PageName(path: string): string = "ide_leaf.rs:page_name";
// A page, carrying the session token for the requests that need it.
func PageResponse(text: string, token: string): HttpResponse = "ide_leaf.rs:page_response";
func CssResponse(text: string): HttpResponse = "ide_leaf.rs:css_response";
// 200 and the JSON; 400 and {"ok": false, "error": msg}; 403.
func Api(j: Json): HttpResponse = "ide_leaf.rs:api";
func ApiErr(msg: string): HttpResponse = "ide_leaf.rs:api_err";
func Forbidden(n: int): HttpResponse = "ide_leaf.rs:forbidden";
// The session's token, and (on a loopback address) a loopback Host.
func Authorized(headers: map[string]string, token: string, loopback: bool): bool = "ide_leaf.rs:authorized";
func HasPrefix(text: string, prefix: string): bool = "../cli/cli_leaf.rs:starts_with";

// Whether a request may go on, or the response that turns it away.
type Gate = enum { Open, Shut(HttpResponse) };

// Writes: the session token, and on a loopback address a loopback Host.
proc WriteGate(req: HttpRequest): Gate {
	WriteGate -> Session.Token(n = 0);
	Session.Token -> Session.Loopback(n = 0);
	Session.Loopback switch {
		(Authorized(headers = WriteGate.req.headers, token = Session.Token, loopback = this)) -> id(Open()),
		else -> id(Shut(Forbidden(n = 0)))
	};
}

// Terminals: only on a loopback address, then as writes.
proc TermGate(req: HttpRequest): Gate {
	TermGate -> Session.Loopback(n = 0);
	Session.Loopback switch {
		(!this) -> id(Shut(ApiErr(msg = "terminals are off: the IDE isn't listening on a loopback address"))),
		else -> WriteGate(req = TermGate.req)
	};
}

// GET /, /explorer, /viewer, /terminal, /workbench, /project, /viz: an IDE
// page, carrying the session token.
proc PageRoute(req: HttpRequest): HttpResponse {
	PageRoute -> Session.Token(n = 0);
	Session.Token -> Pages.Get(name = PageName(path = PageRoute.req.path));
	Pages.Get -> id(PageResponse(text = this, token = Session.Token));
}

// GET /ui.css
proc CssRoute(req: HttpRequest): HttpResponse {
	CssRoute -> Pages.Get(name = "ui.css");
	Pages.Get -> id(CssResponse(text = this));
}

// GET /api/sources: the .sys files under the source directory.
proc SourcesRoute(req: HttpRequest): HttpResponse {
	SourcesRoute -> Session.Base(n = 0);
	Session.Base -> Files.Walk(base = this);
	Files.Walk -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "root", value = Str(Session.Base) }, { key = "files", value = Arr(Strs(xs = this)) }])));
}

func Strs(xs: []string): []Json = "ide_leaf.rs:strs";

// Resolves p under base, refusing paths that escape it.
proc ResolvePath(s: { base: string, p: string }): Res<string> {
	func Bad(p: string): bool = "ide_leaf.rs:bad_path";
	ResolvePath switch {
		(Bad(p = this.s.p)) -> id(Err({ msg = "invalid path", span = { at = 0, end = 0, file = 0 } })),
		else -> Files.Canon(path = JoinP(a = this.s.base, b = this.s.p))
	};
	Files.Canon switch {
		Ok(full) -> switch {
			(full == ResolvePath.s.base || HasPrefix(text = full, prefix = ResolvePath.s.base + "/")) -> id(Ok(full)),
			else -> id(Err({ msg = "path escapes source directory: " + ResolvePath.s.p, span = { at = 0, end = 0, file = 0 } }))
		},
		Err(e) -> id(Err({ msg = "cannot read " + ResolvePath.s.p + ": " + e.msg, span = e.span }))
	};
}

proc ReadSource(s: { base: string, p: string }): Res<string> {
	ReadSource -> ResolvePath(s = this.s);
	ResolvePath switch {
		Ok(full) -> Files.Read(path = full),
		Err(e) -> id(Err(e))
	};
	Files.Read switch {
		Ok(text) -> id(Ok(text)),
		Err(e) -> id(Err({ msg = "cannot read " + ReadSource.s.p + ": " + e.msg, span = e.span }))
	};
}

// GET /api/source?path=..
proc SourceRoute(req: HttpRequest): HttpResponse {
	SourceRoute -> Session.Base(n = 0);
	Session.Base switch {
		("path" in SourceRoute.req.query) -> ReadSource(s = { base = this, p = SourceRoute.req.query["path"] }),
		else -> id(ApiErr(msg = "missing ?path="))
	};
	ReadSource switch {
		Ok(text) -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "path", value = Str(SourceRoute.req.query["path"]) }, { key = "source", value = Str(text) }]))),
		Err(e) -> id(ApiErr(msg = e.msg))
	};
}

// POST /api/save {path, source}: writes an existing .sys file, or an
// existing vandorf.toml if the new text is a valid manifest (one that
// doesn't parse would break the project, and the IDE's view of it).
proc SaveRoute(req: HttpRequest): HttpResponse {
	func IsSys(p: string): bool = "ide_leaf.rs:is_sys";
	func IsManifest(p: string): bool = "ide_leaf.rs:is_manifest";
	func Len(s: string): int = "ide_leaf.rs:byte_len";
	SaveRoute -> WriteGate(req = this.req);
	WriteGate switch {
		Shut(r) -> id(r),
		else -> Session.Base(n = 0)
	};
	Session.Base -> ParseJson(text = SaveRoute.req.body);
	ParseJson switch {
		Ok(j) -> switch {
			(!IsSomeS(m = JsonStr(j = j, key = "path"))) -> id(ApiErr(msg = "missing path")),
			(!IsSomeS(m = JsonStr(j = j, key = "source"))) -> id(ApiErr(msg = "missing source")),
			else -> ResolvePath(s = { base = Session.Base, p = UnwrapS(m = JsonStr(j = j, key = "path")) })
		},
		Err(e) -> id(ApiErr(msg = "bad request: " + e.msg))
	};
	ResolvePath switch {
		Ok(full) -> switch {
			(IsSys(p = full)) -> Files.Write(path = full, text = UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "source"))),
			(IsManifest(p = full) && ManifestError(text = UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "source"))) != "") -> id(ApiErr(msg = "invalid manifest, not saved: " + ManifestError(text = UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "source"))))),
			(IsManifest(p = full)) -> Files.Write(path = full, text = UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "source"))),
			else -> id(ApiErr(msg = "only existing .sys files and manifests can be saved: " + UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "path"))))
		},
		Err(e) -> id(ApiErr(msg = e.msg))
	};
	Files.Write switch {
		Ok(_) -> id(Api(j = Obj([{ key = "ok", value = Bool(true) }, { key = "path", value = Str(UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "path"))) }, { key = "bytes", value = Num(Len(s = UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "source")))) }]))),
		Err(e) -> id(ApiErr(msg = "cannot write " + UnwrapS(m = JsonStr(j = UnwrapJ(r = ParseJson), key = "path")) + ": " + e.msg))
	};
}

func UnwrapJ(r: Res<Json>): Json = "ide_leaf.rs:unwrap_j";
