// Projects (src/project.rs in the reference): vandorf.toml and the .sys
// files it covers.

type Manifest = { name: string, sources: []string, rust: MaybeRust, has_go: bool, go: MaybeGo, python: MaybePython, bins: map[string]Bin, http: map[string]ServerDecl };
// post: shell commands run after generating the language; test: those
// `vcc test` runs.
type GoTarget = { out: string, package: MaybeStr, module: MaybeStr, types_dir: MaybeStr, post: []string, test: []string };
type MaybeGo = enum { None, Some(GoTarget) };
type PythonTarget = { out: string, post: []string, test: []string };
type MaybePython = enum { None, Some(PythonTarget) };
// `[http.<name>]`, as written. setup: a proc run before serving, whose
// result each route takes as ctx. cli: a proc run instead of serving when
// the executable is given a command.
type ServerDecl = { addr: string, setup: MaybeStr, cli: MaybeStr, routes: map[string]string, raw: map[string]string, statics: map[string]string, go: MaybeStr, rust: MaybeStr, python: MaybeStr };
type RustTarget = { out: string, module_dir: MaybeStr, post: []string, test: []string };
type MaybeRust = enum { None, Some(RustTarget) };
type Bin = { entry: string, go: MaybeStr, rust: MaybeStr, python: MaybeStr };
// root: the manifest's directory. paths: relative to root, sorted.
type Project = { root: string, manifest: Manifest, paths: []string, srcs: []string };

// Reads vandorf.toml as src/project.rs does: the project's name and sources,
// its [go] and [rust] targets, its bins and its servers, with defaults
// filled in; an error naming what's wrong otherwise.
func ParseManifest(text: string): Res<Manifest> = "cli_leaf.rs:parse_manifest";
// Joins a and b into one path, resolving `.` and `..` lexically; b may be
// absolute, and then wins.
func JoinP(a: string, b: string): string = "cli_leaf.rs:join";
func Parent(p: string): string = "cli_leaf.rs:parent";
// Rebases each func's implementation paths from the .sys file naming them
// onto `out`, the output directory (dirs[file id] is that file's directory),
// so generated code can reach them.
func RebaseImpls(prog: Program, dirs: []string, out: string): Program = "cli_leaf.rs:rebase_impls";
// Makes target relative to the directory from, with `..` where it's outside
// it; both absolute and normalized.
func Relative(target: string, from: string): string = "cli_leaf.rs:relative";
func SortDedup(xs: []string): []string = "cli_leaf.rs:sort_dedup";
func StartsWith(text: string, prefix: string): bool = "cli_leaf.rs:starts_with";
// Finds the library crate's name in a Cargo.toml: `name = "..."` in [lib],
// else in [package], with `-` as `_`; "" if the crate has no library.
func CargoLibName(toml: string, has_lib_rs: bool): string = "cli_leaf.rs:cargo_lib_name";

// Walks up from dir to the nearest directory that has the file `marker`; ""
// if no directory up to the root has it.
proc FindUp(s: { dir: string, marker: string }): string {
	FindUp -> Fs.IsFile(path = JoinP(a = this.s.dir, b = this.s.marker));
	Fs.IsFile switch {
		(this) -> id(FindUp.s.dir),
		(FindUp.s.dir == "/" || FindUp.s.dir == "") -> id(""),
		else -> FindUp(s = { dir = Parent(p = FindUp.s.dir), marker = FindUp.s.marker })
	};
}

// Loads the project whose manifest is at path: reads and checks the
// manifest, finds the .sys files under its sources, and reads each. Fails,
// naming the manifest, if it doesn't parse or a source directory has no .sys
// files.
proc LoadProject(path: string): Res<Project> {
	LoadProject -> Fs.Read(path = this.path) as Text;
	Text -> ParseManifest(text = this);
	ParseManifest switch {
		Ok(m) -> SourceFiles(s = { root = Parent(p = LoadProject.path), m = m, i = 0, acc = [] }),
		Err(e) -> id(Err({ msg = LoadProject.path + ": " + e.msg, span = e.span }))
	};
	SourceFiles switch {
		Ok(paths) -> switch {
			(paths.len == 0) -> id(Err({ msg = LoadProject.path + ": no .sys files under " + Join(parts = UnwrapM(r = ParseManifest).sources, sep = ", "), span = { at = 0, end = 0, file = 0 } })),
			else -> ReadAll(s = { root = Parent(p = LoadProject.path), paths = paths, i = 0, acc = [] })
		},
		Err(e) -> id(Err({ msg = LoadProject.path + ": " + e.msg, span = e.span }))
	};
	ReadAll -> id(Ok({ root = Parent(p = LoadProject.path), manifest = UnwrapM(r = ParseManifest), paths = UnwrapPaths(r = SourceFiles), srcs = this }));
}

func UnwrapM(r: Res<Manifest>): Manifest = "cli_leaf.rs:unwrap_m";
func UnwrapPaths(r: Res<[]string>): []string = "cli_leaf.rs:unwrap_paths";

// Lists the .sys files under each source directory, relative to root, sorted
// and without duplicates; fails if a source directory doesn't exist.
proc SourceFiles(s: { root: string, m: Manifest, i: int, acc: []string }): Res<[]string> {
	func Rel(paths: []string, root: string): []string = "cli_leaf.rs:rel_all";
	SourceFiles switch {
		(this.s.i == this.s.m.sources.len) -> id(Ok(SortDedup(xs = this.s.acc))),
		else -> Fs.IsDir(path = JoinP(a = this.s.root, b = this.s.m.sources[this.s.i]))
	};
	Fs.IsDir switch {
		(this) -> Fs.Walk(dir = JoinP(a = SourceFiles.s.root, b = SourceFiles.s.m.sources[SourceFiles.s.i])),
		else -> id(Err({ msg = "source directory " + SourceFiles.s.m.sources[SourceFiles.s.i] + " does not exist", span = { at = 0, end = 0, file = 0 } }))
	};
	Fs.Walk -> SourceFiles(s = { root = SourceFiles.s.root, m = SourceFiles.s.m, i = SourceFiles.s.i + 1, acc = SourceFiles.s.acc + Rel(paths = this, root = SourceFiles.s.root) });
}

// Reads each of the files at paths, relative to root, in order.
proc ReadAll(s: { root: string, paths: []string, i: int, acc: []string }): []string {
	ReadAll switch {
		(this.s.i == this.s.paths.len) -> id(this.s.acc),
		else -> Fs.Read(path = JoinP(a = this.s.root, b = this.s.paths[this.s.i]))
	};
	Fs.Read -> ReadAll(s = { root = ReadAll.s.root, paths = ReadAll.s.paths, i = ReadAll.s.i + 1, acc = ReadAll.s.acc + [this] });
}

// Checks that text is a manifest the reference would load, its fields and
// their types: why not, or "".
func ManifestError(text: string): string = "cli_leaf.rs:manifest_error";
// Checks a manifest's text, for the parity tests: why the reference wouldn't
// load it, or "".
proc CheckManifest(text: string): string {
	CheckManifest -> id(ManifestError(text = this.text));
}
