// The commands (src/main.rs in the reference): check, doc and build, on
// the project around the working directory.

type Checked = { project: Project, prog: Program };
type OutFile = { path: string, text: string, kind: string };

// Renders errors as snippets, each its message, path:line:col and the line
// with the span underlined, a blank line apart; an error repeated at the
// same span shows once.
func RenderErrors(errors: []Diag, paths: []string, srcs: []string): string = "cli_leaf.rs:render_errors";

// Finds the vandorf.toml at or above the working directory, loads its
// project, then parses and checks every file. Returns the project and its
// checked program, or every parse error (or else every check error) rendered
// with its file and line.
proc CheckProject(n: int): Res<Checked> {
	CheckProject -> Fs.Cwd(n = 0);
	Fs.Cwd -> FindUp(s = { dir = this, marker = "vandorf.toml" });
	FindUp switch {
		(this == "") -> id(Err({ msg = "no vandorf.toml in " + Fs.Cwd + " or its parents", span = { at = 0, end = 0, file = 0 } })),
		else -> LoadProject(path = JoinP(a = this, b = "vandorf.toml"))
	};
	LoadProject switch {
		Ok(p) -> ParseAll(s = { srcs = p.srcs, i = 0, file = { types = [], interfaces = [], nodes = [] }, errors = [] }),
		Err(e) -> id(Err(e))
	};
	ParseAll switch {
		(this.errors.len > 0) -> id(Err({ msg = RenderErrors(errors = this.errors, paths = UnwrapP(r = LoadProject).paths, srcs = UnwrapP(r = LoadProject).srcs), span = { at = 0, end = 0, file = 0 } })),
		else -> Analyze(s = { srcs = UnwrapP(r = LoadProject).srcs, file = this.file })
	};
	Analyze switch {
		(this.errors.len > 0) -> id(Err({ msg = RenderErrors(errors = this.errors, paths = UnwrapP(r = LoadProject).paths, srcs = UnwrapP(r = LoadProject).srcs), span = { at = 0, end = 0, file = 0 } })),
		else -> id(Ok({ project = UnwrapP(r = LoadProject), prog = this.prog }))
	};
}

func UnwrapP(r: Res<Project>): Project = "cli_leaf.rs:unwrap_p";

// Parses each source file in turn, its spans carrying its index, and merges
// what they declare into one file. A file that doesn't parse adds its error
// and is skipped, so every file's parse error is reported at once.
proc ParseAll(s: { srcs: []string, i: int, file: File, errors: []Diag }): { file: File, errors: []Diag } {
	ParseAll switch {
		(this.s.i == this.s.srcs.len) -> id({ file = this.s.file, errors = this.s.errors }),
		else -> TryParse(src = this.s.srcs[this.s.i], file = this.s.i)
	};
	TryParse switch {
		Ok(f) -> ParseAll(s = { ..ParseAll.s, i = ParseAll.s.i + 1, file = { types = ParseAll.s.file.types + f.types, interfaces = ParseAll.s.file.interfaces + f.interfaces, nodes = ParseAll.s.file.nodes + f.nodes } }),
		Err(e) -> ParseAll(s = { ..ParseAll.s, i = ParseAll.s.i + 1, errors = ParseAll.s.errors + [e] })
	};
}

func HasRust(m: Manifest): bool = "cli_leaf.rs:has_rust";

// Builds what the manifest configures: Go first, then Rust, each language's
// library and the bins (all of them, or only `only`). Fails if it configures
// neither.
proc Build(s: { c: Checked, only: string }): string {
	func GoOutDir(root: string, g: GoTarget): string = "cli_leaf.rs:go_out_dir";
	Build switch {
		(!this.s.c.project.manifest.has_go && !HasRust(m = this.s.c.project.manifest) && !HasPython(m = this.s.c.project.manifest)) -> Fail(msg = "vandorf.toml: configure [go], [rust], or [python] to build") as Neither,
		else -> BinNames(bins = this.s.c.project.manifest.bins, only = this.s.only)
	};
	BinNames -> id(Build.s.c.project.manifest.go) as G;
	G switch {
		Some(g) -> GoBuild(s = { c = Build.s.c, g = g, names = BinNames, only = Build.s.only, out = GoOutDir(root = Build.s.c.project.root, g = g) }),
		else -> id(Build.s.c.project.manifest.rust) as R
	};
	GoBuild -> id(Build.s.c.project.manifest.rust) as R;
	R switch {
		Some(_) -> RustBuild(s = Build.s),
		else -> id(Build.s.c.project.manifest.python) as P
	};
	RustBuild -> id(Build.s.c.project.manifest.python) as P;
	P switch {
		Some(p) -> PythonBuild(s = { c = Build.s.c, target = p, only = Build.s.only }),
		else -> id("built " + Build.s.c.project.manifest.name)
	};
	PythonBuild -> id("built " + Build.s.c.project.manifest.name);
}

// Rebases the program's implementation paths onto out, the Go output
// directory, from the .sys files naming them.
func RebasedTo(c: Checked, out: string): Program = "cli_leaf.rs:rebased_to";
// Names the Go package: [go]'s package, or else the output directory's name,
// made an identifier.
func GoPackage(g: GoTarget, out: string): string = "cli_leaf.rs:go_package";
// Works out the Go import path of out: [go]'s module if it's set, else
// go.mod's module path (root: go.mod's directory, "" if none) followed by
// out's directories below root.
func GoImportBase(g: GoTarget, root: string, gomod: string, out: string): MaybeStr = "cli_leaf.rs:go_import_base";
// Lays out each bin's Go main package: [bin.*]'s go, by default
// <go.out>/../cmd/<name>, relative to go.out, with the proc it runs.
func GoMainSpecs(c: Checked, g: GoTarget, names: []string): []GoMainSpec = "cli_leaf.rs:go_main_specs";
func GoOutFiles(out: string, files: []GoFile): []OutFile = "cli_leaf.rs:go_out_files";
// Lists a check for each func implemented in Go, as impl_checks does for
// Rust: its file, its function (defined by `func`), and its declaration's
// signature and doc.
func GoImplChecks(prog: Program, t: Table, g: GoTarget, out: string, import_base: MaybeStr, root: string, paths: []string, srcs: []string): []ImplCheck = "cli_leaf.rs:go_impl_checks";

// Generates the project's Go: [go]'s code and types packages, the bins'
// mains and the servers' (none for `vcc build <bin>`). Writes them, unless
// that would overwrite a file vandorf didn't generate, formats them, checks
// the implementations against their declarations, then runs [go]'s post
// commands.
proc GoBuild(s: { c: Checked, g: GoTarget, names: []string, only: string, out: string }): string {
	func NoGoSpecs(n: int): Res<[]GoServerSpec> = "cli_leaf.rs:no_go_specs";
	GoBuild -> FindUp(s = { dir = this.s.out, marker = "go.mod" });
	FindUp switch {
		(this == "") -> id(GoImportBase(g = GoBuild.s.g, root = "", gomod = "", out = GoBuild.s.out)) as Base,
		else -> Fs.Read(path = JoinP(a = this, b = "go.mod"))
	};
	Fs.Read -> id(GoImportBase(g = GoBuild.s.g, root = FindUp, gomod = this, out = GoBuild.s.out)) as Base;
	Base switch {
		(GoBuild.s.only == "") -> GoServerSpecs(s = { c = GoBuild.s.c, g = GoBuild.s.g, names = GoBuild.s.c.project.manifest.http.keys, i = 0, acc = [] }) as Specs,
		else -> NoGoSpecs(n = 0)
	};
	Specs -> id(this) as GoSpecs;
	NoGoSpecs -> id(this) as GoSpecs;
	GoSpecs switch {
		Ok(specs) -> GoGenerate(s = { prog = RebasedTo(c = GoBuild.s.c, out = GoBuild.s.out), package = GoPackage(g = GoBuild.s.g, out = GoBuild.s.out), import_base = Base, types_dir = UnwrapOr(m = GoBuild.s.g.types_dir, d = "types"), mains = GoMainSpecs(c = GoBuild.s.c, g = GoBuild.s.g, names = GoBuild.s.names), servers = specs }),
		Err(e) -> Fail(msg = e.msg) as SpecFailed
	};
	GoGenerate switch {
		(IsSomeS(m = this.err)) -> Fail(msg = UnwrapS(m = this.err)) as GenFailed,
		else -> Guard(s = { files = GoOutFiles(out = GoBuild.s.out, files = this.files), i = 0 })
	};
	Guard -> WriteAll(s = { files = GoOutFiles(out = GoBuild.s.out, files = GoGenerate.files), i = 0 });
	// Generated code is already indented; gofmt only aligns it.
	WriteAll -> Tools.Gofmt(files = OutPaths(files = GoOutFiles(out = GoBuild.s.out, files = GoGenerate.files)));
	Tools.Gofmt -> BuildTable(prog = RebasedTo(c = GoBuild.s.c, out = GoBuild.s.out));
	BuildTable -> ImplWarnings(s = { checks = GoImplChecks(prog = RebasedTo(c = GoBuild.s.c, out = GoBuild.s.out), t = this, g = GoBuild.s.g, out = GoBuild.s.out, import_base = Base, root = GoBuild.s.c.project.root, paths = GoBuild.s.c.project.paths, srcs = GoBuild.s.c.project.srcs), t = this, i = 0, errors = [] });
	ImplWarnings -> Commands(s = { what = "post-build", cmds = GoBuild.s.g.post, dir = GoBuild.s.c.project.root, i = 0 });
}

func UnwrapOr(m: MaybeStr, d: string): string = "cli_leaf.rs:unwrap_or";

// Gathers each Go server's spec from its [http.*]: its raw routes and routes
// (failing on one that's in both, or isn't a method and a path), its setup,
// and its static files with their contents.
proc GoServerSpecs(s: { c: Checked, g: GoTarget, names: []string, i: int, acc: []GoServerSpec }): Res<[]GoServerSpec> {
	// Places a server's Go main package: [http.*]'s go, by default
	// <go.out>/../cmd/<name>, relative to go.out.
	func GoServerPath(c: Checked, g: GoTarget, name: string): string = "cli_leaf.rs:go_server_path";
	func SetupName(d: ServerDecl): string = "cli_leaf.rs:setup_name";
	func CliName(d: ServerDecl): string = "cli_leaf.rs:cli_name";
	GoServerSpecs switch {
		(this.s.i == this.s.names.len) -> id(Ok(this.s.acc)),
		else -> Routes(s = { name = this.s.names[this.s.i], routes = this.s.c.project.manifest.http[this.s.names[this.s.i]].raw, keys = this.s.c.project.manifest.http[this.s.names[this.s.i]].raw.keys, other = this.s.c.project.manifest.http[this.s.names[this.s.i]].routes, j = 0, acc = [] }) as Raws
	};
	Raws switch {
		Ok(_) -> Routes(s = { name = GoServerSpecs.s.names[GoServerSpecs.s.i], routes = GoServerSpecs.s.c.project.manifest.http[GoServerSpecs.s.names[GoServerSpecs.s.i]].routes, keys = GoServerSpecs.s.c.project.manifest.http[GoServerSpecs.s.names[GoServerSpecs.s.i]].routes.keys, other = [:], j = 0, acc = [] }),
		Err(e) -> id(Err(e))
	};
	Routes switch {
		Ok(_) -> GoStatics(s = { name = GoServerSpecs.s.names[GoServerSpecs.s.i], root = GoServerSpecs.s.c.project.root, statics = GoServerSpecs.s.c.project.manifest.http[GoServerSpecs.s.names[GoServerSpecs.s.i]].statics, keys = GoServerSpecs.s.c.project.manifest.http[GoServerSpecs.s.names[GoServerSpecs.s.i]].statics.keys, j = 0, acc = [] }),
		Err(e) -> id(Err(e))
	};
	GoStatics switch {
		Ok(statics) -> GoServerSpecs(s = { ..GoServerSpecs.s, i = GoServerSpecs.s.i + 1, acc = GoServerSpecs.s.acc + [{ name = GoServerSpecs.s.names[GoServerSpecs.s.i], addr = GoServerSpecs.s.c.project.manifest.http[GoServerSpecs.s.names[GoServerSpecs.s.i]].addr, setup = SetupName(d = GoServerSpecs.s.c.project.manifest.http[GoServerSpecs.s.names[GoServerSpecs.s.i]]), cli = CliName(d = GoServerSpecs.s.c.project.manifest.http[GoServerSpecs.s.names[GoServerSpecs.s.i]]), routes = UnwrapRoutes(r = Routes), raw = UnwrapRoutes(r = Raws), statics = statics, path = GoServerPath(c = GoServerSpecs.s.c, g = GoServerSpecs.s.g, name = GoServerSpecs.s.names[GoServerSpecs.s.i]) }] }),
		Err(e) -> id(Err(e))
	};
}

// Reads a Go server's static files, each with its URL and content type, to
// embed in its main; fails on one that doesn't exist.
proc GoStatics(s: { name: string, root: string, statics: map[string]string, keys: []string, j: int, acc: []GoStatic }): Res<[]GoStatic> {
	func ContentType(file: string): string = "cli_leaf.rs:content_type";
	GoStatics switch {
		(this.s.j == this.s.keys.len) -> id(Ok(this.s.acc)),
		else -> Fs.IsFile(path = JoinP(a = this.s.root, b = this.s.statics[this.s.keys[this.s.j]]))
	};
	Fs.IsFile switch {
		(this) -> Fs.Read(path = JoinP(a = GoStatics.s.root, b = GoStatics.s.statics[GoStatics.s.keys[GoStatics.s.j]])),
		else -> id(Err({ msg = "vandorf.toml: [http." + GoStatics.s.name + "] serves " + GoStatics.s.statics[GoStatics.s.keys[GoStatics.s.j]] + ", which does not exist", span = { at = 0, end = 0, file = 0 } }))
	};
	Fs.Read -> GoStatics(s = { ..GoStatics.s, j = GoStatics.s.j + 1, acc = GoStatics.s.acc + [{ url = GoStatics.s.keys[GoStatics.s.j], file = GoStatics.s.statics[GoStatics.s.keys[GoStatics.s.j]], ctype = ContentType(file = GoStatics.s.statics[GoStatics.s.keys[GoStatics.s.j]]), text = this }] });
}

// Generates the project's Rust: [rust]'s module (types, procs, mod.rs and
// the servers' handlers), then the bins' and servers' mains, all or just
// `only`. Writes them, unless that would overwrite a file vandorf didn't
// generate, formats them, checks the implementations against their
// declarations, then runs [rust]'s post commands.
proc RustBuild(s: { c: Checked, only: string }): string {
	func Dirs(root: string, paths: []string): []string = "cli_leaf.rs:dirs";
	RustBuild -> id(this.s.c.project.manifest.rust) as R;
	R switch {
		Some(r) -> FindUp(s = { dir = JoinP(a = RustBuild.s.c.project.root, b = r.out), marker = "Cargo.toml" }) as Crate,
		else -> Fail(msg = "vandorf.toml: no [rust]") as NoRust
	};
	Crate -> CrateName(dir = this);
	// `vcc build <bin>` builds no servers.
	CrateName switch {
		(RustBuild.s.only == "") -> ServerSpecs(s = { m = RustBuild.s.c.project.manifest, root = RustBuild.s.c.project.root, out = OutDir(c = RustBuild.s.c), module_dir = ModuleDir(target = UnwrapR(r = R), out = OutDir(c = RustBuild.s.c), croot = Crate), names = RustBuild.s.c.project.manifest.http.keys, i = 0, acc = [] }) as Specs,
		else -> NoSpecs(n = 0)
	};
	func NoSpecs(n: int): Res<[]ServerSpec> = "cli_leaf.rs:no_specs";
	Specs -> id(this) as Servers;
	NoSpecs -> id(this) as Servers;
	Servers switch {
		Ok(specs) -> RustGenerate(s = { prog = Rebased(c = RustBuild.s.c), module_dir = ModuleDir(target = UnwrapR(r = R), out = OutDir(c = RustBuild.s.c), croot = Crate), servers = specs }),
		Err(e) -> Fail(msg = e.msg) as SpecFailed
	};
	RustGenerate switch {
		{ types = _, procs = _, modrs = _, http = _, err = Some(e) } -> Fail(msg = e) as GenFailed,
		else -> Mains(s = { prog = Rebased(c = RustBuild.s.c), bins = RustBuild.s.c.project.manifest.bins, names = BinNames(bins = RustBuild.s.c.project.manifest.bins, only = RustBuild.s.only), module_dir = ModuleDir(target = UnwrapR(r = R), out = OutDir(c = RustBuild.s.c), croot = Crate), krate = CrateName, out = OutDir(c = RustBuild.s.c), i = 0, acc = [
			{ path = JoinP(a = OutDir(c = RustBuild.s.c), b = "types.rs"), text = this.types, kind = "types" }
		] + HttpFile(out = OutDir(c = RustBuild.s.c), text = this.http) + [
			{ path = JoinP(a = OutDir(c = RustBuild.s.c), b = "mod.rs"), text = this.modrs, kind = "code" },
			{ path = JoinP(a = OutDir(c = RustBuild.s.c), b = "procs.rs"), text = this.procs, kind = "code" }
		] })
	};
	Mains -> ServerFiles(s = { prog = Rebased(c = RustBuild.s.c), specs = UnwrapSpecs(r = Servers), module_dir = ModuleDir(target = UnwrapR(r = R), out = OutDir(c = RustBuild.s.c), croot = Crate), krate = CrateName, out = OutDir(c = RustBuild.s.c), i = 0, acc = this });
	ServerFiles -> Guard(s = { files = this, i = 0 });
	Guard -> WriteAll(s = { files = ServerFiles, i = 0 });
	WriteAll -> Tools.Rustfmt(files = OutPaths(files = ServerFiles));
	Tools.Rustfmt -> BuildTable(prog = Rebased(c = RustBuild.s.c));
	// Implementations that aren't where the .sys says (warnings), or don't
	// match it (errors).
	BuildTable -> ImplWarnings(s = { checks = ImplChecks(prog = Rebased(c = RustBuild.s.c), t = this, module_dir = ModuleDir(target = UnwrapR(r = R), out = OutDir(c = RustBuild.s.c), croot = Crate), out = OutDir(c = RustBuild.s.c), root = RustBuild.s.c.project.root, paths = RustBuild.s.c.project.paths, srcs = RustBuild.s.c.project.srcs), t = this, i = 0, errors = [] });
	ImplWarnings -> Commands(s = { what = "post-build", cmds = UnwrapR(r = R).post, dir = RustBuild.s.c.project.root, i = 0 });
}

// Runs `vcc test`: builds everything, then runs each language's test
// commands, Go's then Rust's. Fails if there are none.
proc Test(s: Checked): string {
	func GoTests(m: Manifest): []string = "cli_leaf.rs:go_tests";
	func RustTests(m: Manifest): []string = "cli_leaf.rs:rust_tests";
	Test -> Build(s = { c = this.s, only = "" });
	Build switch {
		(GoTests(m = Test.s.project.manifest).len == 0 && RustTests(m = Test.s.project.manifest).len == 0 && PythonTests(m = Test.s.project.manifest).len == 0) -> Fail(msg = "vandorf.toml: no tests: add test = [..] to [go], [rust], or [python]") as NoTests,
		else -> Commands(s = { what = "test", cmds = GoTests(m = Test.s.project.manifest), dir = Test.s.project.root, i = 0 }) as GoRun
	};
	GoRun -> Commands(s = { what = "test", cmds = RustTests(m = Test.s.project.manifest), dir = Test.s.project.root, i = 0 }) as RustRun;
	RustRun -> Commands(s = { what = "test", cmds = PythonTests(m = Test.s.project.manifest), dir = Test.s.project.root, i = 0 }) as PythonRun;
	PythonRun -> id("tested " + Test.s.project.manifest.name);
}

// Runs shell commands in order in dir, announcing each on stderr; the first
// that fails fails the proc that called this. `what` names them in messages
// (post-build, test).
proc Commands(s: { what: string, cmds: []string, dir: string, i: int }): string {
	Commands switch {
		(this.s.i == this.s.cmds.len) -> id(""),
		else -> Console.Err(line = this.s.what + ": " + this.s.cmds[this.s.i])
	};
	Console.Err -> Tools.Shell(cmd = Commands.s.cmds[Commands.s.i], dir = Commands.s.dir);
	Tools.Shell switch {
		Ok(_) -> Commands(s = { ..Commands.s, i = Commands.s.i + 1 }),
		Err(e) -> Fail(msg = Commands.s.what + " `" + Commands.s.cmds[Commands.s.i] + "` failed (" + e.msg + ")") as Failed
	};
}

// An implementation to check, at path (absolute), against the declaration
// naming it: keyword is what defines the function (fn, func); missing and
// undefined, the warnings when path or the function doesn't exist. qual,
// sig and doc are the declaration's name, the implementation's expected
// signature and the declaration's doc comment; shown is path as messages
// show it; decl_path, decl_text, at and end place the declaration, for
// errors.
type ImplCheck = {
	path: string, function: string, keyword: string, missing: string, undefined: string,
	qual: string, shown: string, sig: string, doc: string,
	decl_path: string, decl_text: string, at: int, end: int
};
// Lists a check for each func implemented in Rust: its file (absolute), its
// function, the warnings to print if the file is missing or doesn't define
// it, and its declaration's signature and doc.
func ImplChecks(prog: Program, t: Table, module_dir: MaybeStr, out: string, root: string, paths: []string, srcs: []string): []ImplCheck = "cli_leaf.rs:impl_checks";

// Checks each implementation against its declaration. A missing file or
// function is a warning (the func calls a stub until it exists); a signature
// or doc comment that doesn't match the declaration is an error, and the
// build fails with all of them, before the language's post commands compile
// the code.
proc ImplWarnings(s: { checks: []ImplCheck, t: Table, i: int, errors: []string }): bool {
	// Whether src defines `fn function` (or a generic `fn function<` / `func
	// Function[T any](`); keyword is fn or func.
	func Defines(src: string, function: string, keyword: string): bool = "cli_leaf.rs:defines_fn";
	// Compares an implementation src defines with its declaration: an error for
	// a signature that doesn't match, and one for a doc comment that doesn't.
	func Mismatches(src: string, c: ImplCheck, t: Table): []string = "cli_leaf.rs:impl_mismatches";
	ImplWarnings switch {
		(this.s.i == this.s.checks.len && this.s.errors.len == 0) -> id(true),
		(this.s.i == this.s.checks.len) -> Refuse(msg = Join(parts = this.s.errors, sep = "\n\n")),
		else -> Fs.IsFile(path = this.s.checks[this.s.i].path)
	};
	Fs.IsFile switch {
		(this) -> Fs.Read(path = ImplWarnings.s.checks[ImplWarnings.s.i].path),
		else -> Console.Err(line = ImplWarnings.s.checks[ImplWarnings.s.i].missing + "\n") as Missing
	};
	Fs.Read switch {
		(Defines(src = this, function = ImplWarnings.s.checks[ImplWarnings.s.i].function, keyword = ImplWarnings.s.checks[ImplWarnings.s.i].keyword)) -> ImplWarnings(s = { ..ImplWarnings.s, i = ImplWarnings.s.i + 1, errors = ImplWarnings.s.errors + Mismatches(src = this, c = ImplWarnings.s.checks[ImplWarnings.s.i], t = ImplWarnings.s.t) }),
		else -> Console.Err(line = ImplWarnings.s.checks[ImplWarnings.s.i].undefined + "\n") as Undefined
	};
	Missing -> ImplWarnings(s = { ..ImplWarnings.s, i = ImplWarnings.s.i + 1 });
	Undefined -> ImplWarnings(s = { ..ImplWarnings.s, i = ImplWarnings.s.i + 1 });
	// Fails with the errors, without the first's `error: ` (the executable
	// prints it).
	func Refuse(msg: string): bool = "cli_leaf.rs:refuse_report";
}

func Fail(msg: string): string = "../leaf.rs:fail";
func UnwrapR(r: MaybeRust): RustTarget = "cli_leaf.rs:unwrap_r";
func OutDir(c: Checked): string = "cli_leaf.rs:out_dir";
func OutPaths(files: []OutFile): []string = "cli_leaf.rs:out_paths";
// Rebases the program's implementation paths onto [rust]'s out, from the
// .sys files naming them.
func Rebased(c: Checked): Program = "cli_leaf.rs:rebased";
// Works out where the Rust output sits in its crate: [rust]'s module_dir, or
// else out relative to the crate's src/.
func ModuleDir(target: RustTarget, out: string, croot: string): MaybeStr = "cli_leaf.rs:module_dir";
func BinNames(bins: map[string]Bin, only: string): []string = "cli_leaf.rs:bin_names";

// Reads the library crate's name from the Cargo.toml in dir, taking whether
// it has a src/lib.rs into account; "" if there's no crate or no library.
proc CrateName(dir: string): string {
	CrateName switch {
		(this.dir == "") -> id(""),
		else -> Fs.Read(path = JoinP(a = this.dir, b = "Cargo.toml"))
	};
	Fs.Read -> Fs.IsFile(path = JoinP(a = CrateName.dir, b = "src/lib.rs"));
	Fs.IsFile -> id(CargoLibName(toml = Fs.Read, has_lib_rs = this));
}

// Generates each bin's Rust main in turn, appending it to the files to
// write; fails on a bin whose entry proc can't run as a main.
proc Mains(s: { prog: Program, bins: map[string]Bin, names: []string, module_dir: MaybeStr, krate: string, out: string, i: int, acc: []OutFile }): []OutFile {
	// Generates an executable running proc `entry` (src/codegen/rust.rs:
	// main_artifact): its directory relative to the output module, its file name
	// and its text, or why the proc can't be one.
	func RustMain(prog: Program, t: Table, name: string, entry: string, path: string, module_dir: MaybeStr, krate: string): { dir: string, file: string, text: string, err: MaybeStr } = "../gen/gen_leaf.rs:rust_main";
	func BinPath(b: Bin, name: string): string = "cli_leaf.rs:bin_path";
	func FailFiles(msg: string): []OutFile = "cli_leaf.rs:fail_files";
	Mains switch {
		(this.s.i == this.s.names.len) -> id(this.s.acc),
		else -> BuildTable(prog = this.s.prog)
	};
	BuildTable -> RustMain(prog = Mains.s.prog, t = this, name = Mains.s.names[Mains.s.i], entry = Mains.s.bins[Mains.s.names[Mains.s.i]].entry, path = BinPath(b = Mains.s.bins[Mains.s.names[Mains.s.i]], name = Mains.s.names[Mains.s.i]), module_dir = Mains.s.module_dir, krate = Mains.s.krate);
	RustMain switch {
		{ dir = _, file = _, text = _, err = Some(e) } -> FailFiles(msg = e),
		else -> Mains(s = { prog = Mains.s.prog, bins = Mains.s.bins, names = Mains.s.names, module_dir = Mains.s.module_dir, krate = Mains.s.krate, out = Mains.s.out, i = Mains.s.i + 1, acc = Mains.s.acc + [{ path = JoinP(a = JoinP(a = Mains.s.out, b = this.dir), b = this.file), text = this.text, kind = "main" }] })
	};
}

// Refuses to overwrite a file vandorf didn't generate (say, a hand-written
// src/main.rs): each file that exists must start with vandorf's header.
proc Guard(s: { files: []OutFile, i: int }): bool {
	Guard switch {
		(this.s.i == this.s.files.len) -> id(true),
		else -> Fs.IsFile(path = this.s.files[this.s.i].path)
	};
	Fs.IsFile switch {
		(this) -> Fs.Read(path = Guard.s.files[Guard.s.i].path),
		else -> Guard(s = { files = Guard.s.files, i = Guard.s.i + 1 })
	};
	Fs.Read switch {
		((StartsWith(text = this, prefix = "// Code generated by vandorf.") && StartsWith(text = Guard.s.files[Guard.s.i].text, prefix = "// Code generated by vandorf.")) || (StartsWith(text = this, prefix = "# Code generated by vandorf.") && StartsWith(text = Guard.s.files[Guard.s.i].text, prefix = "# Code generated by vandorf."))) -> Guard(s = { files = Guard.s.files, i = Guard.s.i + 1 }),
		else -> Refuse(msg = Guard.s.files[Guard.s.i].path + " exists and was not generated by vandorf; not overwriting it")
	};
	func Refuse(msg: string): bool = "cli_leaf.rs:refuse";
}

// Writes each generated file, announcing it on stderr with its kind.
proc WriteAll(s: { files: []OutFile, i: int }): bool {
	func Pad(s: string, n: int): string = "cli_leaf.rs:pad";
	WriteAll switch {
		(this.s.i == this.s.files.len) -> id(true),
		else -> Fs.Write(path = this.s.files[this.s.i].path, text = this.s.files[this.s.i].text)
	};
	Fs.Write -> Console.Err(line = "wrote " + Pad(s = WriteAll.s.files[WriteAll.s.i].kind, n = 5) + " " + WriteAll.s.files[WriteAll.s.i].path);
	Console.Err -> WriteAll(s = { files = WriteAll.s.files, i = WriteAll.s.i + 1 });
}

func HttpFile(out: string, text: string): []OutFile = "cli_leaf.rs:http_file";
func UnwrapSpecs(r: Res<[]ServerSpec>): []ServerSpec = "cli_leaf.rs:unwrap_specs";

// Generates each server's Rust main in turn, after the bins.
proc ServerFiles(s: { prog: Program, specs: []ServerSpec, module_dir: MaybeStr, krate: string, out: string, i: int, acc: []OutFile }): []OutFile {
	func FailFiles(msg: string): []OutFile = "cli_leaf.rs:fail_files";
	ServerFiles switch {
		(this.s.i == this.s.specs.len) -> id(this.s.acc),
		else -> RustServer(s = { prog = this.s.prog, srv = this.s.specs[this.s.i], module_dir = this.s.module_dir, krate = this.s.krate })
	};
	RustServer switch {
		{ dir = _, file = _, text = _, err = Some(e) } -> FailFiles(msg = e),
		else -> ServerFiles(s = { ..ServerFiles.s, i = ServerFiles.s.i + 1, acc = ServerFiles.s.acc + [{ path = JoinP(a = JoinP(a = ServerFiles.s.out, b = this.dir), b = this.file), text = this.text, kind = "main" }] })
	};
}

// Gathers each Rust server's spec from its [http.*]: its raw routes and
// routes split into method and path (failing on one that's in both, or isn't
// a method and a path), its setup, and its static files as its main's source
// file reaches them.
proc ServerSpecs(s: { m: Manifest, root: string, out: string, module_dir: MaybeStr, names: []string, i: int, acc: []ServerSpec }): Res<[]ServerSpec> {
	func ServerPath(d: ServerDecl, name: string): string = "cli_leaf.rs:server_path";
	func SetupName(d: ServerDecl): string = "cli_leaf.rs:setup_name";
	func CliName(d: ServerDecl): string = "cli_leaf.rs:cli_name";
	// Finds the directory of a file under the crate's src/ (path, relative to
	// src/): src/ is found by going up from out once per segment of module_dir.
	func FileDir(out: string, module_dir: MaybeStr, path: string): string = "cli_leaf.rs:file_dir";
	ServerSpecs switch {
		(this.s.i == this.s.names.len) -> id(Ok(this.s.acc)),
		else -> Routes(s = { name = this.s.names[this.s.i], routes = this.s.m.http[this.s.names[this.s.i]].raw, keys = this.s.m.http[this.s.names[this.s.i]].raw.keys, other = this.s.m.http[this.s.names[this.s.i]].routes, j = 0, acc = [] }) as Raws
	};
	Raws switch {
		Ok(_) -> Routes(s = { name = ServerSpecs.s.names[ServerSpecs.s.i], routes = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]].routes, keys = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]].routes.keys, other = [:], j = 0, acc = [] }),
		Err(e) -> id(Err(e))
	};
	Routes switch {
		Ok(routes) -> Statics(s = { name = ServerSpecs.s.names[ServerSpecs.s.i], root = ServerSpecs.s.root, dir = FileDir(out = ServerSpecs.s.out, module_dir = ServerSpecs.s.module_dir, path = ServerPath(d = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]], name = ServerSpecs.s.names[ServerSpecs.s.i])), statics = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]].statics, keys = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]].statics.keys, j = 0, acc = [] }),
		Err(e) -> id(Err(e))
	};
	Statics switch {
		Ok(statics) -> ServerSpecs(s = { ..ServerSpecs.s, i = ServerSpecs.s.i + 1, acc = ServerSpecs.s.acc + [{ name = ServerSpecs.s.names[ServerSpecs.s.i], addr = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]].addr, setup = SetupName(d = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]]), cli = CliName(d = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]]), routes = UnwrapRoutes(r = Routes), raw = UnwrapRoutes(r = Raws), statics = statics, path = ServerPath(d = ServerSpecs.s.m.http[ServerSpecs.s.names[ServerSpecs.s.i]], name = ServerSpecs.s.names[ServerSpecs.s.i]) }] }),
		Err(e) -> id(Err(e))
	};
}

func UnwrapRoutes(r: Res<[]Route>): []Route = "cli_leaf.rs:unwrap_routes";

// Splits each route of a server into its method and path, failing on one
// that's also in `other` (the server's other routes) or isn't a method and a
// path.
proc Routes(s: { name: string, routes: map[string]string, keys: []string, other: map[string]string, j: int, acc: []Route }): Res<[]Route> {
	// other: the server's other routes, which these mustn't repeat.

	// Splits "POST /api/calc" into a route's method and path, with the proc it
	// runs; none if it isn't a method and a path.
	func Split(route: string, proc: string): []Route = "cli_leaf.rs:split_route";
	func DebugQ(s: string): string = "cli_leaf.rs:debug_quote";
	Routes switch {
		(this.s.j == this.s.keys.len) -> id(Ok(this.s.acc)),
		(this.s.keys[this.s.j] in this.s.other) -> id(Err({ msg = "vandorf.toml: [http." + this.s.name + "] route " + DebugQ(s = this.s.keys[this.s.j]) + " is in both routes and raw", span = { at = 0, end = 0, file = 0 } })),
		(Split(route = this.s.keys[this.s.j], proc = this.s.routes[this.s.keys[this.s.j]]).len == 0) -> id(Err({ msg = "vandorf.toml: [http." + this.s.name + "] route " + DebugQ(s = this.s.keys[this.s.j]) + " should be a method and a path, like \"POST /api/calc\"", span = { at = 0, end = 0, file = 0 } })),
		else -> Routes(s = { ..this.s, j = this.s.j + 1, acc = this.s.acc + Split(route = this.s.keys[this.s.j], proc = this.s.routes[this.s.keys[this.s.j]]) })
	};
}

// Resolves a Rust server's static files, each with its URL, its path from
// the server's source file and its content type; fails on one that doesn't
// exist.
proc Statics(s: { name: string, root: string, dir: string, statics: map[string]string, keys: []string, j: int, acc: []StaticFile }): Res<[]StaticFile> {
	func ContentType(file: string): string = "cli_leaf.rs:content_type";
	Statics switch {
		(this.s.j == this.s.keys.len) -> id(Ok(this.s.acc)),
		else -> Fs.IsFile(path = JoinP(a = this.s.root, b = this.s.statics[this.s.keys[this.s.j]]))
	};
	Fs.IsFile switch {
		(this) -> Statics(s = { ..Statics.s, j = Statics.s.j + 1, acc = Statics.s.acc + [{ url = Statics.s.keys[Statics.s.j], file = Relative(target = JoinP(a = Statics.s.root, b = Statics.s.statics[Statics.s.keys[Statics.s.j]]), from = Statics.s.dir), ctype = ContentType(file = Statics.s.statics[Statics.s.keys[Statics.s.j]]) }] }),
		else -> id(Err({ msg = "vandorf.toml: [http." + Statics.s.name + "] serves " + Statics.s.statics[Statics.s.keys[Statics.s.j]] + ", which does not exist", span = { at = 0, end = 0, file = 0 } }))
	};
}

// Renders one diagnostic: the level and message, `path:line:col`, and the
// line with the span underlined, then the notes as `= note` lines.
func Snippet(level: string, msg: string, path: string, text: string, at: int, end: int, notes: []string): string = "cli_leaf.rs:snippet";
// Renders one diagnostic, for the parity tests.
proc RenderSnippet(s: { level: string, msg: string, path: string, text: string, at: int, end: int, notes: []string }): string {
	RenderSnippet -> id(Snippet(level = this.s.level, msg = this.s.msg, path = this.s.path, text = this.s.text, at = this.s.at, end = this.s.end, notes = this.s.notes));
}
