// Expressions. Precedence, loosest first: || (0), && (1), comparisons and
// `in` (2, at most one), + - (3), * / % (4), then prefix ! and -, then
// postfix [key] and .field, then atoms.

type AtLevel = { cur: Cur, level: int };
type AtLevelValue = { cur: Cur, level: int, left: Value };
type AtValue = { cur: Cur, left: Value };

// Whether t is an operator of precedence `level`: `||` at 0, `&&` at 1,
// comparisons and `in` at 2, `+ -` at 3, `* / %` at 4.
func OpAt(t: Tok, level: int): bool = "leaf.rs:op_at";
// Builds `l op r` from its operands, spanning both: a Binary, or an In when
// the operator is `in`.
func Combine(op: Tok, l: Value, r: Value): Value = "leaf.rs:combine";
// Builds `op e` for a prefix `!` or `-`, spanning both; `-` before a number
// literal folds into a negative literal instead.
func Prefix(op: Tok, e: Value): Value = "leaf.rs:prefix";

// Parses an expression, starting at the loosest precedence, `||`.
proc PExpr(toks: []Tok, pos: int): R<Value> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PExpr -> At(toks = this.toks, pos = this.pos);
	At -> PBin(toks = this.toks, pos = this.pos, level = 0);
}

// Parses the operators of one precedence level: a left operand at the next
// level up, then any more of this level's operators (prefix operators once
// past the last level).
proc PBin(toks: []Tok, pos: int, level: int): R<Value> {
	func AtL(toks: []Tok, pos: int, level: int): AtLevel = "leaf.rs:at_level";
	PBin -> AtL(toks = this.toks, pos = this.pos, level = this.level);
	AtL switch {
		(this.level == 5) -> PUnary(toks = this.cur.toks, pos = this.cur.pos),
		else -> PBin(toks = this.cur.toks, pos = this.cur.pos, level = this.level + 1) as Left
	};
	Left -> PBinRest(toks = AtL.cur.toks, pos = this.pos, level = AtL.level, left = this.x);
}

// Parses the operators of a level that follow `left`, each with its right
// operand at the next level, folding them to the left. A comparison (level
// 2) takes only one, so `a < b < c` doesn't parse.
proc PBinRest(toks: []Tok, pos: int, level: int, left: Value): R<Value> {
	func AtLV(toks: []Tok, pos: int, level: int, left: Value): AtLevelValue = "leaf.rs:at_level_value";
	PBinRest -> AtLV(toks = this.toks, pos = this.pos, level = this.level, left = this.left);
	AtLV switch {
		(OpAt(t = this.cur.tok, level = this.level)) -> PBin(toks = this.cur.toks, pos = this.cur.pos + 1, level = this.level + 1) as Right,
		else -> id({ x = this.left, pos = this.cur.pos })
	};
	Right switch {
		(AtLV.level == 2) -> id({ x = Combine(op = AtLV.cur.tok, l = AtLV.left, r = this.x), pos = this.pos }),
		else -> AtLV(toks = AtLV.cur.toks, pos = this.pos, level = AtLV.level, left = Combine(op = AtLV.cur.tok, l = AtLV.left, r = this.x))
	};
}

// Parses a prefix `!` or `-` and its operand, any number of them, or else a
// postfix expression.
//
//   unary := ('!' | '-') unary | postfix
proc PUnary(toks: []Tok, pos: int): R<Value> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PUnary -> At(toks = this.toks, pos = this.pos);
	At switch {
		(IsSym(t = this.tok, s = "!") || IsSym(t = this.tok, s = "-")) -> PUnary(toks = this.toks, pos = this.pos + 1) as Operand,
		else -> PPostfix(toks = this.toks, pos = this.pos)
	};
	Operand -> id({ x = Prefix(op = At.tok, e = this.x), pos = this.pos });
}

// Parses an atom and the indexes and field selections after it.
//
//   postfix := atom ('[' expr ']' | '.' NAME)*
proc PPostfix(toks: []Tok, pos: int): R<Value> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PPostfix -> At(toks = this.toks, pos = this.pos);
	At -> PAtom(toks = this.toks, pos = this.pos);
	PAtom -> PPostRest(toks = At.toks, pos = this.pos, left = this.x);
}

// Parses the `[key]` and `.field` selections that follow `left`, each
// wrapping what came before it, for as long as they continue.
proc PPostRest(toks: []Tok, pos: int, left: Value): R<Value> {
	func AtV(toks: []Tok, pos: int, left: Value): AtValue = "leaf.rs:at_value";
	PPostRest -> AtV(toks = this.toks, pos = this.pos, left = this.left);
	AtV switch {
		(IsSym(t = this.cur.tok, s = "[")) -> PExpr(toks = this.cur.toks, pos = this.cur.pos + 1) as Key,
		(IsSym(t = this.cur.tok, s = ".")) -> NeedName(toks = this.cur.toks, pos = this.cur.pos + 1, what = "a field name"),
		else -> id({ x = this.left, pos = this.cur.pos })
	};
	Key -> Expect(toks = AtV.cur.toks, pos = this.pos, text = "]", what = "] after the key") as Close;
	Close -> AtV(
		toks = this.toks,
		pos = this.pos,
		left = { kind = Index({ e = AtV.left, key = Key.x }), span = { at = AtV.left.span.at, end = this.prev.end, file = AtV.left.span.file } }
	);
	NeedName -> AtV(
		toks = this.toks,
		pos = this.pos,
		left = { kind = Field({ e = AtV.left, name = MkIdent(t = this.tok) }), span = { at = AtV.left.span.at, end = this.tok.end, file = AtV.left.span.file } }
	);
}

// Parses an atom: a literal, a struct literal or update, an array or map
// literal, a parenthesized expression, a path, or a call of a func.
//
//   atom := INT | FLOAT | STRING | 'true' | 'false' | '{' arg,* '}'
//         | '{' '..' expr (',' arg)* '}' | '[' ... ']' | '(' expr ')'
//         | path | path '(' ((NAME '=')? expr),* ')'
proc PAtom(toks: []Tok, pos: int): R<Value> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PAtom -> At(toks = this.toks, pos = this.pos);
	At switch {
		(this.tok.kind == "int") -> id({ x = { kind = Int(IntOf(t = this.tok)), span = SpanOf(t = this.tok) }, pos = this.pos + 1 }),
		(this.tok.kind == "float") -> id({ x = { kind = Float(FloatOf(t = this.tok)), span = SpanOf(t = this.tok) }, pos = this.pos + 1 }),
		(this.tok.kind == "str") -> id({ x = { kind = Str(this.tok.text), span = SpanOf(t = this.tok) }, pos = this.pos + 1 }),
		(IsWord(t = this.tok, s = "true")) -> id({ x = { kind = Bool(true), span = SpanOf(t = this.tok) }, pos = this.pos + 1 }),
		(IsWord(t = this.tok, s = "false")) -> id({ x = { kind = Bool(false), span = SpanOf(t = this.tok) }, pos = this.pos + 1 }),
		(IsSym(t = this.tok, s = "{") && IsSym(t = this.toks[this.pos + 1], s = "..")) -> PExpr(toks = this.toks, pos = this.pos + 2) as UpdateBase,
		(IsSym(t = this.tok, s = "{")) -> PArgList(toks = this.toks, pos = this.pos + 1) as StructArgs,
		(IsSym(t = this.tok, s = "[")) -> PBracket(toks = this.toks, pos = this.pos + 1),
		(IsSym(t = this.tok, s = "(")) -> PExpr(toks = this.toks, pos = this.pos + 1) as Paren,
		(this.tok.kind == "ident") -> PPath(toks = this.toks, pos = this.pos),
		else -> NotAtom(toks = this.toks, pos = this.pos, what = "an expression")
	};
	// Fails at toks[pos], saying what was expected there instead.
	func NotAtom(toks: []Tok, pos: int, what: string): R<Value> = "leaf.rs:expected_value";
	StructArgs -> Expect(toks = At.toks, pos = this.pos, text = "}", what = ", or }") as StructClose;
	// `{ ..base }` or `{ ..base, f = v, .. }`
	UpdateBase -> At(toks = At.toks, pos = this.pos) as AfterBase;
	AfterBase switch {
		(IsSym(t = this.tok, s = ",")) -> PArgList(toks = this.toks, pos = this.pos + 1) as UpdateArgs,
		else -> Expect(toks = this.toks, pos = this.pos, text = "}", what = ", or }") as BareClose
	};
	UpdateArgs -> Expect(toks = At.toks, pos = this.pos, text = "}", what = ", or }") as UpdateClose;
	UpdateClose -> id({ x = { kind = Update({ base = UpdateBase.x, args = UpdateArgs.x }), span = { at = At.tok.at, end = this.prev.end, file = At.tok.file } }, pos = this.pos });
	BareClose -> id({ x = { kind = Update({ base = UpdateBase.x, args = [] }), span = { at = At.tok.at, end = this.prev.end, file = At.tok.file } }, pos = this.pos });
	StructClose -> id({ x = { kind = Struct(StructArgs.x), span = { at = At.tok.at, end = this.prev.end, file = At.tok.file } }, pos = this.pos });
	PBracket -> id(this);
	Paren -> Expect(toks = At.toks, pos = this.pos, text = ")", what = ")") as ParenClose;
	ParenClose -> id({ x = Paren.x, pos = this.pos });
	PPath -> At(toks = At.toks, pos = this.pos) as AfterPath;
	AfterPath switch {
		(IsSym(t = this.tok, s = "(")) -> PApplyArgs(toks = this.toks, pos = this.pos + 1),
		else -> id({ x = { kind = Ref(PPath.x), span = PPath.x.span }, pos = this.pos })
	};
	PApplyArgs -> Expect(toks = At.toks, pos = this.pos, text = ")", what = ", or )") as ApplyClose;
	ApplyClose -> id({
		x = { kind = Apply({ name = PPath.x, args = PApplyArgs.x }), span = { at = PPath.x.span.at, end = this.prev.end, file = PPath.x.span.file } },
		pos = this.pos
	});
}

// Parses an array or map literal after its `[`: `[:]` is the empty map, `[]`
// the empty array, and a first item followed by `:` makes a map.
//
//   '[' ':' ']' | '[' (expr ':' expr),+ ','? ']' | '[' expr,* ','? ']'
proc PBracket(toks: []Tok, pos: int): R<Value> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PBracket -> At(toks = this.toks, pos = this.pos);
	At switch {
		(IsSym(t = this.tok, s = ":")) -> Expect(toks = this.toks, pos = this.pos + 1, text = "]", what = "] in [:]") as EmptyMap,
		(IsSym(t = this.tok, s = "]")) -> id({ x = { kind = Array([]), span = { at = this.prev.at, end = this.tok.end, file = this.prev.file } }, pos = this.pos + 1 }),
		else -> PExpr(toks = this.toks, pos = this.pos) as First
	};
	EmptyMap -> id({ x = { kind = Map([]), span = { at = At.prev.at, end = this.prev.end, file = At.prev.file } }, pos = this.pos });
	First -> At(toks = At.toks, pos = this.pos) as AfterFirst;
	AfterFirst switch {
		(IsSym(t = this.tok, s = ":")) -> PExpr(toks = this.toks, pos = this.pos + 1) as FirstValue,
		else -> PValuesRest(toks = this.toks, pos = this.pos)
	};
	FirstValue -> PEntriesRest(toks = At.toks, pos = this.pos);
	PEntriesRest -> Expect(toks = At.toks, pos = this.pos, text = "]", what = ", or ]") as MapClose;
	MapClose -> id({
		x = { kind = Map([{ key = First.x, value = FirstValue.x }] + PEntriesRest.x), span = { at = At.prev.at, end = this.prev.end, file = At.prev.file } },
		pos = this.pos
	});
	PValuesRest -> Expect(toks = At.toks, pos = this.pos, text = "]", what = ", or ]") as ArrayClose;
	ArrayClose -> id({ x = { kind = Array([First.x] + PValuesRest.x), span = { at = At.prev.at, end = this.prev.end, file = At.prev.file } }, pos = this.pos });
}

// Parses an array literal's items after its first, each after a comma, a
// trailing comma allowed, until its closing bracket.
proc PValuesRest(toks: []Tok, pos: int): R<[]Value> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	func Loop(toks: []Tok, pos: int, acc: []Value): AtAcc<[]Value> = "leaf.rs:at_values";
	PValuesRest -> At(toks = this.toks, pos = this.pos);
	At -> Loop(toks = this.toks, pos = this.pos, acc = []);
	Loop switch {
		(IsSym(t = this.cur.tok, s = ",")) -> At(toks = this.cur.toks, pos = this.cur.pos + 1) as AfterComma,
		else -> id({ x = this.acc, pos = this.cur.pos })
	};
	AfterComma switch {
		(IsClose(t = this.tok)) -> id({ x = Loop.acc, pos = this.pos }),
		else -> PExpr(toks = this.toks, pos = this.pos)
	};
	PExpr -> Loop(toks = Loop.cur.toks, pos = this.pos, acc = Loop.acc + [this.x]);
}

// Parses a map literal's `key: value` entries after its first, each after a
// comma, a trailing comma allowed, until its closing bracket.
proc PEntriesRest(toks: []Tok, pos: int): R<[]Entry> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	func Loop(toks: []Tok, pos: int, acc: []Entry): AtAcc<[]Entry> = "leaf.rs:at_entries";
	PEntriesRest -> At(toks = this.toks, pos = this.pos);
	At -> Loop(toks = this.toks, pos = this.pos, acc = []);
	Loop switch {
		(IsSym(t = this.cur.tok, s = ",")) -> At(toks = this.cur.toks, pos = this.cur.pos + 1) as AfterComma,
		else -> id({ x = this.acc, pos = this.cur.pos })
	};
	AfterComma switch {
		(IsClose(t = this.tok)) -> id({ x = Loop.acc, pos = this.pos }),
		else -> PExpr(toks = this.toks, pos = this.pos) as Key
	};
	Key -> Expect(toks = Loop.cur.toks, pos = this.pos, text = ":", what = ": after the key") as Colon;
	Colon -> PExpr(toks = this.toks, pos = this.pos) as Val;
	Val -> Loop(toks = Loop.cur.toks, pos = this.pos, acc = Loop.acc + [{ key = Key.x, value = this.x }]);
}

// Parses a call's arguments, separated by commas, until its closing
// parenthesis.
proc PApplyArgs(toks: []Tok, pos: int): R<[]ApplyArg> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	func Loop(toks: []Tok, pos: int, acc: []ApplyArg): AtAcc<[]ApplyArg> = "leaf.rs:at_apply_args";
	PApplyArgs -> At(toks = this.toks, pos = this.pos);
	At -> Loop(toks = this.toks, pos = this.pos, acc = []);
	Loop switch {
		(IsClose(t = this.cur.tok)) -> id({ x = this.acc, pos = this.cur.pos }),
		else -> PApplyArg(toks = this.cur.toks, pos = this.cur.pos)
	};
	PApplyArg -> At(toks = Loop.cur.toks, pos = this.pos) as After;
	After switch {
		(IsSym(t = this.tok, s = ",")) -> Loop(toks = this.toks, pos = this.pos + 1, acc = Loop.acc + [PApplyArg.x]),
		else -> id({ x = Loop.acc + [PApplyArg.x], pos = this.pos })
	};
}

// Parses one argument of a call: `name = value`, or just a value.
proc PApplyArg(toks: []Tok, pos: int): R<ApplyArg> {
	func At(toks: []Tok, pos: int): Cur = "leaf.rs:at";
	PApplyArg -> At(toks = this.toks, pos = this.pos);
	At switch {
		(this.tok.kind == "ident" && IsSym(t = this.toks[this.pos + 1], s = "=")) -> Expect(toks = this.toks, pos = this.pos + 1, text = "=", what = "=") as Eq,
		else -> PExpr(toks = this.toks, pos = this.pos) as Positional
	};
	Eq -> PExpr(toks = this.toks, pos = this.pos) as Named;
	Named -> id({ x = { name = Some(MkIdent(t = At.tok)), value = this.x }, pos = this.pos });
	Positional -> id({ x = { name = None(), value = this.x }, pos = this.pos });
}
