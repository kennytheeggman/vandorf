// The visualizer document: each proc laid out as a grid of rows
// (src/document.rs in the reference; the same JSON).
//
// Layout is a breadth-first sweep, one row per step: every node in the last
// row adds its edge targets to the next row. When an edge reaches a node
// already placed (and isn't a back edge), that node is pushed down: it and
// everything placed downstream of it leave the grid, it's placed in the row
// being built, and its descendants are found again from there. An edge is a
// back edge, drawn upward without moving anything, when its target already
// reaches its source through the recorded forward edges.

type Json = enum { Null, Bool(bool), Num(int), Str(string), Arr([]Json), Obj([]JsonField) };
type JsonField = { key: string, value: Json };

// Writes a JSON value in serde_json's pretty format, two spaces per level,
// as the reference printed the document.
func Pretty(j: Json): string = "doc_leaf.rs:pretty";

// 0 func, 1 proc. Edges: 0 call, 1 match, 2 for each expand, 3 for each
// continue, 4 for each collect.
// args: the call's arguments as written.
type Pending = { ty: int, target: int, label: MaybeStr, value: string, call: string, args: string, back: bool };
type Out = { ty: int, target: int, label: MaybeStr, value: string, args: string };
type Pos = { r: int, c: int };
type Layout = { rows: [][]int, pos: map[int]Pos, out: map[int][]Pending };

// Places node n at the end of row r, recording its position.
func Place(l: Layout, n: int, r: int): Layout = "doc_leaf.rs:place";
// Takes the nodes in `set` out of the grid, with their recorded edges,
// closing up their rows; they're placed again from where they're pushed down
// to.
func PushDown(l: Layout, set: map[int]bool): Layout = "doc_leaf.rs:push_down";
func TrimRows(l: Layout): Layout = "doc_leaf.rs:trim_rows";
// Lists the calls a switch can end in, nested switches flattened, each with
// the arm heads on the way, for the edge labels.
func ArmPaths(arms: []SArm): []{ labels: []string, call: Call } = "doc_leaf.rs:arm_paths";
// Lists every proc, nested ones included, in node order.
func Procs(nodes: []NodeDecl): []int = "doc_leaf.rs:all_procs";
func GraphOf(n: NodeDecl): Graph = "doc_leaf.rs:graph_of";
// Lists the nodes in the last row that have an edge out: steps of a region,
// or spawn branches leading on to their join.
func Frontier(l: Layout, g: Graph): []int = "doc_leaf.rs:frontier";

// Prints the visualizer document: one grid per proc, nested ones included,
// keyed by qualified name, as pretty JSON.
proc Document(prog: Program): string {
	Document -> Grids(s = { prog = this.prog, procs = Procs(nodes = this.prog.nodes), i = 0, acc = [:] });
	Grids -> id(Pretty(j = Obj([{ key = "grids", value = Obj(JsonFields(m = this)) }])));
}

// Builds the visualizer document as a JSON value, one grid per proc, for the
// IDE.
proc DocumentJson(prog: Program): Json {
	DocumentJson -> Grids(s = { prog = this.prog, procs = Procs(nodes = this.prog.nodes), i = 0, acc = [:] });
	Grids -> id(Obj([{ key = "grids", value = Obj(JsonFields(m = this)) }]));
}

func JsonFields(m: map[string]Json): []JsonField = "doc_leaf.rs:fields";

// Lays out each proc in turn, from its signature node down, and adds its
// grid to the document under its qualified name.
proc Grids(s: { prog: Program, procs: []int, i: int, acc: map[string]Json }): map[string]Json {
	Grids switch {
		(this.s.i == this.s.procs.len) -> id(this.s.acc),
		else -> Sweep(s = { prog = this.s.prog, pid = this.s.procs[this.s.i], g = GraphOf(n = this.s.prog.nodes[this.s.procs[this.s.i]]), l = Place(l = { rows = [[]], pos = [:], out = [:] }, n = ProcEntry(nodes = this.s.prog.nodes, pid = this.s.procs[this.s.i]), r = 0) })
	};
	Sweep -> GridJson(s = { prog = Grids.s.prog, pid = Grids.s.procs[Grids.s.i], l = TrimRows(l = this) });
	GridJson -> Grids(s = { prog = Grids.s.prog, procs = Grids.s.procs, i = Grids.s.i + 1, acc = Grids.s.acc + [QualName(n = Grids.s.prog.nodes[Grids.s.procs[Grids.s.i]]): this] });
}

func ProcEntry(nodes: []NodeDecl, pid: int): int = "../sema/sema_leaf.rs:proc_entry";

type SweepIn = { prog: Program, pid: int, g: Graph, l: Layout };

// Lays a proc out one row per step: every node in the last row that has
// edges out adds their targets to a new row, until none does. Every pushdown
// moves a node strictly lower, so the grid can't grow past a row per node;
// guard regardless.
proc Sweep(s: SweepIn): Layout {
	Sweep switch {
		(this.s.l.rows.len > this.s.g.region_of.len + this.s.g.spawned.len + 1 || Frontier(l = this.s.l, g = this.s.g).len == 0) -> id(this.s.l),
		else -> Sources(s = { at = this.s, srcs = Frontier(l = this.s.l, g = this.s.g), last = this.s.l.rows.len - 1, row = this.s.l.rows.len, l = { ..this.s.l, rows = this.s.l.rows + [[]] }, i = 0 })
	};
	Sources -> Sweep(s = { prog = Sweep.s.prog, pid = Sweep.s.pid, g = Sweep.s.g, l = this });
}

type SourcesIn = { at: SweepIn, srcs: []int, last: int, row: int, l: Layout, i: int };

// Records the edges out of each node of the last row in turn, placing their
// targets in the new row; a node a pushdown already moved, or already
// recorded, is skipped.
proc Sources(s: SourcesIn): Layout {
	Sources switch {
		(this.s.i == this.s.srcs.len) -> id(this.s.l),
		// A pushdown earlier in this sweep may have moved src down a row (it
		// will be swept from there) or already recorded its edges.
		(!(this.s.srcs[this.s.i] in this.s.l.pos) || this.s.l.pos[this.s.srcs[this.s.i]].r != this.s.last || this.s.srcs[this.s.i] in this.s.l.out) -> Sources(s = { at = this.s.at, srcs = this.s.srcs, last = this.s.last, row = this.s.row, l = this.s.l, i = this.s.i + 1 }),
		else -> EdgeTargets(s = { prog = this.s.at.prog, g = this.s.at.g, src = this.s.srcs[this.s.i] })
	};
	EdgeTargets -> Record(s = { prog = Sources.s.at.prog, pid = Sources.s.at.pid, src = Sources.s.srcs[Sources.s.i], row = Sources.s.row, outs = this, i = 0, l = Sources.s.l, acc = [] });
	Record -> Sources(s = { at = Sources.s.at, srcs = Sources.s.srcs, last = Sources.s.last, row = Sources.s.row, l = this, i = Sources.s.i + 1 });
}

// Records each edge out of src: places its target in the new row if it isn't
// placed yet, or pushes it and what's downstream of it down to the new row;
// an edge to a node that already reaches src is a back edge, drawn upward
// without moving anything.
proc Record(s: { prog: Program, pid: int, src: int, row: int, outs: []Out, i: int, l: Layout, acc: []Pending }): Layout {
	func Placed(l: Layout, target: int, back: bool): { l: Layout, back: bool } = "../sema/sema_leaf.rs:pack_placed";
	Record switch {
		(this.s.i == this.s.outs.len) -> id({ ..this.s.l, out = this.s.l.out + [this.s.src: this.s.acc] }),
		(!(this.s.outs[this.s.i].target in this.s.l.pos)) -> Placed(l = Place(l = this.s.l, n = this.s.outs[this.s.i].target, r = this.s.row), target = this.s.outs[this.s.i].target, back = false),
		(this.s.l.pos[this.s.outs[this.s.i].target].r == this.s.row) -> Placed(l = this.s.l, target = this.s.outs[this.s.i].target, back = false),
		else -> Downstream(s = { l = this.s.l, stack = [this.s.outs[this.s.i].target], seen = [:] })
	};
	Downstream switch {
		(Record.s.outs[Record.s.i].target == Record.s.src || Record.s.src in this) -> Placed(l = Record.s.l, target = Record.s.outs[Record.s.i].target, back = true),
		else -> Placed(l = Place(l = PushDown(l = Record.s.l, set = this), n = Record.s.outs[Record.s.i].target, r = Record.s.row), target = Record.s.outs[Record.s.i].target, back = false)
	};
	Placed -> CallSig(s = { prog = Record.s.prog, pid = Record.s.pid, n = Record.s.outs[Record.s.i].target });
	CallSig -> Record(s = { prog = Record.s.prog, pid = Record.s.pid, src = Record.s.src, row = Record.s.row, outs = Record.s.outs, i = Record.s.i + 1, l = Placed.l, acc = Record.s.acc + [{ ty = Record.s.outs[Record.s.i].ty, target = Record.s.outs[Record.s.i].target, label = Record.s.outs[Record.s.i].label, value = Record.s.outs[Record.s.i].value, call = this, args = Record.s.outs[Record.s.i].args, back = Placed.back }] });
}

// Finds `from` and every placed node reachable from it along recorded
// forward edges: what moves when it's pushed down.
proc Downstream(s: { l: Layout, stack: []int, seen: map[int]bool }): map[int]bool {
	func Last(xs: []int): int = "../sema/sema_leaf.rs:last_int";
	func Pop(xs: []int): []int = "../sema/sema_leaf.rs:pop_int";
	// Lists the targets of n's recorded forward edges.
	func Forward(l: Layout, n: int): []int = "doc_leaf.rs:forward";
	Downstream switch {
		(this.s.stack.len == 0) -> id(this.s.seen),
		(!(Last(xs = this.s.stack) in this.s.l.pos) || Last(xs = this.s.stack) in this.s.seen) -> Downstream(s = { l = this.s.l, stack = Pop(xs = this.s.stack), seen = this.s.seen }),
		else -> Downstream(s = { l = this.s.l, stack = Pop(xs = this.s.stack) + Forward(l = this.s.l, n = Last(xs = this.s.stack)), seen = this.s.seen + [Last(xs = this.s.stack): true] })
	};
}

// Lists the edges out of src as the diagram draws them, each with what it
// carries: a call, one edge per arm path of a switch, a for each's
// expansion, a collect, a spawn's branches, or a branch on to its join.
proc EdgeTargets(s: { prog: Program, g: Graph, src: int }): []Out {
	// Draws a spawner's edges: one to each branch, marked as a spawn.
	func SpawnOuts(branches: []SBranch, value: string): []Out = "doc_leaf.rs:spawn_outs";
	// Draws a branch's edge on to its spawn's join: a joined one's, or, when
	// every branch is detached, the first one's (drawn from the strip); none for
	// other detached ones.
	func BranchOuts(g: Graph, src: int, value: string): []Out = "doc_leaf.rs:branch_outs";
	func Joined(g: Graph, src: int): Type = "doc_leaf.rs:joined_type";
	EdgeTargets switch {
		(this.s.src in this.s.g.spawned) -> ShowType(t = Joined(g = this.s.g, src = this.s.src)) as JoinedType,
		else -> ShowType(t = NodeRet(nodes = this.s.prog.nodes, n = this.s.src)) as Ret
	};
	JoinedType -> id(BranchOuts(g = EdgeTargets.s.g, src = EdgeTargets.s.src, value = this));
	Ret -> id(EdgeTargets.s.g.edges[EdgeTargets.s.src]) as E;
	E switch {
		Call(c) -> switch {
			(EdgeTargets.s.src in EdgeTargets.s.g.region_of && EdgeTargets.s.g.region_of[EdgeTargets.s.src] != 0) -> id([{ ty = 3, target = c.target, label = None(), value = Ret, args = c.text }]),
			else -> id([{ ty = 0, target = c.target, label = None(), value = Ret, args = c.text }])
		},
		Match(arms) -> MatchOuts(s = { paths = ArmPaths(arms = arms), value = Ret, i = 0, acc = [] }),
		ForEach(f) -> ShowType(t = f.elem) as Elem,
		Collect(c) -> id([{ ty = 4, target = c.target, label = None(), value = "[]" + Ret, args = c.text }]),
		Spawn(sp) -> id(SpawnOuts(branches = sp.branches, value = Ret))
	};
	Elem -> id([{ ty = 2, target = ForEachCall(e = E).target, label = None(), value = this, args = ForEachCall(e = E).text }]);
}

// Draws a switch as one edge per call it can end in, nested switches
// flattened, each labelled with the arm heads on the way.
proc MatchOuts(s: { paths: []{ labels: []string, call: Call }, value: string, i: int, acc: []Out }): []Out {
	func Labels(ls: []string): string = "doc_leaf.rs:join_labels";
	MatchOuts switch {
		(this.s.i == this.s.paths.len) -> id(this.s.acc),
		else -> MatchOuts(s = { paths = this.s.paths, value = this.s.value, i = this.s.i + 1, acc = this.s.acc + [{ ty = 1, target = this.s.paths[this.s.i].call.target, label = Some(Labels(ls = this.s.paths[this.s.i].labels)), value = this.s.value, args = this.s.paths[this.s.i].call.text }] })
	};
}

// Shows what a call to n receives, `B(i: int, l: []int)`, named as the
// diagram names n.
proc CallSig(s: { prog: Program, pid: int, n: int }): string {
	CallSig -> ShowParams(s = { ps = NodeParams(nodes = this.s.prog.nodes, n = this.s.n), i = 0, acc = "" });
	ShowParams -> id(DisplayLabel(prog = CallSig.s.prog, pid = CallSig.s.pid, n = CallSig.s.n) + "(" + this + ")");
}

// Shows parameters as `p: t, q: u`.
proc ShowParams(s: { ps: []Member, i: int, acc: string }): string {
	ShowParams switch {
		(this.s.i == this.s.ps.len) -> id(this.s.acc),
		else -> ShowType(t = this.s.ps[this.s.i].ty)
	};
	ShowType -> ShowParams(s = { ps = ShowParams.s.ps, i = ShowParams.s.i + 1, acc = ShowParams.s.acc + Sep(i = ShowParams.s.i) + ShowParams.s.ps[ShowParams.s.i].name + ": " + this });
}

// Names a node as proc pid's diagram shows it: funcs local to the proc by
// bare name; others (interface funcs, top-level funcs) by qualified name.
func DisplayLabel(prog: Program, pid: int, n: int): string = "doc_leaf.rs:display_label";

// ---- JSON ----

// Turns a proc's layout into its grid: the rows, each a list of nodes, and
// the edges between them by row and column.
proc GridJson(s: { prog: Program, pid: int, l: Layout }): Json {
	func Rows(prog: Program, pid: int, l: Layout): Json = "doc_leaf.rs:rows_json";
	func Edges(l: Layout): Json = "doc_leaf.rs:edges_json";
	GridJson -> id(Obj([{ key = "rows", value = Rows(prog = this.s.prog, pid = this.s.pid, l = this.s.l) }, { key = "edges", value = Edges(l = this.s.l) }]));
}
